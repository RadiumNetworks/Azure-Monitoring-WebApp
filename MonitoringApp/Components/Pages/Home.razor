@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AlertStore AlertStore
@inject RcaService RcaService
@inject AlertHistoryOptions AlertHistory
@inject AlertSeverityDisplayOptions AlertSeverityDisplay
@inject InboxTargetOutputDisplayOptions TargetOutputDisplay
@inject AlertRuleEvaluator AlertRuleEvaluator
@inject ApplicationAuthenticationOptions ApplicationAuthentication
@inject CurrentUserIdentity CurrentUserIdentity
@inject QueryResultPresenter QueryResultPresenter
@inject InboxDashboardState Dashboard
@inject InboxLayoutRepository InboxLayoutRepository
@inject IJSRuntime JS
@inject UiText Text
@inject ILogger<Home> Logger

<PageTitle>Alert Console</PageTitle>

<section class="page-heading" data-language-dirty="@((Dashboard.CanUndo || Dashboard.CanRedo) ? "true" : "false")">
    <div class="heading-copy">
        <p class="eyebrow">@Text["Common.Operations"]</p>
        <h1>@Text["Inbox.Title"]</h1>
        <p class="subtitle">@Text["Inbox.Description"]</p>
        <div class="current-time" aria-label="@Text.Format("Inbox.CurrentTimeLabel", TimeZoneLabel(SelectedTimeZone))">
            <span>@Text["Inbox.CurrentTime"]</span>
            <time datetime="@currentTimeUtc.ToString("O")">@FormatCurrentTime()</time>
            <small>@TimeZoneLabel(SelectedTimeZone) (@FormatUtcOffset())</small>
        </div>
    </div>
    <div class="alert-count" aria-label="@Text.Format(AlertHistory.Days == 1 ? "Inbox.ReceivedCount.One" : "Inbox.ReceivedCount.Other", RecentAlertCount, AlertHistory.Days)">
        <strong>@RecentAlertCount</strong>
        <span>@Text.Plural("Inbox.ReceivedWindow", AlertHistory.Days)</span>
    </div>
</section>

@if (dashboardLoadFailed)
{
    <div class="admin-message admin-message-error" role="alert">
        <span>@Text["Inbox.WorkspaceLoadFailed"]</span>
        <button type="button" @onclick="LoadDashboardAsync" disabled="@isLoadingDashboard">@Text["Common.Refresh"]</button>
    </div>
}
@if (inboxLoadError is not null)
{
    <div class="admin-message admin-message-error" role="alert">@inboxLoadError</div>
}
@if (DashboardBrowserError is not null)
{
    <div class="admin-message admin-message-error" role="alert">
        <p>@DashboardBrowserError</p>
        <button type="button" disabled="@IsInitializingBrowser" @onclick="RetryDashboardBrowserAsync">@Text["Inbox.Browser.Retry"]</button>
    </div>
}
@if (firedHistoryLoadError is not null)
{
    <div class="admin-message admin-message-error" role="alert">@firedHistoryLoadError</div>
}
@if (rcaNoticeError is not null)
{
    <div class="admin-message admin-message-error" role="alert">@rcaNoticeError</div>
}
@if (openRcaNotices.Count > 0)
{
    <section class="admin-message admin-message-warning" role="status" aria-label="@Text["Inbox.OpenRcaNotices"]">
        @foreach (var notice in openRcaNotices)
        {
            <div @key="notice.Id">
                <a href="@($"/rca?caseId={notice.Id}")">@RcaNoticeLabel(notice)</a>
                <span>@RcaNoticeDetails(notice)</span>
            </div>
        }
    </section>
}

<details class="inbox-designer-panel">
    <summary>
        <span class="inbox-designer-icon" aria-hidden="true">◇</span>
        <span><strong>@Text["Inbox.Designer"]</strong><small>@Text["Inbox.DesignerDescription"]</small></span>
        <span class="inbox-designer-action">@Text["Inbox.OpenDesigner"] <i aria-hidden="true">⌄</i></span>
    </summary>
    <section class="inbox-command-bar inbox-designer-commands" aria-label="@Text["Inbox.CommandsLabel"]">
        <label class="inbox-edit-toggle">
            <input type="checkbox" @bind="isDashboardEditEnabled" @bind:after="DashboardEditModeChanged" disabled="@(dashboardLoadFailed || isLoadingDashboard)" />
            <span>@Text["Common.Edit"]</span>
        </label>
        <button type="button" @onclick="UndoDashboardAsync" disabled="@(!isDashboardEditEnabled || !Dashboard.CanUndo)">@Text["Inbox.Undo"]</button>
        <button type="button" @onclick="RedoDashboardAsync" disabled="@(!isDashboardEditEnabled || !Dashboard.CanRedo)">@Text["Inbox.Redo"]</button>
        <button type="button" @onclick="ToggleDashboardGridAsync" disabled="@(dashboardLoadFailed || isLoadingDashboard)">@Text[Dashboard.Document.ShowGrid ? "Inbox.HideGrid" : "Inbox.ShowGrid"]</button>
        <button class="danger" type="button" @onclick="ResetDashboardAsync" disabled="@(!isDashboardEditEnabled)">@Text["Common.Reset"]</button>
        <span class="inbox-command-spacer"></span>
        <label class="inbox-grid-setting">
            <span>@Text["Common.Rows"]</span>
            <input type="number" min="8" max="40" step="1" value="@Dashboard.Document.Rows" @onchange="ChangeDashboardRowsAsync" disabled="@(!isDashboardEditEnabled)" title="@Text["Inbox.MinimumRowsHelp"]" />
        </label>
        <label class="inbox-grid-setting inbox-row-size-setting">
            <span>@Text["Inbox.RowSize"]</span>
            <input type="range" min="64" max="132" step="4" value="@Dashboard.Document.RowHeight" @onchange="ChangeDashboardRowHeightAsync" disabled="@(!isDashboardEditEnabled)" />
            <output>@Dashboard.Document.RowHeight px</output>
        </label>
        <span class="inbox-save-status @((dashboardSaveFailed || dashboardLoadFailed) ? "inbox-save-status-error" : null)" role="@((dashboardSaveFailed || dashboardLoadFailed) ? "alert" : "status")"><i></i>@(dashboardStatus ?? Text["Inbox.LoadingWorkspace"])</span>
    </section>
    <div class="inbox-designer-tools">
        <div class="inbox-elements-only" aria-label="@Text["Inbox.ElementsLabel"]">
            <div class="inbox-widget-palette">
                @foreach (var template in InboxDashboardCatalog.Widgets)
                {
                    var isPresent = GetWidget(template.Kind) is not null;
                    <button type="button" class="inbox-element-button @(isPresent ? "present" : null)"
                            disabled="@(!isDashboardEditEnabled || isPresent)" @onclick="() => AddDashboardWidgetAsync(template.Kind)"
                            title="@Text.Format(isPresent ? "Inbox.WidgetAlreadyVisible" : "Inbox.AddWidget", template.Name)">
                        <span>@template.Icon</span>
                        <strong>@template.Name</strong>
                        <b aria-hidden="true">@(isPresent ? "✓" : "+")</b>
                    </button>
                }
            </div>
        </div>
    </div>
</details>

@{
    var dashboardLayout = InboxDashboardCatalog.GetLayout(Dashboard.Document.Layout);
}
<section class="inbox-dashboard-canvas" aria-label="@Text["Inbox.CanvasLabel"]" @ref="dashboardRoot">
    <div class="inbox-dashboard-grid @(Dashboard.Document.ShowGrid ? "show-grid" : null)" data-inbox-dashboard-grid
         data-columns="@dashboardLayout.Columns" data-rows="@Dashboard.Document.Rows" data-row-height="@Dashboard.Document.RowHeight"
         style="--columns:@dashboardLayout.Columns;--rows:@Dashboard.Document.Rows;--row-height:@(Dashboard.Document.RowHeight)px">
        @for (var row = 1; row <= Dashboard.Document.Rows; row++)
        {
            @for (var column = 1; column <= dashboardLayout.Columns; column++)
            {
                var dropRow = row;
                var dropColumn = column;
                <div class="inbox-drop-cell @(dashboardDropTarget == (dropColumn, dropRow) ? "drop-target" : null)"
                     style="grid-column:@dropColumn;grid-row:@dropRow"
                     @ondragenter="() => dashboardDropTarget = (dropColumn, dropRow)"
                     @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(dropColumn, dropRow)">
                    <span>@dropColumn.@dropRow</span>
                </div>
            }
        }

    @if (GetWidget(InboxWidgetKind.Trends) is { } trendsWidget)
    {
        <article class="inbox-dashboard-widget accent-@trendsWidget.Accent @(isDashboardEditEnabled ? "edit-enabled" : null) @(selectedDashboardWidgetId == trendsWidget.Id ? "selected" : null)"
                 data-inbox-widget-id="@trendsWidget.Id" data-column-span="@trendsWidget.ColumnSpan" data-row-span="@trendsWidget.RowSpan"
                  draggable="false" style="@DashboardWidgetStyle(trendsWidget)" @onclick="() => SelectDashboardWidget(trendsWidget.Id)"
                 @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(trendsWidget.Column, trendsWidget.Row)"
                  >
                            <header class="inbox-widget-header"><span data-inbox-drag-handle="@(CanUseDashboardBrowser ? string.Empty : null)" title="@Text["Widgets.DragToMove"]">⠿</span><div><strong>@trendsWidget.Title</strong><small>@Text["Inbox.TrendsDescription"]</small></div><button class="inbox-widget-menu" type="button" @onclick="() => SelectDashboardWidget(trendsWidget.Id)" @onclick:stopPropagation="true">•••</button></header>
                        @if (isDashboardEditEnabled && selectedDashboardWidgetId == trendsWidget.Id)
            {
                <InboxWidgetActions Widget="trendsWidget" OnAction="action => HandleDashboardWidgetActionAsync(trendsWidget.Id, action)" />
            }
            <div class="inbox-widget-body">
    @{
        var hourlyCounts = GetHourlyAlertCounts();
        var maximumHourlyCount = hourlyCounts.Max(bucket => bucket.Count);
        var chartScaleMaximum = Math.Max(1, maximumHourlyCount);
        var criticalHourlyCounts = GetHourlyCriticalAlertCounts();
        var maximumCriticalHourlyCount = criticalHourlyCounts.Max(bucket => bucket.Count);
        var criticalChartScaleMaximum = Math.Max(1, maximumCriticalHourlyCount);
        var chartTickIndexes = GetChartTickIndexes(hourlyCounts.Count);
    }
    <div class="trend-stack">
        <div class="alert-trend" role="img" aria-label="@ChartDescription(hourlyCounts)">
            <div class="trend-heading">
                <strong>@Text["Inbox.AlertsPerHour"]</strong>
                <span>@Text.Format("Inbox.ChartWindow", TimeZoneLabel(SelectedTimeZone))</span>
            </div>
            <div class="chart-frame">
                <span class="chart-maximum">@maximumHourlyCount</span>
                <svg viewBox="0 0 640 120" preserveAspectRatio="none" aria-hidden="true">
                    <line class="chart-grid-line" x1="0" y1="10" x2="640" y2="10" />
                    <line class="chart-grid-line" x1="0" y1="60" x2="640" y2="60" />
                    <line class="chart-grid-line" x1="0" y1="110" x2="640" y2="110" />
                    @foreach (var tickIndex in chartTickIndexes)
                    {
                        var x = ChartCoordinate(ChartX(tickIndex, hourlyCounts.Count));
                        <line class="chart-grid-line chart-grid-line-time" x1="@x" y1="10" x2="@x" y2="110" />
                    }
                    <polyline class="chart-line" points="@ChartPoints(hourlyCounts, chartScaleMaximum)" />
                </svg>
            </div>
            <div class="chart-axis" aria-hidden="true">
                @foreach (var tickIndex in chartTickIndexes)
                {
                    <span style="@ChartTickStyle(tickIndex, hourlyCounts.Count)">@FormatChartTime(hourlyCounts[tickIndex].Hour)</span>
                }
            </div>
        </div>
        <div class="alert-trend critical-alert-trend" role="img" aria-label="@CriticalChartDescription(criticalHourlyCounts)">
            <div class="trend-heading">
                <strong>@Text["Inbox.ActiveCriticalAlerts"]</strong>
                <span>@Text.Format("Inbox.CriticalChartSummary", criticalHourlyCounts[^1].Count, maximumCriticalHourlyCount, TimeZoneLabel(SelectedTimeZone))</span>
            </div>
            <div class="chart-frame">
                <span class="chart-maximum" title="@Text["Inbox.CriticalScaleHelp"]">@maximumCriticalHourlyCount</span>
                <svg viewBox="0 0 640 120" preserveAspectRatio="none" aria-hidden="true">
                    <line class="chart-grid-line" x1="0" y1="10" x2="640" y2="10" />
                    <line class="chart-grid-line" x1="0" y1="60" x2="640" y2="60" />
                    <line class="chart-grid-line" x1="0" y1="110" x2="640" y2="110" />
                    @foreach (var tickIndex in chartTickIndexes)
                    {
                        var x = ChartCoordinate(ChartX(tickIndex, criticalHourlyCounts.Count));
                        <line class="chart-grid-line chart-grid-line-time" x1="@x" y1="10" x2="@x" y2="110" />
                    }
                    <polyline class="chart-line chart-line-critical" points="@CriticalChartPoints(criticalHourlyCounts, criticalChartScaleMaximum)" />
                </svg>
            </div>
            <div class="chart-axis" aria-hidden="true">
                @foreach (var tickIndex in chartTickIndexes)
                {
                    <span style="@ChartTickStyle(tickIndex, criticalHourlyCounts.Count)">@FormatChartTime(criticalHourlyCounts[tickIndex].Hour)</span>
                }
            </div>
        </div>
    </div>
            </div>
            <button class="inbox-resize-handle" disabled="@(!CanUseDashboardBrowser)" data-inbox-resize-handle="@(CanUseDashboardBrowser ? string.Empty : null)" draggable="false" title="@Text.Format("Widgets.DragResize", trendsWidget.Title)" aria-label="@Text.Format("Widgets.Resize", trendsWidget.Title)"></button>
        </article>
    }

    @if (GetWidget(InboxWidgetKind.Filters) is { } filtersWidget)
    {
        <article class="inbox-dashboard-widget accent-@filtersWidget.Accent @(isDashboardEditEnabled ? "edit-enabled" : null) @(selectedDashboardWidgetId == filtersWidget.Id ? "selected" : null)"
                 data-inbox-widget-id="@filtersWidget.Id" data-column-span="@filtersWidget.ColumnSpan" data-row-span="@filtersWidget.RowSpan"
                  draggable="false" style="@DashboardWidgetStyle(filtersWidget)" @onclick="() => SelectDashboardWidget(filtersWidget.Id)"
                 @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(filtersWidget.Column, filtersWidget.Row)"
                  >
                            <header class="inbox-widget-header"><span data-inbox-drag-handle="@(CanUseDashboardBrowser ? string.Empty : null)" title="@Text["Widgets.DragToMove"]">⠿</span><div><strong>@filtersWidget.Title</strong><small>@Text["Inbox.FiltersDescription"]</small></div><button class="inbox-widget-menu" type="button" @onclick="() => SelectDashboardWidget(filtersWidget.Id)" @onclick:stopPropagation="true">•••</button></header>
                        @if (isDashboardEditEnabled && selectedDashboardWidgetId == filtersWidget.Id)
            {
                <InboxWidgetActions Widget="filtersWidget" OnAction="action => HandleDashboardWidgetActionAsync(filtersWidget.Id, action)" />
            }
            <div class="inbox-widget-body inbox-filter-body">
<section class="controls" aria-label="@Text["Inbox.FiltersLabel"]">
    <label>
        <span>@Text["Inbox.View"]</span>
        <select value="@viewMode" @onchange="ChangeViewModeAsync">
            <option value="active">@Text["Inbox.View.Active"]</option>
            <option value="history">@Text["Inbox.View.History"]</option>
            <option value="history-fired">@Text["Inbox.View.FiredHistory"]</option>
        </select>
    </label>
    <label class="search-field">
        <span>@Text["Inbox.Search"]</span>
        <input type="search" @bind="searchText" @bind:event="oninput" @bind:after="ResetPagination" placeholder="@Text["Inbox.SearchPlaceholder"]" />
    </label>
    <label>
        <span>@Text["Common.TimeZone"]</span>
        <select value="@selectedTimeZoneId" @onchange="ChangeTimeZone">
            @foreach (var timeZone in AlertTimeZones.Options)
            {
                <option value="@timeZone.Id">@TimeZoneLabel(timeZone)</option>
            }
        </select>
    </label>
    <label>
        <span>@Text["Inbox.ReceivedFrom"]</span>
        <input type="datetime-local" value="@receivedFromInput" @onchange="ChangeReceivedFrom" @onfocus="BeginDateTimeEdit" @onblur="EndDateTimeEdit" />
    </label>
    <label>
        <span>@Text["Inbox.ReceivedTo"]</span>
        <input type="datetime-local" value="@receivedToInput" @onchange="ChangeReceivedTo" @onfocus="BeginDateTimeEdit" @onblur="EndDateTimeEdit" />
    </label>
    <button class="clear-filters" type="button" disabled="@(!HasFilters)" @onclick="ClearFilters">@Text["Inbox.ClearFilters"]</button>
</section>
            </div>
            <button class="inbox-resize-handle" disabled="@(!CanUseDashboardBrowser)" data-inbox-resize-handle="@(CanUseDashboardBrowser ? string.Empty : null)" draggable="false" title="@Text.Format("Widgets.DragResize", filtersWidget.Title)" aria-label="@Text.Format("Widgets.Resize", filtersWidget.Title)"></button>
        </article>
    }

@{
    var navigationTree = GetNavigationTree();
    var knownSystemCount = navigationTree.Sum(domain => domain.Roles.Sum(role => role.Targets.Count));
    var filteredAlerts = FilteredAlerts.ToArray();
    var pageCount = Math.Max(1, (int)Math.Ceiling(filteredAlerts.Length / (double)PageSize));
    currentPage = Math.Clamp(currentPage, 1, pageCount);
    var visibleAlerts = filteredAlerts
        .Skip((currentPage - 1) * PageSize)
        .Take(PageSize)
        .ToArray();
    var categorizedAlerts = viewMode == "active"
        ? AlertRuleEvaluator.Categorize(visibleAlerts, alertRules, InboxInventory, ActiveAlerts)
        : new AlertCategorizationResult([], visibleAlerts);
    var displayItems = InboxCategories.BuildItems(categorizedAlerts, visibleAlerts, categoryState);
    var heatmapCells = GetHeatmapCells(filteredAlerts);
}
    @if (GetWidget(InboxWidgetKind.Navigation) is { } navigationWidget)
    {
        <article class="inbox-dashboard-widget accent-@navigationWidget.Accent @(isDashboardEditEnabled ? "edit-enabled" : null) @(selectedDashboardWidgetId == navigationWidget.Id ? "selected" : null)"
                 data-inbox-widget-id="@navigationWidget.Id" data-column-span="@navigationWidget.ColumnSpan" data-row-span="@navigationWidget.RowSpan"
                  draggable="false" style="@DashboardWidgetStyle(navigationWidget)" @onclick="() => SelectDashboardWidget(navigationWidget.Id)"
                 @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(navigationWidget.Column, navigationWidget.Row)"
                  >
                            <header class="inbox-widget-header"><span data-inbox-drag-handle="@(CanUseDashboardBrowser ? string.Empty : null)" title="@Text["Widgets.DragToMove"]">⠿</span><div><strong>@navigationWidget.Title</strong><small>@Text["Inbox.NavigationDescription"]</small></div><button class="inbox-widget-menu" type="button" @onclick="() => SelectDashboardWidget(navigationWidget.Id)" @onclick:stopPropagation="true">•••</button></header>
                        @if (isDashboardEditEnabled && selectedDashboardWidgetId == navigationWidget.Id)
            {
                <InboxWidgetActions Widget="navigationWidget" OnAction="action => HandleDashboardWidgetActionAsync(navigationWidget.Id, action)" />
            }
            <div class="inbox-widget-body">
<nav class="alert-navigation" aria-label="@Text["Inbox.NavigationLabel"]">
    <div class="tree-heading">
        <div>
            <strong>@Text["Inbox.NavigationTitle"]</strong>
            <span>@Text["Inbox.NavigationCountsLabel"]</span>
        </div>
        <span class="tree-total">@Text.Format(knownSystemCount == 1 ? "Inbox.NavigationCounts.One" : "Inbox.NavigationCounts.Other", knownSystemCount, navigationTree.Sum(domain => domain.Count))</span>
    </div>
    <div class="tree-root">
        <button type="button" class="tree-node tree-node-root @(IsTreeSelection(string.Empty, string.Empty, string.Empty) ? "selected" : null)" @onclick="() => SelectTreeNode()">
            <span>@Text["Filters.AllDomains"]</span>
            <span class="tree-count" style="@TreeCountStyle(navigationTree.Sum(domain => domain.Count))">@navigationTree.Sum(domain => domain.Count)</span>
        </button>
        @foreach (var domain in navigationTree)
        {
            var domainExpanded = expandedDomains.Contains(domain.Name);
            <div class="tree-branch">
                <div class="tree-row tree-level-1">
                    <button type="button" class="tree-toggle" title="@Text[domainExpanded ? "Inbox.CollapseDomain" : "Inbox.ExpandDomain"]" aria-label="@Text[domainExpanded ? "Inbox.CollapseDomain" : "Inbox.ExpandDomain"]" aria-expanded="@domainExpanded" @onclick="() => ToggleDomain(domain.Name)">
                        <span aria-hidden="true"></span>
                    </button>
                    <button type="button" class="tree-node @(IsTreeSelection(domain.Name, string.Empty, string.Empty) ? "selected" : null)" @onclick="() => SelectTreeNode(domain.Name)">
                        <span title="@domain.Name">@Display(domain.Name)</span>
                        <span class="tree-count" style="@TreeCountStyle(domain.Count)">@domain.Count</span>
                    </button>
                </div>
                @if (domainExpanded)
                {
                    @foreach (var role in domain.Roles)
                    {
                        var roleKey = TreeKey(domain.Name, role.Name);
                        var roleExpanded = expandedRoles.Contains(roleKey);
                        <div class="tree-branch">
                            <div class="tree-row tree-level-2">
                                <button type="button" class="tree-toggle" title="@Text[roleExpanded ? "Inbox.CollapseRole" : "Inbox.ExpandRole"]" aria-label="@Text[roleExpanded ? "Inbox.CollapseRole" : "Inbox.ExpandRole"]" aria-expanded="@roleExpanded" @onclick="() => ToggleRole(roleKey)">
                                    <span aria-hidden="true"></span>
                                </button>
                                <button type="button" class="tree-node @(IsTreeSelection(domain.Name, role.Name, string.Empty) ? "selected" : null)" @onclick="() => SelectTreeNode(domain.Name, role.Name)">
                                    <span title="@role.Name">@Display(role.Name)</span>
                                    <span class="tree-count" style="@TreeCountStyle(role.Count)">@role.Count</span>
                                </button>
                            </div>
                            @if (roleExpanded)
                            {
                                @foreach (var target in role.Targets)
                                {
                                    <div class="tree-row tree-level-3">
                                        <span class="tree-leaf-marker" aria-hidden="true"></span>
                                        <button type="button" class="tree-node @(IsTreeSelection(domain.Name, role.Name, target.Name) ? "selected" : null)" @onclick="() => SelectTreeNode(domain.Name, role.Name, target.Name)">
                                            <span title="@target.DisplayName">@Display(target.DisplayName)</span>
                                            <span class="tree-count" style="@TreeCountStyle(target.Count)">@target.Count</span>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</nav>
            </div>
            <button class="inbox-resize-handle" disabled="@(!CanUseDashboardBrowser)" data-inbox-resize-handle="@(CanUseDashboardBrowser ? string.Empty : null)" draggable="false" title="@Text.Format("Widgets.DragResize", navigationWidget.Title)" aria-label="@Text.Format("Widgets.Resize", navigationWidget.Title)"></button>
        </article>
    }
    @if (GetWidget(InboxWidgetKind.Heatmap) is { } heatmapWidget)
    {
        <article class="inbox-dashboard-widget accent-@heatmapWidget.Accent @(isDashboardEditEnabled ? "edit-enabled" : null) @(selectedDashboardWidgetId == heatmapWidget.Id ? "selected" : null)"
                 data-inbox-widget-id="@heatmapWidget.Id" data-column-span="@heatmapWidget.ColumnSpan" data-row-span="@heatmapWidget.RowSpan"
                  draggable="false" style="@DashboardWidgetStyle(heatmapWidget)" @onclick="() => SelectDashboardWidget(heatmapWidget.Id)"
                 @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(heatmapWidget.Column, heatmapWidget.Row)"
                  >
                            <header class="inbox-widget-header"><span data-inbox-drag-handle="@(CanUseDashboardBrowser ? string.Empty : null)" title="@Text["Widgets.DragToMove"]">⠿</span><div><strong>@heatmapWidget.Title</strong><small>@Text["Inbox.TargetStatus"]</small></div><button class="inbox-widget-menu" type="button" @onclick="() => SelectDashboardWidget(heatmapWidget.Id)" @onclick:stopPropagation="true">•••</button></header>
                        @if (isDashboardEditEnabled && selectedDashboardWidgetId == heatmapWidget.Id)
            {
                <InboxWidgetActions Widget="heatmapWidget" OnAction="action => HandleDashboardWidgetActionAsync(heatmapWidget.Id, action)" />
            }
            <div class="inbox-widget-body">
<section class="alert-heatmap" aria-labelledby="heatmap-title">
    <div class="heatmap-heading">
        <div>
            <strong id="heatmap-title">@Text[TargetOutputDisplay.ShowDomain ? "Inbox.TargetsDomainsSites" : "Inbox.TargetsSites"]</strong>
            <span>@Text["Inbox.HeatmapDescription"]</span>
        </div>
        @if (heatmapCells.Count > 0)
        {
            <div class="heatmap-legend" aria-label="@TargetOutputLegendDescription">
                @foreach (var entry in TargetOutputDisplay.Legend())
                {
                    <i style="background:hsl(var(--heat-hue) var(--heat-saturation) var(--heat-lightness));@InboxTargetOutputDisplayOptions.ColorStyle(entry.Color)"></i><span>@TargetLegendLabel(entry)</span>
                }
                <i class="heatmap-legend-missing-heartbeat"></i><span>@Text["Inbox.MissingHeartbeat"]</span>
            </div>
        }
    </div>
    @if (heatmapCells.Count == 0)
    {
        <p class="heatmap-empty">@Text["Inbox.NoTargets"]</p>
    }
    else
    {
        <div class="heatmap-grid">
            @foreach (var cell in heatmapCells)
            {
                <div class="@TargetOutputDisplay.CssClass(cell)" style="@TargetOutputDisplay.Style(cell)" title="@HeatmapCellDescription(cell)" aria-label="@HeatmapCellDescription(cell)">
                    <strong>@cell.Count</strong>
                    <span class="heatmap-target">@cell.Target</span>
                    @if (TargetOutputDisplay.ShowDomain)
                    {
                        <span class="heatmap-domain">@cell.Domain</span>
                    }
                    <span class="heatmap-site">@cell.Site</span>
                    @if (cell.HasServiceHealthAlert && cell.Count == 0)
                    {
                        <span class="heatmap-heartbeat-status">@Text["Inbox.ServiceHealthAlert"]</span>
                    }
                    else if (cell.MissingHeartbeat)
