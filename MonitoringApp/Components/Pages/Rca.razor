@page "/rca"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject RcaService RcaService
@inject IAuthorizationService Authorization
@inject UiText Text
@inject ILogger<Rca> Logger

<PageTitle>@Text["Navigation.RootCauseAnalysis"]</PageTitle>

<section class="admin-heading">
    <div>
        <p class="eyebrow">@Text["Common.Operations"]</p>
        <h1>@Text["Navigation.RootCauseAnalysis"]</h1>
        <p class="subtitle">@Text["Rca.Description"]</p>
    </div>
    <div class="admin-actions">
        @if (canEdit)
        {
            <button class="admin-primary" type="button" disabled="@(busy || reloadRequired || HasUnsavedChanges)" @onclick="() => OpenAlertPickerAsync(true)">@Text["Rca.New"]</button>
        }
        <button class="admin-secondary" type="button" disabled="@busy" @onclick="RefreshAsync">@Text["Common.Refresh"]</button>
    </div>
</section>

@if (error is not null)
{
    <div class="admin-message admin-message-error" role="alert">@error</div>
}
@if (message is not null)
{
    <div class="admin-message admin-message-success" role="status">@message</div>
}

@if (canEdit && AlertPickerOpen)
{
    <section class="admin-editor rca-linked-alerts" aria-label="@Text["Rca.AssignmentLabel"]">
        <h2>@(creatingCase ? Text["Rca.Create"] : Text.Format("Rca.AssignTo", selected?.CategoryName ?? ""))</h2>
        <p>@Text["Rca.PickerHelp"]</p>
        <form class="admin-form" @onsubmit="SubmitAlertAssignmentAsync" @onsubmit:preventDefault>
            @if (creatingCase)
            {
                <label class="admin-field admin-field-wide">
                    <span>@Text["Rca.Name"]</span>
                    <input type="text" maxlength="256" required @bind="newCaseName" disabled="@busy" />
                </label>
            }
            <label class="admin-field admin-field-wide">
                <span>@Text["Rca.Search"]</span>
                <input type="search" @bind="alertSearch" @bind:event="oninput" disabled="@busy" placeholder="@Text["Rca.SearchPlaceholder"]" />
            </label>
            <div class="admin-field-wide rca-alert-scroll rca-picker-scroll">
                <table class="rca-alert-table">
                    <thead>
                        <tr><th scope="col">@Text["Rca.Select"]</th><th scope="col">@Text["Rca.AlertSystem"]</th><th scope="col">@Text["Rca.State"]</th><th scope="col">@Text["Rca.Received"]</th><th scope="col">@Text["Rca.Current"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var candidate in VisibleAlertCandidates)
                        {
                            <tr @key="candidate.Alert.Id">
                                <td><input type="checkbox" aria-label="@Text.Format("Rca.SelectAlert", candidate.Alert.Name, candidate.Alert.TargetName, candidate.Alert.Id)"
                                    checked="@selectedAlertIds.Contains(candidate.Alert.Id)" disabled="@busy"
                                    @onchange="args => AlertSelectionChanged(candidate.Alert.Id, args)" /></td>
                                <td>@candidate.Alert.Name<br /><small>@Text.Format("Rca.AlertId", candidate.Alert.AlertId)</small><br />@candidate.Alert.TargetName<br /><small>@candidate.Alert.SubscriptionId</small></td>
                                <td>@Text[candidate.IsActive ? "Rca.Active" : "Rca.Inactive"] / @candidate.Alert.MonitorCondition</td>
                                <td>@Utc(candidate.Alert.ReceivedAt)</td>
                                <td>@(candidate.RcaName ?? Text["Inbox.RcaUnassigned"])
                                    @if (candidate.RcaId is { } ownerId)
                                    {
                                        <br /><small>@ownerId</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!candidateLoadFailed && !VisibleAlertCandidates.Any())
                {
                    <p class="admin-empty">@Text["Rca.NoCandidates"]</p>
                }
            </div>
            <p class="admin-field-wide">@Text.Format("Rca.SelectedAlerts", selectedAlertIds.Count)</p>
            @if (ReassignedAlerts.Count > 0)
            {
                <div class="admin-message admin-message-warning admin-field-wide" role="note">
                    <p>@Text["Rca.MoveWarning"]</p>
                    <ul>
                        @foreach (var source in ReassignedAlerts.Select(candidate => (candidate.RcaId, candidate.RcaName)).Distinct())
                        {
                            <li>@source.RcaName (@source.RcaId)</li>
                        }
                    </ul>
                    <label><input type="checkbox" @bind="confirmReassignment" disabled="@busy" /> @Text["Rca.ConfirmMove"]</label>
                </div>
            }
            <div class="admin-actions admin-field-wide">
                <button class="admin-primary" type="submit"
                    disabled="@(busy || reloadRequired || candidateLoadFailed || selectedAlertIds.Count == 0 || creatingCase && string.IsNullOrWhiteSpace(newCaseName) || ReassignedAlerts.Count > 0 && !confirmReassignment)">
                    @Text[creatingCase ? "Rca.CreateSelected" : "Rca.AssignSelected"]
                </button>
                <button class="admin-secondary" type="button" disabled="@busy" @onclick="RefreshAssignableAlertsAsync">@Text["Rca.ReloadAlerts"]</button>
                <button class="admin-secondary" type="button" disabled="@busy" @onclick="CancelAlertAssignment">@Text["Common.Cancel"]</button>
            </div>
        </form>
    </section>
}

<div class="admin-workspace rca-workspace">
    <section class="admin-rule-list" aria-label="@Text["Rca.Incidents"]">
        @if (!casesLoadFailed && cases.Count == 0)
        {
            <p class="admin-empty">@Text["Rca.Empty"]</p>
        }
        @if (cases.Count > 0)
        {
            <h2 class="rca-group-heading">@Text.Format("Rca.OpenCount", cases.Count(rca => rca.Status != RcaStatuses.Closed))</h2>
            <div class="rca-case-list" aria-label="@Text["Rca.Open"]">
                @foreach (var rca in cases.Where(rca => rca.Status != RcaStatuses.Closed))
                {
                    <RcaCaseSummary @key="rca.Id" Case="rca" Selected="@(selected?.Id == rca.Id)"
                                    Busy="@(busy || reloadRequired)" OnSelected="SelectAsync" />
                }
            </div>
            <details class="rca-closed-group">
                <summary>@Text.Format("Rca.ClosedCount", cases.Count(rca => rca.Status == RcaStatuses.Closed))</summary>
                <div class="rca-case-list" aria-label="@Text["Rca.Closed"]">
                    @foreach (var rca in cases.Where(rca => rca.Status == RcaStatuses.Closed))
                    {
                        <RcaCaseSummary @key="rca.Id" Case="rca" Selected="@(selected?.Id == rca.Id)"
                                        Busy="@(busy || reloadRequired)" OnSelected="SelectAsync" />
                    }
                </div>
            </details>
        }
    </section>

    <section class="admin-editor" aria-label="@Text["Rca.Details"]">
        @if (selected is { } current)
        {
            <h2>@current.CategoryName</h2>
            <p>@Text.Format("Rca.Identity", current.Id, current.RuleId == Guid.Empty ? Text["Rca.Manual"] : Text.Format("Rca.RuleId", current.RuleId))</p>
            <p>@Text.Format("Rca.FollowUp", Utc(current.FollowUpDueAt))
                @if (prompts.All(prompt => prompt.Sequence != 1))
                {
                    <span>@Text["Rca.FollowUpPending"]</span>
                }
            </p>
            @if (current.CriticalEndedAt is { } endedAt)
            {
                <p>@Text.Format("Rca.CriticalEnded", Utc(endedAt))</p>
            }
            <section class="rca-linked-alerts" aria-labelledby="rca-linked-alerts-heading">
                <h3 id="rca-linked-alerts-heading">@Text.Format("Rca.LinkedCount", linkedAlerts.Count)</h3>
                @if (canEdit)
                {
                    <button class="admin-secondary" type="button"
                        disabled="@(busy || reloadRequired || AlertPickerOpen || HasUnsavedChanges || current.Status == RcaStatuses.Closed)"
                        @onclick="() => OpenAlertPickerAsync(false)">@Text["Rca.AssignAlerts"]</button>
                    <p>@Text["Rca.AssignHelp"]</p>
                }
                @if (linkedAlerts.Count == 0)
                {
                    <p>@Text["Rca.NoLinkedAlerts"]</p>
                }
                else
                {
                    <p>@Text["Rca.LinkedHelp"]</p>
                    <div class="rca-alert-scroll">
                        <table class="rca-alert-table">
                            <thead>
                                <tr><th scope="col">@Text["Rca.Alert"]</th><th scope="col">@Text["Rca.System"]</th><th scope="col">@Text["Rca.MonitorCondition"]</th><th scope="col">@Text["Rca.Received"]</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in linkedAlerts)
                                {
                                    <tr @key="alert.Id">
                                        <td>
                                            <details>
                                                <summary>@alert.Name</summary>
                                                <p>@Text.Format("Rca.EventId", alert.Id)<br />@Text.Format("Rca.AlertId", alert.AlertId)<br />@Text.Format("Rca.Subscription", alert.SubscriptionId)</p>
                                                @if (!string.IsNullOrWhiteSpace(alert.SearchResultsUrl))
                                                {
                                                    <a href="@alert.SearchResultsUrl" target="_blank" rel="noopener noreferrer">@Text["Rca.OpenSearch"]</a>
                                                }
                                            </details>
                                        </td>
                                        <td>@alert.TargetName</td>
                                        <td>@alert.MonitorCondition</td>
                                        <td>@alert.ReceivedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
            <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label class="admin-field">
                    <span>@Text["AdminScheduledQueries.Status"]</span>
                    <select @bind="status" disabled="@(!canEdit || busy || reloadRequired || AlertPickerOpen)">
                        @foreach (var value in RcaStatuses.All)
                        {
                            <option value="@value">@Text[$"Inbox.RcaStatus.{value}"]</option>
                        }
                    </select>
                </label>
                <label class="admin-field">
                    <span>@Text["Rca.Assignee"]</span>
                    <input type="text" list="rca-assignees" maxlength="256" @bind="assignedTo"
                           disabled="@(!canEdit || busy || reloadRequired || AlertPickerOpen)" placeholder="@Text["Rca.AssigneePlaceholder"]" />
                    <datalist id="rca-assignees">
                        @foreach (var assignee in assignees)
                        {
                            <option value="@assignee"></option>
                        }
                    </datalist>
                    <small>@Text["Rca.AssigneeHelp"]</small>
                </label>
                <label class="admin-field admin-field-wide">
                    <span>@Text["Rca.Analysis"]</span>
                    <textarea rows="16" maxlength="100000" @bind="analysis" readonly="@(!canEdit || busy || reloadRequired || AlertPickerOpen)"></textarea>
                </label>
                @if (canEdit)
                {
                    <label class="admin-field admin-field-wide">
                        <span>@Text["Rca.AddComment"]</span>
                        <textarea rows="4" maxlength="4000" @bind="comment" disabled="@(busy || reloadRequired || AlertPickerOpen)"></textarea>
                    </label>
                    <button class="admin-primary" type="submit" disabled="@(busy || reloadRequired || AlertPickerOpen)">@Text["Common.SaveChanges"]</button>
                }
            </form>

            <h3>@Text["Rca.RawPrompts"]</h3>
            @foreach (var prompt in prompts)
            {
                <details @key="prompt.Id">
                    <summary>@Text[prompt.Sequence == 0 ? "Rca.InitialSnapshot" : "Rca.FollowUpSnapshot"] / @Utc(prompt.CreatedAt)</summary>
                    <label class="admin-field admin-field-wide">
                        <span>@Text["Rca.RawPromptHelp"]</span>
                        <textarea rows="16" readonly value="@prompt.RawPrompt"></textarea>
                    </label>
                </details>
            }

            <h3>@Text["Rca.Changelog"]</h3>
            @foreach (var change in changes)
            {
                <details @key="change.Id">
                    <summary>@Utc(change.CreatedAt) / @change.Actor / @change.Field</summary>
                    @if (change.Field != "Comment")
                    {
                        <label class="admin-field admin-field-wide">
                            <span>@Text["Rca.Before"]</span>
                            <textarea rows="3" readonly value="@change.Before"></textarea>
                        </label>
                    }
                    <label class="admin-field admin-field-wide">
                        <span>@Text[change.Field == "Comment" ? "Logbook.Comment" : "Rca.After"]</span>
                        <textarea rows="4" readonly value="@change.After"></textarea>
                    </label>
                </details>
            }
        }
        else
        {
            <p class="admin-empty">@Text["Rca.SelectCase"]</p>
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "caseId")]
    public Guid? CaseId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private IReadOnlyList<RootCauseAnalysis> cases = [];
    private IReadOnlyList<RcaPrompt> prompts = [];
    private IReadOnlyList<RcaChange> changes = [];
    private IReadOnlyList<AlertRecord> linkedAlerts = [];
    private IReadOnlyList<string> assignees = [];
    private RootCauseAnalysis? selected;
    private string analysis = "";
    private string assignedTo = "";
    private string status = RcaStatuses.Open;
    private string comment = "";
    private string? error;
    private string? message;
    private bool busy;
    private bool canEdit;
    private bool initialized;
    private bool casesLoadFailed;
    private bool candidateLoadFailed;
    private bool reloadRequired;
    private Guid? pendingReloadCaseId;
    private Guid? loadedCaseId;
    private bool creatingCase;
    private bool assigningAlerts;
    private bool confirmReassignment;
    private string newCaseName = "";
    private string alertSearch = "";
    private IReadOnlyList<RcaAlertCandidate> alertCandidates = [];
    private readonly HashSet<Guid> selectedAlertIds = [];
    private bool AlertPickerOpen => creatingCase || assigningAlerts;
    private bool HasUnsavedChanges => selected is not null &&
        (analysis != selected.Analysis || assignedTo != selected.AssignedTo || status != selected.Status || !string.IsNullOrWhiteSpace(comment));
    private IEnumerable<RcaAlertCandidate> VisibleAlertCandidates => alertCandidates.Where(candidate =>
        (creatingCase || candidate.RcaId != selected?.Id) &&
        (string.IsNullOrWhiteSpace(alertSearch) || new[]
        {
            candidate.Alert.Name, candidate.Alert.AlertId, candidate.Alert.TargetName, candidate.Alert.SubscriptionId, candidate.RcaName ?? ""
        }.Any(value => value.Contains(alertSearch.Trim(), StringComparison.OrdinalIgnoreCase))));
    private IReadOnlyList<RcaAlertCandidate> ReassignedAlerts => alertCandidates.Where(candidate =>
        selectedAlertIds.Contains(candidate.Alert.Id) && candidate.RcaId is not null &&
        (creatingCase || candidate.RcaId != selected?.Id)).ToArray();

    private async Task OpenAlertPickerAsync(bool create)
    {
        if (!canEdit || busy || reloadRequired || HasUnsavedChanges || !create && (selected is null || selected.Status == RcaStatuses.Closed))
            return;
        creatingCase = create;
        assigningAlerts = !create;
        newCaseName = "";
        alertSearch = "";
        await RefreshAssignableAlertsAsync();
    }

    private async Task RefreshAssignableAlertsAsync()
    {
        if (!canEdit || busy)
            return;
        busy = true;
        error = null;
        message = null;
        selectedAlertIds.Clear();
        confirmReassignment = false;
        alertCandidates = [];
        try
        {
            alertCandidates = await RcaService.GetAssignableAlertsAsync((await AuthenticationStateTask).User);
            candidateLoadFailed = false;
        }
        catch (Exception exception)
        {
            candidateLoadFailed = true;
            ReportError(exception, "Rca.LoadCandidatesError");
        }
        finally { busy = false; }
    }

    private void AlertSelectionChanged(Guid id, ChangeEventArgs args)
    {
        if (busy)
            return;
        if (args.Value is true)
            selectedAlertIds.Add(id);
        else
            selectedAlertIds.Remove(id);
        confirmReassignment = false;
    }

    private void CancelAlertAssignment()
    {
        creatingCase = assigningAlerts = confirmReassignment = false;
        alertCandidates = [];
        selectedAlertIds.Clear();
        candidateLoadFailed = false;
    }

    private async Task SubmitAlertAssignmentAsync()
    {
        if (!canEdit || busy || reloadRequired || candidateLoadFailed || !AlertPickerOpen)
            return;
        busy = true;
        error = message = null;
        try
        {
            var user = (await AuthenticationStateTask).User;
            var selections = alertCandidates.Where(candidate => selectedAlertIds.Contains(candidate.Alert.Id))
                .Select(candidate => candidate.Selection).ToArray();
            Guid id;
            if (creatingCase)
                id = await RcaService.CreateAsync(user, newCaseName, selections, confirmReassignment);
            else
            {
                id = selected!.Id;
                await RcaService.AssignAlertsAsync(user, id, selected.Revision, selections, confirmReassignment);
            }
            CancelAlertAssignment();
            pendingReloadCaseId = id;
            reloadRequired = true;
            message = Text["Rca.AssignmentsSaved"];
            await ReloadCasesAsync();
        }
        catch (Exception exception) { ReportError(exception, "Rca.SaveAssignmentsError"); }
        finally { busy = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (initialized && loadedCaseId == CaseId)
            return;
        initialized = true;
        loadedCaseId = CaseId;
        selected = null;
        pendingReloadCaseId = null;
        reloadRequired = false;
        var state = await AuthenticationStateTask;
        canEdit = (await Authorization.AuthorizeAsync(state.User, "AdminAccess")).Succeeded;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (busy)
            return;
        CancelAlertAssignment();
        busy = true;
        error = null;
        try { await ReloadCasesAsync(); }
        finally { busy = false; }
    }

    private async Task ReloadCasesAsync()
    {
        try
        {
            var loadedCases = await RcaService.ListAsync();
            var loadedAssignees = canEdit
                ? await RcaService.GetAssigneesAsync((await AuthenticationStateTask).User) : Array.Empty<string>();
            var current = loadedCases.FirstOrDefault(rca => rca.Id == (pendingReloadCaseId ?? selected?.Id ?? CaseId));
            if (current is not null)
                await LoadSelectionAsync(current);
            else
            {
                selected = null;
                prompts = [];
                changes = [];
                linkedAlerts = [];
                analysis = assignedTo = comment = "";
                status = RcaStatuses.Open;
            }
            cases = loadedCases;
            assignees = loadedAssignees;
            casesLoadFailed = false;
            reloadRequired = false;
            pendingReloadCaseId = null;
            error = null;
        }
        catch (Exception exception)
        {
            casesLoadFailed = true;
            ReportError(exception, "Rca.LoadCasesError");
        }
    }

    private async Task SelectAsync(RootCauseAnalysis rca)
    {
        if (busy || reloadRequired)
            return;
        CancelAlertAssignment();
        busy = true;
        error = null;
        message = null;
        try { await LoadSelectionAsync(rca); }
        catch (Exception exception) { ReportError(exception, "Rca.LoadCaseError"); }
        finally { busy = false; }
    }

    private async Task LoadSelectionAsync(RootCauseAnalysis rca)
    {
        var promptTask = RcaService.GetPromptsAsync(rca.Id);
        var changeTask = RcaService.GetChangesAsync(rca.Id);
        var alertTask = RcaService.GetLinkedAlertsAsync(rca.Id);
        await Task.WhenAll(promptTask, changeTask, alertTask);
        prompts = await promptTask;
        changes = await changeTask;
        linkedAlerts = await alertTask;
        selected = rca;
        analysis = rca.Analysis;
        assignedTo = rca.AssignedTo;
        status = rca.Status;
        comment = "";
    }

    private async Task SaveAsync()
    {
        if (!canEdit || selected is null || busy || reloadRequired || AlertPickerOpen)
            return;
        busy = true;
        error = null;
        message = null;
        try
        {
            var state = await AuthenticationStateTask;
            await RcaService.SaveAsync(state.User, selected.Id, selected.Revision,
                analysis, assignedTo, status, comment);
            comment = "";
            pendingReloadCaseId = selected.Id;
            reloadRequired = true;
            message = Text["Rca.Saved"];
            await ReloadCasesAsync();
        }
        catch (Exception exception) { ReportError(exception, "Rca.SaveError"); }
        finally { busy = false; }
    }

    private void ReportError(Exception exception, string fallbackKey)
    {
        if (exception is RcaValidationException validation && Enum.IsDefined(validation.Code))
        {
            Logger.LogWarning(exception, "RCA operation {Operation} failed validation {Code}.", fallbackKey, validation.Code);
            error = Text[validation.Code == RcaValidationCode.Changed ? "Rca.Errors.Changed" : $"Rca.Validation.{validation.Code}"];
        }
        else if (exception is UnauthorizedAccessException)
        {
            Logger.LogWarning(exception, "RCA operation {Operation} was denied.", fallbackKey);
            error = Text["Rca.Errors.NotAllowed"];
        }
        else if (exception is DbUpdateConcurrencyException or InvalidOperationException { InnerException: DbUpdateConcurrencyException })
        {
            Logger.LogWarning(exception, "RCA operation {Operation} encountered a concurrency conflict.", fallbackKey);
            error = Text["Rca.Errors.Changed"];
        }
        else
        {
            Logger.LogError(exception, "RCA operation {Operation} failed.", fallbackKey);
            error = Text[exception is RcaEvidenceException or RcaEvidenceJsonException ? "Rca.Errors.EvidenceInvalid" : fallbackKey];
        }
    }

    private static string Utc(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");
}
