@page "/admin/rules/queries"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "OperatorAccess")]
@using System.Globalization
@using System.Text.Json
@inject ScheduledQueryService Service
@inject CrossTenantLogAnalyticsOptions Options
@inject UiText Text
@inject QueryTextPresentation QueryText
@inject ILogger<AdminScheduledQueries> Logger

<PageTitle>@Text["AdminScheduledQueries.Title"]</PageTitle>

<section class="admin-heading kql-admin-heading">
    <div>
        <p class="eyebrow">@Text["AdminScheduledQueries.Eyebrow"]</p>
        <h1>@Text["AdminScheduledQueries.Title"]</h1>
        <p class="subtitle">@Text["AdminScheduledQueries.Description"]</p>
    </div>
</section>
<p>@Text["AdminScheduledQueries.ExecutionHelp"]</p>

@if (error is not null)
{
    <div class="admin-message admin-message-error" role="alert">@error</div>
}
@if (message is not null)
{
    <div class="admin-message admin-message-success" role="status">@message</div>
}
@if (loadError is not null)
{
    <div class="admin-message admin-message-error" role="alert">@loadError</div>
}
@if (delivery.Pending > 0)
{
    <div class="admin-message admin-message-warning" role="status">
        <p>@Text.Plural("AdminScheduledQueries.PendingNotifications", delivery.Pending)</p>
        @if (delivery.Error is not null)
        {
            <p role="alert">@Text.Format("AdminScheduledQueries.DeliveryFailure", delivery.Error)</p>
        }
    </div>
}
<div class="admin-card-actions kql-query-actions">
    <button class="admin-primary" type="button" disabled="@ActionsUnavailable" @onclick="() => BeginNew(null)">@Text["AdminScheduledQueries.Create"]</button>
    <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="() => BeginNew(false)">@Text["AdminScheduledQueries.CpuExample"]</button>
    <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="() => BeginNew(true)">@Text["AdminScheduledQueries.KerberosExample"]</button>
    <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick='() => BeginTemplate("replication-unknown-targets.json")'>@QueryText.TemplateName("kql/scheduled/replication-unknown-targets")</button>
    @foreach (var example in eventExamples)
    {
        <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="() => BeginEventExample(example.EventId)">@QueryText.TemplateName($"kql/scheduled/event-{example.EventId}")</button>
    }
    <button class="admin-secondary" type="button" disabled="@busy" @onclick="RefreshAsync">@Text["AdminScheduledQueries.Refresh"]</button>
</div>
<QueryJsonImport Busy="@ActionsUnavailable" OnImport="ImportJsonAsync"
                 Description="@Text["QueryImport.ScheduledDescription"]" />
<div class="admin-workspace admin-scheduled-workspace">
    <section class="admin-rule-list">
        <h2>@Text.Format("AdminScheduledQueries.RuleCount", rules.Count)</h2>
        @foreach (var rule in rules)
        {
            <article class="admin-rule-card" @key="rule.Id">
                <details class="scheduled-rule-details">
                <summary><h3>@QueryText.Name(rule)</h3></summary>
                <p>@Text.Format("AdminScheduledQueries.CardSummary", Text[rule.Enabled ? "Common.Enabled" : "Common.Disabled"], Text[ScopeLabel(rule.Scope)], string.Join(", ", rule.WorkspaceKeys), rule.IntervalMinutes.ToString(CultureInfo.CurrentCulture))</p>
                <p>@Text.Format("AdminScheduledQueries.CardCondition", rule.CategoryName, rule.Severity, rule.Comparison, rule.Threshold.ToString(CultureInfo.CurrentCulture))</p>
                <p>@rule.LastStatus</p>
                <p>@Text.Format("AdminScheduledQueries.LastCheck", Time(rule.LastRunUtc), Time(rule.LastWindowEndUtc))</p>
                <p>@Text.Format("AdminScheduledQueries.NextCheck", rule.Enabled ? Time(rule.NextRunUtc) : Text["AdminScheduledQueries.Paused"])</p>
                @if (rule.LastError.Length > 0)
                {
                    <div class="admin-message admin-message-error" role="alert">@rule.LastError</div>
                }
                @foreach (var result in rule.WorkspaceResults)
                {
                    <p>@Text.Format("AdminScheduledQueries.WorkspaceResult", result.WorkspaceKey, result.Targets, result.Values)</p>
                    @if (result.Error is not null)
                    {
                        <div class="admin-message admin-message-error" role="alert">@result.WorkspaceKey: @result.Error</div>
                    }
                }
                <div class="admin-card-actions">
                    <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="() => EditAsync(rule)">@Text["AdminScheduledQueries.EditTargetStatus"]</button>
                    <button class="admin-secondary" type="button" disabled="@(ActionsUnavailable || !rule.Enabled)" @onclick="() => DisableAsync(rule)">@Text["AdminAnalysisQueries.Disable"]</button>
                    <button class="admin-danger" type="button" disabled="@(ActionsUnavailable || rule.Enabled)" @onclick="() => deleteRule = rule">@Text["Common.Delete"]</button>
                </div>
                </details>
            </article>
        }
        @if (rules.Count == 0 && loadError is null)
        {
            <p class="admin-empty">@Text["AdminScheduledQueries.Empty"]</p>
        }
    </section>
    <section class="admin-editor">
        @if (editing is not null)
        {
            var rule = editing;
            <h2>@(rule.Revision == 0 ? Text["AdminScheduledQueries.NewRule"] : QueryText.Name(rule))</h2>
            <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label class="admin-field admin-field-wide"><span>@Text["AdminAnalysisQueries.Name"]</span><input required maxlength="256" @bind="rule.Name" @bind:event="oninput" @bind:after="TemplateNameChanged" /></label>
                <label class="admin-check"><input type="checkbox" @bind="rule.Enabled" /><span>@Text["Common.Enabled"]</span></label>
                <label class="admin-field">
                    <span>@Text["Rules.Scope"]</span><select @bind="rule.Scope" @bind:after="ScopeChanged">
                        <option value="@AnalysisQueryScopes.SelectedSystems">@Text["AdminScheduledQueries.SelectedSystems"]</option>
                        <option value="@AnalysisQueryScopes.Workspace">@Text["AdminScheduledQueries.WorkspaceWide"]</option>
                        <option value="@ScheduledQueryScopes.UnknownInventoryTargets">@Text["AdminScheduledQueries.UnknownInventoryTargets"]</option>
                    </select>
                    <small>@Text["AdminScheduledQueries.ScopeHelp"]</small>
                </label>
                <fieldset class="admin-field admin-field-wide">
                    <legend>@Text["AdminScheduledQueries.Workspaces"]</legend>
                    @foreach (var workspace in Options.Workspaces.OrderBy(item => item.DisplayName))
                    {
                        <label class="admin-check"><input type="checkbox" disabled="@busy"
                            checked="@rule.WorkspaceKeys.Contains(workspace.Key, StringComparer.OrdinalIgnoreCase)"
                            @onchange="args => SetWorkspace(workspace.Key, args.Value is true)" />
                            <span>@workspace.DisplayName (@workspace.Key)</span></label>
                    }
                    @foreach (var key in rule.WorkspaceKeys.Where(key => !Options.Workspaces.Any(workspace => workspace.Key.Equals(key, StringComparison.OrdinalIgnoreCase))))
                    {
                        <label class="admin-check"><input type="checkbox" disabled="@busy" checked
                            @onchange="args => SetWorkspace(key, args.Value is true)" /><span>@Text.Format("AdminScheduledQueries.MissingWorkspace", key)</span></label>
                    }
                    <small>@Text["AdminScheduledQueries.WorkspaceHelp"]</small>
                </fieldset>
                @if (rule.Scope == AnalysisQueryScopes.SelectedSystems)
                {
                <label class="admin-field"><span>@Text["Filters.Domain"]</span><input maxlength="256" @bind="rule.Domain" /></label>
                <label class="admin-field"><span>@Text["Filters.Site"]</span><input maxlength="256" @bind="rule.Site" /></label>
                <label class="admin-field"><span>@Text["Filters.Role"]</span><input maxlength="256" @bind="rule.Role" /></label>
                <label class="admin-field admin-field-wide">
                    <span>@Text["AdminScheduledQueries.Computers"]</span><textarea rows="3" maxlength="4000" @bind="rule.Computers"></textarea>
                    <small>@Text.Format("AdminScheduledQueries.ComputersHelp", ScheduledQueryService.MaxTargets)</small>
                </label>
                }
                <label class="admin-field"><span>@Text["AdminScheduledQueries.Interval"]</span><input required type="number" min="1" max="1440" @bind="rule.IntervalMinutes" /></label>
                <label class="admin-field"><span>@Text["AdminScheduledQueries.Window"]</span><input required type="number" min="1" max="1440" @bind="rule.WindowMinutes" /></label>
                <label class="admin-field">
                    <span>@Text["AdminScheduledQueries.Delay"]</span><input required type="number" min="0" max="60" @bind="rule.IngestionDelayMinutes" />
                    <small>@Text["AdminScheduledQueries.DelayHelp"]</small>
                </label>
                <label class="admin-field">
                    <span>@Text["AdminScheduledQueries.Comparison"]</span><select @bind="rule.Comparison">
                        @foreach (var comparison in ScheduledQueryRule.Comparisons)
                        {
                            <option value="@comparison">@comparison</option>
                        }
                    </select>
                </label>
                <label class="admin-field"><span>@Text["AdminScheduledQueries.Threshold"]</span><input required type="number" step="any" @bind="rule.Threshold" /></label>
                <label class="admin-field"><span>@Text["AdminScheduledQueries.Severity"]</span><select @bind="rule.Severity">
                    @for (var index = 0; index <= 4; index++)
                    {
                        <option value="@($"Sev{index}")">@($"Sev{index}")</option>
                    }
                </select></label>
                <label class="admin-field"><span>@Text["Rules.Category"]</span><input required maxlength="256" @bind="rule.CategoryName" /></label>
                <label class="admin-field admin-field-wide">
                    <span>KQL</span>
                    <KqlEditor @bind-Value="rule.Kql" Required="true" Rows="15" MaxLength="65536" WorkspaceKeys="@rule.WorkspaceKeys" />
                    @if (rule.Scope == ScheduledQueryScopes.UnknownInventoryTargets)
                    {
                        <small>@Text["AdminScheduledQueries.UnknownTargetsKqlHelp"]</small>
                    }
                    else if (rule.Scope == AnalysisQueryScopes.Workspace)
                    {
                        <small>@Text["AdminScheduledQueries.WorkspaceKqlHelp"]</small>
                        <small>@Text["AdminScheduledQueries.EventFieldsHelp"]</small>
                        <small>@Text.Format("AdminScheduledQueries.EventDataHelp", ScheduledQueryEventDetails.MaxUsers)</small>
                    }
                    else
                    {
                        <small>@Text["AdminScheduledQueries.SystemKqlHelp"]</small>
                        <small>@Text["AdminScheduledQueries.CountersHelp"]</small>
                    }
                    @if (rule.Kql.Contains("_InventoryComputers", StringComparison.Ordinal))
                    {
                        <small>@Text["AdminScheduledQueries.InventoryBaselineHelp"]</small>
                    }
                </label>
                <p class="admin-field-wide">@Text["AdminScheduledQueries.LifecycleHelp"]</p>
                <div class="admin-card-actions admin-field-wide">
                    <button class="admin-primary" type="submit" disabled="@ActionsUnavailable">@Text["AdminScheduledQueries.Save"]</button>
                    <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="PreviewAsync">@Text["AdminScheduledQueries.Test"]</button>
                    <button class="admin-secondary" type="button" disabled="@busy" @onclick="CancelEdit">@Text["Common.Cancel"]</button>
                </div>
            </form>
            @foreach (var executionPreview in executionPreviews)
            {
                <article class="analysis-execution-preview-card">
                    <h3>@Text["AdminScheduledQueries.EffectiveKql"]</h3>
                    <p>@Text.Format("AdminScheduledQueries.WorkspaceIdentity", executionPreview.Query.WorkspaceDisplayName, executionPreview.Query.WorkspaceKey, executionPreview.WorkspaceId)</p>
                    <p>@Text.Format(executionPreview.ApiTimeRangeMinutes == 1 ? "AdminScheduledQueries.TestWindow.One" : "AdminScheduledQueries.TestWindow.Other", Time(executionPreview.WindowStartUtc), Time(executionPreview.WindowEndUtc), executionPreview.ApiTimeRangeMinutes.ToString(CultureInfo.CurrentCulture))</p>
                    <p>@Text[rule.Scope == ScheduledQueryScopes.UnknownInventoryTargets ? "AdminScheduledQueries.UnknownTargetsKqlHelp" : rule.Scope == AnalysisQueryScopes.Workspace ? "AdminScheduledQueries.WorkspaceTestHelp" : "AdminScheduledQueries.SystemTestHelp"]</p>
                    @if (rule.Scope == AnalysisQueryScopes.SelectedSystems && executionPreview.Query.Systems.Count == 0)
                    {
                        <p role="status">@Text["AdminScheduledQueries.NoSystems"]</p>
                    }
                    <details open>
                        <summary>@Text["AdminScheduledQueries.GeneratedQuery"]</summary>
                        <pre>@executionPreview.Query.EffectiveKql</pre>
                    </details>
                </article>
            }
            @if (preview is not null)
            {
                <h3>@Text.Format("AdminScheduledQueries.TestResultHeading", Time(preview.WindowEndUtc))</h3>
                <p>@Text["AdminScheduledQueries.TestResultHelp"]</p>
                @foreach (var result in preview.Workspaces)
                {
                    <h4>@Text.Format("AdminScheduledQueries.WorkspaceHeading", result.WorkspaceKey)</h4>
                    <p>@Text.Format("AdminScheduledQueries.TestCounts", result.Targets.Count, result.Values.Count)</p>
                    @if (result.Error is not null)
                    {
                        <div class="admin-message admin-message-error" role="alert">@Text["AdminScheduledQueries.Errors.PreviewWorkspaceFailed"]</div>
                    }
                    <div class="table-scroll"><table><thead><tr><th>@Text["AdminScheduledQueries.Target"]</th>
                        @if (rule.Scope != ScheduledQueryScopes.UnknownInventoryTargets) { <th>@Text["AdminScheduledQueries.Subscription"]</th> }
                        <th>@Text[rule.Scope == ScheduledQueryScopes.UnknownInventoryTargets ? "AdminScheduledQueries.TargetCount" : "AdminScheduledQueries.Value"]</th><th>@Text["AdminScheduledQueries.Evaluation"]</th></tr></thead><tbody>
                        @foreach (var target in result.Targets.Take(50))
                        {
                            var value = result.Values.GetValueOrDefault(target.Series);
                            <tr><td>@target.DisplayName</td>
                                @if (rule.Scope != ScheduledQueryScopes.UnknownInventoryTargets) { <td>@target.SubscriptionId</td> }
                                <td>@value</td><td>@Text[result.Error is not null ? "AdminScheduledQueries.TestError" : value is null ? "AdminScheduledQueries.TestNoData" : rule.Matches(value.Value) ? "AdminScheduledQueries.TestWouldAlert" : "AdminScheduledQueries.TestNormal"]</td></tr>
                        }
                    </tbody></table></div>
                    @foreach (var details in result.EventDetails?.Values ?? Enumerable.Empty<ScheduledQueryEventDetails>())
                    {
                        <h5>@Text.Format("AdminScheduledQueries.EventAccounts", details.EventId)</h5>
                        @if (details.UnparsedEvents > 0 || details.UsersTruncated)
                        {
                            <div class="admin-message admin-message-warning" role="status">@EventWarnings(details)</div>
                        }
                        @if (details.Users.Count == 0)
                        {
                            <p>@Text["AdminScheduledQueries.NoAccounts"]</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var user in details.Users)
                                {
                                    <li>@user</li>
                                }
                            </ul>
                        }
                    }
                }
            }
            @if (states.Count > 0)
            {
                <h3>@Text["AdminScheduledQueries.SavedStatus"]</h3>
                <p>@Text["AdminScheduledQueries.SavedStatusHelp"]</p>
                <div class="table-scroll"><table><thead><tr><th>@Text["Filters.Workspace"]</th><th>@Text["AdminScheduledQueries.Target"]</th><th>@Text["AdminScheduledQueries.Subscription"]</th><th>@Text["AdminScheduledQueries.Status"]</th><th>@Text[rule.Scope == ScheduledQueryScopes.UnknownInventoryTargets ? "AdminScheduledQueries.TargetCount" : "AdminScheduledQueries.Value"]</th><th>@Text["AdminScheduledQueries.ActiveAlert"]</th><th>@Text["AdminScheduledQueries.Checked"]</th></tr></thead><tbody>
                    @foreach (var state in states.Skip(statePage * 50).Take(50))
                    {
                        <tr><td>@state.WorkspaceKey</td><td>@(state.SubscriptionId.Length == 0 ? Text.Format("AdminScheduledQueries.SavedWorkspaceTarget", state.WorkspaceKey) : state.Computer)</td><td>@(rule.Scope == ScheduledQueryScopes.UnknownInventoryTargets ? "" : state.SubscriptionId)</td><td>@state.Status</td><td>@state.Value</td><td>@Text[state.ActiveAlertId is null ? "IngestionAdmin.No" : "IngestionAdmin.Yes"]</td><td>@Time(state.CheckedUtc)</td></tr>
                    }
                </tbody></table></div>
                <button class="admin-secondary" type="button" disabled="@(statePage == 0)" @onclick="() => statePage--">@Text["Common.Previous"]</button>
                <span>@Text.Format("AdminScheduledQueries.StatePage", (statePage + 1).ToString(CultureInfo.CurrentCulture), ((states.Count + 49) / 50).ToString(CultureInfo.CurrentCulture))</span>
                <button class="admin-secondary" type="button" disabled="@((statePage + 1) * 50 >= states.Count)" @onclick="() => statePage++">@Text["Common.Next"]</button>
            }
        }
        else if (loadError is null)
        {
            <p class="admin-empty">@Text["AdminScheduledQueries.EditorEmpty"]</p>
        }
    </section>
</div>
@if (deleteRule is not null)
{
    <section class="admin-message admin-message-error" role="alert">
        <p>@Text.Format("AdminScheduledQueries.DeleteBody", QueryText.Name(deleteRule))</p>
        <button class="admin-danger" type="button" disabled="@ActionsUnavailable" @onclick="DeleteAsync">@Text["Common.ConfirmDelete"]</button>
        <button class="admin-secondary" type="button" disabled="@busy" @onclick="() => deleteRule = null">@Text["Common.Cancel"]</button>
    </section>
}

@code {
    private IReadOnlyList<ScheduledQueryRule> rules = [];
    private IReadOnlyList<ScheduledQueryTargetState> states = [];
    private IReadOnlyList<(int EventId, string Name)> eventExamples = [];
    private ScheduledQueryRule? editing, deleteRule;
    private ScheduledQueryEvaluation? preview;
    private readonly List<ScheduledQueryExecutionPreview> executionPreviews = [];
    private bool busy;
    private int statePage;
    private string? error, message, loadError;
    private (int Pending, string? Error) delivery;
    private bool ActionsUnavailable => busy || loadError is not null;
    private ScheduledQueryTemplateDraft? templateDraft;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task ExecuteAsync(Func<Task> action, string fallbackKey)
    {
        if (ActionsUnavailable) return;
        busy = true;
        error = message = null;
        try { await action(); }
        catch (Exception exception)
        {
            if (exception is QueryTemplateValidationException or ScheduledQueryValidationException or UnauthorizedAccessException or Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
                Logger.LogWarning(exception, "Scheduled query operation {Operation} failed.", fallbackKey);
            else
                Logger.LogError(exception, "Scheduled query operation {Operation} failed.", fallbackKey);
            error = OperationError(exception, fallbackKey);
        }
        finally { busy = false; }
    }

    private async Task RefreshAsync()
    {
        if (busy) return;
        busy = true;
        error = null;
        try { await ReloadAsync(); }
        finally { busy = false; }
    }

    private async Task ReloadAsync()
    {
        try
        {
            var loadedRules = await Service.ListAsync();
            foreach (var rule in loadedRules)
            {
                _ = rule.WorkspaceKeys;
                _ = rule.WorkspaceResults;
            }
            var loadedDelivery = await Service.DeliveryStatusAsync();
            var loadedExamples = ScheduledQueryRule.EventIds
                .Select(eventId => (eventId, ScheduledQueryRule.EventExample(eventId).Name)).ToArray();
            var loadedStates = editing is null ? Array.Empty<ScheduledQueryTargetState>()
                : await Service.StatesAsync(editing.Id);
            rules = loadedRules;
            delivery = loadedDelivery;
            eventExamples = loadedExamples;
            states = loadedStates;
            statePage = 0;
            loadError = null;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not reload scheduled query configuration.");
            loadError = OperationError(exception, "AdminScheduledQueries.Errors.LoadFailed");
        }
    }

    private string OperationError(Exception exception, string fallbackKey) => exception switch
    {
        ScheduledQueryDataException data when Enum.IsDefined(data.Code) => Text[$"ScheduledQueries.Data.{data.Code}"],
        ScheduledQueryDataJsonException data when Enum.IsDefined(data.Code) => Text[$"ScheduledQueries.Data.{data.Code}"],
        QueryTemplateValidationException => AnalysisErrorPresentation.Message(exception, Text, fallbackKey),
        ScheduledQueryValidationException validation when Enum.IsDefined(validation.Code) =>
            Text[$"ScheduledQueries.Validation.{validation.Code}"],
        UnauthorizedAccessException => Text["AdminScheduledQueries.Errors.NotAllowed"],
        Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException => Text["AdminScheduledQueries.Errors.Changed"],
        _ => Text[fallbackKey]
    };

    private Task BeginNew(bool? kerberos) =>
        kerberos.HasValue
            ? BeginTemplate(kerberos.Value ? "kerberos-stopped.json" : "cpu-high.json")
            : BeginRule(() => new());

    private Task BeginEventExample(int eventId) => BeginTemplate($"event-{eventId}.json");

    private Task BeginTemplate(string fileName) => ExecuteAsync(() =>
    {
        var draft = ScheduledQueryTemplateDraft.Create(fileName);
        OpenRule(draft.Rule);
        templateDraft = draft;
        return Task.CompletedTask;
    }, "AdminScheduledQueries.Errors.TemplateFailed");

    private Task ImportJsonAsync(string json) => ExecuteAsync(() =>
    {
        QueryTemplateJson.ValidateImport(json);
        OpenRule(ScheduledQueryTemplates.Parse(json));
        message = Text["AdminScheduledQueries.Status.ImportOpened"];
        return Task.CompletedTask;
    }, "AdminScheduledQueries.Errors.ImportFailed");

    private Task BeginRule(Func<ScheduledQueryRule> create) => ExecuteAsync(() =>
    {
        OpenRule(create());
        return Task.CompletedTask;
    }, "AdminScheduledQueries.Errors.TemplateFailed");

    private void OpenRule(ScheduledQueryRule rule)
    {
        templateDraft?.Complete();
        templateDraft = null;
        rule.WorkspaceKeys = Options.Workspaces.OrderBy(item => item.DisplayName).Take(1).Select(item => item.Key).ToArray();
        editing = rule;
        preview = null;
        executionPreviews.Clear();
        states = [];
        statePage = 0;
    }

    private void ScopeChanged()
    {
        if (editing is not null && editing.Scope != AnalysisQueryScopes.SelectedSystems)
            editing.Domain = editing.Site = editing.Role = editing.Computers = "";
        preview = null;
        executionPreviews.Clear();
    }

    private Task EditAsync(ScheduledQueryRule rule) => ExecuteAsync(async () =>
    {
        var loadedRule = JsonSerializer.Deserialize<ScheduledQueryRule>(JsonSerializer.Serialize(rule))
            ?? throw new InvalidOperationException("The scheduled query editor copy was null.");
        loadedRule.StandardTextProvenanceJson = rule.StandardTextProvenanceJson;
        _ = loadedRule.WorkspaceKeys;
        _ = loadedRule.WorkspaceResults;
        var loadedStates = await Service.StatesAsync(rule.Id);
        templateDraft?.Complete();
        templateDraft = null;
        editing = loadedRule;
        states = loadedStates;
        statePage = 0;
        preview = null;
        executionPreviews.Clear();
    }, "AdminScheduledQueries.Errors.EditFailed");

    private Task SaveAsync() => ExecuteAsync(async () =>
    {
        if (editing is null)
        {
            Logger.LogWarning("No scheduled query draft is selected for saving.");
            error = Text["AdminScheduledQueries.Errors.DraftRequired"];
            return;
        }
        if (templateDraft is not null)
        {
            if (!ReferenceEquals(editing, templateDraft.Rule))
                throw new InvalidOperationException("The scheduled template context does not match the selected editor.");
            await Service.SaveTemplateDraftAsync(templateDraft);
        }
        else
            await Service.SaveAsync(editing);
        CancelEdit();
        preview = null;
        executionPreviews.Clear();
        message = Text["AdminScheduledQueries.Status.Saved"];
        await ReloadAsync();
    }, "AdminScheduledQueries.Errors.SaveFailed");

    private void TemplateNameChanged() => templateDraft?.ObserveName();

    private static string ScopeLabel(string scope) => scope switch
    {
        AnalysisQueryScopes.Workspace => "AdminScheduledQueries.WorkspaceWide",
        ScheduledQueryScopes.UnknownInventoryTargets => "AdminScheduledQueries.UnknownInventoryTargets",
        _ => "AdminScheduledQueries.SelectedSystems"
    };

    private void CancelEdit()
    {
        templateDraft?.Complete();
        templateDraft = null;
        editing = null;
    }

    private Task PreviewAsync() => ExecuteAsync(async () =>
    {
        preview = null;
        executionPreviews.Clear();
        if (editing is null)
        {
            Logger.LogWarning("No scheduled query draft is selected for preview.");
            error = Text["AdminScheduledQueries.Errors.DraftRequired"];
            return;
        }
        preview = await Service.PreviewAsync(editing, onPrepared: prepared =>
            {
                executionPreviews.Add(prepared);
                StateHasChanged();
            });
    }, "AdminScheduledQueries.Errors.PreviewFailed");

    private void SetWorkspace(string key, bool selected)
    {
        if (editing is null) return;
        editing.WorkspaceKeys = selected
            ? editing.WorkspaceKeys.Append(key).Distinct(StringComparer.OrdinalIgnoreCase).ToArray()
            : editing.WorkspaceKeys.Where(value => !value.Equals(key, StringComparison.OrdinalIgnoreCase)).ToArray();
        preview = null;
        executionPreviews.Clear();
    }

    private Task DeleteAsync() => ExecuteAsync(async () =>
    {
        if (deleteRule is null)
        {
            Logger.LogWarning("No scheduled query is selected for deletion.");
            error = Text["AdminScheduledQueries.Errors.DeleteRequired"];
            return;
        }
        await Service.DeleteAsync(deleteRule.Id, deleteRule.Revision);
        if (editing?.Id == deleteRule.Id) CancelEdit();
        deleteRule = null;
        message = Text["AdminScheduledQueries.Status.Deleted"];
        await ReloadAsync();
    }, "AdminScheduledQueries.Errors.DeleteFailed");

    private string Time(DateTime? time) => time?.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) ?? Text["AdminScheduledQueries.Never"];

    private string EventWarnings(ScheduledQueryEventDetails details)
    {
        if (details.UnparsedEvents > 0)
        {
            var key = details.UsersTruncated ? "AdminScheduledQueries.EventWarnings.Both" : "AdminScheduledQueries.EventWarnings.Unparsed";
            return Text.Format(key + (details.UnparsedEvents == 1 ? ".One" : ".Other"),
                details.UnparsedEvents, ScheduledQueryEventDetails.MaxUsers);
        }
        return details.UsersTruncated
            ? Text.Format("AdminScheduledQueries.EventWarnings.Truncated", ScheduledQueryEventDetails.MaxUsers)
            : string.Empty;
    }

    private Task DisableAsync(ScheduledQueryRule rule) => ExecuteAsync(async () =>
    {
        await Service.DisableAsync(rule.Id, rule.Revision);
        if (editing?.Id == rule.Id) CancelEdit();
        message = Text["AdminScheduledQueries.Status.Disabled"];
        await ReloadAsync();
    }, "AdminScheduledQueries.Errors.DisableFailed");
}
