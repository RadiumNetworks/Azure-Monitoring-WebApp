@page "/prompt"
@rendermode InteractiveServer
@implements IDisposable
@using System.Security.Claims
@using System.Globalization
@inject AlertStore AlertStore
@inject IncidentAnalysisSnapshotService SnapshotService
@inject AlertGraphOptions GraphOptions
@inject AgentAnalysisContextOptions AnalysisContextOptions
@inject AgentAnalysisOrchestrator Orchestrator
@inject AgentAnalysisJobService JobService
@inject ApplicationAuthenticationOptions Authentication
@inject MicrosoftSourceCatalog SourceCatalog
@inject IJSRuntime JS
@inject UiText Text
@inject ILogger<Prompt> Logger

<PageTitle>@Text["Navigation.AnalysisWorkspace"]</PageTitle>

<section class="agent-heading">
    <div>
        <p class="eyebrow">@Text["Prompt.Triage"]</p>
        <h1>@Text["Navigation.AnalysisWorkspace"]</h1>
        <p class="subtitle">@Text["Prompt.Description"]</p>
    </div>
    <div class="agent-status" aria-label="@Text["Prompt.SelectionSummary"]">
        <strong>@SelectedAlerts.Count</strong>
        <span>@Text.Format("Prompt.SelectedOf", VisibleAlerts.Count)</span>
    </div>
</section>

<div class="agent-notice" role="note">
    <strong>@Text[Orchestrator.ExecutionState.IsEnabled ? "Prompt.ControlledHandoff" : "Prompt.Unavailable"]</strong>
    <span>@ExecutionNotice</span>
</div>

<section class="agent-controls" aria-label="@Text["Prompt.Settings"]">
    <label>
        <span>@Text["Prompt.AnalysisScope"]</span>
        <select value="@analysisScopeType" @onchange="ChangeAnalysisScope">
            <option value="@nameof(IncidentAnalysisScopeType.Incident)">@Text["Prompt.Incident"]</option>
            <option value="@nameof(IncidentAnalysisScopeType.Target)">@Text["Prompt.Target"]</option>
            <option value="@nameof(IncidentAnalysisScopeType.GraphSubtree)" disabled>@Text["Prompt.Subtree"]</option>
        </select>
    </label>
    <label>
        <span>@Text["Prompt.AlertScope"]</span>
        <select value="@scope" @onchange="ChangeScope">
            <option value="active">@Text["Prompt.ActiveAlerts"]</option>
            <option value="recent">@Text["Prompt.RecentEvents"]</option>
        </select>
    </label>
    <label>
        <span>@Text["Prompt.TimeRange"]</span>
        <select value="@lookbackHours" @onchange="ChangeTimeRange">
            <option value="1">@Text["Prompt.OneHour"]</option>
            <option value="4">@Text["Prompt.FourHours"]</option>
            <option value="24">@Text["Prompt.OneDay"]</option>
            <option value="168">@Text["Prompt.SevenDays"]</option>
        </select>
    </label>
    <fieldset class="agent-detail-options" aria-label="@Text["Prompt.AutomaticContext"]">
        <legend>@Text["Prompt.AutomaticContext"]</legend>
        <label><input type="checkbox" checked="@includeSystemHistory" @onchange="ToggleSystemHistory" /> @Text["Prompt.TargetHistory"]</label>
        <label><input type="checkbox" checked="@includeRelatedContext" @onchange="ToggleRelatedContext" /> @Text["Prompt.RelatedHistory"]</label>
        <span>@Text["Prompt.AlwaysIncluded"]</span>
    </fieldset>
</section>

<section class="agent-scope-summary" aria-labelledby="agent-scope-heading">
    <div>
        <p class="eyebrow">@Text["Prompt.ScopePreview"]</p>
        <h2 id="agent-scope-heading">@Text["Prompt.PreparedData"]</h2>
    </div>
    <dl>
        <div><dt>@Text["Prompt.Mode"]</dt><dd>@Orchestrator.ExecutionState.Mode</dd></div>
        <div><dt>@Text["Prompt.Profile"]</dt><dd>@DisplayValue(Orchestrator.ExecutionState.Profile, Text["Prompt.LocalManual"])</dd></div>
        <div><dt>@Text["Prompt.PrimaryEvents"]</dt><dd>@SelectedAlerts.Count / @AgentAnalysisJobApi.MaxPrimaryEvents</dd></div>
        <div><dt>@Text["Prompt.SystemHistory"]</dt><dd>@HistoryPreview(previewSnapshot?.SystemHistory.Count, includeSystemHistory, Text["Prompt.SevenDays"])</dd></div>
        <div><dt>@Text["Prompt.RelatedContext"]</dt><dd>@HistoryPreview(previewSnapshot?.Context24Hours.Count, includeRelatedContext, Text["Prompt.TwentyFourHours"])</dd></div>
        <div><dt>@Text["Prompt.RuleDecisions"]</dt><dd>@DisplayRuleDecisionSummary()</dd></div>
        <div><dt>@Text["Prompt.Subscriptions"]</dt><dd>@DisplayValues(SelectedAlerts.Select(alert => alert.SubscriptionId))</dd></div>
        <div><dt>@Text["Prompt.Targets"]</dt><dd>@DisplayValues(SelectedAlerts.Select(alert => alert.TargetDisplayName))</dd></div>
        <div><dt>@Text["Prompt.SelectedRange"]</dt><dd>@Text.Plural("Prompt.Hours", lookbackHours)</dd></div>
    </dl>
    <p>@Text["Prompt.RetentionHelp"]</p>
</section>

@if (previewSnapshot is not null)
{
    <section class="agent-evidence" aria-labelledby="agent-evidence-heading">
        <div class="agent-section-heading">
            <div>
                <p class="eyebrow">@Text["Prompt.EvidencePreview"]</p>
                <h2 id="agent-evidence-heading">@Text["Prompt.IncludedEvidence"]</h2>
            </div>
            <span class="agent-prompt-size">@Text.Plural("Prompt.Events", previewSnapshot.AlertCount)</span>
        </div>
        <div class="agent-evidence-grid">
            @foreach (var group in EvidenceGroups())
            {
                <section>
                    <h3>@group.Label <span>@group.Items.Count</span></h3>
                    @if (group.Items.Count == 0)
                    {
                        <p class="agent-job-empty">@Text[group.Included ? "Prompt.NoEvidence" : "Prompt.ExcludedMessage"]</p>
                    }
                    else
                    {
                        @foreach (var evidence in group.Items)
                        {
                            <article>
                                <div>
                                    <strong>@evidence.Name</strong>
                                    <span>@evidence.Target · @evidence.SubscriptionId</span>
                                </div>
                                <span class="agent-decision agent-decision-@evidence.Decision.Type.ToString().ToLowerInvariant()">@evidence.Decision.Type</span>
                                <small>@Text["Prompt.Event"] <code>@evidence.EventId</code></small>
                                @if (evidence.Decision.RuleId is not null)
                                {
                                    <small>@Text["Prompt.Rule"] <code>@evidence.Decision.RuleId</code> · @evidence.Decision.RuleName · @evidence.Decision.VisibleClassification</small>
                                }
                            </article>
                        }
                    }
                </section>
            }
        </div>
    </section>
}

<div class="agent-workspace">
    <section class="agent-alerts" aria-labelledby="agent-alerts-heading">
        <div class="agent-section-heading">
            <div>
                <p class="eyebrow">@Text["Prompt.Source"]</p>
                <h2 id="agent-alerts-heading">@Text["Prompt.ObservedAlerts"]</h2>
            </div>
            <div class="agent-selection-actions">
                <button type="button" @onclick="SelectAll" disabled="@(!VisibleAlerts.Any())">@Text["Prompt.SelectAll"]</button>
                <button type="button" @onclick="ClearSelection" disabled="@(!selectedAlertIds.Any())">@Text["Common.Clear"]</button>
            </div>
        </div>

        @if (alertLoadError is not null)
        {
            <p class="agent-job-error" role="alert">@alertLoadError</p>
            <button type="button" @onclick="() => ReloadAlertsAsync(selectDefaults: false)">@Text["AdminScheduledQueries.Refresh"]</button>
        }
        @if (isLoading)
        {
            <p class="agent-empty">@Text["Prompt.LoadingAlerts"]</p>
        }
        else if (alertLoadError is null && !VisibleAlerts.Any())
        {
            <p class="agent-empty">@Text["Prompt.NoAlerts"]</p>
        }
        else
        {
            <div class="agent-alert-list">
                @foreach (var alert in VisibleAlerts)
                {
                    <label class="agent-alert-row">
                        <input type="checkbox" checked="@selectedAlertIds.Contains(alert.Id)" @onchange="args => ToggleAlert(alert.Id, args)" />
                        <span class="agent-alert-copy">
                            <strong>@alert.Name</strong>
                            <span>@alert.TargetDisplayName</span>
                        </span>
                        <span class="severity @SeverityClass(alert.Severity)">@alert.Severity</span>
                        <time datetime="@alert.ReceivedAt.ToString("O")">@alert.ReceivedAt.ToLocalTime().ToString("g")</time>
                    </label>
                }
            </div>
        }
    </section>

    <section class="agent-prompt" aria-labelledby="agent-prompt-heading">
        <div class="agent-section-heading">
            <div>
                <p class="eyebrow">@Text["AdminAnalysisQueries.Preview"]</p>
                <h2 id="agent-prompt-heading">@Text["Prompt.IncidentPrompt"]</h2>
            </div>
            <span class="agent-prompt-size">@Text.Plural("Prompt.Characters", PreviewPrompt.Length)</span>
        </div>

        <textarea class="agent-prompt-preview" readonly aria-label="@Text["Prompt.GeneratedPrompt"]" value="@PreviewPrompt"></textarea>

        <div class="agent-handoff">
            <span class="agent-copy-status" role="status">@copyStatus</span>
            <button class="agent-copy" type="button" disabled="@(!CanStartConfiguredMode || alertLoadError is not null || isSavingJob || jobReloadRequired || isSavingReview || isRefreshingJob || isCopyingClipboard || isGenerating || !SelectedAlerts.Any() || !string.IsNullOrWhiteSpace(generationError))" @onclick="CreateJobAsync">
                @(isSavingJob ? Text["Prompt.CreatingJob"] : PrimaryActionLabel)
            </button>
            <button class="agent-copy" type="button" disabled="@(isCopyingClipboard || isSavingReview || alertLoadError is not null || isGenerating || !SelectedAlerts.Any() || !string.IsNullOrWhiteSpace(generationError) || string.IsNullOrWhiteSpace(GeneratedPrompt))" @onclick="CopyPromptAsync">
                @Text[isCopyingClipboard ? "Prompt.Copying" : isGenerating ? "Prompt.BuildingSnapshot" : "Prompt.Copy"]
            </button>
            <a class="agent-open" href="https://copilot.microsoft.com/" target="_blank" rel="noopener noreferrer">@Text["Prompt.OpenCopilot"]</a>
        </div>
        @if (copyError is not null)
        {
            <p class="agent-footnote" role="alert">@copyError</p>
        }
        @if (!string.IsNullOrWhiteSpace(generationError))
        {
            <p class="agent-footnote" role="alert">@generationError</p>
        }
        else
        {
            <p class="agent-footnote">@Text["Prompt.EvidenceHelp"]</p>
        }
    </section>
</div>

<section class="agent-jobs" aria-labelledby="agent-jobs-heading">
    <div class="agent-section-heading">
        <div>
            <p class="eyebrow">@Text["Prompt.PersistedAnalysis"]</p>
            <h2 id="agent-jobs-heading">@Text["Prompt.RecentJobs"]</h2>
        </div>
        @if (activeJob is not null)
        {
            <button class="agent-copy" type="button" disabled="@(isRefreshingJob || isSavingReview)" @onclick="RefreshActiveJobAsync">
                @Text[isRefreshingJob ? "Common.Refreshing" : "AdminScheduledQueries.Refresh"]
            </button>
        }
    </div>

    @if (!CanCreateJob)
    {
        <p class="agent-footnote">@Text["Prompt.AccessHelp"]</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(jobError))
        {
            <p class="agent-job-error" role="alert">@jobError</p>
        }
        @if (jobReloadRequired)
        {
            <button type="button" disabled="@(isSavingJob || isSavingReview || isRefreshingJob)" @onclick="RefreshJobHistoryAsync">
                @Text["Prompt.Job.RefreshHistory"]
            </button>
        }
        @if (recentJobs.Count == 0 && string.IsNullOrWhiteSpace(jobError))
        {
            <p class="agent-job-empty">@Text["Prompt.NoJobs"]</p>
        }
        else
        {
            <div class="agent-job-layout">
                <div class="agent-job-list" aria-label="@Text["Prompt.RecentJobsLabel"]">
                    @foreach (var job in recentJobs)
                    {
                        <button type="button" disabled="@(isSavingReview || isSavingJob || isRefreshingJob)" class="@(activeJob?.Id == job.Id ? "selected" : null)" @onclick="() => SelectJobAsync(job.Id)">
                            <span><strong>@job.ScopeValue</strong><small>@job.ScopeType · @job.Mode</small></span>
                            <span class="agent-job-state">@job.Status</span>
                            <time datetime="@job.CreatedAt.ToString("O")">@job.CreatedAt.ToLocalTime().ToString("g")</time>
                        </button>
                    }
                </div>

                <div class="agent-job-detail">
                    @if (activeJob is null)
                    {
                        <p class="agent-job-empty">@Text["Prompt.SelectJob"]</p>
                    }
                    else
                    {
                        <dl class="agent-job-metadata">
                            <div><dt>@Text["AdminScheduledQueries.Status"]</dt><dd>@activeJob.Status</dd></div>
                            <div><dt>@Text["Prompt.AnalysisId"]</dt><dd><code>@activeJob.AnalysisId</code></dd></div>
                            <div><dt>@Text["Prompt.Version"]</dt><dd>@activeJob.ResultVersion</dd></div>
                            <div><dt>@Text["Prompt.ModeProfile"]</dt><dd>@activeJob.Mode / @DisplayValue(activeJob.ExecutionProfile, Text["Prompt.NoProfile"])</dd></div>
                            <div><dt>@Text["Prompt.EvidenceWindow"]</dt><dd>@activeJob.DataFrom.ToLocalTime().ToString("g") – @activeJob.DataTo.ToLocalTime().ToString("g")</dd></div>
                            <div><dt>@Text["Prompt.Retention"]</dt><dd>@Text.Format("Prompt.Until", activeJob.ExpiresAt.ToLocalTime().ToString("g"))</dd></div>
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(activeJob.StatusReason))
                        {
                            <p class="agent-job-reason">@activeJob.StatusReason</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(activeJob.ErrorMessage))
                        {
                            <p class="agent-job-error" role="alert"><strong>@DisplayValue(activeJob.ErrorCode, Text["Prompt.AnalysisFailed"]):</strong> @activeJob.ErrorMessage</p>
                        }
                        @if (activeJob.Status == AgentAnalysisJobStatuses.Completed)
                        {
                            <a class="agent-download" href="@AttachmentPath(activeJob.Id)">@Text["Prompt.Download"]</a>
                        }
                    }
                </div>
            </div>
        }
    }
</section>

@if (activeResult is not null)
{
    <section class="agent-result" aria-labelledby="agent-result-heading">
        <div class="agent-section-heading">
            <div>
                <p class="eyebrow">@Text["Prompt.ValidatedResult"]</p>
                <h2 id="agent-result-heading">@Text["Prompt.FullAnalysis"]</h2>
            </div>
            <span class="agent-prompt-size">@activeResult.ContractVersion · v@activeResult.ResultVersion</span>
        </div>

        <div class="agent-result-section">
            <h3>@Text["Prompt.TeamsSummary"]</h3>
            <ul>
                @foreach (var bullet in activeResult.TeamsSummary)
                {
                    <li>@bullet.Text</li>
                }
            </ul>
        </div>

        <div class="agent-result-grid">
            <section class="agent-result-section">
                <h3>@Text["Prompt.ObservedFacts"]</h3>
                @foreach (var statement in StatementsByKind("ObservedFact"))
                {
                    <article>
                        <span class="agent-result-kind">@statement.Kind</span>
                        <p>@statement.Text</p>
                        <small>@Text.Format("Prompt.EvidenceRules", DisplayIds(statement.EvidenceIds), DisplayIds(statement.RuleIds))</small>
                        @foreach (var source in ResolveSources(statement.SourceIds))
                        {
                            <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Title</a>
                        }
                    </article>
                }
            </section>

            <section class="agent-result-section">
                <h3>@Text["Prompt.RuleAssessments"]</h3>
                @foreach (var statement in StatementsByKind("RuleAssessment"))
                {
                    <article>
                        <span class="agent-result-kind">@statement.Kind</span>
                        <p>@statement.Text</p>
                        <small>@Text.Format("Prompt.EvidenceRules", DisplayIds(statement.EvidenceIds), DisplayIds(statement.RuleIds))</small>
                        @foreach (var source in ResolveSources(statement.SourceIds))
                        {
                            <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Title</a>
                        }
                    </article>
                }
            </section>

            <section class="agent-result-section">
                <h3>@Text["Prompt.Correlations"]</h3>
                @foreach (var statement in StatementsByKind("GraphCorrelation", "HistoricalPattern", "Contradiction"))
                {
                    <article>
                        <span class="agent-result-kind">@statement.Kind</span>
                        <p>@statement.Text</p>
                        <small>@Text.Format("Prompt.EvidenceRules", DisplayIds(statement.EvidenceIds), DisplayIds(statement.RuleIds))</small>
                        @foreach (var source in ResolveSources(statement.SourceIds))
                        {
                            <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Title</a>
                        }
                    </article>
                }
            </section>

            <section class="agent-result-section">
                <h3>@Text["Prompt.OpenEvidence"]</h3>
                @foreach (var statement in StatementsByKind("MissingEvidence"))
                {
                    <article>
                        <span class="agent-result-kind">@statement.Kind</span>
                        <p>@statement.Text</p>
                        <small>@Text.Format("Prompt.EvidenceRules", DisplayIds(statement.EvidenceIds), DisplayIds(statement.RuleIds))</small>
                    </article>
                }
            </section>

            <section class="agent-result-section">
                <h3>@Text["Prompt.Hypotheses"]</h3>
                @foreach (var hypothesis in activeResult.DetailedAnalysis.Hypotheses)
                {
                    <article>
                        <strong class="agent-confidence">@Text.Format("Prompt.Confidence", Convert.ToString(hypothesis.Confidence, CultureInfo.CurrentCulture))</strong>
                        <p>@hypothesis.Statement</p>
                        <small>@Text.Format("Prompt.SupportingEvidence", DisplayIds(hypothesis.SupportingEvidenceIds), DisplayIds(hypothesis.ContradictingEvidenceIds))</small>
                        <small>@Text.Format("Prompt.ConfirmWith", hypothesis.ConfirmationOrRejectionEvidence)</small>
                    </article>
                }
            </section>

            <section class="agent-result-section">
                <h3>@Text["Prompt.Checks"]</h3>
                @foreach (var check in activeResult.DetailedAnalysis.RecommendedChecks)
                {
                    <article>
                        <strong>@check.Action</strong>
                        <p>@Text.Format("Prompt.Expected", check.Target, check.ExpectedSignal)</p>
                        <small>@Text.Format("Prompt.Impact", check.Impact, check.Prerequisites, check.Rollback)</small>
                        @foreach (var source in ResolveSources(check.SourceIds))
                        {
                            <a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Title</a>
                        }
                    </article>
                }
            </section>

            <section class="agent-result-section">
                <h3>@Text["Prompt.Handoff"]</h3>
                <p><strong>@Text["Prompt.Decision"]</strong> @activeResult.DetailedAnalysis.OperatorHandoff.CurrentDecision</p>
                <p><strong>@Text["Prompt.Risk"]</strong> @activeResult.DetailedAnalysis.OperatorHandoff.UnresolvedRisk</p>
                <p><strong>@Text["Prompt.MissingEvidence"]</strong> @activeResult.DetailedAnalysis.OperatorHandoff.MissingEvidence</p>
                <p><strong>@Text["Prompt.Audience"]</strong> @activeResult.DetailedAnalysis.OperatorHandoff.Audience</p>
            </section>
        </div>

        <section class="agent-review" aria-labelledby="agent-review-heading">
            <div>
                <h3 id="agent-review-heading">@Text["Prompt.Review"]</h3>
                <p>@Text.Format("Prompt.ReviewHelp", activeResult.AnalysisId, activeResult.ResultVersion.ToString(CultureInfo.CurrentCulture))</p>
            </div>
            <label>
                <span>@Text["Prompt.ReviewComment"]</span>
                <textarea rows="3" maxlength="4000" @bind="reviewComment" disabled="@isSavingReview" placeholder="@Text["Prompt.ReviewPlaceholder"]"></textarea>
            </label>
            <div class="agent-review-actions">
                <button type="button" disabled="@ReviewActionsUnavailable" @onclick="() => SubmitReviewAsync(AgentAnalysisReviewActions.Accepted)">@Text["Prompt.Accept"]</button>
                <button type="button" disabled="@(ReviewActionsUnavailable || string.IsNullOrWhiteSpace(reviewComment))" @onclick="() => SubmitReviewAsync(AgentAnalysisReviewActions.Commented)">@Text["Prompt.AddComment"]</button>
                <button class="danger" type="button" disabled="@(ReviewActionsUnavailable || string.IsNullOrWhiteSpace(reviewComment))" @onclick="() => SubmitReviewAsync(AgentAnalysisReviewActions.Rejected)">@Text["Prompt.Reject"]</button>
                <button type="button" disabled="@ReviewActionsUnavailable" @onclick="CopyHandoffAsync">@Text["Prompt.CopyHandoff"]</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(reviewStatus))
            {
                <p class="agent-copy-status" role="status">@reviewStatus</p>
            }
            @if (reviewError is not null)
            {
                <p class="admin-message admin-message-error" role="alert">@reviewError</p>
            }
            @if (reviewEvents.Count > 0)
            {
                <ol class="agent-review-log" reversed>
                    @foreach (var entry in reviewEvents)
                    {
                        <li>
                            <strong>@entry.Action</strong>
                            <span>@entry.Actor · @entry.CreatedAt.ToLocalTime().ToString("g") · v@entry.ResultVersion</span>
                            @if (!string.IsNullOrWhiteSpace(entry.Comment))
                            {
                                <p>@entry.Comment</p>
                            }
                        </li>
                    }
                </ol>
            }
        </section>
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private IReadOnlyList<AlertRecord> alerts = [];
    private readonly HashSet<Guid> selectedAlertIds = [];
    private IReadOnlyList<AgentAnalysisJobResponse> recentJobs = [];
    private ClaimsPrincipal currentUser = new(new ClaimsIdentity());
    private AgentAnalysisJobResponse? activeJob;
    private AgentAnalysisResult? activeResult;
    private IReadOnlyList<AgentAnalysisReviewEvent> reviewEvents = [];
    private IncidentAnalysisSnapshot? previewSnapshot;
    private string analysisScopeType = nameof(IncidentAnalysisScopeType.Incident);
    private string scope = "active";
    private int lookbackHours = 24;
    private bool includeSystemHistory = true;
    private bool includeRelatedContext = true;
    private bool isLoading = true;
    private bool isGenerating;
    private bool isSavingJob;
    private bool isRefreshingJob;
    private bool isSavingReview;
    private bool reviewReloadRequired;
    private string? reviewError;
    private bool ReviewActionsUnavailable => disposed || isCopyingClipboard || isSavingReview || reviewReloadRequired || jobReloadRequired || isSavingJob || isRefreshingJob;
    private bool jobReloadRequired;
    private string? alertLoadError;
    private int alertReloadVersion;
    private bool disposed;
    private string copyStatus = string.Empty;
    private string? copyError;
    private bool isCopyingClipboard;
    private int promptVersion;
    private readonly CancellationTokenSource clipboardCancellation = new();
    private string generatedPrompt = "Select at least one alert to prepare an incident analysis prompt.";
    private string? generationError;
    private string? jobError;
    private string reviewComment = string.Empty;
    private string? reviewStatus;
    private DateTimeOffset promptGeneratedAt = DateTimeOffset.UtcNow;
    private CancellationTokenSource? promptCancellation;

    private IReadOnlyList<AlertRecord> VisibleAlerts => (scope == "active"
            ? AlertLifecycle.GetActiveAlerts(alerts)
            : alerts)
        .Where(alert => alert.ReceivedAt >= DateTimeOffset.UtcNow.AddHours(-lookbackHours))
        .OrderByDescending(alert => alert.ReceivedAt)
        .ToArray();

    private IReadOnlyList<AlertRecord> SelectedAlerts => VisibleAlerts
        .Where(alert => selectedAlertIds.Contains(alert.Id))
        .ToArray();

    private bool CanCreateJob => Authentication.IsOpen ||
        currentUser.IsInRole(SqlAuthenticationRoles.Operator) ||
        currentUser.IsInRole(SqlAuthenticationRoles.Admin);
    private bool CanStartConfiguredMode => CanCreateJob && Orchestrator.ExecutionState.IsEnabled;

    private string GeneratedPrompt => generatedPrompt;
    private string PreviewPrompt => SelectedAlerts.Count == 0 && generationError is null ? Text["Prompt.SelectAlert"] : GeneratedPrompt;
    private string PrimaryActionLabel => Orchestrator.ExecutionState.Mode switch
    {
        AgentAnalysisExecutionModes.TeamsWorkflow => Text["Prompt.SendTeams"],
        AgentAnalysisExecutionModes.Api => Text["Prompt.StartApi"],
        _ => Text["Prompt.CreateJob"]
    };
    private string ExecutionNotice => Orchestrator.ExecutionState.IsEnabled
        ? Text.Format("Prompt.ExecutionNotice", Orchestrator.ExecutionState.Mode)
        : Text.Format("Prompt.DisabledNotice", Orchestrator.ExecutionState.Mode,
            AgentAnalysisErrorPresentation.DisabledReason(Orchestrator.ExecutionState, Text));

    protected override async Task OnInitializedAsync()
    {
        currentUser = (await AuthenticationStateTask).User;
        await ReloadAlertsAsync(selectDefaults: true);
        if (CanCreateJob)
        {
            try
            {
                await ReloadRecentJobsAsync();
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Could not load the initial analysis job history.");
                jobError = exception is AgentAnalysisJobValidationException ? JobStartError(exception) : ResultError(exception);
            }
        }
        AlertStore.Changed += HandleStoreChanged;
    }

    private void HandleStoreChanged()
    {
        if (!disposed) _ = InvokeAsync(() => ReloadAlertsAsync(selectDefaults: false));
    }

    private async Task ReloadAlertsAsync(bool selectDefaults)
    {
        if (disposed) return;
        var version = ++alertReloadVersion;
        try
        {
            var loaded = await AlertStore.GetAllRequiredAsync();
            if (disposed || version != alertReloadVersion) return;
            alerts = loaded;
            alertLoadError = null;
            SyncSelection(selectDefaults);
            await GeneratePromptAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not reload alerts for the analysis workspace.");
            if (!disposed && version == alertReloadVersion)
            {
                alertLoadError = Text["Prompt.AlertLoadFailed"];
                promptCancellation?.Cancel();
                isGenerating = false;
            }
        }
        finally
        {
            if (!disposed && version == alertReloadVersion)
            {
                isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ChangeScope(ChangeEventArgs args)
    {
        scope = args.Value?.ToString() == "recent" ? "recent" : "active";
        SyncSelection(selectDefaults: true);
        await GeneratePromptAsync();
    }

    private async Task ChangeAnalysisScope(ChangeEventArgs args)
    {
        analysisScopeType = args.Value?.ToString() == nameof(IncidentAnalysisScopeType.Target)
            ? nameof(IncidentAnalysisScopeType.Target)
            : nameof(IncidentAnalysisScopeType.Incident);
        if (analysisScopeType == nameof(IncidentAnalysisScopeType.Target) && SelectedAlerts.Count > 0)
        {
            SelectTarget(SelectedAlerts[0]);
        }

        await GeneratePromptAsync();
    }

    private async Task ChangeTimeRange(ChangeEventArgs args)
    {
        lookbackHours = ParseOption(args, 24, 1, 4, 24, 168);
        SyncSelection(selectDefaults: true);
        await GeneratePromptAsync();
    }

    private async Task ToggleAlert(Guid alertId, ChangeEventArgs args)
    {
        if (analysisScopeType == nameof(IncidentAnalysisScopeType.Target) && args.Value is true)
        {
            var selectedAlert = VisibleAlerts.First(alert => alert.Id == alertId);
            SelectTarget(selectedAlert);
            await GeneratePromptAsync();
            return;
        }

        if (args.Value is true)
        {
            selectedAlertIds.Add(alertId);
        }
        else
        {
            selectedAlertIds.Remove(alertId);
        }

        await GeneratePromptAsync();
    }

    private async Task ToggleSystemHistory(ChangeEventArgs args)
    {
        includeSystemHistory = args.Value is true;
        await GeneratePromptAsync();
    }

    private async Task ToggleRelatedContext(ChangeEventArgs args)
    {
        includeRelatedContext = args.Value is true;
        await GeneratePromptAsync();
    }

    private async Task SelectAll()
    {
        selectedAlertIds.Clear();
        if (analysisScopeType == nameof(IncidentAnalysisScopeType.Target) && VisibleAlerts.FirstOrDefault() is { } target)
        {
            SelectTarget(target);
        }
        else
        {
            selectedAlertIds.UnionWith(VisibleAlerts.Select(alert => alert.Id));
        }

        await GeneratePromptAsync();
    }

    private async Task ClearSelection()
    {
        selectedAlertIds.Clear();
        await GeneratePromptAsync();
    }

    private void SyncSelection(bool selectDefaults)
    {
        var visibleIds = VisibleAlerts.Select(alert => alert.Id).ToHashSet();
        selectedAlertIds.RemoveWhere(id => !visibleIds.Contains(id));
        if (selectDefaults)
        {
            selectedAlertIds.Clear();
            if (analysisScopeType == nameof(IncidentAnalysisScopeType.Target) && VisibleAlerts.FirstOrDefault() is { } target)
            {
                SelectTarget(target);
            }
            else
            {
                selectedAlertIds.UnionWith(visibleIds);
            }
        }
    }

    private void SelectTarget(AlertRecord selectedAlert)
    {
        selectedAlertIds.Clear();
        selectedAlertIds.UnionWith(VisibleAlerts
            .Where(alert => alert.SubscriptionId.Equals(selectedAlert.SubscriptionId, StringComparison.OrdinalIgnoreCase) &&
                alert.TargetName.Equals(selectedAlert.TargetName, StringComparison.OrdinalIgnoreCase))
            .Select(alert => alert.Id));
    }

    private async Task CopyPromptAsync()
    {
        if (disposed || isCopyingClipboard || isSavingReview) return;
        copyStatus = string.Empty;
        copyError = null;
        if (alertLoadError is not null)
        {
            Logger.LogWarning("Cannot copy an analysis prompt while its alert source is unavailable.");
            copyError = Text["Prompt.AlertLoadFailed"];
            return;
        }
        if (isGenerating || generationError is not null || !SelectedAlerts.Any() || string.IsNullOrWhiteSpace(GeneratedPrompt))
        {
            Logger.LogWarning("Cannot copy an analysis prompt without a current valid selection and prepared prompt.");
            copyError = Text["Prompt.CopyUnavailable"];
            return;
        }
        var version = promptVersion;
        var text = GeneratedPrompt;
        if (await CopyTextToClipboardAsync(text, handoff: false))
            copyStatus = Text[version == promptVersion && GeneratedPrompt == text && alertLoadError is null && !isGenerating
                ? "Prompt.Copied" : "Prompt.CopiedPrevious"];
    }

    private async Task<bool> CopyTextToClipboardAsync(string text, bool handoff)
    {
        if (disposed || isCopyingClipboard) return false;
        isCopyingClipboard = true;
        var cancellationToken = clipboardCancellation.Token;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", cancellationToken, text);
            return !disposed && !cancellationToken.IsCancellationRequested;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return false;
        }
        catch (JSDisconnectedException) when (disposed)
        {
            return false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not confirm the analysis clipboard copy for {Kind}.", handoff ? "handoff" : "prompt");
            if (!disposed)
            {
                if (handoff) reviewError = Text["Prompt.Review.ClipboardFailed"];
                else copyError = Text["Prompt.CopyFailed"];
            }
            return false;
        }
        finally
        {
            isCopyingClipboard = false;
        }
    }

    private async Task CreateJobAsync()
    {
        if (disposed || isCopyingClipboard || isSavingReview || isRefreshingJob || isSavingJob || jobReloadRequired) return;
        if (alertLoadError is not null)
        {
            Logger.LogWarning("Cannot start an analysis job while its alert source is unavailable.");
            jobError = Text["Prompt.AlertLoadFailed"];
            return;
        }
        if (!CanStartConfiguredMode)
        {
            Logger.LogWarning("The current user or execution mode cannot start an analysis job.");
            jobError = CanCreateJob
                ? AgentAnalysisErrorPresentation.DisabledReason(Orchestrator.ExecutionState, Text)
                : Text["Prompt.AccessHelp"];
            return;
        }
        isSavingJob = true;
        jobError = null;
        copyStatus = string.Empty;
        var confirmed = false;
        try
        {
            var response = await JobService.StartAsync(
                new AgentAnalysisJobStartRequest(
                    SelectedAlerts.Select(alert => alert.Id).ToArray(),
                    analysisScopeType,
                    ScopeValue(),
                    SystemHistoryDays: 7,
                    ContextHours: AgentAnalysisJobApi.MaxContextHours,
                    IncludeSystemHistory: includeSystemHistory,
                    IncludeRelatedContext: includeRelatedContext),
                currentUser);
            confirmed = true;
            generatedPrompt = response.ManualPrompt;
            if (activeJob?.Id != response.Job.Id ||
                activeResult is null ||
                activeResult.AnalysisId != response.Job.AnalysisId ||
                activeResult.ResultVersion != response.Job.ResultVersion)
            {
                activeResult = null;
                reviewEvents = [];
                reviewStatus = null;
            }
            activeJob = response.Job;
            copyStatus = Text["Prompt.JobCreated"];
            await ReloadRecentJobsAsync();
            await LoadActiveResultAsync(response.Job.Id);
        }
        catch (Exception exception)
        {
            if (!confirmed && IsJobStartRejection(exception))
                Logger.LogWarning(exception, "Analysis job request was rejected.");
            else
            {
                Logger.LogError(exception, "Could not confirm or reload the analysis job. Confirmed: {Confirmed}.", confirmed);
                jobReloadRequired = true;
                reviewReloadRequired = true;
            }
            jobError = confirmed ? Text["Prompt.Job.CreatedReloadFailed"] : JobStartError(exception);
        }
        finally
        {
            isSavingJob = false;
        }
    }

    private async Task ReloadRecentJobsAsync()
    {
        recentJobs = await JobService.ListAccessibleAsync(currentUser);
    }

    private async Task RefreshJobHistoryAsync()
    {
        if (isSavingReview || isSavingJob || isRefreshingJob) return;
        isRefreshingJob = true;
        try
        {
            await ReloadRecentJobsAsync();
            if (activeJob is not null) await LoadActiveResultAsync(activeJob.Id);
            jobReloadRequired = false;
            jobError = null;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not refresh analysis job history after an unconfirmed start or reload.");
            jobError = ResultError(exception);
        }
        finally
        {
            isRefreshingJob = false;
        }
    }

    private static bool IsJobStartRejection(Exception exception) => exception switch
    {
        AgentAnalysisRequestValidationException or AgentAnalysisUnavailableException => true,
        AgentAnalysisScopeDeniedException { Code: { } code } => Enum.IsDefined(code),
        AgentAnalysisJobValidationException validation => Enum.IsDefined(validation.Code),
        _ => SnapshotCode(exception) is not null
    };

    private string JobStartError(Exception exception) => exception switch
    {
        AgentAnalysisRequestValidationException => Text["Prompt.Job.RequestInvalid"],
        AgentAnalysisUnavailableException => Text["Prompt.Job.Unavailable"],
        AgentAnalysisScopeDeniedException { Code: { } code } when Enum.IsDefined(code) => Text[$"Prompt.Job.{code}"],
        AgentAnalysisJobValidationException validation when Enum.IsDefined(validation.Code) => Text[$"Prompt.Job.{validation.Code}"],
        _ => SnapshotError(exception, "Prompt.Job.StartFailed")
    };

    private static IncidentAnalysisSnapshotCode? SnapshotCode(Exception exception)
    {
        IncidentAnalysisSnapshotCode? code = exception switch
        {
            IncidentAnalysisSnapshotRangeException range => range.Code,
            IncidentAnalysisSnapshotArgumentException argument => argument.Code,
            IncidentAnalysisSnapshotException snapshot => snapshot.Code,
            _ => null
        };
        return code is { } value && Enum.IsDefined(value) ? value : null;
    }

    private string SnapshotError(Exception exception, string fallbackKey) =>
        SnapshotCode(exception) is { } code ? Text[$"Prompt.Snapshot.{code}"] : Text[fallbackKey];

    private async Task SelectJobAsync(Guid id)
    {
        if (isSavingReview || isSavingJob || isRefreshingJob) return;
        isRefreshingJob = true;
        jobError = null;
        try
        {
            await LoadActiveResultAsync(id);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load analysis job {JobId} and its review history.", id);
            reviewReloadRequired = true;
            jobError = ResultError(exception);
        }
        finally
        {
            isRefreshingJob = false;
        }
    }

    private async Task RefreshActiveJobAsync()
    {
        if (isSavingReview || isSavingJob || isRefreshingJob) return;
        if (activeJob is null)
        {
            return;
        }

        isRefreshingJob = true;
        jobError = null;
        try
        {
            await LoadActiveResultAsync(activeJob.Id);
            await ReloadRecentJobsAsync();
            jobReloadRequired = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not refresh the analysis job and its review history.");
            reviewReloadRequired = true;
            jobError = ResultError(exception);
        }
        finally
        {
            isRefreshingJob = false;
        }
    }

    private async Task LoadActiveResultAsync(Guid id)
    {
        var job = await JobService.GetAccessibleAsync(id, currentUser);
        if (job is null)
        {
            activeJob = null;
            activeResult = null;
            jobError = Text["Prompt.JobUnavailable"];
            return;
        }

        AgentAnalysisResult? loadedResult = null;
        IReadOnlyList<AgentAnalysisReviewEvent> loadedReviews = [];
        if (job.Status == AgentAnalysisJobStatuses.Completed && !string.IsNullOrWhiteSpace(job.ResultJson))
        {
            loadedResult = AgentAnalysisResultParser.ParseStored(job.ResultJson);
            loadedReviews = await JobService.ListReviewsAsync(id, currentUser);
        }
        activeJob = AgentAnalysisJobResponse.FromJob(job);
        activeResult = loadedResult;
        reviewEvents = loadedReviews;
        reviewStatus = null;
        jobError = null;
        reviewReloadRequired = false;
        reviewError = null;
    }

    private async Task SubmitReviewAsync(string action, string? comment = null)
    {
        if (ReviewActionsUnavailable) return;
        if (activeJob is null || activeResult is null)
        {
            Logger.LogWarning("Cannot review an analysis without a selected result.");
            reviewError = Text["Prompt.Review.ResultRequired"];
            return;
        }

        isSavingReview = true;
        reviewStatus = null;
        reviewError = null;
        var jobId = activeJob.Id;
        var version = activeResult.ResultVersion;
        try
        {
            var effectiveComment = comment ?? (action is AgentAnalysisReviewActions.Commented or AgentAnalysisReviewActions.Rejected
                ? reviewComment
                : null);
            await JobService.ReviewAsync(jobId, currentUser, action, effectiveComment);
            reviewComment = string.Empty;
            reviewStatus = Text.Format("Prompt.ReviewRecorded", action, version.ToString(CultureInfo.CurrentCulture));
            try
            {
                reviewEvents = await JobService.ListReviewsAsync(jobId, currentUser);
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Review was saved but its history could not be reloaded for job {JobId}.", jobId);
                reviewReloadRequired = true;
                reviewError = Text["Prompt.Review.ReloadFailed"];
            }
        }
        catch (Exception exception)
        {
            if (exception is AgentAnalysisReviewValidationException or KeyNotFoundException or UnauthorizedAccessException)
                Logger.LogWarning(exception, "Analysis review rejected for job {JobId}.", jobId);
            else
            {
                Logger.LogError(exception, "Analysis review write outcome is unknown for job {JobId}.", jobId);
                reviewReloadRequired = true;
            }
            reviewError = ReviewError(exception);
        }
        finally
        {
            isSavingReview = false;
        }
    }

    private async Task CopyHandoffAsync()
    {
        if (ReviewActionsUnavailable) return;
        if (activeResult is null || activeJob is null)
        {
            Logger.LogWarning("Cannot copy an analysis handoff without a selected result.");
            reviewError = Text["Prompt.Review.ResultRequired"];
            return;
        }

        var handoff = activeResult.DetailedAnalysis.OperatorHandoff;
        var jobId = activeJob.Id;
        var resultVersion = activeResult.ResultVersion;
        reviewStatus = null;
        reviewError = null;
        var text = string.Join(Environment.NewLine,
            $"Decision: {handoff.CurrentDecision}",
            $"Unresolved risk: {handoff.UnresolvedRisk}",
            $"Missing evidence: {handoff.MissingEvidence}",
            $"Audience: {handoff.Audience}");
        isSavingReview = true;
        try
        {
            if (!await CopyTextToClipboardAsync(text, handoff: true)) return;
        }
        finally
        {
            isSavingReview = false;
        }
        if (disposed) return;
        if (activeJob?.Id != jobId || activeResult?.ResultVersion != resultVersion)
        {
            Logger.LogWarning("The selected analysis result changed while its handoff was being copied.");
            reviewError = Text["Prompt.Review.CopySelectionChanged"];
            return;
        }
        await SubmitReviewAsync(AgentAnalysisReviewActions.HandoffCopied);
        if (reviewError is not null && reviewStatus is null)
            reviewError = Text["Prompt.Review.CopyAuditFailed"];
    }

    private string ReviewError(Exception exception) => exception switch
    {
        AgentAnalysisReviewValidationException validation when Enum.IsDefined(validation.Code) =>
            Text[$"Prompt.Review.{validation.Code}"],
        KeyNotFoundException => Text["Prompt.JobUnavailable"],
        UnauthorizedAccessException => Text["Prompt.Review.NotAllowed"],
        _ => Text["Prompt.Review.SaveFailed"]
    };

    private string ResultError(Exception exception) => exception switch
    {
        AgentAnalysisResultException result when Enum.IsDefined(result.Code) =>
            Text[$"Prompt.Result.{result.Code}"],
        _ => Text["Prompt.Review.HistoryLoadFailed"]
    };

    private string ScopeValue()
    {
        var selected = SelectedAlerts;
        if (analysisScopeType == nameof(IncidentAnalysisScopeType.Target))
        {
            return selected.FirstOrDefault()?.TargetName ?? "No target selected";
        }

        return selected.Count == 1
            ? selected[0].AlertId
            : $"{selected.Count} selected alert events";
    }

    private IReadOnlyList<MicrosoftSource> ResolveSources(IEnumerable<string> sourceIds)
    {
        var ids = sourceIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
        return SourceCatalog.ApprovedSources.Where(source => ids.Contains(source.Id)).ToArray();
    }

    private string DisplayValues(IEnumerable<string> values)
    {
        var distinct = values
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Order(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        return distinct.Length == 0 ? Text["Common.None"] : string.Join(", ", distinct);
    }

    private string DisplayIds(IEnumerable<Guid> ids)
    {
        var values = ids.Select(id => id.ToString()).ToArray();
        return values.Length == 0 ? Text["Common.None"] : string.Join(", ", values);
    }

    private static string DisplayValue(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private string DisplayRuleDecisionSummary()
    {
        if (previewSnapshot is null)
        {
            return Text[isGenerating ? "Prompt.Calculating" : "Common.None"];
        }

        var decisions = previewSnapshot.PrimaryEvidence
            .GroupBy(evidence => evidence.Decision.Type)
            .OrderBy(group => group.Key)
            .Select(group => $"{group.Key}: {group.Count()}");
        return string.Join(", ", decisions);
    }

    private string HistoryPreview(int? count, bool included, string range) =>
        included ? Text.Format("Prompt.HistoryPreview", count ?? 0, range) : Text["Prompt.Excluded"];

    private static string AttachmentPath(Guid id) => $"/api/agent-analysis/jobs/{id:D}/attachment";

    private IReadOnlyList<AgentExecutiveStatement> StatementsByKind(params string[] kinds)
    {
        var allowedKinds = kinds.ToHashSet(StringComparer.Ordinal);
        return activeResult?.DetailedAnalysis.ExecutiveSummary
            .Where(statement => allowedKinds.Contains(statement.Kind))
            .ToArray() ?? [];
    }

    private IReadOnlyList<EvidencePreviewGroup> EvidenceGroups() => previewSnapshot is null
        ? []
        :
        [
            new(Text["Prompt.PrimaryEvidence"], previewSnapshot.PrimaryEvidence, true),
            new(Text["Prompt.SystemHistory"], previewSnapshot.SystemHistory, includeSystemHistory),
            new(Text["Prompt.RelatedContext"], previewSnapshot.Context24Hours, includeRelatedContext)
        ];

    private async Task GeneratePromptAsync()
    {
        promptVersion++;
        copyStatus = string.Empty;
        copyError = null;
        if (alertLoadError is not null)
        {
            Logger.LogWarning("Cannot generate an incident snapshot while its alert source is unavailable.");
            generationError = Text["Prompt.AlertLoadFailed"];
            return;
        }
        promptCancellation?.Cancel();
        promptCancellation?.Dispose();
        promptCancellation = new CancellationTokenSource();
        var cancellationToken = promptCancellation.Token;
        promptGeneratedAt = DateTimeOffset.UtcNow;
        copyStatus = string.Empty;
        generationError = null;
        previewSnapshot = null;

        if (!Orchestrator.ExecutionState.IsEnabled)
        {
            generatedPrompt = string.Empty;
            generationError = AgentAnalysisErrorPresentation.DisabledReason(Orchestrator.ExecutionState, Text);
            isGenerating = false;
            return;
        }

        var selected = SelectedAlerts;
        if (selected.Count == 0)
        {
            generatedPrompt = "Select at least one alert to prepare an incident analysis prompt.";
            isGenerating = false;
            return;
        }

        isGenerating = true;
        try
        {
            var snapshot = await SnapshotService.BuildAsync(
                selected.Select(alert => alert.Id).ToArray(),
                new IncidentAnalysisScope(
                    AgentAnalysisJobApi.ParseScopeType(analysisScopeType),
                    ScopeValue()),
                GraphOptions.DefaultLayer1,
                GraphOptions.DefaultLayer2,
                GraphOptions.DefaultLayer3,
                promptGeneratedAt,
                new IncidentAnalysisSnapshotOptions(
                    SystemHistoryDays: 7,
                    ContextHours: AgentAnalysisJobApi.MaxContextHours,
                    IncludeSystemHistory: includeSystemHistory,
                    IncludeRelatedContext: includeRelatedContext,
                    InventoryCorrelationLayers: AnalysisContextOptions.InventoryCorrelationLayers),
                cancellationToken: cancellationToken);
            var prepared = Orchestrator.Prepare(snapshot);
            if (cancellationToken.IsCancellationRequested) return;
            previewSnapshot = snapshot;
            generatedPrompt = prepared.Prompt;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (SnapshotCode(exception) is not null ||
                exception is AgentAnalysisJobValidationException { Code: AgentAnalysisJobValidationCode.ScopeUnsupported })
                Logger.LogWarning(exception, "Incident analysis snapshot validation failed.");
            else
                Logger.LogError(exception, "Could not generate the incident analysis snapshot.");
            if (!cancellationToken.IsCancellationRequested)
            {
                generatedPrompt = string.Empty;
                generationError = exception is AgentAnalysisJobValidationException { Code: AgentAnalysisJobValidationCode.ScopeUnsupported }
                    ? Text["Prompt.Job.ScopeUnsupported"]
                    : SnapshotError(exception, "Prompt.GenerationFailed");
            }
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                isGenerating = false;
            }
        }
    }

    private static int ParseOption(ChangeEventArgs args, int fallback, params int[] allowed) =>
        int.TryParse(args.Value?.ToString(), out var value) && allowed.Contains(value) ? value : fallback;

    private static string SeverityClass(string severity) => $"severity-{severity.ToLowerInvariant()}";

    public void Dispose()
    {
        if (disposed) return;
        disposed = true;
        alertReloadVersion++;
        AlertStore.Changed -= HandleStoreChanged;
        promptCancellation?.Cancel();
        promptCancellation?.Dispose();
        clipboardCancellation.Cancel();
        clipboardCancellation.Dispose();
    }

    private sealed record EvidencePreviewGroup(
        string Label,
        IReadOnlyList<IncidentAlertEvidence> Items,
        bool Included);
