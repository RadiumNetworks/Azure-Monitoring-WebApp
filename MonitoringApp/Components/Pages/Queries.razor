@page "/queries"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Text.Json
@inject AlertStore AlertStore
@inject NavigationManager Navigation
@inject UiText Text
@inject ILogger<Queries> Logger

<PageTitle>@Text["QueryExamples.PageTitle"]</PageTitle>

<section class="query-heading">
    <div>
        <p class="eyebrow">@Text["QueryExamples.Eyebrow"]</p>
        <h1>@Text["QueryExamples.Heading"]</h1>
        <p class="subtitle">@Text["QueryExamples.Description"]</p>
    </div>
    <button class="query-refresh" type="button" disabled="@(disposed || isLoading)" @onclick="LoadResultsAsync">
        @(isLoading ? Text["QueryExamples.Refreshing"] : Text["QueryExamples.Refresh"])
    </button>
</section>

@if (errorMessage is not null)
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}

<div class="query-grid">
    @foreach (var example in examples)
    {
        <section class="query-example" aria-labelledby="@example.Id">
            <div class="query-example-heading">
                <div>
                    <span>@Text[example.LabelKey]</span>
                    <h2 id="@example.Id">@Text[example.TitleKey]</h2>
                </div>
                <span class="query-count">@Text.Plural("QueryExamples.Results", example.Response.Count)</span>
            </div>
            <a class="query-url" href="@example.Url" target="_blank" rel="noopener noreferrer">@example.Url</a>
            <div class="query-result-heading">
                <strong>@Text["QueryExamples.Response"]</strong>
                <span>HTTP 200 · application/json</span>
            </div>
            <pre class="query-result">@Serialize(example.Response)</pre>
        </section>
    }
</div>

@code {
    private static readonly JsonSerializerOptions SerializerOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true
    };

    private IReadOnlyList<QueryExample> examples = [];
    private readonly CancellationTokenSource cancellation = new();
    private Task? loadTask;
    private Task? disposeTask;
    private bool disposed;
    private bool isLoading;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadResultsAsync();

    private Task LoadResultsAsync()
    {
        if (disposed || isLoading) return Task.CompletedTask;
        return loadTask = LoadResultsCoreAsync();
    }

    private async Task LoadResultsCoreAsync()
    {
        var token = cancellation.Token;
        isLoading = true;
        StateHasChanged();
        try
        {
            var now = DateTimeOffset.UtcNow;
            var alerts = await AlertStore.GetAllRequiredAsync(token);
            if (disposed || token.IsCancellationRequested) return;
            IReadOnlyList<QueryExample> current =
            [
                CreateExample(
                    "active-query",
                    "QueryExamples.ActiveAlerts",
                    "QueryExamples.Last120Minutes",
                    "api/query?activeMinutes=120",
                    "active",
                    now.AddMinutes(-120),
                    now,
                    AlertQuery.GetActiveSince(alerts, now.AddMinutes(-120))),
                CreateExample(
                    "event-query",
                    "QueryExamples.AlertEvents",
                    "QueryExamples.Last2Hours",
                    "api/query?eventHours=2",
                    "events",
                    now.AddHours(-2),
                    now,
                    AlertQuery.GetEventsSince(alerts, now.AddHours(-2)))
            ];
            examples = current;
            errorMessage = null;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load query examples from the current alert data.");
            if (!disposed && !token.IsCancellationRequested)
                errorMessage = Text[examples.Count == 0 ? "QueryExamples.LoadFailed" : "QueryExamples.RefreshFailed"];
        }
        finally
        {
            isLoading = false;
            if (!disposed) StateHasChanged();
        }
    }

    private QueryExample CreateExample(
        string id,
        string labelKey,
        string titleKey,
        string relativeUrl,
        string mode,
        DateTimeOffset from,
        DateTimeOffset to,
        IReadOnlyList<AlertRecord> matches)
    {
        var items = matches.Select(AlertQueryItem.FromAlert).ToArray();
        return new QueryExample(
            id,
            labelKey,
            titleKey,
            new Uri(new Uri(Navigation.BaseUri), relativeUrl).AbsoluteUri,
            new AlertQueryResponse(mode, from, to, items.Length, items));
    }

    private static string Serialize(AlertQueryResponse response) =>
        JsonSerializer.Serialize(response, SerializerOptions);

    private sealed record QueryExample(
        string Id,
        string LabelKey,
        string TitleKey,
        string Url,
        AlertQueryResponse Response);

    public ValueTask DisposeAsync() => new(disposeTask ??= DisposeCoreAsync());

    private async Task DisposeCoreAsync()
    {
        disposed = true;
        var token = cancellation.Token;
        try { await cancellation.CancelAsync(); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Query examples cancellation failed during teardown.");
        }
        try
        {
            if (loadTask is not null) await loadTask;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Query examples read failed during teardown.");
        }
        finally
        {
            cancellation.Dispose();
        }
    }
}