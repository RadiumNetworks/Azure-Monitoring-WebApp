@page "/admin/alert-authentication"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminAccess")]
@inject AlertIngestionAuthenticationOptions Options
@inject ApplicationAuthenticationOptions ApplicationAuthentication
@inject IAlertIngestionDiagnostics Diagnostics
@inject UiText Text

<PageTitle>@Text["IngestionAdmin.PageTitle"]</PageTitle>

<section class="admin-heading">
    <div>
        <p class="eyebrow">@Text["Common.Administration"]</p>
        <h1>@Text["IngestionAdmin.Title"]</h1>
        <p class="subtitle">@Text["IngestionAdmin.Subtitle"]</p>
    </div>
    <button class="admin-secondary" type="button" @onclick="Refresh">@Text["IngestionAdmin.Refresh"]</button>
</section>

@if (!Options.Enabled)
{
    <div class="admin-message admin-message-warning" role="status">
        <LocalizedContent ResourceKey="IngestionAdmin.DisabledWarning">
            <Value0><strong>@Text["IngestionAdmin.DisabledTitle"]</strong></Value0>
        </LocalizedContent>
    </div>
}
@if (ApplicationAuthentication.IsOpen)
{
    <div class="admin-message admin-message-warning" role="status">
        <LocalizedContent ResourceKey="IngestionAdmin.OpenWarning">
            <Value0><code>open</code></Value0>
            <Value1>AdminAccess</Value1>
            <Value2><code>entra</code></Value2>
            <Value3><code>sql</code></Value3>
        </LocalizedContent>
    </div>
}

<section class="admin-diagnostics-section" aria-labelledby="ingestion-configuration">
    <h2 id="ingestion-configuration">@Text["IngestionAdmin.Configuration"]</h2>
    <dl class="ingestion-diagnostic-fields">
        <div><dt>@Text["IngestionAdmin.Authentication"]</dt><dd>@Text[Options.Enabled ? "Common.Enabled" : "Common.Disabled"]</dd></div>
        <div><dt>@Text["IngestionAdmin.Audience"]</dt><dd><code>@Display(Options.Audience)</code></dd></div>
        <div><dt>@Text["IngestionAdmin.ApplicationRole"]</dt><dd><code>@Options.RequiredRole</code></dd></div>
        <div><dt>@Text["IngestionAdmin.Instance"]</dt><dd><code>@instanceId</code></dd></div>
    </dl>
    @if (configurationErrors.Count > 0)
    {
        <p><strong>@Text["IngestionAdmin.ConfigurationInvalid"]</strong></p>
        <ul>
            @foreach (var error in configurationErrors)
            {
                <li>@error</li>
            }
        </ul>
    }
    <h3>@Text["IngestionAdmin.Sources"]</h3>
    @if (Options.Sources.Count == 0)
    {
        <p>@Text["IngestionAdmin.NoSources"]</p>
    }
    @foreach (var source in Options.Sources)
    {
        <dl class="ingestion-diagnostic-fields">
            <div><dt>@Text["IngestionAdmin.TenantId"]</dt><dd><code>@source.TenantId</code></dd></div>
            <div><dt>@Text["IngestionAdmin.UamiClientId"]</dt><dd><code>@source.ClientId</code></dd></div>
        </dl>
    }
    <p>
        <LocalizedContent ResourceKey="IngestionAdmin.EndpointsHint">
            <Value0><code>POST /api/alerts</code></Value0>
            <Value1><code>GET /api/alert-query-refresh-targets</code></Value1>
            <Value2><code>PUT /api/alerts/{id}/query-result</code></Value2>
            <Value3><code>azp</code></Value3>
            <Value4><code>idtyp=app</code></Value4>
            <Value5><code>@Options.RequiredRole</code></Value5>
        </LocalizedContent>
    </p>
</section>

<section aria-labelledby="ingestion-requests">
    <div class="admin-section-heading">
        <div>
            <h2 id="ingestion-requests">@Text.Format("IngestionAdmin.RecentRequests", requests.Count)</h2>
            <span>@Text.Format("IngestionAdmin.RetentionHint", AlertIngestionDiagnostics.Capacity)</span>
        </div>
    </div>
    <p>
        @Text["IngestionAdmin.HistoryHint"]
    </p>
    @if (requests.Count == 0)
    {
        <p class="admin-empty">@Text["IngestionAdmin.NoRequests"]</p>
    }
    <div class="admin-rule-cards">
        @foreach (var request in requests)
        {
            <article class="admin-rule-card ingestion-diagnostic-card">
                <div class="admin-section-heading">
                    <strong><code>@request.Method @request.Endpoint</code></strong>
                    <span>@Text.Format("IngestionAdmin.RecordedAt", request.RecordedAt.ToString("yyyy-MM-dd HH:mm:ss"))</span>
                    @if (request.AuthenticationBlocked)
                    {
                        <strong class="ingestion-diagnostic-blocked">@Text.Format("IngestionAdmin.Blocked", request.StatusCode)</strong>
                    }
                    else
                    {
                        <span>@Text.Format("IngestionAdmin.HttpStatus", request.StatusCode)</span>
                    }
                </div>
                <p><strong>@request.AuthenticationStatus</strong></p>
                <dl class="ingestion-diagnostic-fields">
                    <div><dt>@Text["IngestionAdmin.ClaimTenant"]</dt><dd><code>@Display(request.TenantId)</code></dd></div>
                    <div><dt>@Text["IngestionAdmin.ReportedClient"]</dt><dd><code>@Display(request.UamiClientId)</code></dd></div>
                    <div><dt>@Text.Format("IngestionAdmin.RequiredRole", Options.RequiredRole)</dt><dd>@RoleStatus(request)</dd></div>
                </dl>
                <details>
                    <summary>@Text["IngestionAdmin.Details"]</summary>
                    <p>@request.InspectionStatus</p>
                    @if (!request.TokenValidated)
                    {
                        <p><strong>@Text["IngestionAdmin.UnverifiedWarning"]</strong></p>
                    }
                    <dl class="ingestion-diagnostic-fields">
                        <div><dt>@Text["IngestionAdmin.AuthorizedParty"]</dt><dd><code>@Display(request.AuthorizedParty)</code></dd></div>
                        <div><dt>@Text["IngestionAdmin.ApplicationId"]</dt><dd><code>@Display(request.ApplicationId)</code></dd></div>
                        <div><dt>@Text["IngestionAdmin.ObjectId"]</dt><dd><code>@Display(request.ObjectId)</code></dd></div>
                        <div><dt>@Text["IngestionAdmin.Version"]</dt><dd>@Display(request.TokenVersion)</dd></div>
                        <div><dt>@Text["IngestionAdmin.IdentityType"]</dt><dd>@Display(request.IdentityType)</dd></div>
                        <div><dt>@Text["IngestionAdmin.Issuer"]</dt><dd><code>@Display(request.Issuer)</code></dd></div>
                        <div><dt>@Text["IngestionAdmin.ClaimAudience"]</dt><dd><code>@List(request.Audiences)</code></dd></div>
                        <div><dt>@Text["IngestionAdmin.ClaimRoles"]</dt><dd><code>@List(request.Roles)</code></dd></div>
                        <div><dt>@Text["IngestionAdmin.Expiry"]</dt><dd>@(request.ExpiresAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? Text["IngestionAdmin.ExpiryMissing"])</dd></div>
                        <div><dt>@Text["IngestionAdmin.TraceId"]</dt><dd><code>@request.TraceId</code></dd></div>
                        <div><dt>@Text["IngestionAdmin.AuthRequired"]</dt><dd>@Text[request.AuthenticationRequired ? "IngestionAdmin.Yes" : "IngestionAdmin.No"]</dd></div>
                    </dl>
                    @if (request.ListsTruncated)
                    {
                        <p><strong>@Text["IngestionAdmin.Truncated"]</strong></p>
                    }
                    @if (request.PolicyChecks.Count == 0)
                    {
                        <p>@Text["IngestionAdmin.NoClaims"]</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var check in request.PolicyChecks)
                            {
                                <li><strong>@Text.Format("IngestionAdmin.CheckResult", Text[check.Passed ? "IngestionAdmin.Pass" : "IngestionAdmin.Fail"], check.Name)</strong> @check.Detail</li>
                            }
                        </ul>
                    }
                    <p>
                        @Text["IngestionAdmin.AssignmentHint"]
                    </p>
                </details>
            </article>
        }
    </div>
</section>

@code {
    private readonly string instanceId =
        Environment.GetEnvironmentVariable("WEBSITE_INSTANCE_ID") ?? Environment.MachineName;
    private IReadOnlyList<string> configurationErrors = [];
    private IReadOnlyList<AlertIngestionRequestDiagnostic> requests = [];

    protected override void OnInitialized()
    {
        configurationErrors = Options.ValidateConfiguration();
        Refresh();
    }

    private void Refresh() => requests = Diagnostics.GetRecent();
    private string Display(string? value) => string.IsNullOrWhiteSpace(value) ? Text["Common.Missing"] : value;
    private string List(IReadOnlyList<string> values) => values.Count == 0 ? Text["Common.None"] : string.Join(", ", values);
    private string RoleStatus(AlertIngestionRequestDiagnostic request) => Text[request.RequiredRolePresent switch
    {
        true => request.TokenValidated ? "IngestionAdmin.RoleValidatedPresent" : "IngestionAdmin.RoleUnverifiedPresent",
        false => request.TokenValidated ? "IngestionAdmin.RoleValidatedMissing" : "IngestionAdmin.RoleUnverifiedMissing",
        null => "IngestionAdmin.RoleUnknown"
    }];
}
