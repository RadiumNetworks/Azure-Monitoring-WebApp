@page "/kql"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "OperatorAccess")]
@implements IDisposable
@inject FreeKqlQueryService Service
@inject CrossTenantLogAnalyticsOptions Options
@inject ILogger<FreeKql> Logger
@inject UiText Text

<PageTitle>@Text["FreeKql.Title"]</PageTitle>
<h1>@Text["FreeKql.Title"]</h1>
<p>@Text["FreeKql.Help"]</p>
<details class="free-kql-examples">
    <summary>@Text["FreeKql.Examples.Title"]</summary>
    <h3>@Text["FreeKql.Examples.Tables"]</h3>
    <pre><code>@Text["FreeKql.Examples.Query.Tables"]</code></pre>
    <h3>@Text["FreeKql.Examples.Schema"]</h3>
    <pre><code>@Text["FreeKql.Examples.Query.Schema"]</code></pre>
    <h3>@Text["FreeKql.Examples.Values"]</h3>
    <pre><code>@Text["FreeKql.Examples.Query.Values"]</code></pre>
    <h3>@Text["FreeKql.Examples.Distinct"]</h3>
    <pre><code>@Text["FreeKql.Examples.Query.Distinct"]</code></pre>
    <h3>@Text["FreeKql.Examples.ExpandRows"]</h3>
    <pre><code>@Text["FreeKql.Examples.Query.ExpandRows"]</code></pre>
    <h3>@Text["FreeKql.Examples.ExpandColumns"]</h3>
    <pre><code>@Text["FreeKql.Examples.Query.ExpandColumns"]</code></pre>
    <h3>@Text["FreeKql.Examples.Join"]</h3>
    <pre><code>@Text["FreeKql.Examples.Query.Join"]</code></pre>
</details>
<form class="admin-form" @onsubmit="ExecuteAsync" @onsubmit:preventDefault>
    <label>
        @Text["FreeKql.Workspace"]
        <select @bind="workspaceKey" @bind:after="WorkspaceChanged" disabled="@busy">
            <option value="">@Text["FreeKql.SelectWorkspace"]</option>
            @foreach (var workspace in Options.Workspaces)
            {
                <option value="@workspace.Key">@workspace.DisplayName</option>
            }
        </select>
    </label>
    @if (Options.Enabled && !string.IsNullOrEmpty(workspaceKey))
    {
        <section class="free-kql-workspace-tables admin-field-wide" aria-label="@Text["FreeKql.Tables.Title"]">
            <strong>@Text["FreeKql.Tables.Title"]</strong>
            @if (tableCatalog is null || tableCatalog.IsLoading)
            {
                <small role="status">@Text["KqlEditor.TablesLoading"]</small>
            }
            else if (tableCatalog.HasError)
            {
                <small role="alert">@Text["KqlEditor.TablesFailed"]</small>
            }
            else if (tableCatalog.TableNames.Count == 0)
            {
                <small role="status">@Text["FreeKql.Tables.Empty"]</small>
            }
            else
            {
                <ul>
                    @foreach (var table in tableCatalog.TableNames)
                    {
                        <li><code>@table</code></li>
                    }
                </ul>
            }
        </section>
    }
    <label class="admin-field-wide">
        KQL
        <KqlEditor @bind-Value="kql" Rows="12" Disabled="@busy"
                   WorkspaceKeys="@(string.IsNullOrEmpty(workspaceKey) ? Array.Empty<string>() : new[] { workspaceKey })"
                   TableCatalogChanged="TablesChanged" />
    </label>
    <div class="admin-form-actions free-kql-actions">
        <button type="submit" disabled="@(busy || !Options.Enabled)">@Text[busy ? "FreeKql.Running" : "FreeKql.Execute"]</button>
        @if (busy)
        {
            <button type="button" @onclick="Cancel">@Text["Common.Cancel"]</button>
        }
    </div>
</form>
@if (!Options.Enabled)
{
    <p role="alert">@Text["Analysis.Validation.LiveDisabled"]</p>
}
@if (error is not null)
{
    <p role="alert">@error</p>
}
@if (result is not null)
{
    @if (result.Limited)
    {
        <p role="status">@Text["FreeKql.Limited"]</p>
    }
    @if (result.Tables.All(table => table.Rows.Count == 0))
    {
        <p>@Text["FreeKql.Empty"]</p>
    }
    <RawQueryTableView Tables="result.Tables" />
}

@code {
    private string workspaceKey = "", kql = "";
    private string? error;
    private FreeKqlResult? result;
    private KqlTableCatalog? tableCatalog;
    private bool busy, disposed;
    private CancellationTokenSource? cancellation;

    private void WorkspaceChanged() => tableCatalog = null;

    private void TablesChanged(KqlTableCatalog catalog)
    {
        if (disposed || catalog.WorkspaceKeys.Count != 1 ||
            !catalog.WorkspaceKeys[0].Equals(workspaceKey, StringComparison.OrdinalIgnoreCase)) return;
        tableCatalog = catalog;
    }

    private async Task ExecuteAsync()
    {
        if (busy || disposed) return;
        busy = true;
        error = null;
        result = null;
        using var request = new CancellationTokenSource();
        cancellation = request;
        try
        {
            if (string.IsNullOrWhiteSpace(kql))
            {
                Logger.LogWarning("Free KQL execution rejected because the query is empty.");
                error = Text["FreeKql.Required"];
                return;
            }
            var response = await Service.ExecuteAsync(workspaceKey, kql, request.Token);
            if (!disposed) result = response;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested)
        {
            if (!disposed) error = Text["FreeKql.Cancelled"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Free KQL execution failed for workspace {WorkspaceKey}.", workspaceKey);
            if (!disposed) error = AnalysisErrorPresentation.Message(exception, Text, "FreeKql.Failed");
        }
        finally { cancellation = null; busy = false; }
    }

    private void Cancel() => cancellation?.Cancel();
    public void Dispose() { disposed = true; Cancel(); }
}
