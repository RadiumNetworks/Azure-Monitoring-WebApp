@page "/admin/analysis-queries"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "OperatorAccess")]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@inject AnalysisQueryRegistry Registry
@inject AnalysisQueryCategoryService Categories
@inject ApplicationAuthenticationOptions AuthenticationOptions
@inject CurrentUserIdentity CurrentUserIdentity
@inject CrossTenantLogAnalyticsOptions Options
@inject AlertStore AlertStore
@inject AnalysisQueryRunner QueryRunner
@inject UiText Text
@inject QueryTextPresentation QueryText
@inject ILogger<AdminAnalysisQueries> Logger

<PageTitle>@Text["AdminAnalysisQueries.PageTitle"]</PageTitle>

<section class="admin-heading kql-admin-heading">
    <div>
        <p class="eyebrow">@Text["Navigation.Configuration"]</p>
        <h1>@Text["Navigation.AnalysisQueries"]</h1>
        <p class="subtitle">@Text["AdminAnalysisQueries.Description"]</p>
    </div>
    <div class="admin-heading-actions">
        @if (!isBusy && queries.Count > 0)
        {
            <a class="admin-secondary" href="api/admin/analysis-queries/export" data-enhance-nav="false"
               title="@Text["AdminAnalysisQueries.ExportHelp"]">@Text["AdminAnalysisQueries.Export"]</a>
        }
        else
        {
            <button class="admin-secondary" type="button" disabled>@Text["AdminAnalysisQueries.Export"]</button>
        }
        <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="InstallAdLibraryAsync">@Text["AdminAnalysisQueries.InstallLibrary"]</button>
        <button class="admin-primary" type="button" disabled="@ActionsUnavailable" @onclick="BeginCreate">@Text["AdminAnalysisQueries.Create"]</button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="admin-message admin-message-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="admin-message admin-message-error" role="alert">@loadError</div>
}

<QueryJsonImport Busy="@ActionsUnavailable" OnImport="ImportJsonAsync"
                 Description="@Text["QueryImport.AnalysisDescription"]" />

<div class="admin-workspace admin-analysis-workspace @(editing is not null ? "editing-draft" : null)">
    <section class="admin-rule-list" aria-labelledby="analysis-query-list">
        <div class="admin-section-heading">
            <div><h2 id="analysis-query-list">@Text["AdminAnalysisQueries.Registry"]</h2><span>@Text.Plural("AdminAnalysisQueries.Definitions", queries.Count)</span></div>
            <div class="admin-card-actions">
                <button class="admin-secondary" type="button" aria-expanded="@(!registryCollapsed)" aria-controls="analysis-query-cards"
                        @onclick="() => registryCollapsed = !registryCollapsed">@(registryCollapsed ? Text["AdminAnalysisQueries.ExpandRegistry"] : Text["AdminAnalysisQueries.MinimizeRegistry"])</button>
                <button class="admin-secondary" type="button" disabled="@isBusy" @onclick="RefreshAsync">@Text["Common.Refresh"]</button>
            </div>
        </div>
        <section class="analysis-category-manager" aria-label="@Text["AdminAnalysisQueries.BulkWorkspaceLabel"]">
            <h3>@Text["AdminAnalysisQueries.BulkWorkspaceTitle"]</h3>
            <p>@Text["AdminAnalysisQueries.BulkWorkspaceHelp"]</p>
            @if (editing is not null)
            {
                <p>@Text["AdminAnalysisQueries.BulkWorkspaceEditorHint"]</p>
            }
            <fieldset class="admin-fieldset" disabled="@(ActionsUnavailable || editing is not null)">
                <legend>@Text["AdminAnalysisQueries.TargetWorkspaces"]</legend>
                @foreach (var workspace in Options.Workspaces.OrderBy(workspace => workspace.DisplayName))
                {
                    <label class="admin-check">
                        <input type="checkbox" checked="@bulkWorkspaceKeys.Contains(workspace.Key)"
                               @onchange="args => ToggleBulkWorkspace(workspace.Key, args)" />
                        <span>@workspace.DisplayName (@workspace.Key)</span>
                    </label>
                }
                @if (Options.Workspaces.Length == 0)
                {
                    <small>@Text["AdminAnalysisQueries.NoWorkspaces"]</small>
                }
                <label class="admin-check admin-field-wide">
                    <input type="checkbox" @bind="bulkIncludeDisabledQueries" />
                    <span>@Text["AdminAnalysisQueries.IncludeDisabled"]</span>
                </label>
                @if (bulkIncludeDisabledQueries)
                {
                    <small>@Text["AdminAnalysisQueries.ReenableWarning"]</small>
                }
                <div class="admin-form-actions">
                    <button class="admin-primary" type="button"
                            disabled="@(ActionsUnavailable || editing is not null || queries.Count == 0 || bulkWorkspaceKeys.Count == 0)"
                            @onclick="AssignWorkspacesToAllAsync">@Text["AdminAnalysisQueries.ApplyWorkspaces"]</button>
                </div>
            </fieldset>
        </section>
        <section class="analysis-category-manager" aria-label="@Text["AdminAnalysisQueries.CategoryManagerLabel"]">
            <h3>@Text["AdminAnalysisQueries.ManageCategories"]</h3>
            <p>@Text["AdminAnalysisQueries.CategoriesHelp"]</p>
            <form class="admin-form" @onsubmit="SaveCategoryAsync" @onsubmit:preventDefault>
                <label class="admin-field"><span>@(categoryToEdit is null ? Text["AdminAnalysisQueries.NewCategory"] : Text["Rules.Editor.CategoryName"])</span>
                    <input required maxlength="128" disabled="@ActionsUnavailable" @bind="categoryName" />
                </label>
                <label class="admin-field"><span>@Text["AdminAnalysisQueries.ParentCategory"]</span>
                    <select disabled="@ActionsUnavailable" @bind="categoryParent">
                        <option value="">@Text["AdminAnalysisQueries.TopLevel"]</option>
                        @foreach (var path in categoryPaths.Where(path => categoryToEdit is null || !AnalysisQueryCategories.IsWithin(path, categoryToEdit)))
                        {
                            <option value="@path">@path</option>
                        }
                    </select>
                </label>
                <div class="admin-card-actions">
                    <button class="admin-primary" type="submit" disabled="@ActionsUnavailable">@(categoryToEdit is null ? Text["AdminAnalysisQueries.CreateCategory"] : Text["AdminAnalysisQueries.SaveCategory"])</button>
                    <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="() => BeginCategoryCreate()">@Text["AdminAnalysisQueries.ClearCategory"]</button>
                </div>
            </form>
        </section>
        <div id="analysis-query-cards" hidden="@registryCollapsed">
            <AnalysisQueryCategoryTree Nodes="RegistryCategories" AllowDrop="@(!ActionsUnavailable)" CategoryDrop="DropQueryAsync">
                <CategoryActions Context="category">
                    <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="() => BeginCategoryCreate(category.Path)">@Text["AdminAnalysisQueries.AddSubcategory"]</button>
                    <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="() => BeginCategoryEdit(category.Path)">@Text["AdminAnalysisQueries.RenameMoveCategory"]</button>
                    <button class="admin-danger" type="button" disabled="@(ActionsUnavailable || category.QueryCount != 0 || category.Children.Count != 0)"
                            @onclick="() => DeleteCategoryAsync(category.Path)">@Text["AdminAnalysisQueries.DeleteEmptyCategory"]</button>
                </CategoryActions>
                <QueryContent Context="query">
                <article class="admin-rule-card @(editing?.Id == query.Id ? "selected" : null)" @key="query.Id"
                         draggable="@(!ActionsUnavailable ? "true" : "false")" @ondragstart="() => draggedQueryId = query.Id"
                         @ondragend="() => draggedQueryId = null">
                    <button class="collapsible-card-toggle" type="button" disabled="@ActionsUnavailable" @onclick="() => BeginEdit(query)">
                        <strong>@QueryText.Name(query)</strong>
                        <span>@query.Category · v@(query.Version) · @query.Status</span>
                    </button>
                    <div class="collapsible-card-details">
                        <label class="admin-field"><span>@Text["AdminAnalysisQueries.CardCategory"]</span>
                            <select value="@CategorySelection(query)" disabled="@ActionsUnavailable"
                                    @onchange="args => MoveQueryAsync(query.Id, args.Value?.ToString() ?? string.Empty)">
                                @foreach (var path in categoryPaths)
                                {
                                    <option value="@path">@path</option>
                                }
                            </select>
                        </label>
                        <div class="collapsible-card-toolbar">
                            <span class="admin-status @(query.Enabled ? "enabled" : "disabled")">@query.Status</span>
                            <div class="admin-card-actions">
                                <button class="admin-secondary" type="button" disabled="@ActionsUnavailable" @onclick="() => ValidateAsync(query.Id)">@Text["AdminAnalysisQueries.Validate"]</button>
                                <button class="admin-primary" type="button" disabled="@(ActionsUnavailable || query.Status != AnalysisQueryStatuses.Validated)" @onclick="() => PublishAsync(query.Id)">@Text["AdminAnalysisQueries.Publish"]</button>
                                <button class="admin-secondary" type="button" disabled="@(ActionsUnavailable || query.PublishedVersionId is null)" @onclick="() => queryToUnpublish = query">@Text["AdminAnalysisQueries.Unpublish"]</button>
                                <button class="admin-danger" type="button" disabled="@ActionsUnavailable" @onclick="() => DisableAsync(query.Id)">@Text["AdminAnalysisQueries.Disable"]</button>
                            </div>
                        </div>
                        @foreach (var workspace in query.Workspaces.OrderBy(item => item.WorkspaceKey))
                        {
                            <div class="cell-secondary">
                                @workspace.WorkspaceKey: @(workspace.Enabled ? workspace.LastValidationStatus : Text["Common.Disabled"])
                                @if (!string.IsNullOrWhiteSpace(workspace.LastValidationMessage))
                                {
                                    <span>· @workspace.LastValidationMessage</span>
                                }
                            </div>
                        }
                    </div>
                </article>
                </QueryContent>
            </AnalysisQueryCategoryTree>
        </div>
    </section>

    <section class="admin-editor" aria-labelledby="analysis-query-editor">
        @if (editing is null)
        {
            <div class="admin-editor-placeholder">
                <strong>@Text["AdminAnalysisQueries.SelectQuery"]</strong>
                <span>@Text["AdminAnalysisQueries.SelectQueryHelp"]</span>
            </div>
        }
        else
        {
            <div class="admin-section-heading">
                <div><p class="eyebrow">@Text["AdminAnalysisQueries.Draft"]</p><h2 id="analysis-query-editor">@QueryText.Name(editing)</h2></div>
            </div>
            <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault @oninput="ClearTestResult">
                <fieldset class="analysis-query-fields" disabled="@ActionsUnavailable">
                <label class="admin-field"><span>@Text["AdminAnalysisQueries.Key"]</span><input required maxlength="128" @bind="editing.Key" /></label>
                <label class="admin-field"><span>@Text["AdminAnalysisQueries.Name"]</span><input required maxlength="256" @bind="editing.Name" /></label>
                <label class="admin-field"><span>@Text["AdminAnalysisQueries.CategoryPath"]</span><input required maxlength="128" list="analysis-category-paths" @bind="editing.Category" />
                    <small>@Text["AdminAnalysisQueries.CategoryPathHelp"]</small>
                </label>
                <datalist id="analysis-category-paths">
                    @foreach (var path in categoryPaths)
                    {
                        <option value="@path"></option>
                    }
                </datalist>
                <label class="admin-field"><span>@Text["AdminAnalysisQueries.Unit"]</span><input maxlength="64" @bind="editing.Unit" /></label>
                <label class="admin-field">
                    <span>@Text["AdminAnalysisQueries.Scope"]</span>
                    <select @bind="editing.Scope">
                        <option value="@AnalysisQueryScopes.SelectedSystems">@Text["AdminAnalysisQueries.ScopeSelectedSystems"]</option>
                        <option value="@AnalysisQueryScopes.Workspace">@Text["AdminAnalysisQueries.ScopeWorkspace"]</option>
                    </select>
                </label>
                @if (editing.Scope == AnalysisQueryScopes.Workspace)
                {
                    <div class="admin-message admin-message-warning admin-field-wide" role="status">
                        @Text["AdminAnalysisQueries.ScopeWorkspaceWarning"]
                    </div>
                }
                <label class="admin-field"><span>@Text["AdminAnalysisQueries.Visualization"]</span>
                    <select @bind:get="editing.VisualizationType" @bind:set="ChangeVisualization">
                        @foreach (var visualization in AnalysisQueryVisualizationTypes.All)
                        {
                            <option value="@visualization">@visualization</option>
                        }
                    </select>
                </label>
                <label class="admin-field admin-field-wide"><span>@Text["AdminAnalysisQueries.EditorDescription"]</span><textarea maxlength="2000" rows="3" @bind="editing.Description"></textarea></label>
                <label class="admin-field admin-field-wide">
                    <span>@Text["AdminAnalysisQueries.VisualizationJson"]</span>
                    <textarea class="analysis-json-editor" rows="12" maxlength="65536" spellcheck="false" wrap="off" @bind="editing.VisualizationJson"></textarea>
                    <small>@Text.Format("AdminAnalysisQueries.VisualizationHelp")</small>
                </label>
                <label class="admin-field"><span>@Text["AdminAnalysisQueries.DefaultRange"]</span><input type="number" min="5" max="43200" @bind="editing.DefaultTimeRangeMinutes" /></label>
                <label class="admin-field"><span>@Text["AdminAnalysisQueries.MaximumRange"]</span><input type="number" min="5" max="43200" @bind="editing.MaxTimeRangeMinutes" /></label>
                <label class="admin-field"><span>@Text["AdminAnalysisQueries.BinSize"]</span><input type="number" min="1" max="1440" @bind="editing.DefaultBinMinutes" /></label>
                <label class="admin-field">
                    <span>@Text["AdminAnalysisQueries.MinimumRole"]</span>
                    <select @bind="editing.MinimumRole">
                        @foreach (var role in SqlAuthenticationRoles.All.Where(role => role != SqlAuthenticationRoles.Reader))
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </label>
                <fieldset class="admin-field admin-field-wide">
                    <legend>@Text["AdminAnalysisQueries.AllowedWorkspaces"]</legend>
                    @foreach (var workspace in editing.Workspaces)
                    {
                        var configured = Options.Workspaces.SingleOrDefault(item =>
                            item.Key.Equals(workspace.WorkspaceKey, StringComparison.OrdinalIgnoreCase));
                        @if (configured is null)
                        {
                            <p role="alert">@Text.Format("AdminAnalysisQueries.UnavailableWorkspace", workspace.WorkspaceKey)</p>
                            <button class="admin-secondary" type="button" disabled="@ActionsUnavailable"
                                    @onclick="() => RemoveUnavailableWorkspace(workspace)">@Text["AdminAnalysisQueries.RemoveUnavailableWorkspace"]</button>
                        }
                        else
                        {
                            <label class="admin-check">
                                <input type="checkbox" @bind="workspace.Enabled" @bind:after="WorkspaceAssignmentsChanged" />
                                <span>@configured.DisplayName (@configured.Key)</span>
                            </label>
                        }
                    }
                    @if (Options.Workspaces.Length == 0)
                    {
                        <small>@Text["AdminAnalysisQueries.NoWorkspaces"]</small>
                    }
                </fieldset>
                <label class="admin-field admin-field-wide">
                    <span>KQL</span>
                    <KqlEditor @bind-Value="editing.Kql" Class="analysis-kql-editor" Required="true" Rows="18"
                               WorkspaceKeys="@editing.Workspaces.Where(workspace => workspace.Enabled).Select(workspace => workspace.WorkspaceKey).ToArray()" />
                    <small>@Text["AdminAnalysisQueries.KqlHelp"]</small>
                </label>
                <div class="admin-form-actions">
                    <button class="admin-secondary" type="button" disabled="@(!CanTest)" @onclick="TestAsync">@(isBusy ? Text["AdminAnalysisQueries.Working"] : Text["AdminAnalysisQueries.TestQuery"])</button>
                </div>
                <fieldset class="admin-field admin-field-wide analysis-query-test">
                    <legend>@Text["AdminAnalysisQueries.TestDraft"]</legend>
                    <p>@Text["AdminAnalysisQueries.TestHelp"]</p>
                    @if (!Options.Enabled)
                    {
                        <div class="admin-message admin-message-warning">@Text["AdminAnalysisQueries.LiveDisabled"]</div>
                    }
                    <label class="admin-field">
                        <span>@Text["AdminAnalysisQueries.TestWorkspace"]</span>
                        <select @bind="testWorkspaceKey" @bind:after="TestWorkspaceChanged">
                            <option value="">@Text["AdminAnalysisQueries.SelectWorkspace"]</option>
                            @foreach (var workspace in Options.Workspaces.Where(item => editing.Workspaces.Any(
                                assignment => assignment.Enabled && assignment.WorkspaceKey == item.Key)))
                            {
                                <option value="@workspace.Key">@workspace.DisplayName (@workspace.Key)</option>
                            }
                        </select>
                    </label>
                    <details class="analysis-system-dropdown">
                        <summary>@Text.Plural("AdminAnalysisQueries.SelectedSystems", testSystemKeys.Count)</summary>
                        <div class="analysis-system-grid">
                            @foreach (var system in TestSystems)
                            {
                                var key = SystemKey(system);
                                <label class="admin-check">
                                    <input type="checkbox" checked="@testSystemKeys.Contains(key)"
                                           disabled="@(!testSystemKeys.Contains(key) && testSystemKeys.Count >= 100)"
                                           @onchange="args => ToggleTestSystem(key, args)" />
                                    <span><strong>@system.Computer</strong><small>@system.Domain · @system.SubscriptionId</small></span>
                                </label>
                            }
                            @if (!TestSystems.Any())
                            {
                                <p>@Text["AdminAnalysisQueries.NoTestSystems"]</p>
                            }
                        </div>
                    </details>
                    <AnalysisExecutionSelections @bind-TimeRangeMinutes="testTimeRangeMinutes" @bind-BinMinutes="testBinMinutes"
                        @bind-GroupBy="testGroupBy" MaxTimeRangeMinutes="editing.MaxTimeRangeMinutes"
                        ShowGrouping="@(editing.Kql.Contains("_GroupBy", StringComparison.Ordinal))" Disabled="@ActionsUnavailable" Changed="ClearTestResult" />
                </fieldset>
                <div class="admin-form-actions">
                    <button class="admin-primary" type="submit" disabled="@ActionsUnavailable">@Text["AdminAnalysisQueries.SaveDraft"]</button>
                    <button class="admin-secondary" type="button" disabled="@isBusy" @onclick="CancelEdit">@Text["Common.Cancel"]</button>
                </div>
                </fieldset>
            </form>
        }
    </section>
    @if (editing is not null)
    {
        <section class="admin-analysis-test-output" aria-labelledby="admin-test-execution">
            <div class="admin-section-heading">
                <div><p class="eyebrow">@Text["AdminAnalysisQueries.Preview"]</p><h2 id="admin-test-execution">@Text["AdminAnalysisQueries.TestExecution"]</h2></div>
            </div>
            @if (testError is not null)
            {
                <div class="admin-message admin-message-error" role="alert">@testError</div>
            }
            @if (testPreview is not null)
            {
                    <h3>@testPreview.WorkspaceDisplayName</h3>
                    <p>@Text.Format("AdminAnalysisQueries.PreviewSystems", string.Join(", ", testPreview.Systems))</p>
                    <article class="analysis-execution-preview-card">
                        <details open><summary>@Text["AdminAnalysisQueries.TestKql"]</summary><pre>@testPreview.EffectiveKql</pre></details>
                    </article>
                    @if (testResult is not null)
                    {
                        <p>@Text.Format("AdminAnalysisQueries.ExecutionSummary", testResult.From.ToString("u"), testResult.To.ToString("u"), testResult.DurationMilliseconds.ToString(CultureInfo.CurrentCulture))</p>
                        <AnalysisResultView Result="testResult" AllowTableView="true" @bind-ShowTable="showTestTable" />
                    }
            }
            else
            {
                <p class="admin-editor-placeholder">@Text["AdminAnalysisQueries.TestEmptyPreview"]</p>
            }
        </section>
    }
</div>

@if (queryToUnpublish is not null)
{
    <section class="admin-message admin-message-warning" role="alertdialog" aria-labelledby="unpublish-query-heading">
        <h2 id="unpublish-query-heading">@Text["AdminAnalysisQueries.WithdrawTitle"]</h2>
        <p><LocalizedEmphasis ResourceKey="AdminAnalysisQueries.WithdrawBody" Value="@QueryText.Name(queryToUnpublish)" /></p>
        <div class="admin-card-actions">
            <button class="admin-secondary" type="button" disabled="@isBusy" @onclick="() => queryToUnpublish = null">@Text["Common.Cancel"]</button>
            <button class="admin-danger" type="button" disabled="@ActionsUnavailable" @onclick="UnpublishAsync">@Text["AdminAnalysisQueries.WithdrawConfirm"]</button>
        </div>
    </section>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private IReadOnlyList<AnalysisQueryDefinition> queries = [];
    private IReadOnlyList<string> categoryPaths = [];
    private IReadOnlyList<AnalysisQueryCategoryNode> RegistryCategories => AnalysisQueryCategories.Build(queries, categoryPaths);
    private string categoryName = string.Empty;
    private string categoryParent = string.Empty;
    private string? categoryToEdit;
    private Guid? draggedQueryId;
    private AnalysisQueryDefinition? editing;
    private AnalysisQueryDefinition? queryToUnpublish;
    private string actor = string.Empty;
    private string? statusMessage;
    private string? errorMessage;
    private string? loadError;
    private bool isBusy;
    private IReadOnlyList<ComputerInventoryEntry> inventory = [];
    private readonly HashSet<string> testSystemKeys = new(StringComparer.OrdinalIgnoreCase);
    private string testWorkspaceKey = string.Empty;
    private int testTimeRangeMinutes = 60;
    private int testBinMinutes = 15;
    private string testGroupBy = "SourceDSA";
    private AnalysisQueryExecutionPreview? testPreview;
    private AnalysisQueryResponse? testResult;
    private string? testError;
    private bool showTestTable;
    private bool registryCollapsed;
    private readonly HashSet<string> bulkWorkspaceKeys = new(StringComparer.OrdinalIgnoreCase);
    private bool bulkIncludeDisabledQueries = true;
    private bool ActionsUnavailable => isBusy || loadError is not null;
    private bool CanTest => Options.Enabled && !ActionsUnavailable && editing is not null &&
        !string.IsNullOrWhiteSpace(testWorkspaceKey) && testSystemKeys.Count > 0;
    private IEnumerable<ComputerInventoryEntry> TestSystems => inventory
        .Where(RoutesToTestWorkspace).OrderBy(item => item.Computer);

    protected override async Task OnInitializedAsync()
    {
        actor = await CurrentUserIdentity.GetActorAsync(
            (await AuthenticationStateTask).User,
            AuthenticationOptions.IsOpen);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (isBusy) return;
        isBusy = true;
        try { await ReloadDataAsync(); }
        finally { isBusy = false; }
    }

    private async Task<bool> ReloadDataAsync()
    {
        try
        {
            var loadedInventory = await AlertStore.GetComputerInventoryAsync();
            var loadedQueries = await Registry.ListAsync();
            var loadedCategories = await Categories.ListAsync();
            inventory = loadedInventory;
            queries = loadedQueries;
            categoryPaths = loadedCategories;
            loadError = null;
            return true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not reload analysis query administration data.");
            loadError = OperationError(exception, "AdminAnalysisQueries.Errors.LoadFailed");
            return false;
        }
    }

    private string CategorySelection(AnalysisQueryDefinition query) =>
        categoryPaths.FirstOrDefault(path => path.Equals(AnalysisQueryCategories.Normalize(query.Category), StringComparison.OrdinalIgnoreCase)) ?? query.Category;

    private void BeginCategoryCreate(string parent = "")
    {
        categoryToEdit = null;
        categoryName = string.Empty;
        categoryParent = parent;
    }

    private void BeginCategoryEdit(string path)
    {
        categoryToEdit = path;
        var separator = path.LastIndexOf('/');
        categoryName = path[(separator + 1)..];
        categoryParent = separator < 0 ? "" : path[..separator];
    }

    private async Task SaveCategoryAsync() => await RunAsync(async () =>
    {
        var syncEditingCategory = editing is not null && queries.Any(query =>
            query.Id == editing.Id && query.Category.Equals(editing.Category, StringComparison.OrdinalIgnoreCase));
        if (categoryToEdit is null)
            await Categories.CreateAsync(categoryName, categoryParent);
        else
            await Categories.UpdateAsync(categoryToEdit, categoryName, categoryParent, actor);
        statusMessage = Text["AdminAnalysisQueries.Status.CategorySaved"];
        BeginCategoryCreate();
        if (await ReloadDataAsync() && syncEditingCategory && editing is not null && queries.FirstOrDefault(query => query.Id == editing.Id) is { } current)
            editing.Category = current.Category;
    }, "AdminAnalysisQueries.Errors.CategorySaveFailed");

    private async Task DeleteCategoryAsync(string path) => await RunAsync(async () =>
    {
        await Categories.DeleteAsync(path);
        if (categoryToEdit == path) BeginCategoryCreate();
        statusMessage = Text["AdminAnalysisQueries.Status.CategoryDeleted"];
        await ReloadDataAsync();
    }, "AdminAnalysisQueries.Errors.CategoryDeleteFailed");

    private async Task MoveQueryAsync(Guid id, string path) => await RunAsync(async () =>
    {
        await Categories.MoveQueryAsync(id, path, actor);
        statusMessage = Text["AdminAnalysisQueries.Status.QueryMoved"];
        if (await ReloadDataAsync() && editing?.Id == id)
            editing.Category = queries.Single(query => query.Id == id).Category;
    }, "AdminAnalysisQueries.Errors.MoveFailed");

    private async Task DropQueryAsync(string path)
    {
        if (ActionsUnavailable) return;
        var id = draggedQueryId;
        draggedQueryId = null;
        if (id is null)
        {
            Logger.LogWarning("An analysis query category drop has no query selection.");
            errorMessage = Text["AdminAnalysisQueries.Errors.DropRequired"];
            return;
        }
        await MoveQueryAsync(id.Value, path);
    }

    private void BeginCreate()
    {
        editing = new AnalysisQueryDefinition
        {
            Name = "New analysis query",
            Category = "Performance",
            Unit = "Percent",
            DefaultBinMinutes = 15,
            MaxTimeRangeMinutes = 43200,
            UpdatedBy = actor,
            Kql = AnalysisQueryTemplates.NewDraftKql,
            VisualizationJson = AnalysisVisualization.TemplateForEditing(AnalysisQueryVisualizationTypes.LineChart),
            Workspaces = Options.Workspaces.Select(workspace => new AnalysisQueryWorkspace
            {
                WorkspaceKey = workspace.Key,
                Enabled = true
            }).ToList()
        };
        ResetTest();
    }

    private Task ImportJsonAsync(string json)
    {
        if (ActionsUnavailable) return Task.CompletedTask;
        return RunAsync(() =>
        {
            QueryTemplateJson.ValidateImport(json);
            var draft = AnalysisQueryTemplates.Parse(json);
            draft.VisualizationJson = AnalysisVisualization.FormatForEditing(draft.VisualizationJson);
            draft.UpdatedBy = actor;
            draft.Workspaces = Options.Workspaces.Select(workspace => new AnalysisQueryWorkspace
            {
                WorkspaceKey = workspace.Key,
                Enabled = true
            }).ToList();
            editing = draft;
            ResetTest();
            statusMessage = Text["AdminAnalysisQueries.Status.ImportOpened"];
            return Task.CompletedTask;
        }, "AdminAnalysisQueries.Errors.ImportFailed");
    }

    private void BeginEdit(AnalysisQueryDefinition query)
    {
        editing = new AnalysisQueryDefinition
        {
            Id = query.Id,
            Key = query.Key,
            Name = query.Name,
            Description = query.Description,
            StandardTextProvenanceJson = query.StandardTextProvenanceJson,
            Category = query.Category,
            Kql = query.Kql,
            Scope = query.Scope,
            VisualizationType = query.VisualizationType,
            VisualizationJson = query.VisualizationJson,
            Unit = query.Unit,
            DefaultTimeRangeMinutes = query.DefaultTimeRangeMinutes,
            MaxTimeRangeMinutes = query.MaxTimeRangeMinutes,
            DefaultBinMinutes = query.DefaultBinMinutes,
            MinimumRole = query.MinimumRole,
            Enabled = query.Enabled,
            Workspaces = Options.Workspaces.Select(workspace => new AnalysisQueryWorkspace
            {
                WorkspaceKey = workspace.Key,
                Enabled = query.Workspaces.Any(item => item.Enabled &&
                    item.WorkspaceKey.Equals(workspace.Key, StringComparison.OrdinalIgnoreCase))
            }).ToList()
        };
        ResetTest();
        FormatVisualizationOptions();
    }

    private void ChangeVisualization(string? visualizationType)
    {
        if (editing is not { } draft)
        {
            Logger.LogWarning("No analysis query draft is selected for changing visualization.");
            errorMessage = Text["AdminAnalysisQueries.Errors.DraftRequired"];
            return;
        }
        if (draft.VisualizationType == visualizationType) return;
        try
        {
            if (visualizationType is null)
                throw new InvalidOperationException("Select a supported analysis visualization type.");
            var template = AnalysisVisualization.TemplateForEditing(visualizationType);
            draft.VisualizationType = visualizationType;
            draft.VisualizationJson = template;
            ClearTestResult();
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogWarning(exception, "Could not load analysis query visualization template.");
            errorMessage = Text["AdminAnalysisQueries.Errors.FormatFailed"];
        }
    }

    private void FormatVisualizationOptions()
    {
        if (editing is not { } draft)
        {
            Logger.LogWarning("No analysis query draft is selected for formatting.");
            errorMessage = Text["AdminAnalysisQueries.Errors.DraftRequired"];
            return;
        }
        try
        {
            draft.VisualizationJson = AnalysisVisualization.FormatForEditing(draft.VisualizationJson);
        }
        catch (Exception exception) when (exception is System.Text.Json.JsonException or InvalidOperationException)
        {
            Logger.LogWarning(exception, "Could not format analysis query visualization options.");
            errorMessage = Text["AdminAnalysisQueries.Errors.FormatFailed"];
        }
    }

    private void CancelEdit()
    {
        editing = null;
        ResetTest();
    }

    private void ResetTest()
    {
        registryCollapsed = editing is not null;
        testWorkspaceKey = editing?.Workspaces.FirstOrDefault(item => item.Enabled)?.WorkspaceKey ?? string.Empty;
        testTimeRangeMinutes = Math.Min(editing?.DefaultTimeRangeMinutes ?? 60, 60);
        testBinMinutes = editing?.DefaultBinMinutes ?? 15;
        testGroupBy = "SourceDSA";
        TestWorkspaceChanged();
        statusMessage = null;
        errorMessage = null;
    }

    private void ClearTestResult()
    {
        testPreview = null;
        testResult = null;
        testError = null;
    }

    private void TestWorkspaceChanged()
    {
        testSystemKeys.Clear();
        ClearTestResult();
    }

    private void RemoveUnavailableWorkspace(AnalysisQueryWorkspace workspace)
    {
        if (ActionsUnavailable) return;
        if (editing is null)
        {
            Logger.LogWarning("No analysis query draft is selected for removing a workspace.");
            errorMessage = Text["AdminAnalysisQueries.Errors.DraftRequired"];
            return;
        }
        if (Options.Workspaces.Any(item => item.Key.Equals(workspace.WorkspaceKey, StringComparison.OrdinalIgnoreCase)) ||
            !editing.Workspaces.Remove(workspace))
        {
            Logger.LogWarning("The unavailable analysis query workspace selection changed.");
            errorMessage = Text["AdminAnalysisQueries.Errors.Changed"];
            return;
        }
        errorMessage = null;
        WorkspaceAssignmentsChanged();
    }

    private void WorkspaceAssignmentsChanged()
    {
        if (editing?.Workspaces.Any(item => item.Enabled && item.WorkspaceKey == testWorkspaceKey) != true)
        {
            testWorkspaceKey = editing?.Workspaces.FirstOrDefault(item => item.Enabled)?.WorkspaceKey ?? string.Empty;
            TestWorkspaceChanged();
        }
        ClearTestResult();
    }

    private bool RoutesToTestWorkspace(ComputerInventoryEntry system)
    {
        try
        {
            return QueryRunner.WorkspaceResolver.Resolve(system.SubscriptionId, system.Domain)
                .Workspace.Key.Equals(testWorkspaceKey, StringComparison.OrdinalIgnoreCase);
        }
        catch (TargetWorkspaceResolutionException) { return false; }
    }

    private static string SystemKey(ComputerInventoryEntry system) => $"{system.SubscriptionId}\u001f{system.Computer}";

    private void ToggleTestSystem(string key, ChangeEventArgs args)
    {
        if (args.Value is true)
            testSystemKeys.Add(key);
        else
            testSystemKeys.Remove(key);
        ClearTestResult();
    }

    private async Task TestAsync() => await RunAsync(async () =>
    {
        ClearTestResult();
        if (editing is not { } draft)
        {
            Logger.LogWarning("No analysis query draft is selected for testing.");
            testError = errorMessage = Text["AdminAnalysisQueries.Errors.DraftRequired"];
            return;
        }
        var systems = TestSystems.Where(system => testSystemKeys.Contains(SystemKey(system))).ToArray();
        try
        {
            testPreview = QueryRunner.CreateDraftExecutionPreview(draft, testWorkspaceKey, systems, testTimeRangeMinutes, testBinMinutes, testGroupBy);
            testResult = await Registry.TestDraftAsync(draft, testWorkspaceKey,
                systems.Select(system => new AnalysisQuerySystem(system.SubscriptionId, system.Computer)).ToArray(),
                testTimeRangeMinutes, binMinutes: testBinMinutes, groupBy: testGroupBy);
        }
        catch (Exception exception)
        {
            testError = OperationError(exception, "AdminAnalysisQueries.Errors.TestFailed");
            throw;
        }
        statusMessage = Text["AdminAnalysisQueries.Status.TestCompleted"];
    }, "AdminAnalysisQueries.Errors.TestFailed");

    private async Task SaveAsync() => await RunAsync(async () =>
    {
        if (editing is null)
        {
            Logger.LogWarning("No analysis query draft is selected for saving.");
            errorMessage = Text["AdminAnalysisQueries.Errors.DraftRequired"];
            return;
        }
        editing = await Registry.SaveDraftAsync(editing, actor);
        FormatVisualizationOptions();
        statusMessage = Text["AdminAnalysisQueries.Status.DraftSaved"];
        await ReloadDataAsync();
    }, "AdminAnalysisQueries.Errors.SaveFailed");

    private async Task InstallAdLibraryAsync() => await RunAsync(async () =>
    {
        var added = await Registry.InstallActiveDirectoryLibraryAsync(actor);
        statusMessage = Text.Plural("AdminAnalysisQueries.Status.LibraryAdded", added);
        await ReloadDataAsync();
    }, "AdminAnalysisQueries.Errors.InstallFailed");

    private void ToggleBulkWorkspace(string key, ChangeEventArgs args)
    {
        if (args.Value is true) bulkWorkspaceKeys.Add(key);
        else bulkWorkspaceKeys.Remove(key);
    }

    private async Task AssignWorkspacesToAllAsync() => await RunAsync(async () =>
    {
        if (editing is not null)
        {
            Logger.LogWarning("Bulk analysis workspace assignment requires a closed editor.");
            errorMessage = Text["AdminAnalysisQueries.Errors.CloseEditor"];
            return;
        }
        var result = await Registry.EnableWorkspacesForAllAsync(bulkWorkspaceKeys, bulkIncludeDisabledQueries, actor);
        statusMessage = Text.Format("AdminAnalysisQueries.Status.BulkApplied", result.UpdatedQueries, result.EnabledAssignments, result.ReactivatedQueries);
        await ReloadDataAsync();
    }, "AdminAnalysisQueries.Errors.BulkFailed");

    private async Task ValidateAsync(Guid id) => await RunAsync(async () =>
    {
        var result = await Registry.ValidateAsync(id, actor);
        if (result.Status == AnalysisQueryStatuses.Validated)
            statusMessage = Text["AdminAnalysisQueries.Status.Validated"];
        else
        {
            Logger.LogWarning("Analysis query {QueryId} validation results were saved without successful validation.", id);
            statusMessage = Text["AdminAnalysisQueries.Status.ValidationResultsSaved"];
            errorMessage = Text["AdminAnalysisQueries.Errors.ValidationRejected"];
        }
        await ReloadDataAsync();
    }, "AdminAnalysisQueries.Errors.ValidateFailed");

    private async Task PublishAsync(Guid id) => await RunAsync(async () =>
    {
        await Registry.PublishAsync(id, actor);
        statusMessage = Text["AdminAnalysisQueries.Status.Published"];
        await ReloadDataAsync();
    }, "AdminAnalysisQueries.Errors.PublishFailed");

    private async Task UnpublishAsync() => await RunAsync(async () =>
    {
        if (queryToUnpublish is not { } query)
        {
            Logger.LogWarning("No analysis query is selected for withdrawal.");
            errorMessage = Text["AdminAnalysisQueries.Errors.WithdrawRequired"];
            return;
        }
        await Registry.UnpublishAsync(query.Id, actor);
        queryToUnpublish = null;
        statusMessage = Text["AdminAnalysisQueries.Status.Withdrawn"];
        await ReloadDataAsync();
    }, "AdminAnalysisQueries.Errors.WithdrawFailed");

    private async Task DisableAsync(Guid id) => await RunAsync(async () =>
    {
        await Registry.DisableAsync(id, actor);
        statusMessage = Text["AdminAnalysisQueries.Status.Disabled"];
        await ReloadDataAsync();
    }, "AdminAnalysisQueries.Errors.DisableFailed");

    private async Task RunAsync(Func<Task> action, string fallbackKey)
    {
        if (ActionsUnavailable) return;
        isBusy = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            if (CurrentUserIdentity.DirectoryEnabled)
                actor = await CurrentUserIdentity.GetActorAsync(
                    (await AuthenticationStateTask).User, AuthenticationOptions.IsOpen);
            await action();
        }
        catch (Exception exception)
        {
            if (exception is QueryTemplateValidationException or AnalysisQueryValidationException or AnalysisValidationException or UnauthorizedAccessException or DbUpdateConcurrencyException)
                Logger.LogWarning(exception, "Analysis query administration operation {Operation} failed.", fallbackKey);
            else
                Logger.LogError(exception, "Analysis query administration operation {Operation} failed.", fallbackKey);
            errorMessage = OperationError(exception, fallbackKey);
        }
        finally { isBusy = false; }
    }

    private string OperationError(Exception exception, string fallbackKey) => exception switch
    {
        UnauthorizedAccessException => Text["AdminAnalysisQueries.Errors.NotAllowed"],
        DbUpdateConcurrencyException => Text["AdminAnalysisQueries.Errors.Changed"],
        _ => AnalysisErrorPresentation.Message(exception, Text, fallbackKey)
    };
}
