@inject UiText Text

<section class="analysis-controls" aria-label="@Text["AnalysisExecution.Label"]">
    <label class="admin-field">
        <span>@Text["AnalysisExecution.TimeRange"]</span>
        <select @bind:get="TimeRangeMinutes" @bind:set="ChangeTimeRangeAsync" disabled="@Disabled">
            <option value="">@Text["AnalysisExecution.UseWidgetSettings"]</option>
            @foreach (var minutes in AnalysisQuerySelections.TimeRanges)
            {
                <option value="@minutes">@AnalysisSelectionLabels.TimeRange(Text, minutes)</option>
            }
        </select>
    </label>
    <label class="admin-field">
        <span>@Text["AnalysisExecution.AveragingInterval"]</span>
        <select @bind:get="BinMinutes" @bind:set="ChangeBinAsync" disabled="@Disabled">
            <option value="">@Text["AnalysisExecution.UseWidgetSettings"]</option>
            @foreach (var minutes in AnalysisQuerySelections.BinSizes)
            {
                <option value="@minutes">@(minutes == 60 ? "1h" : $"{minutes} min")</option>
            }
        </select>
    </label>
    <p>@Text["AnalysisExecution.Help"]</p>
    @if (SessionOnly)
    {
        <p>@Text["AnalysisExecution.SessionHelp"]</p>
    }
</section>

@code {
    [Parameter] public int? TimeRangeMinutes { get; set; }
    [Parameter] public int? BinMinutes { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool SessionOnly { get; set; }
    [Parameter] public EventCallback<(int? TimeRangeMinutes, int? BinMinutes)> Changed { get; set; }

    private Task ChangeTimeRangeAsync(int? minutes) => Disabled ? Task.CompletedTask : Changed.InvokeAsync((minutes, BinMinutes));
    private Task ChangeBinAsync(int? minutes) => Disabled ? Task.CompletedTask : Changed.InvokeAsync((TimeRangeMinutes, minutes));
}
