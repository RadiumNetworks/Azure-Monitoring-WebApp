@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AlertStore AlertStore
@inject AlertHistoryOptions AlertHistory
@inject AlertSeverityDisplayOptions AlertSeverityDisplay
@inject InboxTargetOutputDisplayOptions TargetOutputDisplay
@inject AlertRuleEvaluator AlertRuleEvaluator
@inject ApplicationAuthenticationOptions ApplicationAuthentication
@inject CurrentUserIdentity CurrentUserIdentity
@inject QueryResultPresenter QueryResultPresenter
@inject InboxDashboardState Dashboard
@inject InboxLayoutRepository InboxLayoutRepository
@inject IJSRuntime JS

<PageTitle>Alert Console</PageTitle>

<section class="page-heading">
    <div class="heading-copy">
        <p class="eyebrow">Operations</p>
        <h1>Alert inbox</h1>
        <p class="subtitle">Incoming Azure Monitor notifications, in one live view.</p>
        <div class="current-time" aria-label="Current time in @SelectedTimeZone.Label">
            <span>Current time</span>
            <time datetime="@currentTimeUtc.ToString("O")">@FormatCurrentTime()</time>
            <small>@SelectedTimeZone.Label (@FormatUtcOffset())</small>
        </div>
    </div>
    <div class="alert-count" aria-label="@RecentAlertCount alerts received in the last @HistoryWindowLabel">
        <strong>@RecentAlertCount</strong>
        <span>received / @HistoryWindowLabel</span>
    </div>
</section>

<details class="inbox-designer-panel">
    <summary>
        <span class="inbox-designer-icon" aria-hidden="true">◇</span>
        <span><strong>Designer</strong><small>Workspace controls and elements</small></span>
        <span class="inbox-designer-action">Open workspace controls <i aria-hidden="true">⌄</i></span>
    </summary>
    <section class="inbox-command-bar inbox-designer-commands" aria-label="Inbox workspace commands">
        <label class="inbox-edit-toggle">
            <input type="checkbox" @bind="isDashboardEditEnabled" @bind:after="DashboardEditModeChanged" />
            <span>Edit</span>
        </label>
        <button type="button" @onclick="UndoDashboardAsync" disabled="@(!isDashboardEditEnabled || !Dashboard.CanUndo)">↶ Undo</button>
        <button type="button" @onclick="RedoDashboardAsync" disabled="@(!isDashboardEditEnabled || !Dashboard.CanRedo)">↷ Redo</button>
        <button type="button" @onclick="ToggleDashboardGridAsync">@(Dashboard.Document.ShowGrid ? "Hide grid" : "Show grid")</button>
        <button class="danger" type="button" @onclick="ResetDashboardAsync" disabled="@(!isDashboardEditEnabled)">Reset</button>
        <span class="inbox-command-spacer"></span>
        <label class="inbox-grid-setting">
            <span>Rows</span>
            <input type="number" min="8" max="40" step="1" value="@Dashboard.Document.Rows" @onchange="ChangeDashboardRowsAsync" disabled="@(!isDashboardEditEnabled)" title="The minimum adjusts to the space required by the current sections." />
        </label>
        <label class="inbox-grid-setting inbox-row-size-setting">
            <span>Row size</span>
            <input type="range" min="64" max="132" step="4" value="@Dashboard.Document.RowHeight" @onchange="ChangeDashboardRowHeightAsync" disabled="@(!isDashboardEditEnabled)" />
            <output>@Dashboard.Document.RowHeight px</output>
        </label>
        <span class="inbox-save-status" role="status"><i></i>@dashboardStatus</span>
    </section>
    <div class="inbox-designer-tools">
        <div class="inbox-elements-only" aria-label="Inbox elements">
            <div class="inbox-widget-palette">
                @foreach (var template in InboxDashboardCatalog.Widgets)
                {
                    var isPresent = GetWidget(template.Kind) is not null;
                    <button type="button" class="inbox-element-button @(isPresent ? "present" : null)"
                            disabled="@(!isDashboardEditEnabled || isPresent)" @onclick="() => AddDashboardWidgetAsync(template.Kind)"
                            title="@(isPresent ? $"{template.Name} is already visible" : $"Add {template.Name}")">
                        <span>@template.Icon</span>
                        <strong>@template.Name</strong>
                        <b aria-hidden="true">@(isPresent ? "✓" : "+")</b>
                    </button>
                }
            </div>
        </div>
    </div>
</details>

@{
    var dashboardLayout = InboxDashboardCatalog.GetLayout(Dashboard.Document.Layout);
}
<section class="inbox-dashboard-canvas" aria-label="Adjustable alert inbox" @ref="dashboardRoot">
    <div class="inbox-dashboard-grid @(Dashboard.Document.ShowGrid ? "show-grid" : null)" data-inbox-dashboard-grid
         data-columns="@dashboardLayout.Columns" data-rows="@Dashboard.Document.Rows" data-row-height="@Dashboard.Document.RowHeight"
         style="--columns:@dashboardLayout.Columns;--rows:@Dashboard.Document.Rows;--row-height:@(Dashboard.Document.RowHeight)px">
        @for (var row = 1; row <= Dashboard.Document.Rows; row++)
        {
            @for (var column = 1; column <= dashboardLayout.Columns; column++)
            {
                var dropRow = row;
                var dropColumn = column;
                <div class="inbox-drop-cell @(dashboardDropTarget == (dropColumn, dropRow) ? "drop-target" : null)"
                     style="grid-column:@dropColumn;grid-row:@dropRow"
                     @ondragenter="() => dashboardDropTarget = (dropColumn, dropRow)"
                     @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(dropColumn, dropRow)">
                    <span>@dropColumn.@dropRow</span>
                </div>
            }
        }

    @if (GetWidget(InboxWidgetKind.Trends) is { } trendsWidget)
    {
        <article class="inbox-dashboard-widget accent-@trendsWidget.Accent @(isDashboardEditEnabled ? "edit-enabled" : null) @(selectedDashboardWidgetId == trendsWidget.Id ? "selected" : null)"
                 data-inbox-widget-id="@trendsWidget.Id" data-column-span="@trendsWidget.ColumnSpan" data-row-span="@trendsWidget.RowSpan"
                  draggable="false" style="@DashboardWidgetStyle(trendsWidget)" @onclick="() => SelectDashboardWidget(trendsWidget.Id)"
                 @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(trendsWidget.Column, trendsWidget.Row)"
                  >
                            <header class="inbox-widget-header"><span data-inbox-drag-handle="@(isDashboardEditEnabled ? string.Empty : null)" title="Drag to move">⠿</span><div><strong>@trendsWidget.Title</strong><small>Live time series</small></div><button class="inbox-widget-menu" type="button" @onclick="() => SelectDashboardWidget(trendsWidget.Id)" @onclick:stopPropagation="true">•••</button></header>
                        @if (isDashboardEditEnabled && selectedDashboardWidgetId == trendsWidget.Id)
            {
                <InboxWidgetActions Widget="trendsWidget" OnAction="action => HandleDashboardWidgetActionAsync(trendsWidget.Id, action)" />
            }
            <div class="inbox-widget-body">
    @{
        var hourlyCounts = GetHourlyAlertCounts();
        var maximumHourlyCount = hourlyCounts.Max(bucket => bucket.Count);
        var chartScaleMaximum = Math.Max(1, maximumHourlyCount);
        var criticalHourlyCounts = GetHourlyCriticalAlertCounts();
        var maximumCriticalHourlyCount = criticalHourlyCounts.Max(bucket => bucket.Count);
        var criticalChartScaleMaximum = Math.Max(1, maximumCriticalHourlyCount);
        var chartTickIndexes = GetChartTickIndexes(hourlyCounts.Count);
    }
    <div class="trend-stack">
        <div class="alert-trend" role="img" aria-label="@ChartDescription(hourlyCounts)">
            <div class="trend-heading">
                <strong>Alerts per hour</strong>
                <span>Last 48 hours / @SelectedTimeZone.Label</span>
            </div>
            <div class="chart-frame">
                <span class="chart-maximum">@maximumHourlyCount</span>
                <svg viewBox="0 0 640 120" preserveAspectRatio="none" aria-hidden="true">
                    <line class="chart-grid-line" x1="0" y1="10" x2="640" y2="10" />
                    <line class="chart-grid-line" x1="0" y1="60" x2="640" y2="60" />
                    <line class="chart-grid-line" x1="0" y1="110" x2="640" y2="110" />
                    @foreach (var tickIndex in chartTickIndexes)
                    {
                        var x = ChartCoordinate(ChartX(tickIndex, hourlyCounts.Count));
                        <line class="chart-grid-line chart-grid-line-time" x1="@x" y1="10" x2="@x" y2="110" />
                    }
                    <polyline class="chart-line" points="@ChartPoints(hourlyCounts, chartScaleMaximum)" />
                </svg>
            </div>
            <div class="chart-axis" aria-hidden="true">
                @foreach (var tickIndex in chartTickIndexes)
                {
                    <span style="@ChartTickStyle(tickIndex, hourlyCounts.Count)">@FormatChartTime(hourlyCounts[tickIndex].Hour)</span>
                }
            </div>
        </div>
        <div class="alert-trend critical-alert-trend" role="img" aria-label="@CriticalChartDescription(criticalHourlyCounts)">
            <div class="trend-heading">
                <strong>Active critical alerts</strong>
                <span>Last 48 hours / @SelectedTimeZone.Label</span>
            </div>
            <div class="chart-frame">
                <span class="chart-maximum">@maximumCriticalHourlyCount</span>
                <svg viewBox="0 0 640 120" preserveAspectRatio="none" aria-hidden="true">
                    <line class="chart-grid-line" x1="0" y1="10" x2="640" y2="10" />
                    <line class="chart-grid-line" x1="0" y1="60" x2="640" y2="60" />
                    <line class="chart-grid-line" x1="0" y1="110" x2="640" y2="110" />
                    @foreach (var tickIndex in chartTickIndexes)
                    {
                        var x = ChartCoordinate(ChartX(tickIndex, criticalHourlyCounts.Count));
                        <line class="chart-grid-line chart-grid-line-time" x1="@x" y1="10" x2="@x" y2="110" />
                    }
                    <polyline class="chart-line chart-line-critical" points="@CriticalChartPoints(criticalHourlyCounts, criticalChartScaleMaximum)" />
                </svg>
            </div>
            <div class="chart-axis" aria-hidden="true">
                @foreach (var tickIndex in chartTickIndexes)
                {
                    <span style="@ChartTickStyle(tickIndex, criticalHourlyCounts.Count)">@FormatChartTime(criticalHourlyCounts[tickIndex].Hour)</span>
                }
            </div>
        </div>
    </div>
            </div>
            <button class="inbox-resize-handle" data-inbox-resize-handle="@(isDashboardEditEnabled ? string.Empty : null)" draggable="false" title="Drag to resize @trendsWidget.Title" aria-label="Resize @trendsWidget.Title"></button>
        </article>
    }

    @if (GetWidget(InboxWidgetKind.Filters) is { } filtersWidget)
    {
        <article class="inbox-dashboard-widget accent-@filtersWidget.Accent @(isDashboardEditEnabled ? "edit-enabled" : null) @(selectedDashboardWidgetId == filtersWidget.Id ? "selected" : null)"
                 data-inbox-widget-id="@filtersWidget.Id" data-column-span="@filtersWidget.ColumnSpan" data-row-span="@filtersWidget.RowSpan"
                  draggable="false" style="@DashboardWidgetStyle(filtersWidget)" @onclick="() => SelectDashboardWidget(filtersWidget.Id)"
                 @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(filtersWidget.Column, filtersWidget.Row)"
                  >
                            <header class="inbox-widget-header"><span data-inbox-drag-handle="@(isDashboardEditEnabled ? string.Empty : null)" title="Drag to move">⠿</span><div><strong>@filtersWidget.Title</strong><small>Query controls</small></div><button class="inbox-widget-menu" type="button" @onclick="() => SelectDashboardWidget(filtersWidget.Id)" @onclick:stopPropagation="true">•••</button></header>
                        @if (isDashboardEditEnabled && selectedDashboardWidgetId == filtersWidget.Id)
            {
                <InboxWidgetActions Widget="filtersWidget" OnAction="action => HandleDashboardWidgetActionAsync(filtersWidget.Id, action)" />
            }
            <div class="inbox-widget-body inbox-filter-body">
<section class="controls" aria-label="Alert filters">
    <label>
        <span>View</span>
        <select @bind="viewMode" @bind:after="ResetPagination">
            <option value="active">Active alerts</option>
            <option value="history">Full history</option>
        </select>
    </label>
    <label class="search-field">
        <span>Search alerts</span>
        <input type="search" @bind="searchText" @bind:event="oninput" @bind:after="ResetPagination" placeholder="Rule, target, search query..." />
    </label>
    <label>
        <span>Time zone</span>
        <select value="@selectedTimeZoneId" @onchange="ChangeTimeZone">
            @foreach (var timeZone in AlertTimeZones.Options)
            {
                <option value="@timeZone.Id">@timeZone.Label</option>
            }
        </select>
    </label>
    <label>
        <span>Received from</span>
        <input type="datetime-local" value="@receivedFromInput" @onchange="ChangeReceivedFrom" @onfocus="BeginDateTimeEdit" @onblur="EndDateTimeEdit" />
    </label>
    <label>
        <span>Received to</span>
        <input type="datetime-local" value="@receivedToInput" @onchange="ChangeReceivedTo" @onfocus="BeginDateTimeEdit" @onblur="EndDateTimeEdit" />
    </label>
    <button class="clear-filters" type="button" disabled="@(!HasFilters)" @onclick="ClearFilters">Clear filters</button>
</section>
            </div>
            <button class="inbox-resize-handle" data-inbox-resize-handle="@(isDashboardEditEnabled ? string.Empty : null)" draggable="false" title="Drag to resize @filtersWidget.Title" aria-label="Resize @filtersWidget.Title"></button>
        </article>
    }

@{
    var navigationTree = GetNavigationTree();
    var knownSystemCount = navigationTree.Sum(domain => domain.Roles.Sum(role => role.Targets.Count));
    var filteredAlerts = FilteredAlerts.ToArray();
    var pageCount = Math.Max(1, (int)Math.Ceiling(filteredAlerts.Length / (double)PageSize));
    currentPage = Math.Clamp(currentPage, 1, pageCount);
    var visibleAlerts = filteredAlerts
        .Skip((currentPage - 1) * PageSize)
        .Take(PageSize)
        .ToArray();
    var categorizedAlerts = viewMode == "active"
        ? AlertRuleEvaluator.Categorize(visibleAlerts, alertRules, InboxInventory, ActiveAlerts)
        : new AlertCategorizationResult([], visibleAlerts);
    var displayItems = InboxCategories.BuildItems(categorizedAlerts, visibleAlerts, categoryState);
    var heatmapCells = GetHeatmapCells(filteredAlerts);
}
    @if (GetWidget(InboxWidgetKind.Navigation) is { } navigationWidget)
    {
        <article class="inbox-dashboard-widget accent-@navigationWidget.Accent @(isDashboardEditEnabled ? "edit-enabled" : null) @(selectedDashboardWidgetId == navigationWidget.Id ? "selected" : null)"
                 data-inbox-widget-id="@navigationWidget.Id" data-column-span="@navigationWidget.ColumnSpan" data-row-span="@navigationWidget.RowSpan"
                  draggable="false" style="@DashboardWidgetStyle(navigationWidget)" @onclick="() => SelectDashboardWidget(navigationWidget.Id)"
                 @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(navigationWidget.Column, navigationWidget.Row)"
                  >
                            <header class="inbox-widget-header"><span data-inbox-drag-handle="@(isDashboardEditEnabled ? string.Empty : null)" title="Drag to move">⠿</span><div><strong>@navigationWidget.Title</strong><small>Hierarchy filter</small></div><button class="inbox-widget-menu" type="button" @onclick="() => SelectDashboardWidget(navigationWidget.Id)" @onclick:stopPropagation="true">•••</button></header>
                        @if (isDashboardEditEnabled && selectedDashboardWidgetId == navigationWidget.Id)
            {
                <InboxWidgetActions Widget="navigationWidget" OnAction="action => HandleDashboardWidgetActionAsync(navigationWidget.Id, action)" />
            }
            <div class="inbox-widget-body">
<nav class="alert-navigation" aria-label="Alert history by domain, role, and target">
    <div class="tree-heading">
        <div>
            <strong>Alert navigation</strong>
            <span>Inventory systems / active alert counts</span>
        </div>
        <span class="tree-total">@knownSystemCount systems / @navigationTree.Sum(domain => domain.Count) open</span>
    </div>
    <div class="tree-root">
        <button type="button" class="tree-node tree-node-root @(IsTreeSelection(string.Empty, string.Empty, string.Empty) ? "selected" : null)" @onclick="() => SelectTreeNode()">
            <span>All domains</span>
            <span class="tree-count" style="@TreeCountStyle(navigationTree.Sum(domain => domain.Count))">@navigationTree.Sum(domain => domain.Count)</span>
        </button>
        @foreach (var domain in navigationTree)
        {
            var domainExpanded = expandedDomains.Contains(domain.Name);
            <div class="tree-branch">
                <div class="tree-row tree-level-1">
                    <button type="button" class="tree-toggle" title="@(domainExpanded ? "Collapse domain" : "Expand domain")" aria-label="@(domainExpanded ? "Collapse domain" : "Expand domain")" aria-expanded="@domainExpanded" @onclick="() => ToggleDomain(domain.Name)">
                        <span aria-hidden="true"></span>
                    </button>
                    <button type="button" class="tree-node @(IsTreeSelection(domain.Name, string.Empty, string.Empty) ? "selected" : null)" @onclick="() => SelectTreeNode(domain.Name)">
                        <span title="@domain.Name">@Display(domain.Name)</span>
                        <span class="tree-count" style="@TreeCountStyle(domain.Count)">@domain.Count</span>
                    </button>
                </div>
                @if (domainExpanded)
                {
                    @foreach (var role in domain.Roles)
                    {
                        var roleKey = TreeKey(domain.Name, role.Name);
                        var roleExpanded = expandedRoles.Contains(roleKey);
                        <div class="tree-branch">
                            <div class="tree-row tree-level-2">
                                <button type="button" class="tree-toggle" title="@(roleExpanded ? "Collapse role" : "Expand role")" aria-label="@(roleExpanded ? "Collapse role" : "Expand role")" aria-expanded="@roleExpanded" @onclick="() => ToggleRole(roleKey)">
                                    <span aria-hidden="true"></span>
                                </button>
                                <button type="button" class="tree-node @(IsTreeSelection(domain.Name, role.Name, string.Empty) ? "selected" : null)" @onclick="() => SelectTreeNode(domain.Name, role.Name)">
                                    <span title="@role.Name">@Display(role.Name)</span>
                                    <span class="tree-count" style="@TreeCountStyle(role.Count)">@role.Count</span>
                                </button>
                            </div>
                            @if (roleExpanded)
                            {
                                @foreach (var target in role.Targets)
                                {
                                    <div class="tree-row tree-level-3">
                                        <span class="tree-leaf-marker" aria-hidden="true"></span>
                                        <button type="button" class="tree-node @(IsTreeSelection(domain.Name, role.Name, target.Name) ? "selected" : null)" @onclick="() => SelectTreeNode(domain.Name, role.Name, target.Name)">
                                            <span title="@target.DisplayName">@Display(target.DisplayName)</span>
                                            <span class="tree-count" style="@TreeCountStyle(target.Count)">@target.Count</span>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</nav>
            </div>
            <button class="inbox-resize-handle" data-inbox-resize-handle="@(isDashboardEditEnabled ? string.Empty : null)" draggable="false" title="Drag to resize @navigationWidget.Title" aria-label="Resize @navigationWidget.Title"></button>
        </article>
    }
    @if (GetWidget(InboxWidgetKind.Heatmap) is { } heatmapWidget)
    {
        <article class="inbox-dashboard-widget accent-@heatmapWidget.Accent @(isDashboardEditEnabled ? "edit-enabled" : null) @(selectedDashboardWidgetId == heatmapWidget.Id ? "selected" : null)"
                 data-inbox-widget-id="@heatmapWidget.Id" data-column-span="@heatmapWidget.ColumnSpan" data-row-span="@heatmapWidget.RowSpan"
                  draggable="false" style="@DashboardWidgetStyle(heatmapWidget)" @onclick="() => SelectDashboardWidget(heatmapWidget.Id)"
                 @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(heatmapWidget.Column, heatmapWidget.Row)"
                  >
                            <header class="inbox-widget-header"><span data-inbox-drag-handle="@(isDashboardEditEnabled ? string.Empty : null)" title="Drag to move">⠿</span><div><strong>@heatmapWidget.Title</strong><small>Target status</small></div><button class="inbox-widget-menu" type="button" @onclick="() => SelectDashboardWidget(heatmapWidget.Id)" @onclick:stopPropagation="true">•••</button></header>
                        @if (isDashboardEditEnabled && selectedDashboardWidgetId == heatmapWidget.Id)
            {
                <InboxWidgetActions Widget="heatmapWidget" OnAction="action => HandleDashboardWidgetActionAsync(heatmapWidget.Id, action)" />
            }
            <div class="inbox-widget-body">
<section class="alert-heatmap" aria-labelledby="heatmap-title">
    <div class="heatmap-heading">
        <div>
            <strong id="heatmap-title">@(TargetOutputDisplay.ShowDomain ? "Visible targets, domains and sites" : "Visible targets and sites")</strong>
            <span>Configured alert scale; suppressed alerts do not raise the color.</span>
        </div>
        @if (heatmapCells.Count > 0)
        {
            <div class="heatmap-legend" aria-label="@TargetOutputLegendDescription">
                @foreach (var entry in TargetOutputDisplay.Legend())
                {
                    <i style="background:hsl(var(--heat-hue) var(--heat-saturation) var(--heat-lightness));@InboxTargetOutputDisplayOptions.ColorStyle(entry.Color)"></i><span>@entry.Label</span>
                }
                <i class="heatmap-legend-missing-heartbeat"></i><span>Missing heartbeat</span>
            </div>
        }
    </div>
    @if (heatmapCells.Count == 0)
    {
        <p class="heatmap-empty">No targets match the current view and filters.</p>
    }
    else
    {
        <div class="heatmap-grid">
            @foreach (var cell in heatmapCells)
            {
                <div class="@TargetOutputDisplay.CssClass(cell)" style="@TargetOutputDisplay.Style(cell)" title="@HeatmapCellDescription(cell)" aria-label="@HeatmapCellDescription(cell)">
                    <strong>@cell.Count</strong>
                    <span class="heatmap-target">@cell.Target</span>
                    @if (TargetOutputDisplay.ShowDomain)
                    {
                        <span class="heatmap-domain">@cell.Domain</span>
                    }
                    <span class="heatmap-site">@cell.Site</span>
                    @if (cell.HasServiceHealthAlert && cell.Count == 0)
                    {
                        <span class="heatmap-heartbeat-status">Service health alert</span>
                    }
                    else if (cell.MissingHeartbeat)
                    {
                        <span class="heatmap-heartbeat-status">Missing heartbeat</span>
                    }
                </div>
            }
        </div>
    }
</section>
            </div>
            <button class="inbox-resize-handle" data-inbox-resize-handle="@(isDashboardEditEnabled ? string.Empty : null)" draggable="false" title="Drag to resize @heatmapWidget.Title" aria-label="Resize @heatmapWidget.Title"></button>
        </article>
    }

@if (!IsTimeRangeValid)
{
    <p class="filter-error" role="alert">“Received from” must be earlier than “Received to”.</p>
}

    @if (GetWidget(InboxWidgetKind.Results) is { } resultsWidget)
    {
        <article class="inbox-dashboard-widget inbox-results-widget accent-@resultsWidget.Accent @(isDashboardEditEnabled ? "edit-enabled" : null) @(selectedDashboardWidgetId == resultsWidget.Id ? "selected" : null)"
                 data-inbox-widget-id="@resultsWidget.Id" data-column-span="@resultsWidget.ColumnSpan" data-row-span="@resultsWidget.RowSpan"
                  draggable="false" style="@DashboardWidgetStyle(resultsWidget)" @onclick="() => SelectDashboardWidget(resultsWidget.Id)"
                 @ondragover:preventDefault="true" @ondrop="() => DropDashboardWidgetAsync(resultsWidget.Column, resultsWidget.Row)"
                  >
                            <header class="inbox-widget-header"><span data-inbox-drag-handle="@(isDashboardEditEnabled ? string.Empty : null)" title="Drag to move">⠿</span><div><strong>@resultsWidget.Title</strong><small>Alert queue</small></div><button class="inbox-widget-menu" type="button" @onclick="() => SelectDashboardWidget(resultsWidget.Id)" @onclick:stopPropagation="true">•••</button></header>
                        @if (isDashboardEditEnabled && selectedDashboardWidgetId == resultsWidget.Id)
            {
                <InboxWidgetActions Widget="resultsWidget" OnAction="action => HandleDashboardWidgetActionAsync(resultsWidget.Id, action)" />
            }
            <div class="inbox-widget-body">
<section class="table-region" aria-live="polite">
    <div class="result-summary">
        Showing @PageRangeLabel(filteredAlerts.Length) of @filteredAlerts.Length matching alerts
        (@ViewAlerts.Count() total)
    </div>
    <div class="table-scrollbar" aria-hidden="true"><div></div></div>
    <div class="table-scroll">
        <table class="alert-table">
            <colgroup>
                <col class="column-received" />
                <col class="column-alert" />
                <col class="column-target" />
                <col class="column-query" />
                <col class="column-search-result" />
                <col class="column-comments" />
                <col class="column-results" />
            </colgroup>
            <thead>
                <tr>
                    <th><button type="button" @onclick="() => SortBy(nameof(AlertRecord.ReceivedAt))">Received <span class="column-zone">@SelectedTimeZone.Label</span> @SortIndicator(nameof(AlertRecord.ReceivedAt))</button></th>
                    <th class="resizable-column"><button type="button" @onclick="() => SortBy(nameof(AlertRecord.Name))">Alert @SortIndicator(nameof(AlertRecord.Name))</button><span class="column-resizer" role="separator" aria-orientation="vertical" aria-label="Resize Alert column" aria-valuemin="140" aria-valuenow="190" tabindex="0" data-column-index="1" data-column-key="alert" data-min-width="140"></span></th>
                    <th class="resizable-column"><button type="button" @onclick="() => SortBy(nameof(AlertRecord.TargetName))">Target name @SortIndicator(nameof(AlertRecord.TargetName))</button><span class="column-resizer" role="separator" aria-orientation="vertical" aria-label="Resize Target name column" aria-valuemin="120" aria-valuenow="150" tabindex="0" data-column-index="2" data-column-key="target" data-min-width="120"></span></th>
                    <th class="resizable-column">Search query<span class="column-resizer" role="separator" aria-orientation="vertical" aria-label="Resize Search Query column" aria-valuemin="220" aria-valuenow="340" tabindex="0" data-column-index="3" data-column-key="query" data-min-width="220"></span></th>
                    <th class="resizable-column">Search Result<span class="column-resizer" role="separator" aria-orientation="vertical" aria-label="Resize Search Result column" aria-valuemin="240" aria-valuenow="320" tabindex="0" data-column-index="4" data-column-key="search-result" data-min-width="240"></span></th>
                    <th>Comments</th>
                    <th>Log Analytics dashboard</th>
                </tr>
            </thead>
            <tbody>
                @if (filteredAlerts.Length == 0)
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            <strong>@(alerts.Count == 0 ? "Waiting for the first alert" : "No alerts match these filters")</strong>
                            <span>@(alerts.Count == 0 ? "POST an Azure Monitor payload to /api/alerts." : "Adjust the search or filter values.")</span>
                        </td>
                    </tr>
                }
                @foreach (var item in displayItems)
                {
                    @if (item.IsUncategorizedHeader)
                    {
                        <tr class="alert-uncategorized-row">
                            <td colspan="7">
                                <strong>Uncategorized alerts</strong>
                                <span>@AlertCountLabel(categorizedAlerts.Uncategorized.Count)</span>
                            </td>
                        </tr>
                        continue;
                    }

                    @if (item.Category is { } category)
                    {
                        var isCollapsed = categoryState.IsCollapsed(category);
                        <tr class="alert-category-row category-@category.Tone">
                            <td colspan="7">
                                <button type="button" aria-expanded="@(isCollapsed ? "false" : "true")" @onclick="() => categoryState.Toggle(category)">
                                    <span class="category-chevron" aria-hidden="true"></span>
                                    <strong>@category.Name</strong>
                                    <span>@AlertCountLabel(category.Alerts.Count)</span>
                                </button>
                            </td>
                        </tr>
                        continue;
                    }

                    var alert = item.Alert!;
                    var queryResult = QueryResultPresenter.Parse(alert.RawJson);
                    <tr class="@(expandedAlertId == alert.Id ? "selected" : null)">
                        <td class="timestamp" title="@($"{alert.ReceivedAt.ToUniversalTime():O} UTC")">@FormatTimestamp(alert.ReceivedAt)</td>
                        <td>
                            <button class="alert-name-button @AlertTitleClass(alert.MonitorCondition)" type="button" title="Show alert details" aria-expanded="@(expandedAlertId == alert.Id ? "true" : "false")" @onclick="() => ToggleDetails(alert)">
                                <span class="alert-name-content">
                                    <span>@Display(alert.Name)</span>
                                    <span class="inbox-severity @AlertSeverityDisplay.CssClass(alert.Severity)">@Display(alert.Severity)</span>
                                </span>
                            </button>
                            @if (!string.IsNullOrWhiteSpace(alert.Description))
                            {
                                <span class="cell-secondary">@alert.Description</span>
                            }
                        </td>
                        <td class="target" title="@alert.TargetDisplayName">@Display(alert.TargetDisplayName)</td>
                        <td><div class="search-query">@Display(alert.SearchQuery)</div></td>
                        <td class="search-result-cell">
                            @if (queryResult is null)
                            {
                                <span class="search-result-empty">-</span>
                            }
                            else
                            {
                                @if (queryResult.CollapseRows)
                                {
                                    <details class="query-result-details">
                                        <summary class="query-result-summary" aria-label="@queryResult.Label">
                                            <span class="test-summary">
                                                @foreach (var badge in queryResult.Summary)
                                                {
                                                    <span class="test-count presentation-@badge.Tone">@badge.Text</span>
                                                }
                                            </span>
                                        </summary>
                                        <QueryResultRows Rows="queryResult.Rows" FormatValue="FormatPresentationValue" />
                                    </details>
                                }
                                else
                                {
                                    <div class="test-summary" aria-label="@queryResult.Label">
                                        @foreach (var badge in queryResult.Summary)
                                        {
                                            <span class="test-count presentation-@badge.Tone">@badge.Text</span>
                                        }
                                    </div>
                                    <QueryResultRows Rows="queryResult.Rows" FormatValue="FormatPresentationValue" />
                                }
                                @if (alert.QueryResultRefreshedAt is { } refreshedAt)
                                {
                                    <span class="cell-secondary" title="@($"{refreshedAt.ToUniversalTime():O} UTC")">
                                        Refreshed @FormatTimestamp(refreshedAt)
                                    </span>
                                }
                            }
                        </td>
                        <td class="comments-preview" title="@alert.Comments">@Display(alert.Comments)</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(alert.SearchResultsUrl))
                            {
                                <span>-</span>
                            }
                            else
                            {
                                <a class="search-results-link" href="@alert.SearchResultsUrl" target="_blank" rel="noopener noreferrer">Open</a>
                            }
                        </td>
                    </tr>
                    @if (expandedAlertId == alert.Id)
                    {
                        <tr class="payload-row">
                            <td colspan="7">
                                <div class="comment-editor">
                                    <label for="comment-@alert.Id">Worker comments</label>
                                    <textarea id="comment-@alert.Id" maxlength="4000" rows="3" @bind="commentDraft"></textarea>
                                    <div class="comment-actions">
                                        <button type="button" disabled="@isSavingComment" @onclick="() => SaveCommentsAsync(alert.Id)">
                                            @(isSavingComment ? "Saving..." : "Save comments")
                                        </button>
                                        <span>@commentDraft.Length / 4000</span>
                                        @if (!string.IsNullOrWhiteSpace(commentSaveError))
                                        {
                                            <span class="comment-error" role="alert">@commentSaveError</span>
                                        }
                                    </div>
                                </div>
                                <div class="payload-heading">
                                    <strong>Raw payload</strong>
                                    <span>Alert ID: @Display(alert.AlertId)</span>
                                    @if (alert.QueryResultRefreshedAt is { } refreshedAt)
                                    {
                                        <span title="@($"{refreshedAt.ToUniversalTime():O} UTC")">
                                            Query refreshed: @FormatTimestamp(refreshedAt)
                                        </span>
                                    }
                                </div>
                                <pre>@alert.RawJson</pre>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (pageCount > 1)
    {
        <nav class="inbox-pagination" aria-label="Inbox result pages">
            <button type="button" disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
            @foreach (var pageNumber in VisiblePageNumbers(pageCount))
            {
                <button type="button"
                        class="@(pageNumber == currentPage ? "current" : null)"
                        aria-current="@(pageNumber == currentPage ? "page" : null)"
                        @onclick="() => ChangePage(pageNumber)">
                    @pageNumber
                </button>
            }
            <button type="button" disabled="@(currentPage == pageCount)" @onclick="() => ChangePage(currentPage + 1)">Next</button>
        </nav>
    }
</section>
            </div>
            <button class="inbox-resize-handle" data-inbox-resize-handle="@(isDashboardEditEnabled ? string.Empty : null)" draggable="false" title="Drag to resize @resultsWidget.Title" aria-label="Resize @resultsWidget.Title"></button>
        </article>
    }
    </div>
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private IReadOnlyList<AlertRecord> alerts = [];
    private IReadOnlyList<ComputerInventoryEntry> computerInventory = [];
    private TimeSpan currentHeartbeatAge = AlertGraphTargetStatusResolver.CurrentThreshold;
    private IReadOnlyList<AlertRule> alertRules = [];
    private IReadOnlyList<CriticalAlertLifecycle> criticalAlertLifecycles = [];
    private string viewMode = "active";
    private string searchText = string.Empty;
    private string domainFilter = string.Empty;
    private string roleFilter = string.Empty;
    private string targetNameFilter = string.Empty;
    private string selectedTimeZoneId = "utc";
    private string receivedFromInput = string.Empty;
    private string receivedToInput = string.Empty;
    private DateTime? receivedFrom;
    private DateTime? receivedTo;
    private string sortColumn = nameof(AlertRecord.ReceivedAt);
    private bool sortAscending;
    private Guid? expandedAlertId;
    private string commentDraft = string.Empty;
    private string commentSaveError = string.Empty;
    private string currentUser = string.Empty;
    private bool isSavingComment;
    private bool isEditingDateTime;
    private int currentPage = 1;
    private readonly HashSet<string> expandedDomains = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> expandedRoles = new(StringComparer.OrdinalIgnoreCase);
    private readonly InboxCategoryState categoryState = new();
    private readonly CancellationTokenSource clockCancellation = new();
    private DateTimeOffset currentTimeUtc = DateTimeOffset.UtcNow;
    private Task? clockTask;
    private bool isDashboardEditEnabled;
    private string? selectedDashboardWidgetId;
    private string? draggedDashboardWidgetId;
    private InboxWidgetKind? draggedDashboardTemplate;
    private (int Column, int Row)? dashboardDropTarget;
    private string dashboardOwnerKey = "open-access";
    private string dashboardStatus = "Loading saved workspace…";
    private ElementReference dashboardRoot;
    private IJSObjectReference? dashboardModule;
    private DotNetObjectReference<Home>? dashboardDotNetReference;

    private const double ChartWidth = 640;
    private const double ChartTop = 10;
    private const double ChartBottom = 110;
    private const int ChartTickIntervalHours = 8;
    private const int PageSize = 10;

    private bool IsTimeRangeValid => receivedFrom is null || receivedTo is null || receivedFrom <= receivedTo;
    private AlertTimeZoneOption SelectedTimeZone => AlertTimeZones.Get(selectedTimeZoneId);
    private string HistoryWindowLabel => AlertHistory.Days == 1 ? "day" : $"{AlertHistory.Days} days";
    private IReadOnlyList<AlertRecord> InboxAlerts => InventoryMaintenance.FilterAlerts(alerts, computerInventory);
    private IReadOnlyList<ComputerInventoryEntry> InboxInventory => computerInventory.Where(entry => !entry.Maintenance).ToArray();
    private int RecentAlertCount => InboxAlerts.Count(alert => alert.ReceivedAt >= AlertHistory.GetCutoff(currentTimeUtc));

    private static string TreeCountStyle(int count)
    {
        var hue = 120 - Math.Min(Math.Max(count, 0), 10) * 12;
        return $"--tree-count-hue: {hue}";
    }

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(searchText) ||
        !string.IsNullOrWhiteSpace(domainFilter) ||
        !string.IsNullOrWhiteSpace(roleFilter) ||
        !string.IsNullOrWhiteSpace(targetNameFilter) ||
        receivedFrom is not null ||
        receivedTo is not null;

    private IEnumerable<AlertRecord> ViewAlerts => viewMode == "history"
        ? InboxAlerts
        : ActiveAlerts;

    private IReadOnlyList<AlertRecord> ActiveAlerts => AlertLifecycle.GetActiveAlerts(InboxAlerts);

    private IReadOnlyList<DomainNode> GetNavigationTree() =>
        AlertNavigation.Build(InboxAlerts, ActiveAlerts, InboxInventory, AlertHistory.GetCutoff(currentTimeUtc));

    private IEnumerable<AlertRecord> FilteredAlerts
    {
        get
        {
            var filtered = ViewAlerts.Where(alert =>
                IsTimeRangeValid &&
                MatchesInventoryFilter(alert, domainFilter, roleFilter) &&
                (string.IsNullOrWhiteSpace(targetNameFilter) || alert.TargetName.Equals(targetNameFilter, StringComparison.OrdinalIgnoreCase)) &&
                (receivedFrom is null || ToDisplayTime(alert.ReceivedAt) >= receivedFrom) &&
                (receivedTo is null || ToDisplayTime(alert.ReceivedAt) <= receivedTo) &&
                (string.IsNullOrWhiteSpace(searchText) || SearchableText(alert).Contains(searchText, StringComparison.OrdinalIgnoreCase)));

            return (sortColumn, sortAscending) switch
            {
                (nameof(AlertRecord.Name), true) => filtered.OrderBy(alert => alert.Name),
                (nameof(AlertRecord.Name), false) => filtered.OrderByDescending(alert => alert.Name),
                (nameof(AlertRecord.SubscriptionId), true) => filtered.OrderBy(alert => alert.SubscriptionId),
                (nameof(AlertRecord.SubscriptionId), false) => filtered.OrderByDescending(alert => alert.SubscriptionId),
                (nameof(AlertRecord.TargetName), true) => filtered.OrderBy(alert => alert.TargetName),
                (nameof(AlertRecord.TargetName), false) => filtered.OrderByDescending(alert => alert.TargetName),
                (_, true) => filtered.OrderBy(alert => alert.ReceivedAt),
                _ => filtered.OrderByDescending(alert => alert.ReceivedAt)
            };
        }
    }

    private IReadOnlyList<InboxTargetOutputCell> GetHeatmapCells(IReadOnlyList<AlertRecord> visibleAlerts) =>
        InboxTargetOutput.Build(
            visibleAlerts, ActiveAlerts, computerInventory, currentTimeUtc, currentHeartbeatAge,
            entry => IsTimeRangeValid &&
                MatchesInventoryFilter(entry, domainFilter, roleFilter) &&
                (string.IsNullOrWhiteSpace(targetNameFilter) || entry.Computer.Equals(targetNameFilter, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(searchText) || string.Join(' ',
                    entry.Computer, entry.Site, entry.Domain, entry.Role, entry.ResourceGroup, entry.SubscriptionId)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)),
            AlertRuleEvaluator.Categorize(visibleAlerts, alertRules, InboxInventory, ActiveAlerts).Categories);

    private string HeatmapCellDescription(InboxTargetOutputCell cell) =>
        $"{cell.Target}, " + (TargetOutputDisplay.ShowDomain ? $"domain {cell.Domain}, " : string.Empty) +
        $"site {cell.Site}, subscription {cell.SubscriptionId}: {AlertCountLabel(cell.Count)}" +
        (cell.HasServiceHealthAlert && cell.Count == 0
            ? "; Service health alert: at least one monitored service is not running"
            : string.Empty) +
        (cell.SuppressedOnly
            ? "; Suppressed alerts only"
            : $"; {cell.NonSuppressedCount} non-suppressed alerts") +
        (cell.IsCriticalOutage ? "; Critical outage" : cell.IsOutage ? "; Outage" : string.Empty) +
        (cell.MissingHeartbeat
            ? $"; Missing heartbeat (older than {currentHeartbeatAge.TotalMinutes:0} minutes or never received)"
            : string.Empty);

    private static string AlertCountLabel(int count) => $"{count} {(count == 1 ? "alert" : "alerts")}";

    private string TargetOutputLegendDescription => string.Join("; ",
        TargetOutputDisplay.Legend().Select(entry => $"{entry.Label}: {entry.Color.ToString().ToLowerInvariant()}")) +
        "; Missing heartbeat: gray";

    private IReadOnlyList<HourlyAlertCount> GetHourlyAlertCounts()
    {
        var firstHour = GetChartFirstHour();
        var inboxAlerts = InboxAlerts;

        return Enumerable.Range(0, 48)
            .Select(offset =>
            {
                var hour = firstHour.AddHours(offset);
                var count = inboxAlerts.Count(alert =>
                    alert.MonitorCondition.Equals("Fired", StringComparison.OrdinalIgnoreCase) &&
                    alert.ReceivedAt >= hour &&
                    alert.ReceivedAt < hour.AddHours(1));
                return new HourlyAlertCount(hour, count);
            })
            .ToArray();
    }

    private IReadOnlyList<HourlyCriticalAlertCount> GetHourlyCriticalAlertCounts()
    {
        var visibleAlertIds = InboxAlerts.Select(alert => alert.AlertId).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return CriticalAlertTimeline.GetHourlyCounts(
            criticalAlertLifecycles.Where(lifecycle => visibleAlertIds.Contains(lifecycle.AlertId)),
            GetChartFirstHour(), 48, currentTimeUtc);
    }

    private DateTimeOffset GetChartFirstHour()
    {
        var currentHour = new DateTimeOffset(
            currentTimeUtc.Year,
            currentTimeUtc.Month,
            currentTimeUtc.Day,
            currentTimeUtc.Hour,
            0,
            0,
            TimeSpan.Zero);
        return currentHour.AddHours(-47);
    }

    private static string ChartPoints(IReadOnlyList<HourlyAlertCount> buckets, int maximumCount) =>
        string.Join(' ', buckets.Select((bucket, index) =>
        {
            var x = ChartX(index, buckets.Count);
            var y = ChartBottom - bucket.Count * (ChartBottom - ChartTop) / maximumCount;
            return FormattableString.Invariant($"{x:0.##},{y:0.##}");
        }));

    private static string CriticalChartPoints(
        IReadOnlyList<HourlyCriticalAlertCount> buckets,
        int maximumCount) =>
        string.Join(' ', buckets.Select((bucket, index) =>
        {
            var x = ChartX(index, buckets.Count);
            var y = ChartBottom - bucket.Count * (ChartBottom - ChartTop) / maximumCount;
            return FormattableString.Invariant($"{x:0.##},{y:0.##}");
        }));

    private static IReadOnlyList<int> GetChartTickIndexes(int bucketCount) =>
        Enumerable.Range(0, bucketCount)
            .Where(index => index % ChartTickIntervalHours == 0 || index == bucketCount - 1)
            .ToArray();

    private static double ChartX(int index, int bucketCount) =>
        index * ChartWidth / Math.Max(1, bucketCount - 1);

    private static string ChartCoordinate(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string ChartTickStyle(int index, int bucketCount) =>
        FormattableString.Invariant($"--chart-tick:{index * 100d / Math.Max(1, bucketCount - 1):0.##}%");

    private static string ChartDescription(IReadOnlyList<HourlyAlertCount> buckets)
    {
        var total = buckets.Sum(bucket => bucket.Count);
        var maximum = buckets.Max(bucket => bucket.Count);
        return $"Alerts received per hour over the last 48 hours. {total} total, with a maximum of {maximum} in one hour.";
    }

    private static string CriticalChartDescription(IReadOnlyList<HourlyCriticalAlertCount> buckets)
    {
        var maximum = buckets.Max(bucket => bucket.Count);
        return $"Active critical alerts over the last 48 hours, with a maximum of {maximum} active at one time.";
    }

    private DateTime ToDisplayTime(DateTimeOffset timestamp) =>
        AlertTimeZones.ToDisplayTime(timestamp, selectedTimeZoneId);

    private string FormatTimestamp(DateTimeOffset timestamp) =>
        ToDisplayTime(timestamp).ToString("yyyy-MM-dd HH:mm:ss");

    private string FormatPresentationValue(QueryResultValue value) =>
        value.Format.Equals("datetime", StringComparison.OrdinalIgnoreCase) &&
        DateTimeOffset.TryParse(value.Value, out var timestamp)
            ? FormatTimestamp(timestamp)
            : value.Value;

    private string FormatChartTime(DateTimeOffset timestamp) =>
        ToDisplayTime(timestamp).ToString("ddd HH:mm");

    private string FormatCurrentTime() =>
        ToDisplayTime(currentTimeUtc).ToString("yyyy-MM-dd HH:mm:ss");

    private string FormatUtcOffset()
    {
        var offset = SelectedTimeZone.TimeZone.GetUtcOffset(currentTimeUtc);
        var sign = offset < TimeSpan.Zero ? '-' : '+';
        return $"UTC{sign}{Math.Abs(offset.Hours):00}:{Math.Abs(offset.Minutes):00}";
    }

    private void ChangeTimeZone(ChangeEventArgs eventArgs)
    {
        var newTimeZoneId = eventArgs.Value?.ToString() ?? "utc";
        if (newTimeZoneId.Equals(selectedTimeZoneId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (receivedFrom is not null)
        {
            receivedFrom = AlertTimeZones.ConvertWallClock(receivedFrom.Value, selectedTimeZoneId, newTimeZoneId);
            receivedFromInput = FormatDateTimeInput(receivedFrom.Value);
        }

        if (receivedTo is not null)
        {
            receivedTo = AlertTimeZones.ConvertWallClock(receivedTo.Value, selectedTimeZoneId, newTimeZoneId);
            receivedToInput = FormatDateTimeInput(receivedTo.Value);
        }

        selectedTimeZoneId = newTimeZoneId;
        ResetPagination();
    }

    private void ChangeReceivedFrom(ChangeEventArgs eventArgs)
    {
        receivedFromInput = eventArgs.Value?.ToString() ?? string.Empty;
        receivedFrom = ParseDateTimeInput(receivedFromInput);
        ResetPagination();
    }

    private void ChangeReceivedTo(ChangeEventArgs eventArgs)
    {
        receivedToInput = eventArgs.Value?.ToString() ?? string.Empty;
        receivedTo = ParseDateTimeInput(receivedToInput);
        ResetPagination();
    }

    private static DateTime? ParseDateTimeInput(string value) =>
        DateTime.TryParseExact(
            value,
            ["yyyy-MM-ddTHH:mm", "yyyy-MM-ddTHH:mm:ss"],
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out var parsedValue)
                ? parsedValue
                : null;

    private static string FormatDateTimeInput(DateTime value) =>
        value.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        currentUser = CurrentUserIdentity.GetActor(
            authenticationState.User,
            ApplicationAuthentication.IsOpen);
        dashboardOwnerKey = string.IsNullOrWhiteSpace(currentUser) ? "open-access" : currentUser;
        var savedDashboard = await InboxLayoutRepository.LoadAsync(dashboardOwnerKey);
        if (savedDashboard is not null)
        {
            Dashboard.Load(savedDashboard);
            dashboardStatus = "Database workspace restored";
        }
        else
        {
            dashboardStatus = "Default workspace ready";
        }
        alerts = await AlertStore.GetAllAsync();
        computerInventory = await AlertStore.GetComputerInventoryAsync();
        alertRules = await AlertStore.GetAllAlertRulesAsync();
        currentHeartbeatAge = InventoryHeartbeatFreshnessRule.Resolve(alertRules);
        criticalAlertLifecycles = await AlertStore.GetCriticalAlertLifecyclesAsync(
            GetChartFirstHour(),
            currentTimeUtc);
        AlertStore.Changed += HandleStoreChanged;
        clockTask = RunClockAsync(clockCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        dashboardModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/inbox-dashboard.js");
        dashboardDotNetReference = DotNetObjectReference.Create(this);
        await dashboardModule.InvokeVoidAsync("initialize", dashboardDotNetReference, dashboardRoot);
    }

    private async Task RunClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                currentTimeUtc = DateTimeOffset.UtcNow;
                if (!isEditingDateTime)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void HandleStoreChanged()
    {
        _ = ReloadAlertsAsync();
    }

    private void BeginDateTimeEdit() => isEditingDateTime = true;

    private void EndDateTimeEdit()
    {
        isEditingDateTime = false;
        currentTimeUtc = DateTimeOffset.UtcNow;
    }

    private async Task ReloadAlertsAsync()
    {
        alerts = await AlertStore.GetAllAsync();
        computerInventory = await AlertStore.GetComputerInventoryAsync();
        alertRules = await AlertStore.GetAllAlertRulesAsync();
        currentHeartbeatAge = InventoryHeartbeatFreshnessRule.Resolve(alertRules);
        criticalAlertLifecycles = await AlertStore.GetCriticalAlertLifecyclesAsync(
            GetChartFirstHour(),
            currentTimeUtc);
        await InvokeAsync(StateHasChanged);
    }

    private void SortBy(string column)
    {
        sortAscending = sortColumn == column ? !sortAscending : true;
        sortColumn = column;
        ResetPagination();
    }

    private string SortIndicator(string column) => sortColumn == column
        ? sortAscending ? "(asc)" : "(desc)"
        : string.Empty;

    private void ToggleDetails(AlertRecord alert)
    {
        expandedAlertId = expandedAlertId == alert.Id ? null : alert.Id;
        commentDraft = expandedAlertId is null ? string.Empty : alert.Comments;
        commentSaveError = string.Empty;
    }

    private async Task SaveCommentsAsync(Guid id)
    {
        isSavingComment = true;
        commentSaveError = string.Empty;

        try
        {
            if (!await AlertStore.UpdateCommentsAsync(id, commentDraft, currentUser))
            {
                commentSaveError = "This alert no longer exists.";
            }
        }
        catch
        {
            commentSaveError = "Comments could not be saved.";
        }
        finally
        {
            isSavingComment = false;
        }
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        domainFilter = string.Empty;
        roleFilter = string.Empty;
        targetNameFilter = string.Empty;
        receivedFromInput = string.Empty;
        receivedToInput = string.Empty;
        receivedFrom = null;
        receivedTo = null;
        ResetPagination();
    }

    private void SelectTreeNode(
        string domain = "",
        string role = "",
        string targetName = "")
    {
        domainFilter = domain;
        roleFilter = role;
        targetNameFilter = targetName;
        ResetPagination();
    }

    private void ResetPagination()
    {
        currentPage = 1;
        expandedAlertId = null;
        commentDraft = string.Empty;
        commentSaveError = string.Empty;
    }

    private void ChangePage(int page)
    {
        currentPage = Math.Max(1, page);
        expandedAlertId = null;
        commentDraft = string.Empty;
        commentSaveError = string.Empty;
    }

    private string PageRangeLabel(int totalCount)
    {
        if (totalCount == 0)
        {
            return "0";
        }

        var first = (currentPage - 1) * PageSize + 1;
        var last = Math.Min(currentPage * PageSize, totalCount);
        return $"{first}-{last}";
    }

    private IEnumerable<int> VisiblePageNumbers(int pageCount)
    {
        const int maximumButtons = 7;
        var first = Math.Max(1, currentPage - maximumButtons / 2);
        var last = Math.Min(pageCount, first + maximumButtons - 1);
        first = Math.Max(1, last - maximumButtons + 1);
        return Enumerable.Range(first, last - first + 1);
    }

    private bool IsTreeSelection(string domain, string role, string targetName) =>
        domainFilter.Equals(domain, StringComparison.OrdinalIgnoreCase) &&
        roleFilter.Equals(role, StringComparison.OrdinalIgnoreCase) &&
        targetNameFilter.Equals(targetName, StringComparison.OrdinalIgnoreCase);

    private void ToggleDomain(string domain)
    {
        if (!expandedDomains.Remove(domain))
        {
            expandedDomains.Add(domain);
        }
    }

    private void ToggleRole(string key)
    {
        if (!expandedRoles.Remove(key))
        {
            expandedRoles.Add(key);
        }
    }

    private static string TreeKey(string domain, string role) => $"{domain}\u001f{role}";

    private bool MatchesInventoryFilter(AlertRecord alert, string domain, string role)
    {
        if (string.IsNullOrWhiteSpace(domain) && string.IsNullOrWhiteSpace(role))
        {
            return true;
        }

        var entry = computerInventory.FirstOrDefault(candidate =>
            candidate.SubscriptionId.Equals(alert.SubscriptionId, StringComparison.OrdinalIgnoreCase) &&
            candidate.Computer.Equals(alert.TargetName, StringComparison.OrdinalIgnoreCase));
        return MatchesInventoryFilter(entry, domain, role);
    }

    private static bool MatchesInventoryFilter(ComputerInventoryEntry? entry, string domain, string role)
    {
        var alertDomain = string.IsNullOrWhiteSpace(entry?.Domain) ? "Unknown domain" : entry.Domain.Trim();
        var alertRole = string.IsNullOrWhiteSpace(entry?.Role) ? "Unknown role" : entry.Role.Trim();
        return (string.IsNullOrWhiteSpace(domain) || alertDomain.Equals(domain, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(role) || alertRole.Equals(role, StringComparison.OrdinalIgnoreCase));
    }

    private static string Display(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string? AlertTitleClass(string monitorCondition) => monitorCondition.ToUpperInvariant() switch
    {
        "FIRED" => "alert-title-fired",
        "RESOLVED" => "alert-title-resolved",
        _ => null
    };

    private static string SearchableText(AlertRecord alert) => string.Join(' ',
        alert.Name,
        alert.Description,
        alert.Severity,
        alert.Status,
        alert.SignalType,
        alert.MonitorCondition,
        alert.Target,
        alert.TargetName,
        alert.TargetDisplayName,
        alert.SiteName,
        alert.ResourceGroup,
        alert.SearchQuery,
        alert.SubscriptionId,
        alert.AlertId,
        alert.Comments);

    private InboxDashboardWidget? GetWidget(InboxWidgetKind kind) =>
        Dashboard.Document.Widgets.FirstOrDefault(widget => widget.Kind == kind);

    private void DashboardEditModeChanged()
    {
        if (!isDashboardEditEnabled)
        {
            selectedDashboardWidgetId = null;
            EndDashboardDrag();
        }
    }

    private void SelectDashboardWidget(string id)
    {
        if (isDashboardEditEnabled)
        {
            selectedDashboardWidgetId = id;
        }
    }

    private void StartTemplateDrag(InboxWidgetKind kind)
    {
        if (!isDashboardEditEnabled || GetWidget(kind) is not null)
        {
            return;
        }

        draggedDashboardTemplate = kind;
        draggedDashboardWidgetId = null;
    }

    private void StartDashboardWidgetDrag(string id)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        selectedDashboardWidgetId = id;
        draggedDashboardWidgetId = id;
        draggedDashboardTemplate = null;
    }

    private void EndDashboardDrag()
    {
        draggedDashboardWidgetId = null;
        draggedDashboardTemplate = null;
        dashboardDropTarget = null;
    }

    private async Task DropDashboardWidgetAsync(int column, int row)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        if (draggedDashboardTemplate is { } kind && GetWidget(kind) is null)
        {
            var widget = Dashboard.AddWidget(kind, column, row);
            selectedDashboardWidgetId = widget.Id;
        }
        else if (draggedDashboardWidgetId is { } id)
        {
            Dashboard.MoveWidget(id, column, row);
        }
        else
        {
            return;
        }

        EndDashboardDrag();
        await SaveDashboardAsync("Position saved");
    }

    private async Task AddDashboardWidgetAsync(InboxWidgetKind kind)
    {
        if (!isDashboardEditEnabled || GetWidget(kind) is not null)
        {
            return;
        }

        var widget = Dashboard.AddWidget(kind);
        selectedDashboardWidgetId = widget.Id;
        await SaveDashboardAsync("Section added");
    }

    private async Task ChangeDashboardRowsAsync(ChangeEventArgs eventArgs)
    {
        if (isDashboardEditEnabled && int.TryParse(eventArgs.Value?.ToString(), out var rows))
        {
            Dashboard.UpdateWorkspace(document => document.Rows = rows);
            await SaveDashboardAsync("Row count saved");
        }
    }

    private async Task ChangeDashboardRowHeightAsync(ChangeEventArgs eventArgs)
    {
        if (isDashboardEditEnabled && int.TryParse(eventArgs.Value?.ToString(), out var rowHeight))
        {
            Dashboard.UpdateWorkspace(document => document.RowHeight = rowHeight);
            await SaveDashboardAsync("Row size saved");
        }
    }

    private async Task NudgeDashboardSizeAsync(string id, int columns, int rows)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        var widget = Dashboard.Document.Widgets.First(item => item.Id == id);
        Dashboard.ResizeWidget(id, widget.ColumnSpan + columns, widget.RowSpan + rows);
        await SaveDashboardAsync("Size saved");
    }

    private async Task NudgeDashboardPositionAsync(string id, int columns, int rows)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        var widget = Dashboard.Document.Widgets.First(item => item.Id == id);
        Dashboard.MoveWidget(id, widget.Column + columns, widget.Row + rows);
        await SaveDashboardAsync("Position saved");
    }

    private async Task RemoveDashboardWidgetAsync(string id)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        Dashboard.RemoveWidget(id);
        selectedDashboardWidgetId = null;
        await SaveDashboardAsync("Section removed");
    }

    private async Task HandleDashboardWidgetActionAsync(string id, string action)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        switch (action)
        {
            case "left":
                await NudgeDashboardPositionAsync(id, -1, 0);
                break;
            case "right":
                await NudgeDashboardPositionAsync(id, 1, 0);
                break;
            case "up":
                await NudgeDashboardPositionAsync(id, 0, -1);
                break;
            case "down":
                await NudgeDashboardPositionAsync(id, 0, 1);
                break;
            case "narrower":
                await NudgeDashboardSizeAsync(id, -1, 0);
                break;
            case "wider":
                await NudgeDashboardSizeAsync(id, 1, 0);
                break;
            case "shorter":
                await NudgeDashboardSizeAsync(id, 0, -1);
                break;
            case "taller":
                await NudgeDashboardSizeAsync(id, 0, 1);
                break;
            case "remove":
                await RemoveDashboardWidgetAsync(id);
                break;
        }
    }

    [JSInvokable]
    public async Task CommitDashboardResize(string id, int columnSpan, int rowSpan)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        Dashboard.ResizeWidget(id, columnSpan, rowSpan);
        await SaveDashboardAsync("Size saved");
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CommitDashboardMove(string id, int column, int row)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        selectedDashboardWidgetId = id;
        Dashboard.MoveWidget(id, column, row);
        await SaveDashboardAsync("Position saved");
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleDashboardGridAsync()
    {
        Dashboard.UpdateWorkspace(document => document.ShowGrid = !document.ShowGrid);
        await SaveDashboardAsync("Grid preference saved");
    }

    private async Task UndoDashboardAsync()
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        Dashboard.Undo();
        selectedDashboardWidgetId = null;
        await SaveDashboardAsync("Change undone");
    }

    private async Task RedoDashboardAsync()
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        Dashboard.Redo();
        selectedDashboardWidgetId = null;
        await SaveDashboardAsync("Change restored");
    }

    private async Task ResetDashboardAsync()
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        Dashboard.Reset();
        selectedDashboardWidgetId = null;
        await SaveDashboardAsync("Default workspace restored");
    }

    private async Task SaveDashboardAsync(string status)
    {
        try
        {
            var result = await InboxLayoutRepository.SaveAsync(dashboardOwnerKey, Dashboard.Document);
            dashboardStatus = $"{status} · revision {result.Revision}";
        }
        catch
        {
            dashboardStatus = "Workspace could not be saved";
        }
    }

    private static string DashboardWidgetStyle(InboxDashboardWidget widget) =>
        $"grid-column:{widget.Column} / span {widget.ColumnSpan};grid-row:{widget.Row} / span {widget.RowSpan};";

    private sealed record HourlyAlertCount(DateTimeOffset Hour, int Count);

    public async ValueTask DisposeAsync()
    {
        AlertStore.Changed -= HandleStoreChanged;
        clockCancellation.Cancel();
        clockCancellation.Dispose();

        if (dashboardModule is not null)
        {
            try
            {
                await dashboardModule.InvokeVoidAsync("dispose", dashboardRoot);
                await dashboardModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        dashboardDotNetReference?.Dispose();
    }
}