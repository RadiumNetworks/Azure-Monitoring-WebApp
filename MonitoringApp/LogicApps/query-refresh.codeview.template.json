{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "workspaceId": { "type": "String", "defaultValue": "" },
      "refreshTargetsUrl": { "type": "String", "defaultValue": "" },
      "alertsApiBaseUrl": { "type": "String", "defaultValue": "" },
      "webhookAudience": { "type": "String", "defaultValue": "" },
      "$connections": { "type": "Object", "defaultValue": {} }
    },
    "triggers": {
      "Every_five_minutes": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Minute",
          "interval": 5,
          "timeZone": "UTC"
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        }
      }
    },
    "actions": {
      "Get_Active_Refresh_Targets": {
        "type": "Http",
        "inputs": {
          "uri": "@parameters('refreshTargetsUrl')",
          "method": "GET",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "identity": "<user-assigned-managed-identity-resource-id>",
            "audience": "@parameters('webhookAudience')"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT5S",
            "minimumInterval": "PT5S",
            "maximumInterval": "PT30S"
          }
        },
        "runAfter": {}
      },
      "For_each_active_alert": {
        "type": "Foreach",
        "foreach": "@body('Get_Active_Refresh_Targets')",
        "operationOptions": "Sequential",
        "actions": {
          "Query_Executed_At": {
            "type": "Compose",
            "inputs": "@utcNow()",
            "runAfter": {}
          },
          "Run_Log_Analytics_Query": {
            "type": "Http",
            "inputs": {
              "uri": "@concat('https://api.loganalytics.azure.com/v1/workspaces/', parameters('workspaceId'), '/query')",
              "method": "POST",
              "headers": {
                "Content-Type": "application/json",
                "Prefer": "wait=30"
              },
              "body": {
                "query": "{{refreshQueryExpression}}",
                "timespan": "{{timespan}}"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "<user-assigned-managed-identity-resource-id>",
                "audience": "https://api.loganalytics.io"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT30S"
              }
            },
            "runAfter": {
              "Query_Executed_At": ["Succeeded"]
            }
          },
          "Update_Query_Result": {
            "type": "Http",
            "inputs": {
              "uri": "@concat(parameters('alertsApiBaseUrl'), '/', item()?['id'], '/query-result')",
              "method": "PUT",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "type": "{{queryResultType}}",
                "dimensionName": "{{dimensionName}}",
                "dimensionValue": "@item()?['dimensionValue']",
                "columns": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['columns'], json('[]'))",
                "rows": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]'))",
                "rowCount": "@length(coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]')))",
                "queryExecutedAt": "@outputs('Query_Executed_At')"
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "identity": "<user-assigned-managed-identity-resource-id>",
                "audience": "@parameters('webhookAudience')"
              },
              "retryPolicy": {
                "type": "exponential",
                "count": 3,
                "interval": "PT5S",
                "minimumInterval": "PT5S",
                "maximumInterval": "PT30S"
              }
            },
            "runAfter": {
              "Run_Log_Analytics_Query": ["Succeeded"]
            }
          }
        },
        "runAfter": {
          "Get_Active_Refresh_Targets": ["Succeeded"]
        }
      }
    },
    "outputs": {}
  },
  "parameters": {
    "workspaceId": { "value": "<log-analytics-workspace-guid>" },
    "refreshTargetsUrl": {
      "value": "https://<app-service-name>.azurewebsites.net/api/alert-query-refresh-targets?type={{queryResultType}}"
    },
    "alertsApiBaseUrl": {
      "value": "https://<app-service-name>.azurewebsites.net/api/alerts"
    },
    "webhookAudience": { "value": "api://<monitoring-api-client-id>" },
    "$connections": { "value": {} }
  }
}
