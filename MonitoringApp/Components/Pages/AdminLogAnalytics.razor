@page "/admin/log-analytics"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminAccess")]
@inject CrossTenantLogAnalyticsOptions Options
@inject LogAnalyticsConnectionDiagnostics Diagnostics
@inject UiText Text
@inject ILogger<AdminLogAnalytics> Logger

<PageTitle>@Text["LogAnalyticsAdmin.PageTitle"]</PageTitle>

<section class="admin-heading">
    <div>
        <p class="eyebrow">@Text["Common.Administration"]</p>
        <h1>@Text["LogAnalyticsAdmin.Title"]</h1>
        <p class="subtitle">@Text["LogAnalyticsAdmin.Subtitle"]</p>
    </div>
    <div class="admin-heading-actions">
        <button class="admin-secondary"
                type="button"
                disabled="@isRunning"
                @onclick="RunDiagnosticsAsync">
            @Text[isRunning ? "LogAnalyticsAdmin.Testing" : "LogAnalyticsAdmin.Run"]
        </button>
    </div>
</section>

@if (!Options.Enabled)
{
    <div class="admin-message admin-message-warning" role="status">
        <strong>@Text["LogAnalyticsAdmin.Disabled"]</strong>
        <LocalizedContent ResourceKey="LogAnalyticsAdmin.EnableHint">
            <Value0><code>CrossTenantLogAnalytics:Enabled</code></Value0>
            <Value1><code>true</code></Value1>
        </LocalizedContent>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}

@if (report is not null)
{
    <p class="admin-diagnostics-time">@Text.Format("LogAnalyticsAdmin.CheckedAt", report.CheckedAt.ToString("yyyy-MM-dd HH:mm:ss"))</p>
    <section class="admin-diagnostics-section" aria-labelledby="key-vault-diagnostic">
        <h2 id="key-vault-diagnostic">Key Vault</h2>
        <DiagnosticStepView Step="report.KeyVault" />
    </section>

    <div class="admin-diagnostics-grid">
        @foreach (var workspace in report.Workspaces)
        {
            <section class="admin-diagnostics-section" aria-labelledby="@($"workspace-{workspace.Key}")">
                <h2 id="@($"workspace-{workspace.Key}")">@workspace.DisplayName</h2>
                <code>@workspace.Key</code>
                <DiagnosticStepView Step="workspace.Token" />
                <DiagnosticStepView Step="workspace.Query" />
            </section>
        }
    </div>
}
else if (string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="admin-empty">@Text["LogAnalyticsAdmin.NoReport"]</p>
}

@code {
    private bool isRunning;
    private string? errorMessage;
    private LogAnalyticsDiagnosticsReport? report;

    private async Task RunDiagnosticsAsync()
    {
        if (isRunning)
        {
            return;
        }

        isRunning = true;
        errorMessage = null;
        try
        {
            report = await Diagnostics.RunAsync();
        }
        catch (OperationCanceledException exception)
        {
            errorMessage = Text["LogAnalyticsAdmin.Cancelled"];
            Logger.LogWarning(exception, "Log Analytics diagnostics were cancelled.");
        }
        catch (Exception exception)
        {
            errorMessage = Text["LogAnalyticsAdmin.Failed"];
            Logger.LogError(exception, "Log Analytics diagnostics failed. The previous report is retained.");
        }
        finally
        {
            isRunning = false;
        }
    }
}
