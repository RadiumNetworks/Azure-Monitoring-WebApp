@foreach (var resultRow in Rows)
{
    <div class="query-result-row">
        @if (!string.IsNullOrWhiteSpace(resultRow.Title))
        {
            <strong class="query-result-title">@resultRow.Title</strong>
        }
        <div class="query-result-meta">
            @foreach (var value in resultRow.Metadata)
            {
                <span>
                    @if (!string.IsNullOrWhiteSpace(value.Label))
                    {
                        <strong>@value.Label:</strong>
                    }
                    @FormatValue(value)
                </span>
            }
        </div>
        @if (resultRow.Alerts.Count > 0)
        {
            <div class="failed-tests" aria-label="Alert details">
                @foreach (var item in resultRow.Alerts)
                {
                    <span><strong>@item.Label</strong> @item.Value</span>
                }
            </div>
        }
        @if (resultRow.Facts.Count > 0)
        {
            <div class="query-result-facts">
                @foreach (var value in resultRow.Facts)
                {
                    <span><strong>@value.Label</strong> @FormatValue(value)</span>
                }
            </div>
        }
        @foreach (var details in resultRow.Details)
        {
            <details class="test-details">
                <summary>@details.Label</summary>
                <ul>
                    @foreach (var item in details.Items)
                    {
                        <li class="presentation-@item.Tone">
                            @if (!item.Label.Equals(details.Label, StringComparison.OrdinalIgnoreCase))
                            {
                                <span>@item.Label</span>
                            }
                            <strong>@item.Value</strong>
                        </li>
                    }
                </ul>
            </details>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<QueryResultPresentationRow> Rows { get; set; }

    [Parameter, EditorRequired]
    public required Func<QueryResultValue, string> FormatValue { get; set; }
}