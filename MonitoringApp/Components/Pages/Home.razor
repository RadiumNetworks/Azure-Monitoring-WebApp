    private const int PageSize = 10;

    private bool IsTimeRangeValid => receivedFrom is null || receivedTo is null || receivedFrom <= receivedTo;
    private AlertTimeZoneOption SelectedTimeZone => AlertTimeZones.Get(selectedTimeZoneId);
    private IReadOnlyList<AlertRecord> InboxAlerts => InventoryMaintenance.FilterAlerts(
        InboxTargetOutput.WithInventorySites(alerts, computerInventory), computerInventory);
    private IReadOnlyList<ComputerInventoryEntry> InboxInventory => computerInventory.Where(entry => !entry.Maintenance).ToArray();
    private int RecentAlertCount => InboxAlerts.Count(alert => alert.ReceivedAt >= AlertHistory.GetCutoff(currentTimeUtc));

    private static string TreeCountStyle(int count)
    {
        var hue = 120 - Math.Min(Math.Max(count, 0), 10) * 12;
        return $"--tree-count-hue: {hue}";
    }

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(searchText) ||
        !string.IsNullOrWhiteSpace(domainFilter) ||
        !string.IsNullOrWhiteSpace(roleFilter) ||
        !string.IsNullOrWhiteSpace(targetNameFilter) ||
        receivedFrom is not null ||
        receivedTo is not null;

    private IEnumerable<AlertRecord> ViewAlerts => viewMode switch
    {
        "history" => InboxAlerts,
        "history-fired" => InventoryMaintenance.FilterAlerts(
            InboxTargetOutput.WithInventorySites(firedHistoryAlerts, computerInventory), computerInventory),
        _ => ActiveAlerts
    };

    private IReadOnlyList<AlertRecord> ActiveAlerts => AlertLifecycle.GetActiveAlerts(InboxAlerts);

    private IReadOnlyList<DomainNode> GetNavigationTree() =>
        AlertNavigation.Build(InboxAlerts, ActiveAlerts, InboxInventory, AlertHistory.GetCutoff(currentTimeUtc));

    private IEnumerable<AlertRecord> FilteredAlerts
    {
        get
        {
            var filtered = ViewAlerts.Where(alert =>
                IsTimeRangeValid &&
                MatchesInventoryFilter(alert, domainFilter, roleFilter) &&
                (string.IsNullOrWhiteSpace(targetNameFilter) || alert.TargetName.Equals(targetNameFilter, StringComparison.OrdinalIgnoreCase)) &&
                (receivedFrom is null || ToDisplayTime(alert.ReceivedAt) >= receivedFrom) &&
                (receivedTo is null || ToDisplayTime(alert.ReceivedAt) <= receivedTo) &&
                (string.IsNullOrWhiteSpace(searchText) || SearchableText(alert).Contains(searchText, StringComparison.OrdinalIgnoreCase)));

            return (sortColumn, sortAscending) switch
            {
                (nameof(AlertRecord.Name), true) => filtered.OrderBy(alert => alert.Name),
                (nameof(AlertRecord.Name), false) => filtered.OrderByDescending(alert => alert.Name),
                (nameof(AlertRecord.SubscriptionId), true) => filtered.OrderBy(alert => alert.SubscriptionId),
                (nameof(AlertRecord.SubscriptionId), false) => filtered.OrderByDescending(alert => alert.SubscriptionId),
                (nameof(AlertRecord.TargetName), true) => filtered.OrderBy(alert => alert.TargetName),
                (nameof(AlertRecord.TargetName), false) => filtered.OrderByDescending(alert => alert.TargetName),
                (_, true) => filtered.OrderBy(alert => alert.ReceivedAt),
                _ => filtered.OrderByDescending(alert => alert.ReceivedAt)
            };
        }
    }

    private IReadOnlyList<InboxTargetOutputCell> GetHeatmapCells(IReadOnlyList<AlertRecord> visibleAlerts) =>
        InboxTargetOutput.Build(
            visibleAlerts, ActiveAlerts, computerInventory, currentTimeUtc, currentHeartbeatAge,
            entry => IsTimeRangeValid &&
                MatchesInventoryFilter(entry, domainFilter, roleFilter) &&
                (string.IsNullOrWhiteSpace(targetNameFilter) || entry.Computer.Equals(targetNameFilter, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrWhiteSpace(searchText) || string.Join(' ',
                    entry.Computer, entry.Site, entry.Domain, entry.Role, entry.ResourceGroup, entry.SubscriptionId)
                    .Contains(searchText, StringComparison.OrdinalIgnoreCase)),
            AlertRuleEvaluator.Categorize(visibleAlerts, alertRules, InboxInventory, ActiveAlerts).Categories);

    private string HeatmapCellDescription(InboxTargetOutputCell cell)
    {
        var domain = TargetOutputDisplay.ShowDomain ? "Domain" : "NoDomain";
        var count = cell.HasServiceHealthAlert && cell.Count == 0 ? "ServiceHealth"
            : cell.Count == 1 ? "One" : "Other";
        var suppression = cell.SuppressedOnly ? "Suppressed" : "Counted";
        var outage = cell.IsCriticalOutage ? "Critical" : cell.IsOutage ? "Outage" : "Normal";
        var heartbeat = cell.MissingHeartbeat ? "Missing" : "Current";
        var description = Text.Format($"Inbox.TargetCell.{domain}.{count}.{suppression}.{outage}.{heartbeat}",
            cell.Target, cell.Domain, cell.Site, cell.SubscriptionId, cell.Count,
            cell.NonSuppressedCount, currentHeartbeatAge.TotalMinutes);
        return cell.NonRunningServices.Count == 0 ? description
            : Text.Format("Inbox.TargetServicesDescription", description, string.Join(", ", cell.NonRunningServices));
    }

    private string AlertCountLabel(int count) => Text.Plural("Inbox.AlertCount", count);

    private string TargetLegendLabel(InboxTargetColorLegend entry) => entry.Kind switch
    {
        InboxTargetLegendKind.CountBand => entry.Label,
        InboxTargetLegendKind.Suppressed => Text["Inbox.Legend.Suppressed"],
        InboxTargetLegendKind.CriticalOutage => Text["Inbox.Legend.CriticalOutage"],
        InboxTargetLegendKind.ServiceHealthAlert => Text["Inbox.ServiceHealthAlert"],
        _ => throw new ArgumentOutOfRangeException(nameof(entry))
    };

    private string TargetOutputLegendDescription => Text.Format("Inbox.Legend.Description", string.Join("; ",
        TargetOutputDisplay.Legend().Select(entry => Text.Format("Inbox.Legend.Entry",
            TargetLegendLabel(entry), Text[$"Inbox.TargetColor.{entry.Color}"]))));

    private IReadOnlyList<HourlyAlertCount> GetHourlyAlertCounts()
    {
        var firstHour = GetChartFirstHour();
        var inboxAlerts = InboxAlerts;

        return Enumerable.Range(0, 48)
            .Select(offset =>
            {
                var hour = firstHour.AddHours(offset);
                var count = inboxAlerts.Count(alert =>
                    alert.MonitorCondition.Equals("Fired", StringComparison.OrdinalIgnoreCase) &&
                    alert.ReceivedAt >= hour &&
                    alert.ReceivedAt < hour.AddHours(1));
                return new HourlyAlertCount(hour, count);
            })
            .ToArray();
    }

    private IReadOnlyList<HourlyCriticalAlertCount> GetHourlyCriticalAlertCounts()
    {
        var visibleAlertIds = InboxAlerts.Select(alert => alert.AlertId).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var activeAlerts = ActiveAlerts;
        var suppressedActiveAlertIds = AlertRuleEvaluator.Categorize(
                activeAlerts, alertRules, InboxInventory, activeAlerts).Categories
            .Where(category => category.AnalysisClassification == AlertRuleAnalysisClassifications.Suppressed)
            .SelectMany(category => category.Alerts)
            .Select(alert => alert.AlertId);
        return CriticalAlertTimeline.GetHourlyCounts(
            criticalAlertLifecycles.Where(lifecycle => visibleAlertIds.Contains(lifecycle.AlertId)),
            GetChartFirstHour(), 48, currentTimeUtc, suppressedActiveAlertIds);
    }

    private DateTimeOffset GetChartFirstHour()
    {
        var currentHour = new DateTimeOffset(
            currentTimeUtc.Year,
            currentTimeUtc.Month,
            currentTimeUtc.Day,
            currentTimeUtc.Hour,
            0,
            0,
            TimeSpan.Zero);
        return currentHour.AddHours(-47);
    }

    private static string ChartPoints(IReadOnlyList<HourlyAlertCount> buckets, int maximumCount) =>
        string.Join(' ', buckets.Select((bucket, index) =>
        {
            var x = ChartX(index, buckets.Count);
            var y = ChartBottom - bucket.Count * (ChartBottom - ChartTop) / maximumCount;
            return FormattableString.Invariant($"{x:0.##},{y:0.##}");
        }));

    private static string CriticalChartPoints(
        IReadOnlyList<HourlyCriticalAlertCount> buckets,
        int maximumCount) =>
        string.Join(' ', buckets.Select((bucket, index) =>
        {
            var x = ChartX(index, buckets.Count);
            var y = ChartBottom - bucket.Count * (ChartBottom - ChartTop) / maximumCount;
            return FormattableString.Invariant($"{x:0.##},{y:0.##}");
        }));

    private static IReadOnlyList<int> GetChartTickIndexes(int bucketCount) =>
        Enumerable.Range(0, bucketCount)
            .Where(index => index % ChartTickIntervalHours == 0 || index == bucketCount - 1)
            .ToArray();

    private static double ChartX(int index, int bucketCount) =>
        index * ChartWidth / Math.Max(1, bucketCount - 1);

    private static string ChartCoordinate(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string ChartTickStyle(int index, int bucketCount) =>
        FormattableString.Invariant($"--chart-tick:{index * 100d / Math.Max(1, bucketCount - 1):0.##}%");

    private string ChartDescription(IReadOnlyList<HourlyAlertCount> buckets)
    {
        var total = buckets.Sum(bucket => bucket.Count);
        var maximum = buckets.Max(bucket => bucket.Count);
        return Text.Format("Inbox.ChartDescription", total, maximum);
    }

    private string CriticalChartDescription(IReadOnlyList<HourlyCriticalAlertCount> buckets)
    {
        var maximum = buckets.Max(bucket => bucket.Count);
        return Text.Format("Inbox.CriticalChartDescription", buckets[^1].Count, maximum);
    }

    private DateTime ToDisplayTime(DateTimeOffset timestamp) =>
        AlertTimeZones.ToDisplayTime(timestamp, selectedTimeZoneId);

    private string FormatTimestamp(DateTimeOffset timestamp) =>
        Text.Format("Inbox.TimestampValue", ToDisplayTime(timestamp));

    private string FormatPresentationValue(QueryResultValue value) =>
        value.Format.Equals("datetime", StringComparison.OrdinalIgnoreCase) &&
        DateTimeOffset.TryParse(value.Value, out var timestamp)
            ? FormatTimestamp(timestamp)
            : value.Value;

    private string FormatChartTime(DateTimeOffset timestamp) =>
        Text.Format("Inbox.ChartTime", ToDisplayTime(timestamp));

    private string TimeZoneLabel(AlertTimeZoneOption option) =>
        Text[$"Inbox.TimeZone.{option.Id}"];

    private string FormatCurrentTime() =>
        Text.Format("Inbox.ClockValue", ToDisplayTime(currentTimeUtc));

    private string FormatUtcOffset()
    {
        var offset = SelectedTimeZone.TimeZone.GetUtcOffset(currentTimeUtc);
        var sign = offset < TimeSpan.Zero ? '-' : '+';
        return $"UTC{sign}{Math.Abs(offset.Hours):00}:{Math.Abs(offset.Minutes):00}";
    }

    private void ChangeTimeZone(ChangeEventArgs eventArgs)
    {
        var newTimeZoneId = eventArgs.Value?.ToString() ?? "utc";
        if (newTimeZoneId.Equals(selectedTimeZoneId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (receivedFrom is not null)
        {
            receivedFrom = AlertTimeZones.ConvertWallClock(receivedFrom.Value, selectedTimeZoneId, newTimeZoneId);
            receivedFromInput = FormatDateTimeInput(receivedFrom.Value);
        }

        if (receivedTo is not null)
        {
            receivedTo = AlertTimeZones.ConvertWallClock(receivedTo.Value, selectedTimeZoneId, newTimeZoneId);
            receivedToInput = FormatDateTimeInput(receivedTo.Value);
        }

        selectedTimeZoneId = newTimeZoneId;
        ResetPagination();
    }

    private void ChangeReceivedFrom(ChangeEventArgs eventArgs)
    {
        receivedFromInput = eventArgs.Value?.ToString() ?? string.Empty;
        receivedFrom = ParseDateTimeInput(receivedFromInput);
        ResetPagination();
    }

    private void ChangeReceivedTo(ChangeEventArgs eventArgs)
    {
        receivedToInput = eventArgs.Value?.ToString() ?? string.Empty;
        receivedTo = ParseDateTimeInput(receivedToInput);
        ResetPagination();
    }

    private static DateTime? ParseDateTimeInput(string value) =>
        DateTime.TryParseExact(
            value,
            ["yyyy-MM-ddTHH:mm", "yyyy-MM-ddTHH:mm:ss"],
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out var parsedValue)
                ? parsedValue
                : null;

    private static string FormatDateTimeInput(DateTime value) =>
        value.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        currentUser = await CurrentUserIdentity.GetActorAsync(
            authenticationState.User,
            ApplicationAuthentication.IsOpen);
        dashboardOwnerKey = string.IsNullOrWhiteSpace(currentUser) ? "open-access" : currentUser;
        await LoadDashboardAsync();
        await LoadAlertsAsync();
        await RefreshRcaNoticesAsync();
        AlertStore.Changed += HandleStoreChanged;
        clockTask = RunClockAsync(clockCancellation.Token);
    }

    private async Task LoadDashboardAsync()
    {
        if (isLoadingDashboard)
            return;

        isLoadingDashboard = true;
        try
        {
            var savedDashboard = await InboxLayoutRepository.LoadRequiredAsync(dashboardOwnerKey);
            if (savedDashboard is not null)
            {
                Dashboard.Load(savedDashboard);
                dashboardStatus = Text["Inbox.WorkspaceRestored"];
            }
            else
            {
                dashboardStatus = Text["Inbox.WorkspaceReady"];
            }
            dashboardLoadFailed = false;
            dashboardSaveFailed = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load the saved inbox workspace.");
            dashboardLoadFailed = true;
            isDashboardEditEnabled = false;
            dashboardStatus = exception is IdentityMigrationException migration
                ? Text[migration.ResourceKey] : Text["Inbox.WorkspaceLoadFailed"];
        }
        finally
        {
            isLoadingDashboard = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!disposed && dashboardBrowser?.Initialized != true && DashboardBrowserError is null)
            await InitializeDashboardBrowserAsync();
    }

    private Task RetryDashboardBrowserAsync() => InitializeDashboardBrowserAsync();

    private Task InitializeDashboardBrowserAsync()
    {
        if (disposed) return Task.CompletedTask;
        dashboardBrowser ??= new(JS, Logger, "./js/inbox-dashboard.js", this, clockCancellation.Token);
        return dashboardBrowser.InitializeAsync(dashboardRoot,
            () => disposed ? Task.CompletedTask : InvokeAsync(StateHasChanged));
    }

    private async Task RunClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                currentTimeUtc = DateTimeOffset.UtcNow;
                await InvokeAsync(RefreshLiveDataAsync);
                if (currentTimeUtc - lastRcaNoticeRefresh >= TimeSpan.FromSeconds(30))
                {
                    await InvokeAsync(RefreshRcaNoticesAsync);
                }
                if (!isEditingDateTime)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void HandleStoreChanged()
    {
        if (!disposed) _ = InvokeAsync(ReloadAlertsAsync);
    }

    private Task RefreshLiveDataAsync() => currentTimeUtc - lastInboxDataRefresh >= TimeSpan.FromSeconds(30)
        ? LoadAlertsAsync() : Task.CompletedTask;

    private string RcaNoticeLabel(OpenRcaNotice notice) => notice.Domains.Count == 0
        ? Text.Format("Inbox.RcaNotice", notice.CategoryName)
        : Text.Format("Inbox.RcaNoticeWithDomains", notice.CategoryName, string.Join(", ", notice.Domains));

    private string RcaNoticeDetails(OpenRcaNotice notice) => Text.Format("Inbox.RcaNoticeDetails",
        RcaStatusLabel(notice.Status),
        string.IsNullOrWhiteSpace(notice.AssignedTo) ? Text["Inbox.RcaUnassigned"] : notice.AssigneeDisplayName ?? notice.AssignedTo);

    private string RcaStatusLabel(string status) => status switch
    {
        RcaStatuses.Open => Text["Inbox.RcaStatus.Open"],
        "InAnalysis" => Text["Inbox.RcaStatus.InAnalysis"],
        "Actions" => Text["Inbox.RcaStatus.Actions"],
        RcaStatuses.Closed => Text["Inbox.RcaStatus.Closed"],
        _ => RcaStatuses.Label(status)
    };

    private async Task RefreshRcaNoticesAsync()
    {
        lastRcaNoticeRefresh = DateTimeOffset.UtcNow;
        try
        {
            openRcaNotices = await RcaService.GetOpenNoticesAsync(clockCancellation.Token);
            rcaNoticeError = null;
        }
        catch (OperationCanceledException) when (clockCancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not refresh open RCA notices.");
            rcaNoticeError = Text[exception is RcaEvidenceException or RcaEvidenceJsonException
                ? "Rca.Errors.EvidenceInvalid" : "Inbox.RcaRefreshFailed"];
        }
    }

    private void BeginDateTimeEdit() => isEditingDateTime = true;

    private async Task ChangeViewModeAsync(ChangeEventArgs eventArgs)
    {
        var requestedViewMode = eventArgs.Value?.ToString() ?? "active";
        if (requestedViewMode == "history-fired" && !isFiredHistoryLoaded)
        {
            try
            {
                firedHistoryAlerts = await AlertStore.GetFiredHistoryRequiredAsync();
                isFiredHistoryLoaded = true;
                firedHistoryLoadError = null;
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Could not load fired alert history for the inbox.");
                firedHistoryLoadError = Text["Inbox.FiredHistoryLoadFailed"];
                return;
            }
        }

        viewMode = requestedViewMode;
        ResetPagination();
    }

    private void EndDateTimeEdit()
    {
        isEditingDateTime = false;
        currentTimeUtc = DateTimeOffset.UtcNow;
    }

    private async Task ReloadAlertsAsync()
    {
        await LoadAlertsAsync();
        await RefreshRcaNoticesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAlertsAsync()
    {
        if (disposed) return;
        await inboxReloadLock.WaitAsync();
        try
        {
            if (disposed) return;
            var refreshedAlerts = await AlertStore.GetAllRequiredAsync();
            var refreshedHistory = isFiredHistoryLoaded
                ? await AlertStore.GetFiredHistoryRequiredAsync()
                : firedHistoryAlerts;
            var refreshedInventory = await AlertStore.GetComputerInventoryAsync();
            var refreshedRules = await AlertStore.GetAllAlertRulesAsync();
            var refreshedHeartbeatAge = InventoryHeartbeatFreshnessRule.Resolve(refreshedRules);
            var refreshedLifecycles = await AlertStore.GetCriticalAlertLifecyclesRequiredAsync(
                GetChartFirstHour(),
                currentTimeUtc);
            if (disposed) return;

            alerts = refreshedAlerts;
            firedHistoryAlerts = refreshedHistory;
            computerInventory = refreshedInventory;
            alertRules = refreshedRules;
            currentHeartbeatAge = refreshedHeartbeatAge;
            criticalAlertLifecycles = refreshedLifecycles;
            inboxLoadError = null;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load the inbox alert data.");
            inboxLoadError = Text["Inbox.LoadFailed"];
        }
        finally
        {
            lastInboxDataRefresh = currentTimeUtc;
            inboxReloadLock.Release();
        }
    }

    private void SortBy(string column)
    {
        sortAscending = sortColumn == column ? !sortAscending : true;
        sortColumn = column;
        ResetPagination();
    }

    private string SortIndicator(string column) => sortColumn == column
        ? Text[sortAscending ? "Inbox.SortAscending" : "Inbox.SortDescending"]
        : string.Empty;

    private void ToggleDetails(AlertRecord alert)
    {
        expandedAlertId = expandedAlertId == alert.Id ? null : alert.Id;
        commentDraft = expandedAlertId is null ? string.Empty : alert.Comments;
        commentSaveError = string.Empty;
    }

    private async Task SaveCommentsAsync(Guid id)
    {
        isSavingComment = true;
        commentSaveError = string.Empty;

        bool updated;
        try
        {
            if (CurrentUserIdentity.DirectoryEnabled)
                currentUser = await CurrentUserIdentity.GetActorAsync(
                    (await AuthenticationStateTask).User, ApplicationAuthentication.IsOpen);
            updated = await AlertStore.UpdateCommentsAsync(id, commentDraft, currentUser);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Comment save could not be confirmed for alert {AlertRecordId}.", id);
            commentSaveError = Text["Inbox.CommentSaveUnconfirmed"];
            return;
        }
        finally
        {
            isSavingComment = false;
        }

        if (!updated)
        {
            commentSaveError = Text["Inbox.CommentAlertMissing"];
        }
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        domainFilter = string.Empty;
        roleFilter = string.Empty;
        targetNameFilter = string.Empty;
        receivedFromInput = string.Empty;
        receivedToInput = string.Empty;
        receivedFrom = null;
        receivedTo = null;
        ResetPagination();
    }

    private void SelectTreeNode(
        string domain = "",
        string role = "",
        string targetName = "")
    {
        domainFilter = domain;
        roleFilter = role;
        targetNameFilter = targetName;
        ResetPagination();
    }

    private void ResetPagination()
    {
        currentPage = 1;
        expandedAlertId = null;
        commentDraft = string.Empty;
        commentSaveError = string.Empty;
    }

    private void ChangePage(int page)
    {
        currentPage = Math.Max(1, page);
        expandedAlertId = null;
        commentDraft = string.Empty;
        commentSaveError = string.Empty;
    }

    private string PageRangeLabel(int totalCount)
    {
        if (totalCount == 0)
        {
            return "0";
        }

        var first = (currentPage - 1) * PageSize + 1;
        var last = Math.Min(currentPage * PageSize, totalCount);
        return $"{first}-{last}";
    }

    private IEnumerable<int> VisiblePageNumbers(int pageCount)
    {
        const int maximumButtons = 7;
        var first = Math.Max(1, currentPage - maximumButtons / 2);
        var last = Math.Min(pageCount, first + maximumButtons - 1);
        first = Math.Max(1, last - maximumButtons + 1);
        return Enumerable.Range(first, last - first + 1);
    }

    private bool IsTreeSelection(string domain, string role, string targetName) =>
        domainFilter.Equals(domain, StringComparison.OrdinalIgnoreCase) &&
        roleFilter.Equals(role, StringComparison.OrdinalIgnoreCase) &&
        targetNameFilter.Equals(targetName, StringComparison.OrdinalIgnoreCase);

    private void ToggleDomain(string domain)
    {
        if (!expandedDomains.Remove(domain))
        {
            expandedDomains.Add(domain);
        }
    }

    private void ToggleRole(string key)
    {
        if (!expandedRoles.Remove(key))
        {
            expandedRoles.Add(key);
        }
    }

    private static string TreeKey(string domain, string role) => $"{domain}\u001f{role}";

    private bool MatchesInventoryFilter(AlertRecord alert, string domain, string role)
    {
        if (string.IsNullOrWhiteSpace(domain) && string.IsNullOrWhiteSpace(role))
        {
            return true;
        }

        var entry = computerInventory.FirstOrDefault(candidate =>
            candidate.SubscriptionId.Equals(alert.SubscriptionId, StringComparison.OrdinalIgnoreCase) &&
            candidate.Computer.Equals(alert.TargetName, StringComparison.OrdinalIgnoreCase));
        return MatchesInventoryFilter(entry, domain, role);
    }

    private static bool MatchesInventoryFilter(ComputerInventoryEntry? entry, string domain, string role)
    {
        var alertDomain = string.IsNullOrWhiteSpace(entry?.Domain) ? "Unknown domain" : entry.Domain.Trim();
        var alertRole = string.IsNullOrWhiteSpace(entry?.Role) ? "Unknown role" : entry.Role.Trim();
        return (string.IsNullOrWhiteSpace(domain) || alertDomain.Equals(domain, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(role) || alertRole.Equals(role, StringComparison.OrdinalIgnoreCase));
    }

    private static string Display(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string? AlertTitleClass(string monitorCondition) => monitorCondition.ToUpperInvariant() switch
    {
        "FIRED" => "alert-title-fired",
        "RESOLVED" => "alert-title-resolved",
        _ => null
    };

    private static string SearchableText(AlertRecord alert) => string.Join(' ',
        alert.Name,
        alert.Description,
        alert.Severity,
        alert.Status,
        alert.SignalType,
        alert.MonitorCondition,
        alert.Target,
        alert.TargetName,
        alert.TargetDisplayName,
        alert.SiteName,
        alert.ResourceGroup,
        alert.SearchQuery,
        alert.SubscriptionId,
        alert.AlertId,
        alert.Comments);

    private InboxDashboardWidget? GetWidget(InboxWidgetKind kind) =>
        Dashboard.Document.Widgets.FirstOrDefault(widget => widget.Kind == kind);

    private void DashboardEditModeChanged()
    {
        if (!isDashboardEditEnabled)
        {
            selectedDashboardWidgetId = null;
            EndDashboardDrag();
        }
    }

    private void SelectDashboardWidget(string id)
    {
        if (isDashboardEditEnabled)
        {
            selectedDashboardWidgetId = id;
        }
    }

    private void StartTemplateDrag(InboxWidgetKind kind)
    {
        if (!isDashboardEditEnabled || GetWidget(kind) is not null)
        {
            return;
        }

        draggedDashboardTemplate = kind;
        draggedDashboardWidgetId = null;
    }

    private void StartDashboardWidgetDrag(string id)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        selectedDashboardWidgetId = id;
        draggedDashboardWidgetId = id;
        draggedDashboardTemplate = null;
    }

    private void EndDashboardDrag()
    {
        draggedDashboardWidgetId = null;
        draggedDashboardTemplate = null;
        dashboardDropTarget = null;
    }

    private async Task DropDashboardWidgetAsync(int column, int row)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        if (draggedDashboardTemplate is { } kind && GetWidget(kind) is null)
        {
            var widget = Dashboard.AddWidget(kind, column, row);
            selectedDashboardWidgetId = widget.Id;
        }
        else if (draggedDashboardWidgetId is { } id)
        {
            Dashboard.MoveWidget(id, column, row);
        }
        else
        {
            return;
        }

        EndDashboardDrag();
        await SaveDashboardAsync("Inbox.PositionSaved");
    }

    private async Task AddDashboardWidgetAsync(InboxWidgetKind kind)
    {
        if (!isDashboardEditEnabled || GetWidget(kind) is not null)
        {
            return;
        }

        var widget = Dashboard.AddWidget(kind);
        selectedDashboardWidgetId = widget.Id;
        await SaveDashboardAsync("Inbox.SectionAdded");
    }

    private async Task ChangeDashboardRowsAsync(ChangeEventArgs eventArgs)
    {
        if (isDashboardEditEnabled && int.TryParse(eventArgs.Value?.ToString(), out var rows))
        {
            Dashboard.UpdateWorkspace(document => document.Rows = rows);
            await SaveDashboardAsync("Inbox.RowsSaved");
        }
    }

    private async Task ChangeDashboardRowHeightAsync(ChangeEventArgs eventArgs)
    {
        if (isDashboardEditEnabled && int.TryParse(eventArgs.Value?.ToString(), out var rowHeight))
        {
            Dashboard.UpdateWorkspace(document => document.RowHeight = rowHeight);
            await SaveDashboardAsync("Inbox.RowSizeSaved");
        }
    }

    private async Task NudgeDashboardSizeAsync(string id, int columns, int rows)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        var widget = Dashboard.Document.Widgets.First(item => item.Id == id);
        Dashboard.ResizeWidget(id, widget.ColumnSpan + columns, widget.RowSpan + rows);
        await SaveDashboardAsync("Inbox.SizeSaved");
    }

    private async Task NudgeDashboardPositionAsync(string id, int columns, int rows)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        var widget = Dashboard.Document.Widgets.First(item => item.Id == id);
        Dashboard.MoveWidget(id, widget.Column + columns, widget.Row + rows);
        await SaveDashboardAsync("Inbox.PositionSaved");
    }

    private async Task RemoveDashboardWidgetAsync(string id)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        Dashboard.RemoveWidget(id);
        selectedDashboardWidgetId = null;
        await SaveDashboardAsync("Inbox.SectionRemoved");
    }

    private async Task HandleDashboardWidgetActionAsync(string id, string action)
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        switch (action)
        {
            case "left":
                await NudgeDashboardPositionAsync(id, -1, 0);
                break;
            case "right":
                await NudgeDashboardPositionAsync(id, 1, 0);
                break;
            case "up":
                await NudgeDashboardPositionAsync(id, 0, -1);
                break;
            case "down":
                await NudgeDashboardPositionAsync(id, 0, 1);
                break;
            case "narrower":
                await NudgeDashboardSizeAsync(id, -1, 0);
                break;
            case "wider":
                await NudgeDashboardSizeAsync(id, 1, 0);
                break;
            case "shorter":
                await NudgeDashboardSizeAsync(id, 0, -1);
                break;
            case "taller":
                await NudgeDashboardSizeAsync(id, 0, 1);
                break;
            case "remove":
                await RemoveDashboardWidgetAsync(id);
                break;
        }
    }

    [JSInvokable]
    public async Task CommitDashboardResize(string id, int columnSpan, int rowSpan)
    {
        if (!CanUseDashboardBrowser)
        {
            return;
        }

        Dashboard.ResizeWidget(id, columnSpan, rowSpan);
        await SaveDashboardAsync("Inbox.SizeSaved");
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CommitDashboardMove(string id, int column, int row)
    {
        if (!CanUseDashboardBrowser)
        {
            return;
        }

        selectedDashboardWidgetId = id;
        Dashboard.MoveWidget(id, column, row);
        await SaveDashboardAsync("Inbox.PositionSaved");
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleDashboardGridAsync()
    {
        if (dashboardLoadFailed || isLoadingDashboard)
            return;

        Dashboard.UpdateWorkspace(document => document.ShowGrid = !document.ShowGrid);
        await SaveDashboardAsync("Inbox.GridSaved");
    }

    private async Task UndoDashboardAsync()
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        Dashboard.Undo();
        selectedDashboardWidgetId = null;
        await SaveDashboardAsync("Inbox.ChangeUndone");
    }

    private async Task RedoDashboardAsync()
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        Dashboard.Redo();
        selectedDashboardWidgetId = null;
        await SaveDashboardAsync("Inbox.ChangeRestored");
    }

    private async Task ResetDashboardAsync()
    {
        if (!isDashboardEditEnabled)
        {
            return;
        }

        Dashboard.Reset();
        selectedDashboardWidgetId = null;
        await SaveDashboardAsync("Inbox.DefaultRestored");
    }

    private async Task SaveDashboardAsync(string statusKey)
    {
        if (dashboardLoadFailed || isLoadingDashboard)
        {
            Logger.LogWarning("Inbox workspace save is blocked until its saved layout has been loaded.");
            return;
        }

        int revision;
        try
        {
            var result = await InboxLayoutRepository.SaveAsync(dashboardOwnerKey, Dashboard.Document);
            revision = result.Revision;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Inbox workspace save could not be confirmed.");
            dashboardSaveFailed = true;
            dashboardStatus = exception is IdentityMigrationException migration
                ? Text[migration.ResourceKey] : Text["Inbox.WorkspaceSaveUnconfirmed"];
            return;
        }
        dashboardSaveFailed = false;
        dashboardStatus = Text.Format(statusKey, revision);
    }

    private static string DashboardWidgetStyle(InboxDashboardWidget widget) =>
        $"grid-column:{widget.Column} / span {widget.ColumnSpan};grid-row:{widget.Row} / span {widget.RowSpan};";

    private sealed record HourlyAlertCount(DateTimeOffset Hour, int Count);

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        AlertStore.Changed -= HandleStoreChanged;
        clockCancellation.Cancel();
        if (clockTask is not null) await clockTask;
        if (dashboardBrowser is not null) await dashboardBrowser.DisposeAsync();
        clockCancellation.Dispose();
    }
}