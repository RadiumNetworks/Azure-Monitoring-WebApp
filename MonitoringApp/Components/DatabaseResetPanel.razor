@inject DatabaseResetService DatabaseReset
@inject DatabaseConfigurationStatus DatabaseConfiguration
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<DatabaseResetPanel> Logger
@inject UiText Text

<section class="admin-editor" aria-labelledby="database-reset-heading">
    <div class="admin-section-heading">
        <div>
            <p class="eyebrow">@Text["DatabaseReset.DangerZone"]</p>
            <h2 id="database-reset-heading">@Text["DatabaseReset.Title"]</h2>
        </div>
    </div>
    <div class="admin-message admin-message-warning" role="alert">
        <strong>@Text["DatabaseReset.BackupWarning"]</strong>
        <p>@Text["DatabaseReset.ScopeWarning"]</p>
        <p>@Text["DatabaseReset.PreservedWarning"]</p>
        <p>@Text["DatabaseReset.PauseWarning"]</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="admin-message admin-message-success" role="status">@statusMessage</div>
    }
    @if (!showConfirmation && !string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
    }
    <button class="admin-danger" type="button" disabled="@(isResetting || !DatabaseConfiguration.IsValid)"
            @onclick="BeginReset">@Text[resetReviewRequired ? "DatabaseReset.PrepareAgain" : "DatabaseReset.Begin"]</button>
</section>

@if (showConfirmation)
{
    <div class="admin-dialog-backdrop" role="presentation">
        <section class="admin-dialog" role="dialog" aria-modal="true"
                 aria-labelledby="confirm-database-reset-heading" aria-describedby="database-reset-warning">
            <p class="eyebrow">@Text["Common.PermanentAction"]</p>
            <h2 id="confirm-database-reset-heading">@Text["DatabaseReset.ConfirmTitle"]</h2>
            <p id="database-reset-warning">
                @Text["DatabaseReset.ConfirmBody"]
            </p>
            @if (resetReviewRequired)
            {
                <p class="admin-message admin-message-warning" role="alert">@Text["DatabaseReset.ReviewRequired"]</p>
                <label class="admin-check">
                    <input type="checkbox" disabled="@isResetting" @bind="databaseReviewed" />
                    @Text["DatabaseReset.ReviewAcknowledgement"]
                </label>
            }
            <p>
                <LocalizedContent ResourceKey="DatabaseReset.DatabaseTarget">
                    <Value0><strong>@DatabaseConfiguration.Database</strong></Value0>
                    <Value1><strong>@DatabaseConfiguration.Server</strong></Value1>
                </LocalizedContent>
            </p>
            <label class="admin-field">
                <span><LocalizedContent ResourceKey="DatabaseReset.ConfirmationHint"><Value0>RESET</Value0></LocalizedContent></span>
                <input autocomplete="off" spellcheck="false" disabled="@isResetting"
                       @bind="confirmation" @bind:event="oninput" />
            </label>
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
            }
            <div class="admin-form-actions">
                <button class="admin-secondary" type="button" disabled="@isResetting" @onclick="CancelReset">@Text["Common.Cancel"]</button>
                <button class="admin-danger" type="button" disabled="@(isResetting || confirmation != "RESET" || resetReviewRequired && !databaseReviewed)"
                        @onclick="ResetAsync">@Text[isResetting ? "DatabaseReset.Resetting" : "DatabaseReset.Confirm"]</button>
            </div>
        </section>
    </div>
}

@code {
    private bool showConfirmation;
    private bool isResetting;
    private bool resetReviewRequired;
    private bool databaseReviewed;
    private string confirmation = string.Empty;
    private string? statusMessage;
    private string? errorMessage;

    private void BeginReset()
    {
        if (isResetting) return;
        confirmation = string.Empty;
        databaseReviewed = false;
        statusMessage = null;
        errorMessage = null;
        showConfirmation = true;
    }

    private void CancelReset()
    {
        if (isResetting) return;
        showConfirmation = false;
        confirmation = string.Empty;
        databaseReviewed = false;
        errorMessage = null;
    }

    private async Task ResetAsync()
    {
        if (isResetting)
            return;

        if (resetReviewRequired && (!showConfirmation || !databaseReviewed))
        {
            errorMessage = Text["DatabaseReset.ReviewRequired"];
            Logger.LogWarning("Blocked database reset pending explicit database-state review.");
            return;
        }

        isResetting = true;
        statusMessage = null;
        errorMessage = null;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var ruleCount = await DatabaseReset.ResetAsync(user, confirmation);
            showConfirmation = false;
            resetReviewRequired = false;
            databaseReviewed = false;
            statusMessage = Text.Plural("DatabaseReset.Completed", ruleCount);
        }
        catch (Exception exception)
        {
            var validation = MaintenanceErrorPresentation.ValidationMessage(exception, legacy: false, Text);
            if (validation is not null)
            {
                Logger.LogWarning(exception, "The admin database reset action was rejected.");
                errorMessage = validation;
            }
            else
            {
                Logger.LogError(exception, "The admin database reset outcome is unconfirmed.");
                errorMessage = Text["DatabaseReset.Unconfirmed"];
                resetReviewRequired = true;
                databaseReviewed = false;
                showConfirmation = false;
            }
        }
        finally
        {
            confirmation = string.Empty;
            isResetting = false;
        }
    }
}
