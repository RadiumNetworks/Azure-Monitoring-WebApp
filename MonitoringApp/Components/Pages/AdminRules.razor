@page "/admin/rules"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "OperatorAccess")]
@inject AlertStore AlertStore
@inject UiText Text
@inject ILogger<AdminRules> Logger

<PageTitle>@Text["Rules.PageTitle"]</PageTitle>

<section class="admin-heading">
    <div>
        <p class="eyebrow">@Text["Rules.Eyebrow"]</p>
        <h1>@Text["Rules.Title"]</h1>
        <p class="subtitle">@Text["Rules.Description"]</p>
    </div>
    <div class="admin-card-actions">
        <button class="admin-primary" type="button" @onclick="BeginCreate">@Text["Rules.Create"]</button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="admin-message admin-message-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}

<div class="admin-workspace">
    <section class="admin-rule-list" aria-labelledby="rules-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="rules-heading">@Text["Rules.Current"]</h2>
                <span>@RuleCountLabel(rules.Count)</span>
            </div>
            <button class="admin-secondary" type="button" disabled="@isLoading" @onclick="LoadRulesAsync">
                @Text[isLoading ? "Common.Refreshing" : "Common.Refresh"]
            </button>
        </div>

        @if (isLoading && rules.Count == 0)
        {
            <p class="admin-empty">@Text["Rules.Loading"]</p>
        }
        else if (rules.Count == 0)
        {
            <p class="admin-empty">@Text["Rules.Empty"]</p>
        }
        else
        {
            <div class="admin-rule-cards">
                @foreach (var rule in rules)
                {
                    var isExpanded = IsExpanded(rule);
                    <article class="admin-rule-card collapsible-rule-card @(editingRule?.Id == rule.Id ? "selected" : null) @(isExpanded ? "expanded" : null)">
                        <button class="collapsible-card-toggle" type="button" aria-expanded="@isExpanded.ToString().ToLowerInvariant()" @onclick="() => ToggleExpanded(rule)">
                            <strong title="@rule.Name">@rule.Name</strong>
                            <span title="@RuleTypeLabel(rule)">@RuleTypeLabel(rule)</span>
                            <span class="collapsible-card-chevron" aria-hidden="true"></span>
                        </button>
                        @if (isExpanded)
                        {
                            <div class="collapsible-card-details">
                                <div class="collapsible-card-toolbar">
                                    <span class="admin-status @(rule.Enabled ? "enabled" : "disabled")">
                                        @Text[rule.Enabled ? "Common.Enabled" : "Common.Disabled"]
                                    </span>
                                    <div class="admin-card-actions">
                                        <button class="admin-secondary" type="button" @onclick="() => BeginEdit(rule)">@Text["Common.Edit"]</button>
                                        <button class="admin-danger" type="button" @onclick="() => BeginDelete(rule)">@Text["Common.Delete"]</button>
                                    </div>
                                </div>
                                <dl class="admin-rule-summary">
                                    @if (rule.RuleType is not (AlertRuleTypes.InventoryHeartbeatFreshness or AlertRuleTypes.ReplicationInventoryWarning))
                                    {
                                        <div><dt>@Text["Rules.Priority"]</dt><dd>@rule.Priority.ToString(System.Globalization.CultureInfo.CurrentUICulture)</dd></div>
                                    }
                                    <div><dt>@Text["Rules.Type"]</dt><dd>@RuleTypeLabel(rule)</dd></div>
                                    <div><dt>@Text["Rules.Condition"]</dt><dd>@ConditionLabel(rule)</dd></div>
                                    @if (rule.RuleType == AlertRuleTypes.Categorization)
                                    {
                                        <div><dt>@Text["Rules.Category"]</dt><dd>@rule.CategoryName</dd></div>
                                        <div><dt>@Text["Rules.Scope"]</dt><dd>@Text[rule.ApplyToTarget ? "Rules.Scope.AllTargetAlerts" : "Rules.Scope.MatchingAlert"]</dd></div>
                                        <div><dt>@Text["Rules.Criticality"]</dt><dd>@Text[rule.IsCritical ? "Rules.Critical" : "Rules.Standard"]</dd></div>
                                        <div><dt>@Text["Rules.AnalysisClassification"]</dt><dd>@AnalysisClassificationLabel(rule.AnalysisClassification)</dd></div>
                                    }
                                    else if (rule.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness)
                                    {
                                        <div><dt>@Text["Rules.Scope"]</dt><dd>@Text["Rules.Scope.AllInventoryTargets"]</dd></div>
                                        <div><dt>@Text["Rules.HeartbeatFreshness"]</dt><dd>@Text.Plural("Rules.DurationMinutes", rule.Threshold)</dd></div>
                                        <div><dt>@Text["Rules.DefaultWhenDisabledOrDeleted"]</dt><dd>@Text.Plural("Rules.DurationMinutes", InventoryHeartbeatFreshnessRule.DefaultMinutes)</dd></div>
                                    }
                                    else if (rule.RuleType == AlertRuleTypes.ReplicationInventoryWarning)
                                    {
                                        <div><dt>@Text["Rules.Scope"]</dt><dd>@Text["Rules.Scope.ReplicationResults"]</dd></div>
                                        <div><dt>@Text["Rules.Action"]</dt><dd>@Text["Rules.Editor.RetiredReplicationHelp"]</dd></div>
                                        <div><dt>@Text["Rules.Inventory"]</dt><dd>@Text["Rules.Action.InventoryUnchanged"]</dd></div>
                                    }
                                    else if (rule.RuleType == AlertRuleTypes.InventoryRoleAssignment)
                                    {
                                        <div><dt>@Text["Rules.Action"]</dt><dd>@Text["Rules.Action.RetiredRoleAssignment"]</dd></div>
                                    }
                                    else
                                    {
                                        <div><dt>@Text["Rules.Action"]</dt><dd>@Text["Rules.Action.UpdateInventory"]</dd></div>
                                    }
                                </dl>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="admin-editor" aria-labelledby="editor-heading">
        @if (editingRule is null)
        {
            <div class="admin-editor-placeholder">
                <strong>@Text["Rules.Editor.PlaceholderTitle"]</strong>
                <span>@Text["Rules.Editor.PlaceholderDescription"]</span>
            </div>
        }
        else
        {
            var rule = editingRule;
            <div class="admin-section-heading">
                <div>
                    <p class="eyebrow">@Text[isCreating ? "Rules.Editor.NewRule" : "Rules.Editor.EditRule"]</p>
                    <h2 id="editor-heading">@(isCreating ? Text["Rules.Editor.CreateTitle"] : rule.Name)</h2>
                </div>
            </div>

            <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label class="admin-field admin-field-wide">
                    <span>@Text["Rules.Editor.Name"]</span>
                    <input required maxlength="256" @bind="rule.Name" />
                    <small>@Text["Rules.Editor.NameHelp"]</small>
                </label>

                @if (rule.RuleType is not (AlertRuleTypes.InventoryHeartbeatFreshness or AlertRuleTypes.ReplicationInventoryWarning))
                {
                <label class="admin-field">
                    <span>@Text["Rules.Priority"]</span>
                    <input type="number" min="0" required @bind="rule.Priority" />
                    <small>@Text["Rules.Editor.PriorityHelp"]</small>
                </label>
                }

                <label class="admin-check">
                    <input type="checkbox" disabled="@(rule.RuleType is AlertRuleTypes.InventoryRoleAssignment or AlertRuleTypes.ReplicationInventoryWarning)" @bind="rule.Enabled" />
                    <span>@Text["Rules.Editor.Enabled"]</span>
                </label>

                <label class="admin-field admin-field-wide">
                    <span>@Text["Rules.Editor.Type"]</span>
                    <select @bind="rule.RuleType" @bind:after="RuleTypeChanged">
                        <option value="@AlertRuleTypes.Categorization">@Text["Rules.TypeOption.Categorization"]</option>
                        <option value="@AlertRuleTypes.Suppression">@Text["Rules.TypeOption.Suppression"]</option>
                        <option value="@AlertRuleTypes.InventoryStatus">@Text["Rules.TypeOption.InventoryStatus"]</option>
                        @if (rule.RuleType == AlertRuleTypes.InventoryRoleAssignment)
                        {
                            <option value="@AlertRuleTypes.InventoryRoleAssignment">@Text["Rules.TypeOption.RetiredRoleAssignment"]</option>
                        }
                        @if (rule.RuleType == AlertRuleTypes.ReplicationInventoryWarning)
                        {
                            <option value="@AlertRuleTypes.ReplicationInventoryWarning">@Text["Rules.TypeOption.RetiredReplicationWarning"]</option>
                        }
                        <option value="@AlertRuleTypes.InventoryHeartbeatFreshness" disabled="@rules.Any(existing => existing.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness && existing.Id != rule.Id)">@Text["Rules.TypeOption.HeartbeatFreshness"]</option>
                    </select>
                </label>

                @if (rule.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness)
                {
                    <fieldset class="admin-fieldset">
                        <legend>@Text["Rules.Editor.FreshnessLegend"]</legend>
                        <label class="admin-field admin-field-wide">
                            <span>@Text["Rules.Editor.FreshnessLimit"]</span>
                            <input type="number" min="1" required @bind="rule.Threshold" />
                            <small>@Text["Rules.Editor.FreshnessHelp"]</small>
                            <small>@Text.Plural("Rules.Editor.FreshnessDefaultHelp", InventoryHeartbeatFreshnessRule.DefaultMinutes)</small>
                        </label>
                    </fieldset>
                }
                else if (rule.RuleType == AlertRuleTypes.ReplicationInventoryWarning)
                {
                    <fieldset class="admin-fieldset">
                        <legend>@Text["Rules.Editor.ReplicationLegend"]</legend>
                        <p>@Text["Rules.Editor.RetiredReplicationHelp"]</p>
                        <p>@Text["Rules.Editor.ReplicationRetentionHelp"]</p>
                    </fieldset>
                }
                else
                {
                <fieldset class="admin-fieldset">
                    <legend>@Text["Rules.Editor.MatchingLegend"]</legend>
                    <label class="admin-field">
                        <span>@Text["Rules.Editor.AlertNameContains"]</span>
                        <input maxlength="256" @bind="rule.AlertNameContains" />
                        <small>@Text["Rules.Editor.AlertNameHelp"]</small>
                    </label>
                    <label class="admin-field">
                        <span>@Text["Rules.Editor.QueryResultType"]</span>
                        <input maxlength="128" @bind="rule.QueryResultType" />
                        <small>@Text["Rules.Editor.QueryResultTypeHelp"]</small>
                    </label>
                    @if (rule.RuleType != AlertRuleTypes.InventoryRoleAssignment)
                    {
                        <label class="admin-field admin-field-wide">
                            <span>@Text["Rules.Condition"]</span>
                            <select @bind="rule.ConditionType">
                                @if (rule.RuleType is AlertRuleTypes.Suppression or AlertRuleTypes.InventoryStatus)
                                {
                                    <option value="@AlertRuleConditionTypes.AnyMatchingAlert">@Text["Rules.ConditionOption.AnyMatchingAlert"]</option>
                                }
                                <option value="@AlertRuleConditionTypes.RowCountGreaterThan">@Text["Rules.ConditionOption.RowCountGreaterThan"]</option>
                                <option value="@AlertRuleConditionTypes.RowCountEquals">@Text["Rules.ConditionOption.RowCountEquals"]</option>
                                <option value="@AlertRuleConditionTypes.OnlyFailedItems">@Text["Rules.ConditionOption.OnlyFailedItems"]</option>
                                <option value="@AlertRuleConditionTypes.NoFailedItems">@Text["Rules.ConditionOption.NoFailedItems"]</option>
                                @if (rule.RuleType == AlertRuleTypes.Categorization)
                                {
                                    <option value="@AlertRuleConditionTypes.DomainControllerPercentageInDomain">@Text["Rules.ConditionOption.DomainPercentage"]</option>
                                    <option value="@AlertRuleConditionTypes.AllDomainControllersInSite">@Text["Rules.ConditionOption.AllSiteControllers"]</option>
                                }
                            </select>
                        </label>
                        @if (rule.ConditionType is AlertRuleConditionTypes.RowCountGreaterThan or AlertRuleConditionTypes.RowCountEquals)
                        {
                            <label class="admin-field admin-field-wide">
                                <span>@Text["Rules.Editor.RowCountThreshold"]</span>
                                <input type="number" min="0" required @bind="rule.Threshold" />
                                <small>@Text[rule.ConditionType == AlertRuleConditionTypes.RowCountEquals
                                    ? "Rules.Editor.RowCountEqualsHelp" : "Rules.Editor.RowCountGreaterHelp"]</small>
                            </label>
                        }
                        else if (rule.ConditionType == AlertRuleConditionTypes.DomainControllerPercentageInDomain)
                        {
                            <label class="admin-field admin-field-wide">
                                <span>@Text["Rules.Editor.DomainPercentage"]</span>
                                <input type="number" min="0" max="100" required @bind="rule.Threshold" />
                                <small>@Text["Rules.Editor.DomainPercentageHelp"]</small>
                            </label>
                        }
                        else if (rule.ConditionType == AlertRuleConditionTypes.OnlyFailedItems)
                        {
                            <label class="admin-field admin-field-wide">
                                <span>@Text["Rules.Editor.FailedItemNames"]</span>
                                <input required maxlength="256" @bind="rule.FailedItemName" />
                                <small>@Text["Rules.Editor.FailedItemNamesHelp"]</small>
                            </label>
                        }
                    }
                    else
                    {
                        <label class="admin-field admin-field-wide">
                            <span>@Text["Rules.Editor.InventoryRole"]</span>
                            <input required maxlength="256" @bind="rule.InventoryRole" />
                            <small>@Text["Rules.Editor.RetiredRoleHelp"]</small>
                        </label>
                    }
                </fieldset>
                }

                @if (rule.RuleType == AlertRuleTypes.Categorization)
                {
                    <fieldset class="admin-fieldset">
                    <legend>@Text["Rules.Editor.CategoryLegend"]</legend>
                    <label class="admin-field admin-field-wide">
                        <span>@Text["Rules.Editor.CategoryName"]</span>
                        <input required maxlength="256" @bind="rule.CategoryName" />
                    </label>
                    <label class="admin-field">
                        <span>@Text["Rules.Editor.Tone"]</span>
                        <select @bind="rule.Tone">
                            <option value="info">@Text["Rules.Tone.Information"]</option>
                            <option value="failure">@Text["Rules.Tone.Failure"]</option>
                        </select>
                    </label>
                    <label class="admin-field">
                        <span>@Text["Rules.AnalysisClassification"]</span>
                        <select @bind="rule.AnalysisClassification">
                            <option value="@AlertRuleAnalysisClassifications.None">@Text["Rules.Classification.Standard"]</option>
                            <option value="@AlertRuleAnalysisClassifications.SystemOutage">@Text["Rules.Classification.SystemOutage"]</option>
                            <option value="@AlertRuleAnalysisClassifications.Suppressed">@Text["Rules.Classification.Suppressed"]</option>
                        </select>
                        <small>@Text["Rules.Editor.ClassificationHelp"]</small>
                    </label>
                    <div class="admin-check-group">
                        <label class="admin-check">
                            <input type="checkbox" @bind="rule.Collapsed" />
                            <span>@Text["Rules.Editor.Collapsed"]</span>
                        </label>
                        <label class="admin-check">
                            <input type="checkbox" @bind="rule.ApplyToTarget" />
                            <span>@Text["Rules.Editor.ApplyToTarget"]</span>
                        </label>
                        <label class="admin-check">
                            <input type="checkbox" @bind="rule.IsCritical" />
                            <span>@Text["Rules.Editor.Critical"]</span>
                        </label>
                    </div>
                    </fieldset>
                }

                <div class="admin-form-actions">
                    <button class="admin-secondary" type="button" disabled="@isSaving" @onclick="CancelEdit">@Text["Common.Cancel"]</button>
                    <button class="admin-primary" type="submit" disabled="@isSaving">
                        @Text[isSaving ? "Common.Saving" : isCreating ? "Rules.Create" : "Common.SaveChanges"]
                    </button>
                </div>
            </form>
        }
    </section>
</div>

@if (ruleToDelete is not null)
{
    <div class="admin-dialog-backdrop" role="presentation">
        <section class="admin-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-rule-heading">
            <p class="eyebrow">@Text["Rules.Delete.Eyebrow"]</p>
            <h2 id="delete-rule-heading">@Text["Rules.Delete.Title"]</h2>
            <p>
                <LocalizedEmphasis ResourceKey="Rules.Delete.Confirmation" Value="@ruleToDelete.Name" />
                @DeleteImpact(ruleToDelete)
            </p>
            <div class="admin-form-actions">
                <button class="admin-secondary" type="button" disabled="@isDeleting" @onclick="CancelDelete">@Text["Common.Cancel"]</button>
                <button class="admin-danger" type="button" disabled="@isDeleting" @onclick="DeleteAsync">
                    @Text[isDeleting ? "Common.Deleting" : "Rules.Delete.Submit"]
                </button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<AlertRule> rules = [];
    private readonly HashSet<Guid> expandedRules = [];
    private AlertRule? editingRule;
    private AlertRule? ruleToDelete;
    private bool isCreating;
    private bool isLoading;
    private bool isSaving;
    private bool isDeleting;
    private string? statusMessage;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadRulesAsync();

    private async Task<bool> LoadRulesAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            rules = await AlertStore.GetAllAlertRulesAsync();
            return true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the alert rule editor.");
            errorMessage = Text["Rules.Errors.LoadFailed"];
            return false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginCreate()
    {
        editingRule = new AlertRule
        {
            Enabled = true,
            Priority = rules.Count == 0 ? 10 : rules.Max(rule => rule.Priority) + 10,
            RuleType = AlertRuleTypes.Categorization,
            ConditionType = AlertRuleConditionTypes.RowCountGreaterThan,
            Collapsed = true,
            Tone = "info"
        };
        isCreating = true;
        statusMessage = null;
        errorMessage = null;
    }

    private void BeginEdit(AlertRule source)
    {
        editingRule = Clone(source);
        isCreating = false;
        statusMessage = null;
        errorMessage = null;
    }

    private void RuleTypeChanged()
    {
        if (editingRule?.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness)
        {
            editingRule.Threshold = InventoryHeartbeatFreshnessRule.DefaultMinutes;
        }
    }

    private bool IsExpanded(AlertRule rule) => expandedRules.Contains(rule.Id);

    private void ToggleExpanded(AlertRule rule)
    {
        if (!expandedRules.Add(rule.Id))
        {
            expandedRules.Remove(rule.Id);
        }
    }

    private void CancelEdit()
    {
        editingRule = null;
        isCreating = false;
        errorMessage = null;
    }

    private void BeginDelete(AlertRule source)
    {
        ruleToDelete = Clone(source);
        statusMessage = null;
        errorMessage = null;
    }

    private void CancelDelete() => ruleToDelete = null;

    private async Task DeleteAsync()
    {
        if (ruleToDelete is null || isDeleting)
        {
            return;
        }

        isDeleting = true;
        statusMessage = null;
        errorMessage = null;
        var deletedRule = ruleToDelete;
        try
        {
            var deleted = await AlertStore.DeleteAlertRuleAsync(deletedRule.Id);
            if (!deleted)
            {
                errorMessage = Text["Rules.Delete.NotFound"];
                return;
            }

            if (editingRule?.Id == deletedRule.Id)
            {
                editingRule = null;
                isCreating = false;
            }

            ruleToDelete = null;
            statusMessage = Text.Format("Rules.Delete.Success", deletedRule.Name);
            if (!await LoadRulesAsync())
            {
                statusMessage = null;
                errorMessage = Text["Rules.Errors.DeletedRefreshFailed"];
            }
        }
        catch (AlertRuleException exception) when (exception.Code == AlertRuleErrorCode.DeletedNotificationFailed)
        {
            ruleToDelete = null;
            if (editingRule?.Id == deletedRule.Id)
            {
                editingRule = null;
                isCreating = false;
            }
            await LoadRulesAsync();
            ShowRuleError(exception);
        }
        catch (AlertRuleException exception)
        {
            ShowRuleError(exception);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The outcome of deleting alert rule {AlertRuleId} could not be confirmed.", deletedRule.Id);
            errorMessage = Text["Rules.Errors.ChangeUnconfirmed"];
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task SaveAsync()
    {
        if (editingRule is null || isSaving)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            var saved = await AlertStore.SaveAlertRuleAsync(editingRule);
            statusMessage = Text.Format(isCreating ? "Rules.Create.Success" : "Rules.Update.Success", saved.Name);
            editingRule = null;
            isCreating = false;
            if (!await LoadRulesAsync())
            {
                statusMessage = null;
                errorMessage = Text["Rules.Errors.SavedRefreshFailed"];
            }
        }
        catch (AlertRuleException exception) when (exception.Code == AlertRuleErrorCode.SavedNotificationFailed)
        {
            editingRule = null;
            isCreating = false;
            await LoadRulesAsync();
            ShowRuleError(exception);
        }
        catch (AlertRuleException exception)
        {
            ShowRuleError(exception);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The outcome of saving an alert rule could not be confirmed.");
            errorMessage = Text["Rules.Errors.ChangeUnconfirmed"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private static AlertRule Clone(AlertRule source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Enabled = source.Enabled,
        Priority = source.Priority,
        RuleType = source.RuleType,
        AlertNameContains = source.AlertNameContains,
        QueryResultType = source.QueryResultType,
        ConditionType = source.ConditionType,
        Threshold = source.Threshold,
        FailedItemName = source.FailedItemName,
        CategoryName = source.CategoryName,
        ApplyToTarget = source.ApplyToTarget,
        Collapsed = source.Collapsed,
        Tone = source.Tone,
        InventoryRole = source.InventoryRole,
        IsCritical = source.IsCritical,
        AnalysisClassification = source.AnalysisClassification
    };

    private void ShowRuleError(AlertRuleException exception)
    {
        Logger.LogWarning(exception, "Alert rule operation reported {ErrorCode}.", exception.Code);
        var prefix = exception.Code is AlertRuleErrorCode.DuplicateReplicationWarning or
            AlertRuleErrorCode.DuplicateHeartbeatFreshness or AlertRuleErrorCode.DuplicateName or
            AlertRuleErrorCode.InvalidId or AlertRuleErrorCode.ChangeUnconfirmed or
            AlertRuleErrorCode.SavedNotificationFailed or AlertRuleErrorCode.DeletedNotificationFailed
                ? "Rules.Errors." : "Rules.Validation.";
        errorMessage = Text.Format(prefix + exception.Code, exception.Arguments.ToArray());
    }

    private string DeleteImpact(AlertRule rule) => rule.RuleType switch
    {
        AlertRuleTypes.InventoryHeartbeatFreshness => Text.Plural("Rules.Delete.FreshnessImpact", InventoryHeartbeatFreshnessRule.DefaultMinutes),
        AlertRuleTypes.InventoryRoleAssignment => Text["Rules.Delete.RetiredImpact"],
        AlertRuleTypes.Suppression => Text["Rules.Delete.SuppressionImpact"],
        AlertRuleTypes.InventoryStatus => Text["Rules.Delete.InventoryStatusImpact"],
        AlertRuleTypes.ReplicationInventoryWarning => Text["Rules.Delete.ReplicationWarningImpact"],
        _ => Text.Format("Rules.Delete.CategoryImpact", rule.CategoryName)
    };

    private string ConditionLabel(AlertRule rule) => rule.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness
        ? Text.Plural("Rules.Condition.HeartbeatAge", rule.Threshold)
        : rule.RuleType == AlertRuleTypes.ReplicationInventoryWarning
        ? Text["Rules.Condition.ReplicationWarning"]
        : rule.RuleType == AlertRuleTypes.InventoryRoleAssignment
        ? Text.Format("Rules.Condition.RoleAssignment",
            string.IsNullOrWhiteSpace(rule.QueryResultType) ? Text["Rules.Condition.MatchingAlert"] : rule.QueryResultType, rule.InventoryRole)
        : rule.ConditionType switch
    {
        AlertRuleConditionTypes.AnyMatchingAlert => Text["Rules.Condition.AnyMatchingAlert"],
        AlertRuleConditionTypes.RowCountGreaterThan => Text.Plural("Rules.Condition.RowCountGreaterThan", rule.Threshold),
        AlertRuleConditionTypes.RowCountEquals => Text.Plural("Rules.Condition.RowCountEquals", rule.Threshold),
        AlertRuleConditionTypes.OnlyFailedItems => Text.Format("Rules.Condition.OnlyFailedItems", rule.FailedItemName),
        AlertRuleConditionTypes.NoFailedItems => Text["Rules.Condition.NoFailedItems"],
        AlertRuleConditionTypes.DomainControllerPercentageInDomain => Text.Format("Rules.Condition.DomainPercentage", rule.Threshold),
        AlertRuleConditionTypes.AllDomainControllersInSite => Text["Rules.Condition.AllSiteControllers"],
        _ => rule.ConditionType
    };

    private string RuleTypeLabel(AlertRule rule) => Text[rule.RuleType switch
    {
        AlertRuleTypes.InventoryHeartbeatFreshness => "Rules.Type.HeartbeatFreshness",
        AlertRuleTypes.ReplicationInventoryWarning => "Rules.TypeOption.RetiredReplicationWarning",
        AlertRuleTypes.InventoryRoleAssignment => "Rules.Type.RetiredRoleAssignment",
        AlertRuleTypes.InventoryStatus => "Rules.Type.InventoryStatus",
        AlertRuleTypes.Suppression => "Rules.Type.Suppression",
        _ => "Rules.Type.Categorization"
    }];

    private string AnalysisClassificationLabel(string value) => Text[value switch
    {
        AlertRuleAnalysisClassifications.SystemOutage => "Rules.Classification.SystemOutage",
        AlertRuleAnalysisClassifications.Suppressed => "Rules.Classification.Suppressed",
        _ => "Rules.Classification.Standard"
    }];

    private string RuleCountLabel(int count) => Text.Plural("Rules.Count", count);
}
