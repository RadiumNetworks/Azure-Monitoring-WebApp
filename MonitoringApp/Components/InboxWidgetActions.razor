@inject UiText Text

<div class="inbox-widget-quick-actions" aria-label="@Text.Format("Widgets.ActionsFor", Widget.Title)" @onclick:stopPropagation="true">
    <div class="inbox-widget-action-group" aria-label="@Text["Widgets.MoveSection"]">
        <button type="button" title="@Text["Widgets.MoveLeft"]" aria-label="@Text.Format("Widgets.MoveLeftLabel", Widget.Title)" @onclick="MoveLeftAsync">←</button>
        <button type="button" title="@Text["Widgets.MoveUp"]" aria-label="@Text.Format("Widgets.MoveUpLabel", Widget.Title)" @onclick="MoveUpAsync">↑</button>
        <button type="button" title="@Text["Widgets.MoveDown"]" aria-label="@Text.Format("Widgets.MoveDownLabel", Widget.Title)" @onclick="MoveDownAsync">↓</button>
        <button type="button" title="@Text["Widgets.MoveRight"]" aria-label="@Text.Format("Widgets.MoveRightLabel", Widget.Title)" @onclick="MoveRightAsync">→</button>
    </div>
    <div class="inbox-widget-action-group" aria-label="@Text["Widgets.ResizeSection"]">
        <button type="button" title="@Text["Widgets.ReduceWidth"]" aria-label="@Text.Format("Widgets.ReduceWidthLabel", Widget.Title)" @onclick="MakeNarrowerAsync">@Text["Widgets.ReduceWidthSymbol"]</button>
        <button type="button" title="@Text["Widgets.IncreaseWidth"]" aria-label="@Text.Format("Widgets.IncreaseWidthLabel", Widget.Title)" @onclick="MakeWiderAsync">@Text["Widgets.IncreaseWidthSymbol"]</button>
        <button type="button" title="@Text["Widgets.ReduceHeight"]" aria-label="@Text.Format("Widgets.ReduceHeightLabel", Widget.Title)" @onclick="MakeShorterAsync">@Text["Widgets.ReduceHeightSymbol"]</button>
        <button type="button" title="@Text["Widgets.IncreaseHeight"]" aria-label="@Text.Format("Widgets.IncreaseHeightLabel", Widget.Title)" @onclick="MakeTallerAsync">@Text["Widgets.IncreaseHeightSymbol"]</button>
    </div>
    <button class="inbox-widget-delete" type="button" title="@Text["Widgets.RemoveSection"]" aria-label="@Text.Format("Widgets.RemoveLabel", Widget.Title)" @onclick="RemoveAsync">@Text["Common.Remove"]</button>
</div>

@code {
    [Parameter, EditorRequired]
    public InboxDashboardWidget Widget { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<string> OnAction { get; set; }

    private Task MoveLeftAsync() => OnAction.InvokeAsync("left");
    private Task MoveUpAsync() => OnAction.InvokeAsync("up");
    private Task MoveDownAsync() => OnAction.InvokeAsync("down");
    private Task MoveRightAsync() => OnAction.InvokeAsync("right");
    private Task MakeNarrowerAsync() => OnAction.InvokeAsync("narrower");
    private Task MakeWiderAsync() => OnAction.InvokeAsync("wider");
    private Task MakeShorterAsync() => OnAction.InvokeAsync("shorter");
    private Task MakeTallerAsync() => OnAction.InvokeAsync("taller");
    private Task RemoveAsync() => OnAction.InvokeAsync("remove");
}
