{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "workspaceId": { "type": "String", "defaultValue": "" },
      "webhookUrl": { "type": "String", "defaultValue": "" },
      "webhookAudience": { "type": "String", "defaultValue": "" }
    },
    "triggers": {
      "When_an_Azure_Monitor_alert_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": ["data"],
            "properties": {
              "schemaId": { "type": "string" },
              "data": {
                "type": "object",
                "required": ["alertContext"],
                "properties": {
                  "essentials": { "type": "object" },
                  "alertContext": {
                    "type": "object",
                    "required": ["condition"],
                    "properties": {
                      "condition": {
                        "type": "object",
                        "required": ["allOf"],
                        "properties": {
                          "allOf": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "dimensions": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "name": { "type": "string" },
                                      "value": { "type": "string" }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "{{filterAction}}": {
        "type": "Query",
        "inputs": {
          "from": "@coalesce(triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['dimensions'], json('[]'))",
          "where": "{{dimensionFilterExpression}}"
        },
        "runAfter": {}
      },
      "{{dimensionFoundAction}}": {
        "type": "If",
        "expression": "{{dimensionFoundExpression}}",
        "actions": {
          "{{dimensionName}}": {
            "type": "Compose",
            "inputs": "{{dimensionValueExpression}}",
            "runAfter": {}
          },
          "{{safeValueAction}}": {
            "type": "If",
            "expression": "{{safeValueExpression}}",
            "actions": {
              "Run_Log_Analytics_Query": {
                "type": "Http",
                "inputs": {
                  "uri": "@concat('https://api.loganalytics.azure.com/v1/workspaces/', parameters('workspaceId'), '/query')",
                  "method": "POST",
                  "headers": {
                    "Content-Type": "application/json",
                    "Prefer": "wait=30"
                  },
                  "body": {
                    "query": "{{queryExpression}}",
                    "timespan": "{{timespan}}"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "identity": "<user-assigned-managed-identity-resource-id>",
                    "audience": "https://api.loganalytics.io"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "minimumInterval": "PT5S",
                    "maximumInterval": "PT30S"
                  }
                },
                "runAfter": {}
              },
              "Forward_Alert_To_Webhook": {
                "type": "Http",
                "inputs": {
                  "uri": "@parameters('webhookUrl')",
                  "method": "POST",
                  "headers": { "Content-Type": "application/json" },
                  "body": {
                    "schemaId": "@triggerBody()?['schemaId']",
                    "data": "@triggerBody()?['data']",
                    "queryResult": {
                      "type": "{{queryResultType}}",
                      "{{contextProperty}}": "{{dimensionOutputExpression}}",
                      "columns": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['columns'], json('[]'))",
                      "rows": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]'))",
                      "rowCount": "@length(coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]')))"
                    }
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "identity": "<user-assigned-managed-identity-resource-id>",
                    "audience": "@parameters('webhookAudience')"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "minimumInterval": "PT5S",
                    "maximumInterval": "PT30S"
                  }
                },
                "runAfter": { "Run_Log_Analytics_Query": ["Succeeded"] }
              },
              "Return_Query_Result": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": 200,
                  "headers": { "Content-Type": "application/json" },
                  "body": {
                    "{{contextProperty}}": "{{dimensionOutputExpression}}",
                    "columns": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['columns'], json('[]'))",
                    "rows": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]'))",
                    "rowCount": "@length(coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]')))",
                    "webhookStatusCode": "@outputs('Forward_Alert_To_Webhook')?['statusCode']",
                    "webhookResponse": "@body('Forward_Alert_To_Webhook')",
                    "alert": "@triggerBody()"
                  }
                },
                "runAfter": { "Forward_Alert_To_Webhook": ["Succeeded"] }
              }
            },
            "else": {
              "actions": {
                "{{invalidResponseAction}}": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": {
                    "statusCode": 400,
                    "headers": { "Content-Type": "application/json" },
                    "body": {
                      "error": "{{invalidDimensionError}}",
                      "{{contextProperty}}": "{{dimensionOutputExpression}}"
                    }
                  },
                  "runAfter": {}
                }
              }
            },
            "runAfter": { "{{dimensionName}}": ["Succeeded"] }
          }
        },
        "else": {
          "actions": {
            "{{missingResponseAction}}": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 400,
                "headers": { "Content-Type": "application/json" },
                "body": { "error": "{{missingDimensionError}}" }
              },
              "runAfter": {}
            }
          }
        },
        "runAfter": { "{{filterAction}}": ["Succeeded"] }
      }
    },
    "outputs": {}
  },
  "parameters": {
    "workspaceId": { "value": "<log-analytics-workspace-guid>" },
    "webhookUrl": { "value": "https://<app-service-name>.azurewebsites.net/api/alerts" },
    "webhookAudience": { "value": "api://<monitoring-api-client-id>" }
  }
}
