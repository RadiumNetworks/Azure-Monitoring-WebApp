    private Task RefreshClockAsync(CancellationToken cancellationToken) =>
        AnalysisRefreshLoop.RunAsync(() => InvokeAsync(RefreshDashboardTickAsync), cancellationToken);

    private async Task RefreshDashboardTickAsync()
    {
        if (setupAwaitingExecution || !Dashboard.Document.AutoRefreshEnabled || isRunning || isDashboardRunning || PersonalActionsBlocked)
            return;
        var refreshedDashboard = CanRunDashboard;
        if (refreshedDashboard)
            await RunDashboardAsync();
        if (hasDetailRequest && CanRun && Dashboard.Document.AutoRefreshEnabled)
        {
            var matchingWidget = refreshedDashboard ? Dashboard.Document.Widgets.FirstOrDefault(widget =>
                widget.QueryDefinitionId == selectedQueryId &&
                (Dashboard.Document.TimeRangeMinutesOverride ?? widget.TimeRangeMinutes) == timeRangeMinutes &&
                (Dashboard.Document.BinMinutesOverride ?? widget.BinMinutes ?? SelectedQuery?.DefaultBinMinutes) == binMinutes &&
                widget.GroupBy == groupBy) : null;
            if (matchingWidget is not null && widgetErrors.TryGetValue(matchingWidget.Id, out var refreshError))
            {
                result = null;
                errorMessage = refreshError;
            }
            else if (matchingWidget is not null && widgetResults.TryGetValue(matchingWidget.Id, out var refreshed))
                result = refreshed;
            else
                await RunAsync();
        }
        StateHasChanged();
    }

    private void QueryChanged()
    {
        openedWidgetId = null;
        result = null;
        hasDetailRequest = false;
        if (SelectedQuery is { } query)
        {
            timeRangeMinutes = query.DefaultTimeRangeMinutes;
            binMinutes = query.DefaultBinMinutes;
            groupBy = "SourceDSA";
        }
        RefreshExecutionPreview();
    }

    private void ValidateSelectionDraft()
    {
        if (UsesInventoryRoles && selectedInventoryRoles.Count == 0)
            throw new AnalysisValidationException(AnalysisValidationCode.DashboardRolesRequired, "Select at least one inventory role.");
        Dashboard.Document.ValidateSelection();
    }

    private void InvalidateSelection()
    {
        selectionGeneration++;
        result = null;
        hasDetailRequest = false;
        widgetResults.Clear();
        widgetErrors.Clear();
        executionPreviews = [];
        previewError = null;
        roleSelection = null;
        roleSelectionFingerprint = null;
        roleSelectionError = null;
    }

    private bool IsCurrentSelection(long generation) =>
        !disposed && generation == selectionGeneration && selectedPublishedDashboard is null;

    private async Task SelectionModeChangedAsync(ChangeEventArgs args)
    {
        if (DashboardBusy || PersonalActionsBlocked)
            return;
        if (!Enum.TryParse<AnalysisDashboardSelectionMode>(args.Value?.ToString(), out var mode) || !Enum.IsDefined(mode))
        {
            Logger.LogWarning("Invalid dashboard selection mode.");
            errorMessage = Text["Analysis.Validation.DashboardSelectionInvalid"];
            return;
        }
        selectionMode = mode;
        await ApplySystemSelectionAsync();
    }

    private async Task InventoryRoleChangedAsync(string role, ChangeEventArgs args)
    {
        if (DashboardBusy || PersonalActionsBlocked || !UsesInventoryRoles)
            return;
        if (string.IsNullOrWhiteSpace(role))
        {
            Logger.LogWarning("An empty dashboard inventory role was submitted.");
            errorMessage = Text["Analysis.Validation.DashboardSelectionInvalid"];
            return;
        }
        role = InventoryRoleRuleMatcher.NormalizeRole(role.Trim());
        if (args.Value is true)
            selectedInventoryRoles.Add(role);
        else
            selectedInventoryRoles.Remove(role);
        await ApplySystemSelectionAsync();
    }

    private async Task ApplySystemSelectionAsync()
    {
        InvalidateSelection();
        errorMessage = null;
        if (!UsesInventoryRoles || selectedInventoryRoles.Count > 0)
            Dashboard.SetSystemSelection(selectionMode, selectedInventoryRoles);
        missingDashboardSystems = UsesInventoryRoles ? [] :
            AnalysisDashboardInventorySelection.Resolve(Dashboard.Document.Systems, inventory).MissingSystems;
        if (UsesInventoryRoles)
            await RefreshRoleInventoryAsync();
        else
            RefreshExecutionPreview();
        dashboardStatus = Text["Analysis.RoleSelection.Changes"];
        if (!editMode)
            await RunDashboardAsync();
    }

    private void UpdateRoleSelectionPreview()
    {
        ValidateSelectionDraft();
        roleSelection = AnalysisDashboardInventorySelection.Resolve(
            Dashboard.Document, inventory, QueryRunner.WorkspaceResolver, workspaceFilter);
        var keys = roleSelection.Systems.Select(system => $"{system.SubscriptionId}\u001f{system.Computer}")
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var fingerprint = System.Text.Json.JsonSerializer.Serialize(inventory.Where(system => keys.Contains(SystemKey(system)))
            .DistinctBy(SystemKey, StringComparer.OrdinalIgnoreCase).OrderBy(SystemKey, StringComparer.OrdinalIgnoreCase)
            .Select(system => new { Key = SystemKey(system).ToUpperInvariant(),
                Domain = CrossTenantLogAnalyticsOptions.NormalizeDomain(system.Domain) }));
        if (roleSelectionFingerprint is not null && roleSelectionFingerprint != fingerprint)
        {
            result = null;
            widgetResults.Clear();
            widgetErrors.Clear();
        }
        roleSelectionFingerprint = fingerprint;
        roleSelectionError = null;
    }

    private void RoleSelectionFailed(Exception exception)
    {
        roleSelection = null;
        roleSelectionFingerprint = null;
        roleSelectionError = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ExecutionFailed");
        previewError = roleSelectionError;
        executionPreviews = [];
        result = null;
        widgetResults.Clear();
        widgetErrors.Clear();
    }

    private async Task<bool> LoadRoleSelectionAsync()
    {
        var generation = selectionGeneration;
        isRefreshingSelection = true;
        roleSelection = null;
        roleSelectionError = null;
        try
        {
            var currentInventory = await AlertStore.GetComputerInventoryAsync(refreshCancellation.Token);
            if (!IsCurrentSelection(generation))
                return false;
            inventory = currentInventory;
            inventoryLoadedAt = DateTimeOffset.UtcNow;
            UpdateRoleSelectionPreview();
            RefreshExecutionPreview();
            return true;
        }
        finally { isRefreshingSelection = false; }
    }

    private async Task RefreshRoleInventoryAsync()
    {
        if (disposed || !UsesInventoryRoles)
            return;
        InvalidateSelection();
        var generation = selectionGeneration;
        try { await LoadRoleSelectionAsync(); }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not refresh the dashboard inventory-role selection.");
            if (IsCurrentSelection(generation))
                RoleSelectionFailed(exception);
        }
    }

    private async Task RefreshRolePreviewAsync()
    {
        if (DashboardBusy || PersonalActionsBlocked)
            return;
        await RefreshRoleInventoryAsync();
    }

    private async Task SelectVisibleAsync()
    {
        if (PersonalActionsBlocked || DashboardBusy || UsesInventoryRoles)
            return;
        var additional = VisibleSystems.Select(SystemKey).Where(key => !selectedSystems.Contains(key)).ToArray();
        var capacity = Math.Max(0, 100 - selectedSystems.Count);
        foreach (var key in additional.Take(capacity))
            selectedSystems.Add(key);
        errorMessage = additional.Length > capacity
            ? Text["Analysis.SelectionLimit"]
            : null;
        await RefreshSelectedSystemsAsync();
    }

    private async Task ClearSelectionAsync()
    {
        if (PersonalActionsBlocked || DashboardBusy || UsesInventoryRoles)
            return;
        selectedSystems.Clear();
        await RefreshSelectedSystemsAsync();
    }

    private async Task ToggleSystemAsync(string key, ChangeEventArgs eventArgs)
    {
        if (PersonalActionsBlocked || DashboardBusy || UsesInventoryRoles)
            return;
        if (eventArgs.Value is true)
        {
            if (!selectedSystems.Contains(key) && selectedSystems.Count >= 100)
            {
                errorMessage = Text["Analysis.SelectAtMost"];
                return;
            }
            selectedSystems.Add(key);
        }
        else
            selectedSystems.Remove(key);
        await RefreshSelectedSystemsAsync();
    }

