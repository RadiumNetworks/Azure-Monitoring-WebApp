{
  "type": "DCDiag",
  "label": "DCDiag test summary",
  "labelKey": "QueryResults.DCDiagSummary",
  "identity": {
    "targetColumns": ["Computer"],
    "siteColumns": ["Site"],
    "targetDimensions": ["Computer"],
    "siteDimensions": ["Site"]
  },
  "summary": [
    { "operation": "object-value-count", "column": "Status", "match": "Passed", "label": "passed", "labelKey": "QueryResults.Passed", "tone": "success" },
    { "operation": "object-value-count", "column": "Status", "exclude": "Passed", "label": "failed", "labelKey": "QueryResults.Failed", "tone": "failure", "omitWhenZero": true }
  ],
  "row": {
    "title": "{Computer}",
    "metadata": [
      { "column": "Site", "label": "Site", "labelKey": "QueryResults.Site" },
      { "column": "TimeGenerated", "label": "Observed", "labelKey": "QueryResults.Observed", "format": "datetime" }
    ],
    "alerts": [
      { "source": "object-entries", "column": "Status", "exclude": "Passed", "tone": "failure" }
    ],
    "details": [
      { "source": "object-entries", "column": "Status", "label": "All {count} tests", "labelKey": "QueryResults.AllTests", "successValue": "Passed", "tone": "failure", "failureFirst": true }
    ]
  }
}