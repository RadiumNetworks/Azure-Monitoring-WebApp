@inject AnalysisDashboardPublishing Publishing
@inject UiText Text
@inject ILogger<PublishedDashboardNavigation> Logger

@if (errorMessage is not null)
{
    <span class="navigation-dashboard-error" role="alert">@errorMessage</span>
}
@foreach (var dashboard in dashboards)
{
    <NavLink href="@($"/analysis/published/{dashboard.Id:D}")" Match="NavLinkMatch.All">@dashboard.Name</NavLink>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private IReadOnlyList<PublishedAnalysisDashboard> dashboards = [];
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        dashboards = [];
        errorMessage = null;
        try
        {
            var authentication = await AuthenticationStateTask;
            dashboards = await Publishing.ListAsync(authentication.User);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load published dashboards for navigation.");
            errorMessage = Text["Navigation.DashboardListFailed"];
        }
    }
}
