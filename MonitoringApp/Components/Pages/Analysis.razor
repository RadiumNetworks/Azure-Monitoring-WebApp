    private async Task RunDashboardAsync()
    {
        if (!CanRunDashboard)
            return;
        isDashboardRunning = true;
        errorMessage = null;
        widgetErrors.Clear();
        StateHasChanged();
        var systems = inventory
            .Where(item => selectedSystems.Contains(SystemKey(item)))
            .Select(item => new AnalysisQuerySystem(item.SubscriptionId, item.Computer))
            .ToArray();
        using var concurrency = new SemaphoreSlim(3, 3);
        var unique = new Dictionary<string, Task<AnalysisQueryResponse>>(StringComparer.Ordinal);
        var jobs = new List<(AnalysisDashboardWidget Widget, Task<AnalysisQueryResponse> Task)>();
        foreach (var widget in Dashboard.Document.Widgets)
        {
            var query = availableQueries.FirstOrDefault(item => item.Id == widget.QueryDefinitionId);
            if (query is null)
            {
                widgetErrors[widget.Id] = "The published query is no longer available.";
                continue;
            }
            var request = Dashboard.Document.CreateExecutionRequest(widget, systems)
                with { WorkspaceKey = workspaceFilter, Domain = dashboardDomainFilter };
            var key = $"{query.Id:N}|{query.Version}|{request.TimeRangeMinutes}|{request.BinMinutes ?? query.DefaultBinMinutes}|{request.GroupBy}";
            if (!unique.TryGetValue(key, out var task))
            {
                task = ExecuteDashboardRequestAsync(
                    request,
                    concurrency);
                unique.Add(key, task);
            }
            jobs.Add((widget, task));
        }

        await Task.WhenAll(jobs.Select(async job =>
        {
            try
            {
                var response = await job.Task;
                if (Dashboard.Document.Widgets.Any(widget => widget.Id == job.Widget.Id))
                {
                    widgetResults[job.Widget.Id] = response;
                    widgetErrors.Remove(job.Widget.Id);
                }
            }
            catch (Exception exception)
            {
                if (Dashboard.Document.Widgets.Any(widget => widget.Id == job.Widget.Id))
                    widgetErrors[job.Widget.Id] = exception.Message;
            }
        }));
        dashboardStatus = $"Dashboard refreshed · {DateTimeOffset.UtcNow:u} · {unique.Count} unique request(s)";
        isDashboardRunning = false;
    }

    private async Task<AnalysisQueryResponse> ExecuteDashboardRequestAsync(
        AnalysisQueryRequest request,
        SemaphoreSlim concurrency)
    {
        var cancellationToken = refreshCancellation.Token;
        await concurrency.WaitAsync(cancellationToken);
        try
        {
            return await Execution.ExecuteAsync(request, cancellationToken);
        }
        finally
        {
            concurrency.Release();
        }
    }

    private void UndoDashboard()
    {
        if (PersonalActionsBlocked)
            return;
        Dashboard.Undo();
        RestoreDashboardSystems();
        dashboardStatus = "Unsaved undo";
    }

    private void RedoDashboard()
    {
        if (PersonalActionsBlocked)
            return;
        Dashboard.Redo();
        RestoreDashboardSystems();
        dashboardStatus = "Unsaved redo";
    }

    private void RestoreDashboardSystems()
    {
        widgetResults.Clear();
        widgetErrors.Clear();
        hasDetailRequest = false;
        selectedSystems.Clear();
        foreach (var saved in Dashboard.Document.Systems)
            selectedSystems.Add($"{saved.SubscriptionId}\u001f{saved.Computer}");
        var opened = Dashboard.Document.Widgets.FirstOrDefault(widget => widget.Id == openedWidgetId);
        if (opened is not null)
            OpenWidget(opened);
        else
        {
            openedWidgetId = null;
            result = null;
            RefreshExecutionPreview();
        }
    }

    private async Task ReloadPublicationsAsync()
    {
        try
        {
            publishedDashboards = await Publishing.ListAsync((await AuthenticationStateTask).User, refreshCancellation.Token);
            publicationError = null;
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            publicationError = $"Published dashboards could not be loaded: {exception.Message}";
        }
    }

    private async Task OpenPublishedDashboardAsync(Guid id)
    {
        if (DashboardBusy)
            return;
        if (selectedPublishedDashboard is null && !await TrySaveDashboardAsync())
            return;
        selectedPublishedDashboard = id;
        runPublishedOnWorkspaceChange = false;
        confirmWithdrawDashboard = false;
    }

    private async Task ReturnToPersonalDashboard()
    {
        if (!DashboardBusy)
        {
            selectedPublishedDashboard = null;
            if (!editMode)
                await RunDashboardAsync();
        }
    }

    private async Task PublishDashboardAsync()
    {
        if (DashboardBusy || selectedPublishedDashboard is not null)
            return;
        isPublishingDashboard = true;
        publicationError = publicationMessage = null;
        try
        {
            if (!await TrySaveDashboardAsync())
                return;
            var publication = await Publishing.PublishAsync(dashboardCollection.ActiveDashboardId, dashboardRevision,
                (await AuthenticationStateTask).User, refreshCancellation.Token);
            dashboardRevision++;
            dashboardStatus = $"Dashboard saved · revision {dashboardRevision}";
            publicationMessage = $"Published {publication.Name} v{publication.Version} for everyone.";
            await ReloadPublicationsAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            publicationError = $"The dashboard could not be published: {exception.Message}";
        }
        finally
        {
            isPublishingDashboard = false;
        }
    }

    private async Task WithdrawDashboardAsync()
    {
        if (DashboardBusy || selectedPublishedDashboard is not null)
            return;
        isPublishingDashboard = true;
        publicationError = publicationMessage = null;
        try
        {
            await Publishing.WithdrawAsync(dashboardCollection.ActiveDashboardId,
                (await AuthenticationStateTask).User, refreshCancellation.Token);
            confirmWithdrawDashboard = false;
            publicationMessage = "Dashboard withdrawn. It is now private to you.";
            await ReloadPublicationsAsync();
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            publicationError = $"The dashboard could not be withdrawn: {exception.Message}";
        }
        finally
        {
            isPublishingDashboard = false;
        }
    }

    private async Task SelectDashboardAsync(Guid id)
    {
        await ChangeDashboardAsync(collection => collection.Select(id));
        if (!editMode && errorMessage is null)
            await RunDashboardAsync();
    }
    private Task CreateDashboardAsync(string name) => ChangeDashboardAsync(collection => collection.Add(name));
    private Task RenameDashboardAsync(string name) => ChangeDashboardAsync(collection => collection.RenameActive(name));
    private Task DeleteDashboardAsync() => ChangeDashboardAsync(collection => collection.DeleteActive());

    private async Task ChangeDashboardAsync(Action<AnalysisDashboardCollection> change)
    {
        if (isRunning || isDashboardRunning || PersonalActionsBlocked)
            return;
        isChangingDashboard = true;
        errorMessage = null;
        try
        {
            if (!await TrySaveDashboardAsync())
                return;
            var candidate = dashboardCollection.Copy();
            change(candidate);
            var saved = await DashboardRepository.SaveAsync(dashboardOwnerKey, candidate, dashboardRevision);
            dashboardRevision = saved.Revision;
            dashboardCollection = candidate;
            Dashboard.Load(candidate.OpenActive());
            confirmWithdrawDashboard = false;
            selectedQueryId = Guid.Empty;
            openedWidgetId = null;
            domainFilter = siteFilter = roleFilter = string.Empty;
            RestoreDashboardSystems();
            dashboardStatus = $"{Dashboard.Document.Name} · saved revision {dashboardRevision}";
        }
        catch (DbUpdateConcurrencyException)
        {
            errorMessage = "The dashboards were changed in another session. Reload the page before trying again.";
        }
        catch (Exception exception) when (exception is DbUpdateException or InvalidOperationException)
        {
            errorMessage = $"The dashboard change could not be saved: {exception.Message}";
        }
        finally
        {
            isChangingDashboard = false;
        }
    }

    private async Task SaveDashboardAsync() => await TrySaveDashboardAsync();

    private async Task<bool> TrySaveDashboardAsync()
    {
        if (selectedPublishedDashboard is not null)
        {
            publicationError = "Published dashboards are read-only. Return to My dashboards to make changes.";
            return false;
        }
        if (isSavingDashboard)
        {
            errorMessage = "A dashboard save is already in progress. Retry after it completes.";
            return false;
        }
        isSavingDashboard = true;
        try
        {
            dashboardCollection.CaptureActive(Dashboard.Document);
            var snapshot = dashboardCollection.Copy();
            var saved = await DashboardRepository.SaveAsync(
                dashboardOwnerKey,
                snapshot,
                dashboardRevision);
            dashboardRevision = saved.Revision;
            dashboardStatus = $"Dashboard saved · revision {dashboardRevision}";
            return true;
        }
        catch (DbUpdateConcurrencyException)
        {
            errorMessage = "The dashboard was changed in another session. Reload the page before saving again.";
            return false;
        }
        catch (DbUpdateException)
        {
            errorMessage = "The dashboard could not be saved. Your changes remain on this page; retry Save dashboard.";
            return false;
        }
        finally { isSavingDashboard = false; }
    }

