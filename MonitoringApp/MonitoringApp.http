@MonitoringApp_HostAddress = http://localhost:5078
@AlertAccessToken = replace-with-logic-app-uami-access-token

# Remove the Authorization header while AlertIngestionAuthentication is disabled.
POST {{MonitoringApp_HostAddress}}/api/alerts
Authorization: Bearer {{AlertAccessToken}}
Content-Type: application/json

{
	"schemaId": "azureMonitorCommonAlertSchema",
	"data": {
		"essentials": {
			"alertId": "alert-001",
			"alertRule": "High CPU",
			"severity": "Sev1",
			"alertState": "Activated",
			"signalType": "Metric",
			"monitorCondition": "Fired",
			"targetResourceGroup": "rg-production",
			"targetSubscriptionId": "sub-001",
			"alertTargetIDs": [
				"/subscriptions/sub-001/resourceGroups/rg-production/providers/Microsoft.Compute/virtualMachines/vm-web-01"
			],
			"firedDateTime": "2026-08-20T10:30:00Z",
			"description": "CPU exceeded 90 percent."
		}
	}
}

###

GET {{MonitoringApp_HostAddress}}/api/query?activeMinutes=30
Accept: application/json

###

GET {{MonitoringApp_HostAddress}}/api/query?eventHours=24
Accept: application/json

###

GET {{MonitoringApp_HostAddress}}/api/alert-query-refresh-targets?type=DCPort
Authorization: Bearer {{AlertAccessToken}}
Accept: application/json

###

@DCPortAlertRecordId = 00000000-0000-0000-0000-000000000000

PUT {{MonitoringApp_HostAddress}}/api/alerts/{{DCPortAlertRecordId}}/query-result
Authorization: Bearer {{AlertAccessToken}}
Content-Type: application/json

{
	"type": "DCPort",
	"dimensionName": "Computer",
	"dimensionValue": "DC01",
	"columns": [
		{ "name": "TimeGenerated", "type": "datetime" },
		{ "name": "RemoteSystem", "type": "string" },
		{ "name": "Port", "type": "string" },
		{ "name": "Protocol", "type": "string" },
		{ "name": "Status", "type": "dynamic" }
	],
	"rows": [],
	"rowCount": 0,
	"queryExecutedAt": "2026-10-06T10:00:00Z"
}

###

GET {{MonitoringApp_HostAddress}}/api/alert-query-refresh-targets?type=DCDiag
Authorization: Bearer {{AlertAccessToken}}
Accept: application/json

###
