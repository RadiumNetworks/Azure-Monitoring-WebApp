<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.55.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AlertConsoleUrlResolver.cs" Link="Configuration\AlertConsoleUrlResolver.cs" />
    <None Include="..\alertconsole.local.json"
          Link="alertconsole.local.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never"
          Condition="Exists('..\alertconsole.local.json')" />
  </ItemGroup>

</Project>