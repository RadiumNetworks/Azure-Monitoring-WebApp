@page "/admin/inventory"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "OperatorAccess")]
@inject AlertStore AlertStore

<PageTitle>Computer Inventory</PageTitle>

<section class="admin-heading">
    <div>
        <p class="eyebrow">Administration</p>
        <h1>Computer inventory</h1>
        <p class="subtitle">Review discovered systems and maintain their location, resource group, and role metadata.</p>
    </div>
    <div class="admin-heading-actions">
        <button class="admin-secondary" type="button" disabled="@(isLoading || isPrefilling)" @onclick="PrefillFromAlertsAsync">
            @(isPrefilling ? "Checking alerts..." : "Prefill from last 7 days")
        </button>
        <button class="admin-secondary" type="button" disabled="@(isLoading || isPrefilling)" @onclick="LoadInventoryAsync">
            @(isLoading ? "Refreshing..." : "Refresh")
        </button>
        <button class="admin-primary" type="button" disabled="@isPrefilling" @onclick="BeginCreate">Create entry</button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="admin-message admin-message-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}

<div class="inventory-filter">
    <label class="admin-field">
        <span>Search inventory</span>
        <input type="search" placeholder="Computer, site, domain, or subscription" @bind="searchText" @bind:event="oninput" />
    </label>
    <span>@InventoryCountLabel(FilteredEntries.Count)</span>
</div>

<div class="inventory-filter-grid" aria-label="Inventory filters">
    <label class="admin-field">
        <span>Subscription</span>
        <select @bind="subscriptionFilter">
            <option value="">All subscriptions</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.SubscriptionId)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <label class="admin-field">
        <span>Resource group</span>
        <select @bind="resourceGroupFilter">
            <option value="">All resource groups</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.ResourceGroup)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <label class="admin-field">
        <span>Site</span>
        <select @bind="siteFilter">
            <option value="">All sites</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.Site)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <label class="admin-field">
        <span>Domain</span>
        <select @bind="domainFilter">
            <option value="">All domains</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.Domain)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <label class="admin-field">
        <span>Role</span>
        <select @bind="roleFilter">
            <option value="">All roles</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.Role)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <button class="admin-secondary" type="button" disabled="@(!HasInventoryFilters)" @onclick="ClearInventoryFilters">Clear filters</button>
</div>

<div class="admin-workspace">
    <section class="admin-rule-list" aria-labelledby="inventory-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="inventory-heading">Systems</h2>
                <span>Automatically discovered from incoming alerts</span>
            </div>
        </div>

        @if (isLoading && entries.Count == 0)
        {
            <p class="admin-empty">Loading inventory...</p>
        }
        else if (FilteredEntries.Count == 0)
        {
            <p class="admin-empty">No matching systems were found.</p>
        }
        else
        {
            <div class="admin-rule-cards inventory-cards">
                @foreach (var entry in FilteredEntries)
                {
                    var isExpanded = IsExpanded(entry);
                    <article class="admin-rule-card inventory-card @(IsSelected(entry) ? "selected" : null) @(isExpanded ? "expanded" : null)">
                        <button class="inventory-card-toggle" type="button" aria-expanded="@isExpanded.ToString().ToLowerInvariant()" @onclick="() => ToggleExpanded(entry)">
                            <strong title="@entry.Computer">@entry.Computer</strong>
                            <span class="inventory-card-domain" title="@DisplayValue(entry.Domain)">@DisplayValue(entry.Domain)</span>
                            <span class="inventory-card-site" title="@DisplayValue(entry.Site)">@DisplayValue(entry.Site)</span>
                            <span title="@(entry.Maintenance ? "Maintenance" : DisplayValue(entry.Role))">@(entry.Maintenance ? "Maintenance" : DisplayValue(entry.Role))</span>
                            <span class="inventory-card-chevron" aria-hidden="true"></span>
                        </button>
                        @if (isExpanded)
                        {
                            <div class="inventory-card-details">
                                <div class="inventory-card-toolbar">
                                    <span class="admin-status @(entry.Maintenance ? "inventory-maintenance" : "enabled")">@(entry.Maintenance ? "Maintenance" : "Discovered")</span>
                                    <div class="inventory-card-actions">
                                        <button class="admin-secondary" type="button" @onclick="() => BeginEdit(entry)">Edit</button>
                                        <button class="admin-danger" type="button" @onclick="() => BeginDelete(entry)">Delete</button>
                                    </div>
                                </div>
                                <dl class="admin-rule-summary">
                                    <div><dt>Site</dt><dd>@DisplayValue(entry.Site)</dd></div>
                                    <div><dt>Domain</dt><dd>@DisplayValue(entry.Domain)</dd></div>
                                    <div><dt>Role</dt><dd>@DisplayValue(entry.Role)</dd></div>
                                    <div><dt>Resource group</dt><dd>@DisplayValue(entry.ResourceGroup)</dd></div>
                                    <div><dt>Private IP</dt><dd>@DisplayValue(entry.PrivateIP)</dd></div>
                                    <div><dt>Last heartbeat</dt><dd>@DisplayHeartbeat(entry.LastHeartbeatAt)</dd></div>
                                    <div><dt>NTDS database size</dt><dd>@DisplayNtdsSize(entry.NtdsFileSizeInGb)</dd></div>
                                    <div><dt>Maintenance</dt><dd>@(entry.Maintenance ? "Enabled" : "Disabled")</dd></div>
                                    <div class="inventory-subscription"><dt>Subscription</dt><dd>@entry.SubscriptionId</dd></div>
                                </dl>
                                @if (entry.Certificates.Count > 0)
                                {
                                    <section class="inventory-observation-details" aria-label="Certificates">
                                        <h3>Certificates</h3>
                                        <div class="inventory-detail-table">
                                            <div class="inventory-detail-heading"><span>Name</span><span>Serial number</span><span>Expires</span></div>
                                            @foreach (var certificate in entry.Certificates)
                                            {
                                                <div>
                                                    <span title="@certificate.Name">@DisplayValue(certificate.Name)</span>
                                                    <span title="@certificate.SerialNumber">@DisplayValue(certificate.SerialNumber)</span>
                                                    <span>@DisplayDate(certificate.ExpiresAt)</span>
                                                </div>
                                            }
                                        </div>
                                    </section>
                                }
                                @if (entry.Services.Count > 0)
                                {
                                    <section class="inventory-observation-details" aria-label="Services">
                                        <h3>Services</h3>
                                        <div class="inventory-service-list">
                                            @foreach (var service in entry.Services)
                                            {
                                                <span><strong>@service.Name</strong> @DisplayServiceStatus(service.Status)</span>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="admin-editor" aria-labelledby="inventory-editor-heading">
        @if (editingEntry is null)
        {
            <div class="admin-editor-placeholder">
                <strong>Select or create a system</strong>
                <span>Choose an inventory record to maintain it, or create a new computer entry.</span>
            </div>
        }
        else
        {
            var entry = editingEntry;
            <div class="admin-section-heading">
                <div>
                    <p class="eyebrow">@(isCreating ? "New entry" : "Edit system")</p>
                    <h2 id="inventory-editor-heading">@(isCreating ? "Create computer entry" : entry.Computer)</h2>
                </div>
            </div>

            <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                @if (isCreating)
                {
                    <label class="admin-field admin-field-wide">
                        <span>Subscription ID</span>
                        <select required @bind="entry.SubscriptionId">
                            <option value="">Select a subscription</option>
                            @foreach (var subscriptionId in subscriptionIds)
                            {
                                <option value="@subscriptionId">@subscriptionId</option>
                            }
                        </select>
                        <small>Subscriptions are populated from previously received alerts.</small>
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>Computer</span>
                        <input required maxlength="256" @bind="entry.Computer" />
                        <small>Together with the subscription, this forms the primary key.</small>
                    </label>
                }
                else
                {
                    <label class="admin-field admin-field-wide">
                        <span>Subscription ID</span>
                        <input value="@entry.SubscriptionId" readonly />
                        <small>Part of the inventory primary key and cannot be changed.</small>
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>Computer</span>
                        <input value="@entry.Computer" readonly />
                        <small>Part of the inventory primary key and cannot be changed.</small>
                    </label>
                }
                <label class="admin-field">
                    <span>Site</span>
                    <input maxlength="256" @bind="entry.Site" />
                    <small>May be discovered automatically from a later alert.</small>
                </label>
                <label class="admin-field">
                    <span>Domain</span>
                    <input maxlength="256" @bind="entry.Domain" />
                    <small>Can be maintained manually until alerts provide this value.</small>
                </label>
                <label class="admin-field">
                    <span>Resource group</span>
                    <input maxlength="256" @bind="entry.ResourceGroup" />
                    <small>Discovered from alerts when available.</small>
                </label>
                <label class="admin-field">
                    <span>Role</span>
                    <input maxlength="256" @bind="entry.Role" />
                    <small>May be assigned automatically by an inventory-role alert rule.</small>
                </label>
                <label class="admin-check">
                    <input type="checkbox" @bind="entry.Maintenance" />
                    <span>Maintenance</span>
                </label>
                <small>Hide this system's alerts and missing heartbeat from the inbox. The graph shows it in blue. Alerts continue to be stored and are visible again after maintenance ends.</small>
                @if (!isCreating)
                {
                    <label class="admin-field">
                        <span>Private IP</span>
                        <input value="@DisplayValue(entry.PrivateIP)" readonly />
                        <small>Updated automatically from inventory heartbeat events.</small>
                    </label>
                    <label class="admin-field">
                        <span>Last heartbeat</span>
                        <input value="@DisplayHeartbeat(entry.LastHeartbeatAt)" readonly />
                        <small>Used to determine the target status in the graph.</small>
                    </label>
                    <label class="admin-field">
                        <span>NTDS database size</span>
                        <input value="@DisplayNtdsSize(entry.NtdsFileSizeInGb)" readonly />
                        <small>A reported NTDS database or NTDS service identifies the computer as a domain controller.</small>
                    </label>
                    <section class="admin-field admin-field-wide inventory-editor-observations" aria-label="Certificate inventory">
                        <span>Certificates</span>
                        @if (entry.Certificates.Count == 0)
                        {
                            <div class="inventory-observation-empty">No certificate data received.</div>
                        }
                        else
                        {
                            <div class="inventory-detail-table">
                                <div class="inventory-detail-heading"><span>Name</span><span>Serial number</span><span>Expires</span></div>
                                @foreach (var certificate in entry.Certificates)
                                {
                                    <div>
                                        <span title="@certificate.Name">@DisplayValue(certificate.Name)</span>
                                        <span title="@certificate.SerialNumber">@DisplayValue(certificate.SerialNumber)</span>
                                        <span>@DisplayDate(certificate.ExpiresAt)</span>
                                    </div>
                                }
                            </div>
                        }
                        <small>Updated automatically from inventory heartbeat events.</small>
                    </section>
                    <section class="admin-field admin-field-wide inventory-editor-observations" aria-label="Service inventory">
                        <span>Services</span>
                        @if (entry.Services.Count == 0)
                        {
                            <div class="inventory-observation-empty">No service data received.</div>
                        }
                        else
                        {
                            <div class="inventory-service-table">
                                <div class="inventory-detail-heading"><span>Service</span><span>Last status</span></div>
                                @foreach (var service in entry.Services)
                                {
                                    <div>
                                        <span>@service.Name</span>
                                        <span>@DisplayServiceStatus(service.Status)</span>
                                    </div>
                                }
                            </div>
                        }
                        <small>Status reported with the inventory heartbeat at @DisplayHeartbeat(entry.LastHeartbeatAt).</small>
                    </section>
                }
                <div class="admin-form-actions">
                    <button class="admin-secondary" type="button" disabled="@isSaving" @onclick="CancelEdit">Cancel</button>
                    <button class="admin-primary" type="submit" disabled="@isSaving">
                        @(isSaving ? "Saving..." : isCreating ? "Create entry" : "Save changes")
                    </button>
                </div>
            </form>
        }
    </section>
</div>

@if (entryToDelete is not null)
{
    <div class="admin-dialog-backdrop" role="presentation">
        <section class="admin-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-inventory-heading">
            <p class="eyebrow">Permanent action</p>
            <h2 id="delete-inventory-heading">Delete computer entry?</h2>
            <p>
                Delete <strong>@entryToDelete.Computer</strong> from subscription
                <strong>@entryToDelete.SubscriptionId</strong>? A later alert may discover and create it again.
            </p>
            <div class="admin-form-actions">
                <button class="admin-secondary" type="button" disabled="@isDeleting" @onclick="CancelDelete">Cancel</button>
                <button class="admin-danger" type="button" disabled="@isDeleting" @onclick="DeleteAsync">
                    @(isDeleting ? "Deleting..." : "Delete entry")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<ComputerInventoryEntry> entries = [];
    private IReadOnlyList<string> subscriptionIds = [];
    private readonly HashSet<(string SubscriptionId, string Computer)> expandedEntries = [];
    private ComputerInventoryEntry? editingEntry;
    private ComputerInventoryEntry? entryToDelete;
    private string searchText = string.Empty;
    private string subscriptionFilter = string.Empty;
    private string resourceGroupFilter = string.Empty;
    private string siteFilter = string.Empty;
    private string domainFilter = string.Empty;
    private string roleFilter = string.Empty;
    private bool isCreating;
    private bool isLoading;
    private bool isPrefilling;
    private bool isSaving;
    private bool isDeleting;
    private string? statusMessage;
    private string? errorMessage;

    private IReadOnlyList<ComputerInventoryEntry> FilteredEntries => entries
        .Where(entry => string.IsNullOrWhiteSpace(searchText) ||
            entry.Computer.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            entry.SubscriptionId.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (entry.ResourceGroup?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (entry.Site?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (entry.Domain?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (entry.Role?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(entry => MatchesFilter(entry.SubscriptionId, subscriptionFilter))
        .Where(entry => MatchesFilter(entry.ResourceGroup, resourceGroupFilter))
        .Where(entry => MatchesFilter(entry.Site, siteFilter))
        .Where(entry => MatchesFilter(entry.Domain, domainFilter))
        .Where(entry => MatchesFilter(entry.Role, roleFilter))
        .ToArray();

    private bool HasInventoryFilters =>
        !string.IsNullOrWhiteSpace(subscriptionFilter) ||
        !string.IsNullOrWhiteSpace(resourceGroupFilter) ||
        !string.IsNullOrWhiteSpace(siteFilter) ||
        !string.IsNullOrWhiteSpace(domainFilter) ||
        !string.IsNullOrWhiteSpace(roleFilter);

    protected override Task OnInitializedAsync() => LoadInventoryAsync();

    private async Task LoadInventoryAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            entries = await AlertStore.GetComputerInventoryAsync();
            subscriptionIds = await AlertStore.GetAlertSubscriptionIdsAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginCreate()
    {
        editingEntry = new ComputerInventoryEntry
        {
            SubscriptionId = subscriptionIds.Count == 1 ? subscriptionIds[0] : string.Empty
        };
        isCreating = true;
        statusMessage = null;
        errorMessage = subscriptionIds.Count == 0
            ? "No subscription IDs have been observed in alerts yet."
            : null;
    }

    private async Task PrefillFromAlertsAsync()
    {
        if (isPrefilling)
        {
            return;
        }

        isPrefilling = true;
        statusMessage = null;
        errorMessage = null;
        try
        {
            var result = await AlertStore.PrefillComputerInventoryFromLastSevenDaysAsync();
            await LoadInventoryAsync();
            statusMessage = $"Checked {result.AlertsScanned} alerts and found {result.SystemsFound} systems. " +
                $"Created {result.SystemsCreated}, filled {result.DomainsFilled} missing domains and {result.SitesFilled} missing sites, " +
                $"filled {result.ResourceGroupsFilled} resource groups, assigned {result.RolesAssigned} roles, " +
                $"and left {result.SystemsUnchanged} unchanged.";
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isPrefilling = false;
        }
    }

    private void BeginEdit(ComputerInventoryEntry source)
    {
        editingEntry = Clone(source);
        isCreating = false;
        statusMessage = null;
        errorMessage = null;
    }

    private void CancelEdit()
    {
        editingEntry = null;
        isCreating = false;
        errorMessage = null;
    }

    private async Task SaveAsync()
    {
        if (editingEntry is null || isSaving)
        {
            return;
        }

        isSaving = true;
        statusMessage = null;
        errorMessage = null;
        try
        {
            var saved = isCreating
                ? await AlertStore.CreateComputerInventoryEntryAsync(editingEntry)
                : await AlertStore.SaveComputerInventoryEntryAsync(editingEntry);
            statusMessage = isCreating
                ? $"Inventory record for '{saved.Computer}' was created."
                : $"Inventory record for '{saved.Computer}' was updated.";
            editingEntry = null;
            isCreating = false;
            await LoadInventoryAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void BeginDelete(ComputerInventoryEntry source)
    {
        entryToDelete = Clone(source);
        statusMessage = null;
        errorMessage = null;
    }

    private void CancelDelete() => entryToDelete = null;

    private async Task DeleteAsync()
    {
        if (entryToDelete is null || isDeleting)
        {
            return;
        }

        isDeleting = true;
        statusMessage = null;
        errorMessage = null;
        var deletedEntry = entryToDelete;
        try
        {
            var deleted = await AlertStore.DeleteComputerInventoryEntryAsync(
                deletedEntry.SubscriptionId,
                deletedEntry.Computer);
            if (!deleted)
            {
                errorMessage = "The inventory record no longer exists.";
                return;
            }

            if (IsSelected(deletedEntry))
            {
                editingEntry = null;
                isCreating = false;
            }

            entryToDelete = null;
            statusMessage = $"Inventory record for '{deletedEntry.Computer}' was deleted.";
            await LoadInventoryAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private bool IsSelected(ComputerInventoryEntry entry) =>
        editingEntry is not null &&
        entry.SubscriptionId == editingEntry.SubscriptionId &&
        entry.Computer == editingEntry.Computer;

    private bool IsExpanded(ComputerInventoryEntry entry) =>
        expandedEntries.Contains((entry.SubscriptionId, entry.Computer));

    private void ToggleExpanded(ComputerInventoryEntry entry)
    {
        var key = (entry.SubscriptionId, entry.Computer);
        if (!expandedEntries.Add(key))
        {
            expandedEntries.Remove(key);
        }
    }

    private static ComputerInventoryEntry Clone(ComputerInventoryEntry source) => new()
    {
        SubscriptionId = source.SubscriptionId,
        Computer = source.Computer,
        Site = source.Site,
        Domain = source.Domain,
        ResourceGroup = source.ResourceGroup,
        Role = source.Role,
        PrivateIP = source.PrivateIP,
        LastHeartbeatAt = source.LastHeartbeatAt,
        NtdsFileSizeInGb = source.NtdsFileSizeInGb,
        CertificatesJson = source.CertificatesJson,
        ServicesJson = source.ServicesJson,
        Maintenance = source.Maintenance
    };

    private void ClearInventoryFilters()
    {
        subscriptionFilter = string.Empty;
        resourceGroupFilter = string.Empty;
        siteFilter = string.Empty;
        domainFilter = string.Empty;
        roleFilter = string.Empty;
    }

    private static bool MatchesFilter(string? value, string filter) =>
        string.IsNullOrWhiteSpace(filter) || string.Equals(value, filter, StringComparison.OrdinalIgnoreCase);

    private static IReadOnlyList<string> FilterOptions(IEnumerable<string?> values) => values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private static string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not available" : value;

    private static string DisplayHeartbeat(DateTimeOffset? value) =>
        value?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "Not available";

    private static string DisplayDate(DateTimeOffset? value) =>
        value?.ToUniversalTime().ToString("yyyy-MM-dd") ?? "Not available";

    private static string DisplayNtdsSize(double? value) =>
        value.HasValue ? $"{value.Value:N2} GB" : "Not available";

    private static string DisplayServiceStatus(int? status) => status switch
    {
        1 => "Stopped",
        2 => "Start pending",
        3 => "Stop pending",
        4 => "Running",
        5 => "Continue pending",
        6 => "Pause pending",
        7 => "Paused",
        _ => status.HasValue ? $"Status {status.Value}" : "Unknown"
    };

    private static string InventoryCountLabel(int count) =>
        count == 1 ? "1 system" : $"{count} systems";
}