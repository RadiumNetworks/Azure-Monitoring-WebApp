@inject UiText Text

<fieldset class="analysis-controls" disabled="@Disabled" aria-label="@Text["AnalysisGrid.Label"]">
    <legend>@Text["AnalysisGrid.Title"]</legend>
    <label>
        <span>@Text["AnalysisGrid.Columns"]</span>
        <input type="number" min="2" max="6" value="@Document.Columns" @onchange="ChangeColumns" />
    </label>
    <label>
        <span>@Text["Common.Rows"]</span>
        <input type="number" min="8" max="120" value="@Document.Rows" @onchange="ChangeRows" />
    </label>
    <label>
        <span>@Text["AnalysisGrid.RowHeight"]</span>
        <input type="number" min="64" max="132" value="@Document.RowHeight" @onchange="ChangeRowHeight" />
    </label>
    <small>@Text["AnalysisGrid.Help"]</small>
    @if (validationError is not null)
    {
        <span role="alert">@validationError</span>
    }
</fieldset>

@code {
    [Parameter, EditorRequired] public AnalysisDashboardDocument Document { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<(int Columns, int Rows, int RowHeight)> SizeChanged { get; set; }
    private string? validationError;

    private Task ChangeColumns(ChangeEventArgs args) => Change(args, 2, 6,
        value => (value, Document.Rows, Document.RowHeight));
    private Task ChangeRows(ChangeEventArgs args) => Change(args, 8, 120,
        value => (Document.Columns, value, Document.RowHeight));
    private Task ChangeRowHeight(ChangeEventArgs args) => Change(args, 64, 132,
        value => (Document.Columns, Document.Rows, value));

    private async Task Change(ChangeEventArgs args, int minimum, int maximum,
        Func<int, (int Columns, int Rows, int RowHeight)> update)
    {
        if (Disabled) return;
        if (!int.TryParse(args.Value?.ToString(), out var value) || value < minimum || value > maximum)
        {
            validationError = Text.Format("AnalysisGrid.WholeNumber", minimum, maximum);
            return;
        }
        validationError = null;
        await SizeChanged.InvokeAsync(update(value));
    }
}
