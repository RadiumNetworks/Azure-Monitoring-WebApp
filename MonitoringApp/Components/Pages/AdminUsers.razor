@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminAccess")]
@inject ApplicationAuthenticationOptions AuthenticationOptions
@inject SqlAuthenticationService AuthenticationService
@inject UiText Text
@inject ILogger<AdminUsers> Logger
@inject IServiceProvider Services

<PageTitle>@Text[UseDirectory ? "UserDirectory.Title" : "AdminUsers.PageTitle"]</PageTitle>

@if (UseDirectory)
{
    <UserDirectoryPanel />
}
else
{
<section class="admin-heading">
    <div>
        <p class="eyebrow">@Text["Common.Administration"]</p>
        <h1>@Text["AdminUsers.Title"]</h1>
        <p class="subtitle">@Text["AdminUsers.Subtitle"]</p>
    </div>
    <div class="admin-heading-actions">
        <button class="admin-secondary" type="button" disabled="@IsBusy" @onclick="LoadUsersAsync">
            @Text[isLoading ? "Common.Refreshing" : "Common.Refresh"]
        </button>
        <button class="admin-primary" type="button" disabled="@MutationBlocked" @onclick="BeginCreate">@Text["AdminUsers.Create"]</button>
    </div>
</section>

@if (AuthenticationOptions.IsEntra)
{
    <div class="admin-message admin-message-warning" role="status">
        <LocalizedContent ResourceKey="AdminUsers.EntraWarning">
            <Value0><strong>@Text["AdminUsers.EntraActive"]</strong></Value0>
        </LocalizedContent>
    </div>
}
else if (AuthenticationOptions.IsOpen)
{
    <div class="admin-message admin-message-warning" role="alert">
        <LocalizedContent ResourceKey="AdminUsers.OpenWarning">
            <Value0><strong>@Text["AdminUsers.OpenActive"]</strong></Value0>
            <Value1><strong>sql</strong></Value1>
            <Value2><a href="/admin/settings">@Text["AdminUsers.SettingsPage"]</a></Value2>
        </LocalizedContent>
    </div>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="admin-message admin-message-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}
@if (reloadRequired)
{
    <div class="admin-message admin-message-warning" role="status">@Text["AdminUsers.Errors.ReloadRequired"]</div>
}

@if (Services.GetService<IdentityDirectoryOptions>()?.Enabled == true && !AuthenticationOptions.IsOpen)
{
    <IdentityMigrationPanel />
}

<div class="admin-workspace">
        <section class="admin-rule-list" aria-labelledby="users-heading">
            <div class="admin-section-heading">
                <div>
                    <h2 id="users-heading">@Text["AdminUsers.CurrentUsers"]</h2>
                    @if (hasLoaded)
                    {
                        <span>@UserCountLabel(users.Count)</span>
                    }
                </div>
            </div>

            @if (isLoading && users.Count == 0)
            {
                <p class="admin-empty">@Text["AdminUsers.Loading"]</p>
            }
            else if (hasLoaded && users.Count == 0)
            {
                <p class="admin-empty">@Text["AdminUsers.Empty"]</p>
            }
            else
            {
                <div class="admin-rule-cards auth-user-cards">
                    @foreach (var user in users)
                    {
                        <article class="admin-rule-card @(editingUsername == user.Username ? "selected" : null)">
                            <div class="admin-rule-card-heading">
                                <div>
                                    <span class="admin-status enabled">@user.Role</span>
                                    <h3>@user.Username</h3>
                                </div>
                                <div class="admin-card-actions">
                                    <button class="admin-secondary" type="button" disabled="@MutationBlocked" @onclick="() => BeginEdit(user)">@Text["Common.Edit"]</button>
                                    <button class="admin-danger" type="button" disabled="@MutationBlocked" @onclick="() => BeginDelete(user.Username)">@Text["Common.Delete"]</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="admin-editor" aria-labelledby="user-editor-heading">
            @if (editingUsername is null)
            {
                <div class="admin-editor-placeholder">
                    <strong>@Text["AdminUsers.SelectUser"]</strong>
                    <span>@Text["AdminUsers.SelectHint"]</span>
                </div>
            }
            else
            {
                <div class="admin-section-heading">
                    <div>
                        <p class="eyebrow">@Text[isCreating ? "AdminUsers.NewUser" : "AdminUsers.EditUser"]</p>
                        <h2 id="user-editor-heading">@(isCreating ? Text["AdminUsers.CreateTitle"] : editingUsername)</h2>
                    </div>
                </div>

                <form class="admin-form" inert="@IsBusy" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                    <label class="admin-field admin-field-wide">
                        <span>@Text["Authentication.Username"]</span>
                        @if (isCreating)
                        {
                            <input required maxlength="128" autocomplete="off" @bind="editingUsername" />
                        }
                        else
                        {
                            <input value="@editingUsername" readonly />
                        }
                        <small>@Text["AdminUsers.UsernameHint"]</small>
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>@Text["AdminUsers.Role"]</span>
                        <select required @bind="editingRole">
                            @foreach (var role in SqlAuthenticationRoles.All)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <small>@Text["AdminUsers.RoleHint"]</small>
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>@Text[isCreating ? "Authentication.Password" : "AdminUsers.NewPassword"]</span>
                        <input type="password" required="@PasswordRequired" maxlength="1024" autocomplete="new-password" @bind="password" @bind:event="oninput" />
                        <small>@Text[isCreating ? "AdminUsers.PasswordRequiredHint" : "AdminUsers.PasswordOptionalHint"]</small>
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>@Text["AdminUsers.ConfirmPassword"]</span>
                        <input type="password" required="@PasswordRequired" maxlength="1024" autocomplete="new-password" @bind="passwordConfirmation" @bind:event="oninput" />
                    </label>
                    <div class="admin-form-actions">
                        <button class="admin-secondary" type="button" disabled="@IsBusy" @onclick="CancelEdit">@Text["Common.Cancel"]</button>
                        <button class="admin-primary" type="submit" disabled="@MutationBlocked">
                            @Text[isSaving ? "Common.Saving" : isCreating ? "AdminUsers.Create" : "Common.SaveChanges"]
                        </button>
                    </div>
                </form>
            }
        </section>
</div>

@if (usernameToDelete is not null)
{
    <div class="admin-dialog-backdrop" role="presentation">
        <section class="admin-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-user-heading">
            <p class="eyebrow">@Text["Common.PermanentAction"]</p>
            <h2 id="delete-user-heading">@Text["AdminUsers.DeleteTitle"]</h2>
            <p>
                <LocalizedEmphasis ResourceKey="AdminUsers.DeleteBody" Value="@usernameToDelete" />
            </p>
            <div class="admin-form-actions">
                <button class="admin-secondary" type="button" disabled="@IsBusy" @onclick="CancelDelete">@Text["Common.Cancel"]</button>
                <button class="admin-danger" type="button" disabled="@MutationBlocked" @onclick="DeleteAsync">
                    @Text[isDeleting ? "Common.Deleting" : "AdminUsers.DeleteUser"]
                </button>
            </div>
        </section>
    </div>
}

}

@code {
    private IReadOnlyList<SqlAuthenticationUserSummary> users = [];
    private string? editingUsername;
    private string editingRole = SqlAuthenticationRoles.Reader;
    private string? usernameToDelete;
    private string password = string.Empty;
    private string passwordConfirmation = string.Empty;
    private bool isCreating;
    private bool isLoading;
    private bool isSaving;
    private bool isDeleting;
    private bool hasLoaded;
    private bool reloadRequired;
    private string? statusMessage;
    private string? errorMessage;

    private bool UseDirectory => Services.GetService<IdentityDirectoryOptions>()?.Enabled == true;
    protected override Task OnInitializedAsync() => UseDirectory ? Task.CompletedTask : LoadUsersAsync();

    private bool PasswordRequired => isCreating || password.Length > 0 || passwordConfirmation.Length > 0;
    private bool IsBusy => isLoading || isSaving || isDeleting;
    private bool MutationBlocked => IsBusy || !hasLoaded || reloadRequired;

    private async Task<bool> LoadUsersAsync()
    {
        if (IsBusy) return false;
        statusMessage = null;
        return await RefreshUsersAsync();
    }

    private async Task<bool> RefreshUsersAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            users = await AuthenticationService.GetUsersAsync();
            hasLoaded = true;
            reloadRequired = false;
            return true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load authentication users.");
            errorMessage = Text["AdminUsers.Errors.LoadFailed"];
            return false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginCreate()
    {
        if (MutationBlocked) return;
        editingUsername = string.Empty;
        editingRole = users.Count == 0 ? SqlAuthenticationRoles.Admin : SqlAuthenticationRoles.Reader;
        password = string.Empty;
        passwordConfirmation = string.Empty;
        isCreating = true;
        statusMessage = null;
        errorMessage = null;
    }

    private void BeginEdit(SqlAuthenticationUserSummary user)
    {
        if (MutationBlocked) return;
        editingUsername = user.Username;
        editingRole = user.Role;
        password = string.Empty;
        passwordConfirmation = string.Empty;
        isCreating = false;
        statusMessage = null;
        errorMessage = null;
    }

    private void CancelEdit()
    {
        if (IsBusy) return;
        ClearEdit();
        errorMessage = null;
    }

    private void ClearEdit()
    {
        editingUsername = null;
        editingRole = SqlAuthenticationRoles.Reader;
        password = string.Empty;
        passwordConfirmation = string.Empty;
        isCreating = false;
    }

    private async Task SaveAsync()
    {
        if (editingUsername is null || MutationBlocked)
        {
            return;
        }

        if ((isCreating || password.Length > 0 || passwordConfirmation.Length > 0) &&
            password != passwordConfirmation)
        {
            statusMessage = null;
            errorMessage = Text["AdminUsers.PasswordMismatch"];
            return;
        }

        isSaving = true;
        statusMessage = null;
        errorMessage = null;
        var roleUpdated = false;
        try
        {
            var username = editingUsername;
            if (isCreating)
            {
                username = await AuthenticationService.CreateUserAsync(username, password, editingRole);
                statusMessage = Text.Format("AdminUsers.Created", username);
            }
            else
            {
                await AuthenticationService.SetRoleAsync(username, editingRole);
                roleUpdated = true;
                if (password.Length > 0)
                {
                    await AuthenticationService.SetPasswordAsync(username, password);
                }
                statusMessage = Text.Format("AdminUsers.Updated", username);
            }

            ClearEdit();
            if (!await RefreshUsersAsync())
            {
                reloadRequired = true;
                statusMessage = null;
                errorMessage = Text["AdminUsers.Errors.SavedRefreshFailed"];
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "An authentication user save did not complete successfully.");
            var knownMessage = KnownErrorMessage(exception);
            reloadRequired = roleUpdated || knownMessage is null || IsUnconfirmed(exception);
            errorMessage = roleUpdated && password.Length > 0
                ? Text["AdminUsers.Errors.RoleSavedPasswordUnconfirmed"]
                : knownMessage ?? Text["AdminUsers.Errors.ChangeUnconfirmed"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private void BeginDelete(string username)
    {
        if (MutationBlocked) return;
        usernameToDelete = username;
        statusMessage = null;
        errorMessage = null;
    }

    private void CancelDelete()
    {
        if (!IsBusy) usernameToDelete = null;
    }

    private async Task DeleteAsync()
    {
        if (usernameToDelete is null || MutationBlocked)
        {
            return;
        }

        isDeleting = true;
        statusMessage = null;
        errorMessage = null;
        var username = usernameToDelete;
        try
        {
            if (!await AuthenticationService.DeleteUserAsync(username))
            {
                errorMessage = Text["AdminUsers.Errors.Missing"];
                return;
            }

            if (editingUsername == username)
            {
                ClearEdit();
            }

            usernameToDelete = null;
            statusMessage = Text.Format("AdminUsers.Deleted", username);
            if (!await RefreshUsersAsync())
            {
                reloadRequired = true;
                statusMessage = null;
                errorMessage = Text["AdminUsers.Errors.DeletedRefreshFailed"];
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "An authentication user delete did not complete successfully.");
            var knownMessage = KnownErrorMessage(exception);
            reloadRequired = knownMessage is null || IsUnconfirmed(exception);
            if (reloadRequired) usernameToDelete = null;
            errorMessage = knownMessage ?? Text["AdminUsers.Errors.ChangeUnconfirmed"];
        }
        finally
        {
            isDeleting = false;
        }
    }

    private string UserCountLabel(int count) => Text.Plural("AdminUsers.Count", count);

    private string? KnownErrorMessage(Exception exception) => exception switch
    {
        SqlAuthenticationException { Code: SqlAuthenticationErrorCode.DuplicateUser, Arguments: [string username] } =>
            Text.Format("AdminUsers.Errors.DuplicateUser", username),
        SqlAuthenticationException { Code: var code } when code is
            SqlAuthenticationErrorCode.Username or SqlAuthenticationErrorCode.Password or
            SqlAuthenticationErrorCode.Role or SqlAuthenticationErrorCode.Missing or
            SqlAuthenticationErrorCode.LastAdmin or SqlAuthenticationErrorCode.LastUserOrAdmin or
            SqlAuthenticationErrorCode.CreateUnconfirmed or SqlAuthenticationErrorCode.PasswordUnconfirmed or
            SqlAuthenticationErrorCode.DeleteUnconfirmed => Text["AdminUsers.Errors." + code],
        _ => null
    };

    private static bool IsUnconfirmed(Exception exception) => exception is SqlAuthenticationException
    {
        Code: SqlAuthenticationErrorCode.CreateUnconfirmed or SqlAuthenticationErrorCode.PasswordUnconfirmed or
            SqlAuthenticationErrorCode.DeleteUnconfirmed
    };
}
