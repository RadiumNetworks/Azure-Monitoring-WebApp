@page "/login"
@layout LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject ApplicationAuthenticationOptions AuthenticationOptions
@inject UiText Text

<PageTitle>@Text["Authentication.SignIn"]</PageTitle>

<section class="login-shell">
    <div class="login-panel">
        <p class="eyebrow">@Text["Authentication.RestrictedAccess"]</p>
        <h1>@Text["Authentication.SignIn"]</h1>
        @if (AuthenticationOptions.IsOpen)
        {
            <p class="subtitle">@Text["Authentication.OpenModeDescription"]</p>
            <a class="admin-primary login-home-link" href="/">@Text["Authentication.OpenConsole"]</a>
        }
        else if (AuthenticationOptions.IsEntra)
        {
            <p class="subtitle">@Text["Authentication.EntraModeDescription"]</p>
            <a class="admin-primary login-home-link" href="@("/.auth/login/aad?post_login_redirect_uri=" + Uri.EscapeDataString(SafeReturnUrl))">@Text["Authentication.SignInWithMicrosoft"]</a>
        }
        else
        {
            <p class="subtitle">@Text["Authentication.SqlModeDescription"]</p>
            @if (Error == "invalid")
            {
                <div class="admin-message admin-message-error" role="alert">
                    @Text["Authentication.InvalidCredentials"]
                </div>
            }
            <form class="login-form" method="post" action="/auth/login">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@SafeReturnUrl" />
                <label class="admin-field">
                    <span>@Text["Authentication.Username"]</span>
                    <input name="Username" required maxlength="128" autocomplete="username" autofocus />
                </label>
                <label class="admin-field">
                    <span>@Text["Authentication.Password"]</span>
                    <input name="Password" type="password" required maxlength="1024" autocomplete="current-password" />
                </label>
                <button class="admin-primary" type="submit">@Text["Authentication.SignIn"]</button>
            </form>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private string SafeReturnUrl =>
        !string.IsNullOrWhiteSpace(ReturnUrl) &&
        Uri.TryCreate(ReturnUrl, UriKind.Relative, out _) &&
        ReturnUrl.StartsWith('/') &&
        !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            ? ReturnUrl
            : "/";
}
