@{
    var solarOverlay = AlertGraphSolarOverlay.Build(TimeUtc);
    var siteMarkers = AlertGraphSiteMap.Build(Records, Locations, TimeUtc);
    var moonSites = EasterEgg?.Sites.Where(site => site.MoonPosition is not null).ToArray() ?? [];
    var marsSites = EasterEgg?.Sites.Where(site => site.MarsPosition is not null).ToArray() ?? [];
}

<div class="graph-site-map-frame">
    @if (EasterEgg is not null)
    {
        <aside class="graph-offworld-sites graph-easter-egg-@EasterEgg.Theme" aria-label="@EasterEgg.AriaLabel">
            <span class="graph-offworld-heading">
                @EasterEgg.Heading
                @if (EasterEgg.Note is { } note)
                {
                    <small class="graph-offworld-note">@note</small>
                }
            </span>
            <div class="graph-offworld-site-list">
                @foreach (var site in EasterEgg.Sites)
                {
                    <div class="graph-offworld-site graph-offworld-site-@site.Tone @(site.IsDanger ? "graph-offworld-site-danger" : null)"
                         title="@SiteTitle(site)">
                        <EasterEggIcon Tone="@site.Tone" Size="22" />
                        <strong>@site.Name</strong>
                    </div>
                }
            </div>
        </aside>
    }
    <div class="graph-site-map-bodies @(moonSites.Length > 0 ? "has-moon" : null) @(marsSites.Length > 0 ? "has-mars" : null)">
        <svg class="graph-site-map-svg"
             viewBox="0 0 2756 1399"
             role="img"
             aria-label="World map showing alert status for @siteMarkers.Count configured sites@(EasterEgg?.Sites.Any(site => site.EarthLocation is not null || site.EarthLocationOptions is not null || site.IsOrbiting) == true ? $" and {EasterEgg.Heading}" : "")">
            <image href="/world-map-configurable.svg" x="0" y="0" width="2756" height="1399" preserveAspectRatio="xMidYMid meet" />
            <g class="graph-solar-overlay" aria-hidden="true">
                @foreach (var path in solarOverlay.Paths)
                {
                    <path class="@(path.Phase == AlertGraphSolarPhase.Night ? "graph-map-night" : "graph-map-twilight")" d="@path.Data" />
                }
            </g>
            @foreach (var marker in siteMarkers)
            {
                <g class="graph-site-marker @(marker.HasOpenAlerts ? "graph-site-marker-alert" : "graph-site-marker-healthy")"
                   transform="translate(@Coordinate(marker.X) @Coordinate(marker.Y))" role="group"
                   aria-label="@marker.Name, @marker.StatusLabel, @marker.SolarPhaseLabel">
                    <title>@marker.Name · @marker.StatusLabel · @marker.SolarPhaseLabel</title>
                    <circle class="graph-site-marker-pulse" r="31" aria-hidden="true" />
                    <circle class="graph-site-marker-point" r="18" aria-hidden="true" />
                    <text x="@Coordinate(marker.LabelOffsetX)" y="@Coordinate(marker.LabelOffsetY)" text-anchor="@marker.TextAnchor">@marker.Name</text>
                </g>
            }
            @if (EasterEgg is not null)
            {
                @foreach (var site in EasterEgg.Sites)
                {
                    @if (ResolveEarthLocation(site) is { } location)
                    {
                        var (x, y) = AlertGraphSiteMap.Project(location.Latitude, location.Longitude);
                        <g class="graph-earth-easter-site graph-easter-marker-@site.Tone"
                           transform="translate(@Coordinate(x) @Coordinate(y))" role="group" tabindex="0"
                           aria-label="@SiteTitle(site), Easter egg">
                            <title>@SiteTitle(site)</title>
                            <line class="graph-easter-leader" x1="0" y1="0" x2="@Coordinate(location.OffsetX)" y2="@Coordinate(location.OffsetY)" />
                            <circle class="graph-easter-anchor" r="7" />
                            <g transform="translate(@Coordinate(location.OffsetX) @Coordinate(location.OffsetY))">
                                @if (site.Tone == "ufo")
                                {
                                    <g class="graph-easter-hovering">
                                        <EasterEggIcon Tone="@site.Tone" X="-55" Y="-55" Size="110" />
                                    </g>
                                }
                                else
                                {
                                    <circle class="graph-easter-disc" r="43" />
                                    <EasterEggIcon Tone="@site.Tone" X="-29" Y="-29" Size="58" />
                                }
                            </g>
                        </g>
                    }
                }
                @foreach (var site in EasterEgg.Sites.Where(site => site.IsOrbiting))
                {
                    <g class="graph-easter-orbit" role="group" aria-label="@site.Name Earth orbit">
                        <title>@site.Name Earth orbit</title>
                        <ellipse class="graph-orbit-path" cx="1378" cy="699" rx="1250" ry="610" />
                        <g class="graph-orbiting-site graph-easter-marker-@site.Tone">
                            <circle class="graph-easter-disc" r="38" />
                            <EasterEggIcon Tone="@site.Tone" X="-29" Y="-29" Size="58" />
                        </g>
                    </g>
                }
            }
        </svg>
        @if (moonSites.Length > 0)
        {
            <aside class="graph-moon-panel" aria-labelledby="graph-moon-heading">
                <h3 id="graph-moon-heading">@(EasterEgg?.Theme == "lunar" ? "Moon landing anniversary" : "Moon")</h3>
                <svg class="graph-moon-svg" viewBox="0 0 798 768" role="img"
                     aria-label="@($"Moon with {moonSites.Length} lunar site {(moonSites.Length == 1 ? "marker" : "markers")}")">
                    <image href="/moon-easter-egg.png" width="798" height="768" preserveAspectRatio="xMidYMid meet" />
                    @for (var index = 0; index < moonSites.Length; index++)
                    {
                        var site = moonSites[index];
                        var position = site.MoonPosition!;
                        <g class="graph-moon-site graph-easter-marker-@site.Tone"
                           transform="translate(@Coordinate(position.X * 798) @Coordinate(position.Y * 768))"
                           role="group" tabindex="0" aria-label="@SiteTitle(site), Moon site">
                            <title>@SiteTitle(site)</title>
                            <circle class="graph-easter-disc" r="34" />
                            <EasterEggIcon Tone="@site.Tone" X="-23" Y="-23" Size="46" />
                            <text class="graph-moon-marker-number" x="27" y="-22">@(index + 1)</text>
                        </g>
                    }
                </svg>
                <ol class="graph-moon-site-legend">
                    @foreach (var site in moonSites)
                    {
                        <li>@site.Name</li>
                    }
                </ol>
            </aside>
        }
        @if (marsSites.Length > 0)
        {
            <aside class="graph-mars-panel" aria-labelledby="graph-mars-heading">
                <h3 id="graph-mars-heading">Mars</h3>
                <div class="graph-mars-render">
                    <svg class="graph-mars-svg" viewBox="0 0 530 513" role="img" aria-label="Mars with Warhammer site marker">
                        <image href="/mars-easter-egg.png" width="530" height="513" preserveAspectRatio="xMidYMid meet" />
                        @foreach (var site in marsSites)
                        {
                            var position = site.MarsPosition!;
                            <g class="graph-mars-site graph-easter-marker-@site.Tone"
                               transform="translate(@Coordinate(position.X * 530) @Coordinate(position.Y * 513))"
                               role="group" tabindex="0" aria-label="@SiteTitle(site), Mars site">
                                <title>@SiteTitle(site)</title>
                                <circle class="graph-easter-disc" r="24" />
                                <EasterEggIcon Tone="@site.Tone" X="-16" Y="-16" Size="32" />
                            </g>
                        }
                    </svg>
                    <p class="graph-mars-property">Property of Fabricator-General of Mars, Adeptus Mechanicus</p>
                </div>
                <ul class="graph-mars-site-legend">
                    @foreach (var site in marsSites)
                    {
                        <li>@SiteTitle(site)</li>
                    }
                </ul>
            </aside>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AlertGraphRecord> Records { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<AlertGraphSiteLocationOptions> Locations { get; set; } = [];
    [Parameter] public DateTimeOffset TimeUtc { get; set; }
    [Parameter] public AlertGraphEasterEgg? EasterEgg { get; set; }

    private readonly Dictionary<string, AlertGraphEasterEggEarthLocation> selectedEarthLocations = [];
    private string? selectedTheme;
    private bool hasRenderedInteractively;

    protected override void OnParametersSet()
    {
        if (hasRenderedInteractively && selectedTheme != EasterEgg?.Theme)
            SelectEarthLocations();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        // Choose after hydration so prerendering cannot briefly show a different random position.
        hasRenderedInteractively = true;
        SelectEarthLocations();
        if (selectedEarthLocations.Count > 0)
            StateHasChanged();
    }

    private void SelectEarthLocations()
    {
        selectedTheme = EasterEgg?.Theme;
        selectedEarthLocations.Clear();
        if (EasterEgg is not null)
        {
            foreach (var site in EasterEgg.Sites)
            {
                if (site.EarthLocationOptions is { } options)
                    selectedEarthLocations.Add(site.Name, options[Random.Shared.Next(options.Count)]);
            }
        }
    }

    private AlertGraphEasterEggEarthLocation? ResolveEarthLocation(AlertGraphEasterEggSite site) =>
        site.EarthLocation ?? selectedEarthLocations.GetValueOrDefault(site.Name);

    private static string Coordinate(double value) =>
        value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static string SiteTitle(AlertGraphEasterEggSite site) =>
        string.IsNullOrWhiteSpace(site.Status) ? site.Name : $"{site.Name} · {site.Status}";
}
