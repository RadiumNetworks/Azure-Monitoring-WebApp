@page "/admin/inventory"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "OperatorAccess")]
@inject AlertStore AlertStore
@inject UiText Text
@inject ILogger<AdminInventory> Logger

<PageTitle>@Text["AdminInventory.PageTitle"]</PageTitle>

<section class="admin-heading">
    <div>
        <p class="eyebrow">@Text["Common.Administration"]</p>
        <h1>@Text["AdminInventory.Title"]</h1>
        <p class="subtitle">@Text["AdminInventory.Description"]</p>
    </div>
    <div class="admin-heading-actions">
        <button class="admin-secondary" type="button" disabled="@isLoading" @onclick="LoadInventoryAsync">
            @Text[isLoading ? "Common.Refreshing" : "Common.Refresh"]
        </button>
        <button class="admin-primary" type="button" @onclick="BeginCreate">@Text["AdminInventory.CreateEntry"]</button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="admin-message admin-message-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}

<div class="inventory-filter">
    <label class="admin-field">
        <span>@Text["AdminInventory.Search"]</span>
        <input type="search" placeholder="@Text["AdminInventory.SearchPlaceholder"]" @bind="searchText" @bind:event="oninput" />
    </label>
    <span>@Text.Plural("AdminInventory.Count", FilteredEntries.Count)</span>
</div>

<div class="inventory-filter-grid" aria-label="@Text["AdminInventory.Filters"]">
    <label class="admin-field">
        <span>@Text["AdminInventory.Subscription"]</span>
        <select @bind="subscriptionFilter">
            <option value="">@Text["AdminInventory.AllSubscriptions"]</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.SubscriptionId)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <label class="admin-field">
        <span>@Text["AdminInventory.ResourceGroup"]</span>
        <select @bind="resourceGroupFilter">
            <option value="">@Text["AdminInventory.AllResourceGroups"]</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.ResourceGroup)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <label class="admin-field">
        <span>@Text["Filters.Site"]</span>
        <select @bind="siteFilter">
            <option value="">@Text["Filters.AllSites"]</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.Site)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <label class="admin-field">
        <span>@Text["Filters.Domain"]</span>
        <select @bind="domainFilter">
            <option value="">@Text["Filters.AllDomains"]</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.Domain)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <label class="admin-field">
        <span>@Text["Filters.Role"]</span>
        <select @bind="roleFilter">
            <option value="">@Text["Filters.AllRoles"]</option>
            @foreach (var value in FilterOptions(entries.Select(entry => entry.Role)))
            {
                <option value="@value">@value</option>
            }
        </select>
    </label>
    <button class="admin-secondary" type="button" disabled="@(!HasInventoryFilters)" @onclick="ClearInventoryFilters">@Text["AdminInventory.ClearFilters"]</button>
</div>

<div class="admin-workspace">
    <section class="admin-rule-list" aria-labelledby="inventory-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="inventory-heading">@Text["AdminInventory.Systems"]</h2>
                <span>@Text["AdminInventory.DiscoveryHint"]</span>
            </div>
        </div>

        @if (isLoading && entries.Count == 0)
        {
            <p class="admin-empty">@Text["AdminInventory.Loading"]</p>
        }
        else if (FilteredEntries.Count == 0)
        {
            <p class="admin-empty">@Text["AdminInventory.NoMatches"]</p>
        }
        else
        {
            <div class="admin-rule-cards inventory-cards">
                @foreach (var entry in FilteredEntries)
                {
                    var isExpanded = IsExpanded(entry);
                    <article class="admin-rule-card inventory-card @(IsSelected(entry) ? "selected" : null) @(isExpanded ? "expanded" : null)">
                        <button class="inventory-card-toggle" type="button" aria-expanded="@isExpanded.ToString().ToLowerInvariant()" @onclick="() => ToggleExpanded(entry)">
                            <strong title="@entry.Computer">@entry.Computer</strong>
                            <span class="inventory-card-domain" title="@DisplayValue(entry.Domain)">@DisplayValue(entry.Domain)</span>
                            <span class="inventory-card-site" title="@DisplayValue(entry.Site)">@DisplayValue(entry.Site)</span>
                            <span title="@(entry.Maintenance ? Text["AdminInventory.Maintenance"] : DisplayValue(entry.Role))">@(entry.Maintenance ? Text["AdminInventory.Maintenance"] : DisplayValue(entry.Role))</span>
                            <span class="inventory-card-chevron" aria-hidden="true"></span>
                        </button>
                        @if (isExpanded)
                        {
                            <div class="inventory-card-details">
                                <div class="inventory-card-toolbar">
                                    <span class="admin-status @(entry.Maintenance ? "inventory-maintenance" : "enabled")">@Text[entry.Maintenance ? "AdminInventory.Maintenance" : "AdminInventory.Discovered"]</span>
                                    <div class="inventory-card-actions">
                                        <button class="admin-secondary" type="button" @onclick="() => BeginEdit(entry)">@Text["Common.Edit"]</button>
                                        <button class="admin-danger" type="button" @onclick="() => BeginDelete(entry)">@Text["Common.Delete"]</button>
                                    </div>
                                </div>
                                <dl class="admin-rule-summary">
                                    <div><dt>@Text["Filters.Site"]</dt><dd>@DisplayValue(entry.Site)</dd></div>
                                    <div><dt>@Text["Filters.Domain"]</dt><dd>@DisplayValue(entry.Domain)</dd></div>
                                    <div><dt>@Text["Filters.Role"]</dt><dd>@DisplayValue(entry.Role)</dd></div>
                                    <div><dt>@Text["AdminInventory.ResourceGroup"]</dt><dd>@DisplayValue(entry.ResourceGroup)</dd></div>
                                    <div><dt>@Text["AdminInventory.PrivateIp"]</dt><dd>@DisplayValue(entry.PrivateIP)</dd></div>
                                    <div><dt>@Text["AdminInventory.LastHeartbeat"]</dt><dd>@DisplayHeartbeat(entry.LastHeartbeatAt)</dd></div>
                                    <div><dt>@Text["AdminInventory.LastBootTime"]</dt><dd>@DisplayHeartbeat(entry.LastBootTime)</dd></div>
                                    <div><dt>@Text["AdminInventory.NtdsSize"]</dt><dd>@DisplayNtdsSize(entry.NtdsFileSizeInGb)</dd></div>
                                    <div><dt>@Text["AdminInventory.Maintenance"]</dt><dd>@Text[entry.Maintenance ? "Common.Enabled" : "Common.Disabled"]</dd></div>
                                    <div class="inventory-subscription"><dt>@Text["AdminInventory.Subscription"]</dt><dd>@entry.SubscriptionId</dd></div>
                                </dl>
                                @if (entry.Certificates.Count > 0)
                                {
                                    <section class="inventory-observation-details" aria-label="@Text["AdminInventory.Certificates"]">
                                        <h3>@Text["AdminInventory.Certificates"]</h3>
                                        <div class="inventory-detail-table">
                                            <div class="inventory-detail-heading"><span>@Text["AdminInventory.Name"]</span><span>@Text["AdminInventory.SerialNumber"]</span><span>@Text["AdminInventory.Expires"]</span></div>
                                            @foreach (var certificate in entry.Certificates)
                                            {
                                                <div>
                                                    <span title="@certificate.Name">@DisplayValue(certificate.Name)</span>
                                                    <span title="@certificate.SerialNumber">@DisplayValue(certificate.SerialNumber)</span>
                                                    <span>@DisplayDate(certificate.ExpiresAt)</span>
                                                </div>
                                            }
                                        </div>
                                    </section>
                                }
                                @if (entry.Services.Count > 0)
                                {
                                    <section class="inventory-observation-details" aria-label="@Text["AdminInventory.Services"]">
                                        <h3>@Text["AdminInventory.Services"]</h3>
                                        <div class="inventory-service-list">
                                            @foreach (var service in entry.Services)
                                            {
                                                <span><strong>@service.Name</strong> @DisplayServiceStatus(service.Status)</span>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="admin-editor" aria-labelledby="inventory-editor-heading">
        @if (editingEntry is null)
        {
            <div class="admin-editor-placeholder">
                <strong>@Text["AdminInventory.SelectSystem"]</strong>
                <span>@Text["AdminInventory.SelectSystemHelp"]</span>
            </div>
        }
        else
        {
            var entry = editingEntry;
            <div class="admin-section-heading">
                <div>
                    <p class="eyebrow">@Text[isCreating ? "AdminInventory.NewEntry" : "AdminInventory.EditSystem"]</p>
                    <h2 id="inventory-editor-heading">@(isCreating ? Text["AdminInventory.CreateComputer"] : entry.Computer)</h2>
                </div>
            </div>

            <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                @if (isCreating)
                {
                    <label class="admin-field admin-field-wide">
                        <span>@Text["AdminInventory.SubscriptionId"]</span>
                        <select required @bind="entry.SubscriptionId">
                            <option value="">@Text["AdminInventory.SelectSubscription"]</option>
                            @foreach (var subscriptionId in subscriptionIds)
                            {
                                <option value="@subscriptionId">@subscriptionId</option>
                            }
                        </select>
                        <small>@Text["AdminInventory.SubscriptionsHelp"]</small>
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>@Text["AdminInventory.Computer"]</span>
                        <input required maxlength="256" @bind="entry.Computer" />
                        <small>@Text["AdminInventory.PrimaryKeyHelp"]</small>
                    </label>
                }
                else
                {
                    <label class="admin-field admin-field-wide">
                        <span>@Text["AdminInventory.SubscriptionId"]</span>
                        <input value="@entry.SubscriptionId" readonly />
                        <small>@Text["AdminInventory.FixedKeyHelp"]</small>
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>@Text["AdminInventory.Computer"]</span>
                        <input value="@entry.Computer" readonly />
                        <small>@Text["AdminInventory.FixedKeyHelp"]</small>
                    </label>
                }
                <label class="admin-field">
                    <span>@Text["Filters.Site"]</span>
                    <input maxlength="256" @bind="entry.Site" />
                    <small>@Text["AdminInventory.SiteHelp"]</small>
                </label>
                <label class="admin-field">
                    <span>@Text["Filters.Domain"]</span>
                    <input maxlength="256" @bind="entry.Domain" />
                    <small>@Text["AdminInventory.DomainHelp"]</small>
                </label>
                <label class="admin-field">
                    <span>@Text["AdminInventory.ResourceGroup"]</span>
                    <input maxlength="256" @bind="entry.ResourceGroup" />
                    <small>@Text["AdminInventory.ResourceGroupHelp"]</small>
                </label>
                <label class="admin-field">
                    <span>@Text["Filters.Role"]</span>
                    <input maxlength="256" @bind="entry.Role" />
                    <small>@Text["AdminInventory.RoleHelp"]</small>
                </label>
                <label class="admin-check">
                    <input type="checkbox" @bind="entry.Maintenance" />
                    <span>@Text["AdminInventory.Maintenance"]</span>
                </label>
                <small>@Text["AdminInventory.MaintenanceHelp"]</small>
                @if (!isCreating)
                {
                    <label class="admin-field">
                        <span>@Text["AdminInventory.PrivateIp"]</span>
                        <input value="@DisplayValue(entry.PrivateIP)" readonly />
                        <small>@Text["AdminInventory.HeartbeatHelp"]</small>
                    </label>
                    <label class="admin-field">
                        <span>@Text["AdminInventory.LastHeartbeat"]</span>
                        <input value="@DisplayHeartbeat(entry.LastHeartbeatAt)" readonly />
                        <small>@Text["AdminInventory.GraphStatusHelp"]</small>
                    </label>
                    <label class="admin-field">
                        <span>@Text["AdminInventory.LastBootTime"]</span>
                        <input value="@DisplayHeartbeat(entry.LastBootTime)" readonly />
                        <small>@Text["AdminInventory.HeartbeatHelp"]</small>
                    </label>
                    <label class="admin-field">
                        <span>@Text["AdminInventory.NtdsSize"]</span>
                        <input value="@DisplayNtdsSize(entry.NtdsFileSizeInGb)" readonly />
                        <small>@Text["AdminInventory.NtdsHelp"]</small>
                    </label>
                    <section class="admin-field admin-field-wide inventory-editor-observations" aria-label="@Text["AdminInventory.CertificateInventory"]">
                        <span>@Text["AdminInventory.Certificates"]</span>
                        @if (entry.Certificates.Count == 0)
                        {
                            <div class="inventory-observation-empty">@Text["AdminInventory.NoCertificates"]</div>
                        }
                        else
                        {
                            <div class="inventory-detail-table">
                                <div class="inventory-detail-heading"><span>@Text["AdminInventory.Name"]</span><span>@Text["AdminInventory.SerialNumber"]</span><span>@Text["AdminInventory.Expires"]</span></div>
                                @foreach (var certificate in entry.Certificates)
                                {
                                    <div>
                                        <span title="@certificate.Name">@DisplayValue(certificate.Name)</span>
                                        <span title="@certificate.SerialNumber">@DisplayValue(certificate.SerialNumber)</span>
                                        <span>@DisplayDate(certificate.ExpiresAt)</span>
                                    </div>
                                }
                            </div>
                        }
                        <small>@Text["AdminInventory.HeartbeatHelp"]</small>
                    </section>
                    <section class="admin-field admin-field-wide inventory-editor-observations" aria-label="@Text["AdminInventory.ServiceInventory"]">
                        <span>@Text["AdminInventory.Services"]</span>
                        @if (entry.Services.Count == 0)
                        {
                            <div class="inventory-observation-empty">@Text["AdminInventory.NoServices"]</div>
                        }
                        else
                        {
                            <div class="inventory-service-table">
                                <div class="inventory-detail-heading"><span>@Text["AdminInventory.Service"]</span><span>@Text["AdminInventory.LastStatus"]</span></div>
                                @foreach (var service in entry.Services)
                                {
                                    <div>
                                        <span>@service.Name</span>
                                        <span>@DisplayServiceStatus(service.Status)</span>
                                    </div>
                                }
                            </div>
                        }
                        <small>@Text.Format("AdminInventory.ServiceHeartbeat", DisplayHeartbeat(entry.LastHeartbeatAt))</small>
                    </section>
                }
                <div class="admin-form-actions">
                    <button class="admin-secondary" type="button" disabled="@isSaving" @onclick="CancelEdit">@Text["Common.Cancel"]</button>
                    <button class="admin-primary" type="submit" disabled="@isSaving">
                        @Text[isSaving ? "Common.Saving" : isCreating ? "AdminInventory.CreateEntry" : "Common.SaveChanges"]
                    </button>
                </div>
            </form>
        }
    </section>
</div>

@if (entryToDelete is not null)
{
    <div class="admin-dialog-backdrop" role="presentation">
        <section class="admin-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-inventory-heading">
            <p class="eyebrow">@Text["Common.PermanentAction"]</p>
            <h2 id="delete-inventory-heading">@Text["AdminInventory.DeleteTitle"]</h2>
            <p><LocalizedContent ResourceKey="AdminInventory.DeleteBody">
                <Value0><strong>@entryToDelete.Computer</strong></Value0>
                <Value1><strong>@entryToDelete.SubscriptionId</strong></Value1>
            </LocalizedContent></p>
            <div class="admin-form-actions">
                <button class="admin-secondary" type="button" disabled="@isDeleting" @onclick="CancelDelete">@Text["Common.Cancel"]</button>
                <button class="admin-danger" type="button" disabled="@isDeleting" @onclick="DeleteAsync">
                    @Text[isDeleting ? "Common.Deleting" : "AdminInventory.DeleteEntry"]
                </button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<ComputerInventoryEntry> entries = [];
    private IReadOnlyList<string> subscriptionIds = [];
    private readonly HashSet<(string SubscriptionId, string Computer)> expandedEntries = [];
    private ComputerInventoryEntry? editingEntry;
    private ComputerInventoryEntry? entryToDelete;
    private string searchText = string.Empty;
    private string subscriptionFilter = string.Empty;
    private string resourceGroupFilter = string.Empty;
    private string siteFilter = string.Empty;
    private string domainFilter = string.Empty;
    private string roleFilter = string.Empty;
    private bool isCreating;
    private bool isLoading;
    private bool isSaving;
    private bool isDeleting;
    private string? statusMessage;
    private string? errorMessage;

    private IReadOnlyList<ComputerInventoryEntry> FilteredEntries => entries
        .Where(entry => string.IsNullOrWhiteSpace(searchText) ||
            entry.Computer.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            entry.SubscriptionId.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (entry.ResourceGroup?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (entry.Site?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (entry.Domain?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (entry.Role?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(entry => MatchesFilter(entry.SubscriptionId, subscriptionFilter))
        .Where(entry => MatchesFilter(entry.ResourceGroup, resourceGroupFilter))
        .Where(entry => MatchesFilter(entry.Site, siteFilter))
        .Where(entry => MatchesFilter(entry.Domain, domainFilter))
        .Where(entry => MatchesFilter(entry.Role, roleFilter))
        .ToArray();

    private bool HasInventoryFilters =>
        !string.IsNullOrWhiteSpace(subscriptionFilter) ||
        !string.IsNullOrWhiteSpace(resourceGroupFilter) ||
        !string.IsNullOrWhiteSpace(siteFilter) ||
        !string.IsNullOrWhiteSpace(domainFilter) ||
        !string.IsNullOrWhiteSpace(roleFilter);

    protected override Task OnInitializedAsync() => LoadInventoryAsync();

    private async Task LoadInventoryAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            entries = await AlertStore.GetComputerInventoryAsync();
            subscriptionIds = await AlertStore.GetAlertSubscriptionIdsAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load computer inventory.");
            errorMessage = Text["AdminInventory.Errors.LoadFailed"];
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginCreate()
    {
        editingEntry = new ComputerInventoryEntry
        {
            SubscriptionId = subscriptionIds.Count == 1 ? subscriptionIds[0] : string.Empty
        };
        isCreating = true;
        statusMessage = null;
        errorMessage = subscriptionIds.Count == 0
            ? Text["AdminInventory.NoSubscriptions"]
            : null;
    }

    private void BeginEdit(ComputerInventoryEntry source)
    {
        editingEntry = Clone(source);
        isCreating = false;
        statusMessage = null;
        errorMessage = null;
    }

    private void CancelEdit()
    {
        editingEntry = null;
        isCreating = false;
        errorMessage = null;
    }

    private async Task SaveAsync()
    {
        if (editingEntry is null || isSaving)
        {
            return;
        }

        isSaving = true;
        statusMessage = null;
        errorMessage = null;
        try
        {
            var saved = isCreating
                ? await AlertStore.CreateComputerInventoryEntryAsync(editingEntry)
                : await AlertStore.SaveComputerInventoryEntryAsync(editingEntry);
            statusMessage = isCreating
                ? Text.Format("AdminInventory.Created", saved.Computer)
                : Text.Format("AdminInventory.Updated", saved.Computer);
            editingEntry = null;
            isCreating = false;
            await LoadInventoryAsync();
        }
        catch (ComputerInventoryException exception) when (exception.Code == ComputerInventoryErrorCode.SavedNotificationFailed)
        {
            editingEntry = null;
            isCreating = false;
            await ReloadAfterCommittedFailureAsync(exception);
        }
        catch (ComputerInventoryException exception)
        {
            ShowInventoryError(exception);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The outcome of saving a computer inventory record could not be confirmed.");
            errorMessage = Text["AdminInventory.Errors.ChangeUnconfirmed"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private void BeginDelete(ComputerInventoryEntry source)
    {
        entryToDelete = Clone(source);
        statusMessage = null;
        errorMessage = null;
    }

    private void CancelDelete() => entryToDelete = null;

    private async Task DeleteAsync()
    {
        if (entryToDelete is null || isDeleting)
        {
            return;
        }

        isDeleting = true;
        statusMessage = null;
        errorMessage = null;
        var deletedEntry = entryToDelete;
        try
        {
            var deleted = await AlertStore.DeleteComputerInventoryEntryAsync(
                deletedEntry.SubscriptionId,
                deletedEntry.Computer);
            if (!deleted)
            {
                errorMessage = Text["AdminInventory.Missing"];
                return;
            }

            ClearDeletedSelection(deletedEntry);
            statusMessage = Text.Format("AdminInventory.Deleted", deletedEntry.Computer);
            await LoadInventoryAsync();
        }
        catch (ComputerInventoryException exception) when (exception.Code == ComputerInventoryErrorCode.DeletedNotificationFailed)
        {
            ClearDeletedSelection(deletedEntry);
            await ReloadAfterCommittedFailureAsync(exception);
        }
        catch (ComputerInventoryException exception)
        {
            ShowInventoryError(exception);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The outcome of deleting a computer inventory record could not be confirmed.");
            errorMessage = Text["AdminInventory.Errors.ChangeUnconfirmed"];
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ClearDeletedSelection(ComputerInventoryEntry entry)
    {
        if (IsSelected(entry))
        {
            editingEntry = null;
            isCreating = false;
        }
        entryToDelete = null;
    }

    private void ShowInventoryError(ComputerInventoryException exception)
    {
        Logger.LogWarning(exception, "Computer inventory operation reported {ErrorCode}.", exception.Code);
        errorMessage = Text.Format("AdminInventory.Errors." + exception.Code, exception.Arguments.ToArray());
    }

    private async Task ReloadAfterCommittedFailureAsync(ComputerInventoryException exception)
    {
        ShowInventoryError(exception);
        var notificationMessage = errorMessage;
        await LoadInventoryAsync();
        errorMessage = errorMessage is null ? notificationMessage : Text["AdminInventory.Errors.CommittedReloadFailed"];
    }

    private bool IsSelected(ComputerInventoryEntry entry) =>
        editingEntry is not null &&
        entry.SubscriptionId == editingEntry.SubscriptionId &&
        entry.Computer == editingEntry.Computer;

    private bool IsExpanded(ComputerInventoryEntry entry) =>
        expandedEntries.Contains((entry.SubscriptionId, entry.Computer));

    private void ToggleExpanded(ComputerInventoryEntry entry)
    {
        var key = (entry.SubscriptionId, entry.Computer);
        if (!expandedEntries.Add(key))
        {
            expandedEntries.Remove(key);
        }
    }

    private static ComputerInventoryEntry Clone(ComputerInventoryEntry source) => new()
    {
        SubscriptionId = source.SubscriptionId,
        Computer = source.Computer,
        Site = source.Site,
        Domain = source.Domain,
        ResourceGroup = source.ResourceGroup,
        Role = source.Role,
        PrivateIP = source.PrivateIP,
        LastHeartbeatAt = source.LastHeartbeatAt,
        LastBootTime = source.LastBootTime,
        NtdsFileSizeInGb = source.NtdsFileSizeInGb,
        CertificatesJson = source.CertificatesJson,
        ServicesJson = source.ServicesJson,
        Maintenance = source.Maintenance
    };

    private void ClearInventoryFilters()
    {
        subscriptionFilter = string.Empty;
        resourceGroupFilter = string.Empty;
        siteFilter = string.Empty;
        domainFilter = string.Empty;
        roleFilter = string.Empty;
    }

    private static bool MatchesFilter(string? value, string filter) =>
        string.IsNullOrWhiteSpace(filter) || string.Equals(value, filter, StringComparison.OrdinalIgnoreCase);

    private static IReadOnlyList<string> FilterOptions(IEnumerable<string?> values) => values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(value) ? Text["AdminInventory.NotAvailable"] : value;

    private string DisplayHeartbeat(DateTimeOffset? value) =>
        value?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? Text["AdminInventory.NotAvailable"];

    private string DisplayDate(DateTimeOffset? value) =>
        value?.ToUniversalTime().ToString("yyyy-MM-dd") ?? Text["AdminInventory.NotAvailable"];

    private string DisplayNtdsSize(double? value) =>
        value.HasValue ? $"{value.Value:N2} GB" : Text["AdminInventory.NotAvailable"];

    private string DisplayServiceStatus(int? status) => status switch
    {
        1 => Text["AdminInventory.Service.Stopped"],
        2 => Text["AdminInventory.Service.StartPending"],
        3 => Text["AdminInventory.Service.StopPending"],
        4 => Text["AdminInventory.Service.Running"],
        5 => Text["AdminInventory.Service.ContinuePending"],
        6 => Text["AdminInventory.Service.PausePending"],
        7 => Text["AdminInventory.Service.Paused"],
        _ => status.HasValue ? Text.Format("AdminInventory.Service.Other", status.Value.ToString(System.Globalization.CultureInfo.CurrentCulture)) : Text["AdminInventory.Service.Unknown"]
    };

}