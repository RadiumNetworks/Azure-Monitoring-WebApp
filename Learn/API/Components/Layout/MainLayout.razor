@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/"><span>{ }</span><strong>API<br />Learning</strong></a>
        <NavMenu />
        <div class="sidebar-note"><i></i><span>SQLite connected</span></div>
    </aside>
    <main class="main-area">
        <header class="topbar">
            <span>JSON ingestion &amp; querying</span>
            <a href="/graphql" target="_blank">Open GraphQL IDE ↗</a>
        </header>
        <article class="content-shell">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
