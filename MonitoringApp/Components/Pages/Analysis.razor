    private async Task DuplicateDashboardAsync()
    {
        if (DashboardBusy || dashboardLoadFailed)
            return;
        isChangingDashboard = true;
        publicationError = publicationMessage = null;
        try
        {
            AnalysisDashboardDocument source;
            if (selectedPublishedDashboard is Guid publishedId)
                source = (await Publishing.LoadAsync(publishedId,
                    (await AuthenticationStateTask).User, refreshCancellation.Token)).Document;
            else
            {
                if (!await TrySaveDashboardAsync())
                    return;
                source = Dashboard.Document;
            }
            source.ValidateSelection();
            var candidate = dashboardCollection.Copy();
            candidate.AddCopy(source);
            var saved = await DashboardRepository.SaveForOwnerAsync(
                dashboardActorKey, dashboardOwnerKey, candidate, dashboardRevision, refreshCancellation.Token);
            ActivatePersonalDashboard(candidate, saved.Revision);
            if (UsesInventoryRoles) await RefreshRoleInventoryAsync();
            editMode = dashboardEditMode = true;
            publicationMessage = Text.Format("AnalysisStatus.CopyCreated", Dashboard.Document.Name);
        }
        catch (DbUpdateConcurrencyException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard collection changed before duplication.");
            publicationError = Text["Analysis.Errors.CopyConflict"];
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard duplication access was denied.");
            publicationError = Text["Analysis.Errors.PublicationNotAllowed"];
        }
        catch (KeyNotFoundException exception)
        {
            Logger.LogWarning(exception, "The source analysis publication is unavailable.");
            publicationError = Text["Analysis.Errors.PublicationUnavailable"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis dashboard duplication could not be completed.");
            publicationError = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.CopyFailed");
        }
        finally
        {
            isChangingDashboard = false;
        }
    }

    private void ActivatePersonalDashboard(AnalysisDashboardCollection collection, int revision)
    {
        var document = collection.OpenActive();
        document.ValidateSelection();
        dashboardRevision = revision;
        dashboardCollection = collection;
        selectedPublishedDashboard = null;
        runPublishedOnFilterChange = false;
        Dashboard.Load(document);
        setupAwaitingExecution = false;
        ClearSetupPreview();
        setupExportJson = null;
        if (document.ViewFilters is { } filters)
        {
            workspaceFilter = filters.WorkspaceKey;
            domainFilter = filters.Domain;
            siteFilter = filters.Site;
            roleFilter = filters.Role;
        }
        confirmWithdrawDashboard = false;
        selectedQueryId = Guid.Empty;
        openedWidgetId = null;
        RestoreDashboardSystems();
        dashboardStatus = Text.Format("AnalysisStatus.NamedSaved", Dashboard.Document.Name, dashboardRevision);
    }

    private async Task ChangeDashboardAsync(Action<AnalysisDashboardCollection> change)
    {
        if (isRunning || isDashboardRunning || PersonalActionsBlocked)
            return;
        isChangingDashboard = true;
        errorMessage = null;
        try
        {
            if (!await TrySaveDashboardAsync())
                return;
            var candidate = dashboardCollection.Copy();
            change(candidate);
            candidate.Active.Document.ValidateSelection();
            var saved = await DashboardRepository.SaveForOwnerAsync(dashboardActorKey, dashboardOwnerKey, candidate, dashboardRevision);
            ActivatePersonalDashboard(candidate, saved.Revision);
            if (UsesInventoryRoles) await RefreshRoleInventoryAsync();
        }
        catch (DbUpdateConcurrencyException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard collection changed in another session.");
            errorMessage = Text["Analysis.Errors.CollectionChanged"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The analysis dashboard change could not be completed.");
            errorMessage = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ChangeFailed");
        }
        finally
        {
            isChangingDashboard = false;
        }
    }

    private async Task SaveDashboardAsync() => await TrySaveDashboardAsync();

    private async Task<bool> TrySaveDashboardAsync()
    {
        try { ValidateSelectionDraft(); }
        catch (AnalysisValidationException exception)
        {
            Logger.LogWarning(exception, "Cannot save an invalid dashboard selection draft.");
            errorMessage = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.SaveUnconfirmed");
            return false;
        }
        if (dashboardLoadFailed || isLoadingDashboard)
        {
            Logger.LogWarning("Analysis dashboard save is blocked until workspace loading succeeds.");
            return false;
        }
        if (selectedPublishedDashboard is not null)
        {
            Logger.LogWarning("Cannot save a published analysis dashboard as a personal dashboard.");
            publicationError = Text["Analysis.Errors.PublishedReadOnly"];
            return false;
        }
        if (isSavingDashboard)
        {
            Logger.LogWarning("An analysis dashboard save is already in progress.");
            errorMessage = Text["Analysis.Errors.SaveInProgress"];
            return false;
        }
        isSavingDashboard = true;
        errorMessage = null;
        try
        {
            dashboardCollection.CaptureActive(Dashboard.Document);
            var snapshot = dashboardCollection.Copy();
            var saved = await DashboardRepository.SaveForOwnerAsync(
                dashboardActorKey, dashboardOwnerKey,
                snapshot,
                dashboardRevision);
            dashboardRevision = saved.Revision;
            errorMessage = null;
            dashboardStatus = Text.Format("AnalysisStatus.Saved", dashboardRevision);
            return true;
        }
        catch (UnauthorizedAccessException exception)
        {
            DashboardAccessDenied(exception);
            return false;
        }
        catch (DbUpdateConcurrencyException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard changed in another session before saving.");
            errorMessage = Text["Analysis.Errors.SavedElsewhere"];
            return false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis dashboard save could not be confirmed.");
            errorMessage = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.SaveUnconfirmed");
            return false;
        }
        finally { isSavingDashboard = false; }
    }

    [JSInvokable]
    public async Task CommitDashboardMove(string id, int column, int row)
    {
        if (!CanEditGrid || PersonalActionsBlocked)
            return;
        Dashboard.MoveWidget(id, column, row);
        await SaveDashboardAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CommitDashboardResize(string id, int columnSpan, int rowSpan)
    {
        if (!CanEditGrid || PersonalActionsBlocked)
            return;
        Dashboard.ResizeWidget(id, columnSpan, rowSpan);
        await SaveDashboardAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string DashboardWidgetStyle(AnalysisDashboardWidget widget) =>
        $"grid-column:{widget.Column}/span {widget.ColumnSpan};grid-row:{widget.Row}/span {widget.RowSpan};";

    private static string PanelStyle(AnalysisDashboardPanelLayout panel) =>
        $"width:{(panel.Width == 0 ? "100%" : $"{panel.Width}px")};height:{panel.Height}px;";

    private async Task RunAsync()
    {
        if (!CanRun)
            return;
        isRunning = true;
        hasDetailRequest = true;
        errorMessage = null;
        result = null;
        StateHasChanged();
        var generation = selectionGeneration;
        try
        {
            if (!await CheckDashboardAccessAsync())
                return;
            IReadOnlyList<AnalysisQuerySystem> systems;
            if (UsesInventoryRoles)
            {
                if (!await LoadRoleSelectionAsync())
                    return;
                systems = roleSelection?.Systems ?? throw new InvalidOperationException("The role selection snapshot is missing.");
                if (systems.Count == 0)
                    return;
            }
            else
                systems = inventory
                    .Where(item => selectedSystems.Contains(SystemKey(item)))
                    .Select(item => new AnalysisQuerySystem(item.SubscriptionId, item.Computer))
                    .ToArray();
            var request = new AnalysisQueryRequest(selectedQueryId, systems, timeRangeMinutes, binMinutes, groupBy,
                workspaceFilter, UsesInventoryRoles ? null : domainFilter, UsesInventoryRoles ? null : siteFilter,
                UsesInventoryRoles ? null : roleFilter);
            var response = await Execution.ExecuteAsync(request, refreshCancellation.Token);
            if (!await CheckDashboardAccessAsync())
                return;
            if (IsCurrentSelection(generation) && hasDetailRequest && request.QueryDefinitionId == selectedQueryId &&
                request.TimeRangeMinutes == timeRangeMinutes && request.BinMinutes == binMinutes && request.GroupBy == groupBy)
                result = response;
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis detail query execution failed.");
            if (IsCurrentSelection(generation))
            {
                if (UsesInventoryRoles && roleSelection is null) RoleSelectionFailed(exception);
                errorMessage = exception is KeyNotFoundException
                    ? Text["Analysis.Errors.QueryUnavailable"]
                    : AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ExecutionFailed");
            }
        }
        finally
        {
            isRunning = false;
        }
    }

    private static string SystemKey(ComputerInventoryEntry entry) => $"{entry.SubscriptionId}\u001f{entry.Computer}";

    private void RefreshExecutionPreview()
    {
        previewError = null;
        executionPreviews = [];
        if (UsesInventoryRoles && roleSelectionError is not null)
            previewError = roleSelectionError;
        if (SelectedQuery is null || (UsesInventoryRoles ? roleSelection?.Systems.Count is not > 0 : selectedSystems.Count == 0))
            return;
        try
        {
            var roleKeys = roleSelection?.Systems.Select(system => $"{system.SubscriptionId}\u001f{system.Computer}")
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            var systems = inventory.Where(item => UsesInventoryRoles
                ? roleKeys?.Contains(SystemKey(item)) == true : selectedSystems.Contains(SystemKey(item))).ToArray();
            executionPreviews = QueryRunner.CreateExecutionPreviews(SelectedQuery, systems, timeRangeMinutes, binMinutes, groupBy,
                workspaceFilter, UsesInventoryRoles ? null : domainFilter, UsesInventoryRoles ? null : siteFilter,
                UsesInventoryRoles ? null : roleFilter);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis execution preview failed.");
            previewError = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.PreviewFailed");
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        await refreshCancellation.CancelAsync();
        if (refreshTask is not null)
            await refreshTask;
        if (dashboardBrowser is not null) await dashboardBrowser.DisposeAsync();
        refreshCancellation.Dispose();
    }
}
