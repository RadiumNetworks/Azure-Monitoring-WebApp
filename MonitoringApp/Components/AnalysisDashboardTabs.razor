@inject UiText Text

<section class="analysis-dashboard-tabs" aria-label="@Text["AnalysisDashboards.PersonalDashboards"]">
    <nav aria-label="@Text["AnalysisDashboards.SelectDashboard"]">
        @foreach (var entry in Collection.Dashboards)
        {
            <button class="@(entry.Id == Collection.ActiveDashboardId ? "admin-primary" : "admin-secondary")"
                    type="button" aria-pressed="@(entry.Id == Collection.ActiveDashboardId ? "true" : "false")"
                    disabled="@Disabled" @onclick="() => SelectAsync(entry.Id)">@entry.Document.Name</button>
        }
    </nav>
    @if (EditMode)
    {
    <div class="analysis-dashboard-management">
        <form @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <label><span>@Text["AnalysisDashboards.NewName"]</span><input required maxlength="256" @bind="newName" disabled="@Disabled" /></label>
            <button class="admin-secondary" type="submit" disabled="@Disabled">@Text["AnalysisDashboards.Create"]</button>
        </form>
        <form @onsubmit="RenameAsync" @onsubmit:preventDefault>
            <label><span>@Text["AnalysisDashboards.CurrentName"]</span><input required maxlength="256" @bind="currentName" disabled="@Disabled" /></label>
            <button class="admin-secondary" type="submit" disabled="@Disabled">@Text["Common.Rename"]</button>
        </form>
        <button class="admin-danger" type="button" disabled="@(Disabled || Collection.Dashboards.Count <= 1)"
                @onclick="ConfirmDelete">@Text["AnalysisDashboards.Delete"]</button>
    </div>
    }
    @if (EditMode && confirmDelete)
    {
        <div class="admin-message admin-message-warning" role="alertdialog" aria-labelledby="delete-dashboard-heading">
            <h2 id="delete-dashboard-heading">@Text["AnalysisDashboards.DeleteTitle"]</h2>
            <p><LocalizedEmphasis ResourceKey="AnalysisDashboards.DeleteBody" Value="@Collection.Active.Document.Name" /></p>
            <button class="admin-secondary" type="button" disabled="@Disabled" @onclick="() => confirmDelete = false">@Text["Common.Cancel"]</button>
            <button class="admin-danger" type="button" disabled="@Disabled" @onclick="DeleteAsync">@Text["Common.ConfirmDelete"]</button>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public AnalysisDashboardCollection Collection { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool EditMode { get; set; } = true;
    [Parameter] public EventCallback<Guid> Selected { get; set; }
    [Parameter] public EventCallback<string> Created { get; set; }
    [Parameter] public EventCallback<string> Renamed { get; set; }
    [Parameter] public EventCallback Deleted { get; set; }
    private string newName = "";
    private string currentName = "";
    private Guid displayedId;
    private string? displayedName;
    private bool confirmDelete;
    private Guid confirmedDashboardId;

    protected override void OnParametersSet()
    {
        if (!EditMode)
            confirmDelete = false;
        if (displayedId == Collection.ActiveDashboardId && displayedName == Collection.Active.Document.Name)
            return;
        displayedId = Collection.ActiveDashboardId;
        displayedName = Collection.Active.Document.Name;
        currentName = displayedName;
        confirmDelete = false;
    }

    private async Task CreateAsync()
    {
        if (Disabled || !EditMode) return;
        await Created.InvokeAsync(newName);
    }

    private Task SelectAsync(Guid id) => Disabled ? Task.CompletedTask : Selected.InvokeAsync(id);
    private Task RenameAsync() => Disabled || !EditMode ? Task.CompletedTask : Renamed.InvokeAsync(currentName);
    private Task ConfirmDelete()
    {
        if (Disabled || !EditMode || Collection.Dashboards.Count <= 1) return Task.CompletedTask;
        confirmedDashboardId = Collection.ActiveDashboardId;
        confirmDelete = true;
        return Task.CompletedTask;
    }
    private Task DeleteAsync()
    {
        if (Disabled || !EditMode) return Task.CompletedTask;
        if (!confirmDelete || Collection.Dashboards.Count <= 1 || confirmedDashboardId != Collection.ActiveDashboardId)
        {
            confirmDelete = false;
            return Task.CompletedTask;
        }
        confirmDelete = false;
        return Deleted.InvokeAsync();
    }
}
