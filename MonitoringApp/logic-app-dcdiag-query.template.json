{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflowName": {
      "type": "string",
      "defaultValue": "dcdiag-alert-details"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "workspaceId": {
      "type": "string",
      "metadata": {
        "description": "Workspace ID (GUID), not the Azure resource ID, of the Log Analytics workspace containing DCDiagData_CL."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "parameters": {
          "workspaceId": {
            "value": "[parameters('workspaceId')]"
          }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "workspaceId": {
              "type": "String"
            }
          },
          "triggers": {
            "When_an_Azure_Monitor_alert_is_received": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "schemaId": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "alertContext"
                      ],
                      "properties": {
                        "essentials": {
                          "type": "object"
                        },
                        "alertContext": {
                          "type": "object",
                          "required": [
                            "condition"
                          ],
                          "properties": {
                            "condition": {
                              "type": "object",
                              "required": [
                                "allOf"
                              ],
                              "properties": {
                                "allOf": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "dimensions": {
                                        "type": "array",
                                        "items": {
                                          "type": "object",
                                          "properties": {
                                            "name": {
                                              "type": "string"
                                            },
                                            "value": {
                                              "type": "string"
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "actions": {
            "Filter_Computer_Dimension": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['dimensions'], json('[]'))",
                "where": "@equals(toLower(string(item()?['name'])), 'computer')"
              },
              "runAfter": {}
            },
            "Computer_Dimension_Found": {
              "type": "If",
              "expression": "@greater(length(body('Filter_Computer_Dimension')), 0)",
              "actions": {
                "Computer": {
                  "type": "Compose",
                  "inputs": "@trim(string(first(body('Filter_Computer_Dimension'))?['value']))",
                  "runAfter": {}
                },
                "Computer_Value_Is_Safe": {
                  "type": "If",
                  "expression": "@and(not(empty(outputs('Computer'))), not(equals(toUpper(outputs('Computer')), '<EMPTY_VALUE>')), not(contains(outputs('Computer'), decodeUriComponent('%22'))), not(contains(outputs('Computer'), decodeUriComponent('%5C'))), not(contains(outputs('Computer'), decodeUriComponent('%0A'))), not(contains(outputs('Computer'), decodeUriComponent('%0D'))))",
                  "actions": {
                    "Run_Log_Analytics_Query": {
                      "type": "Http",
                      "inputs": {
                        "uri": "@concat('https://api.loganalytics.azure.com/v1/workspaces/', parameters('workspaceId'), '/query')",
                        "method": "POST",
                        "headers": {
                          "Content-Type": "application/json",
                          "Prefer": "wait=30"
                        },
                        "body": {
                          "query": "@concat('DCDiagData_CL\n| where TimeGenerated > ago(1h)\n| where tostring(Computer) =~ \"', outputs('Computer'), '\"\n| project-away Passed, Failed, Type\n| mv-expand Status\n| where tostring(Status) has \"Failed\" and tostring(Status) !has \"DFSREvent\"\n| summarize arg_max(TimeGenerated, *) by TimeGenerated, Computer\n| order by TimeGenerated desc')",
                          "timespan": "PT1H"
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://api.loganalytics.io"
                        },
                        "retryPolicy": {
                          "type": "exponential",
                          "count": 3,
                          "interval": "PT5S",
                          "minimumInterval": "PT5S",
                          "maximumInterval": "PT30S"
                        }
                      },
                      "runAfter": {}
                    },
                    "Return_Query_Result": {
                      "type": "Response",
                      "kind": "Http",
                      "inputs": {
                        "statusCode": 200,
                        "headers": {
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "computer": "@outputs('Computer')",
                          "columns": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['columns'], json('[]'))",
                          "rows": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]'))",
                          "rowCount": "@length(coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]')))",
                          "alert": "@triggerBody()"
                        }
                      },
                      "runAfter": {
                        "Run_Log_Analytics_Query": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Return_Invalid_Computer": {
                        "type": "Response",
                        "kind": "Http",
                        "inputs": {
                          "statusCode": 400,
                          "headers": {
                            "Content-Type": "application/json"
                          },
                          "body": {
                            "error": "The Computer dimension is empty, contains a placeholder, or contains unsupported characters.",
                            "computer": "@outputs('Computer')"
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "runAfter": {
                    "Computer": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Return_Missing_Computer": {
                    "type": "Response",
                    "kind": "Http",
                    "inputs": {
                      "statusCode": 400,
                      "headers": {
                        "Content-Type": "application/json"
                      },
                      "body": {
                        "error": "The alert payload does not contain a Computer dimension at data.alertContext.condition.allOf[0].dimensions."
                      }
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {
                "Filter_Computer_Dimension": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        }
      }
    }
  ],
  "outputs": {
    "workflowName": {
      "type": "string",
      "value": "[parameters('workflowName')]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('workflowName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
