    }

    private async Task RunDashboardAsync()
    {
        if (!CanRunDashboard)
            return;
        isDashboardRunning = true;
        errorMessage = null;
        StateHasChanged();
        var cancellationToken = refreshCancellation.Token;
        try
        {
            var systems = inventory
                .Where(item => selectedSystems.Contains(SystemKey(item)))
                .Select(item => new AnalysisQuerySystem(item.SubscriptionId, item.Computer))
                .ToArray();
            var batch = new AnalysisDashboardQueryBatch(Execution.ExecuteAsync, cancellationToken);
            var widgets = Dashboard.Document.Widgets.OrderBy(widget => widget.Row).ThenBy(widget => widget.Column).ToArray();
            var failedWidgets = 0;
            foreach (var widget in widgets)
            {
                cancellationToken.ThrowIfCancellationRequested();
                try
                {
                    var query = availableQueries.FirstOrDefault(item => item.Id == widget.QueryDefinitionId)
                        ?? throw new KeyNotFoundException("The published query is no longer available.");
                    var request = Dashboard.Document.CreateExecutionRequest(widget, systems)
                        with { WorkspaceKey = workspaceFilter, Domain = domainFilter, Site = siteFilter, Role = roleFilter };
                    var response = await batch.ExecuteAsync(query, request);
                    if (Dashboard.Document.Widgets.Any(current => current.Id == widget.Id))
                    {
                        widgetResults[widget.Id] = response;
                        widgetErrors.Remove(widget.Id);
                    }
                }
                catch (Exception exception) when (exception is not OperationCanceledException || !cancellationToken.IsCancellationRequested)
                {
                    Logger.LogError(exception, "Analysis widget {WidgetId} execution failed.", widget.Id);
                    if (Dashboard.Document.Widgets.Any(current => current.Id == widget.Id))
                    {
                        failedWidgets++;
                        widgetResults.Remove(widget.Id);
                        widgetErrors[widget.Id] = exception is KeyNotFoundException
                            ? Text["Analysis.Errors.QueryUnavailable"]
                            : AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ExecutionFailed");
                    }
                }
                StateHasChanged();
                await Task.Yield();
            }
            dashboardStatus = failedWidgets > 0
                ? Text.Format(failedWidgets == 1 ? "AnalysisStatus.RefreshFailures.One" : "AnalysisStatus.RefreshFailures.Other",
                    failedWidgets, DateTimeOffset.UtcNow)
                : Text.Format(batch.Count == 1 ? "AnalysisStatus.RefreshedRequests.One" : "AnalysisStatus.RefreshedRequests.Other",
                    DateTimeOffset.UtcNow, batch.Count);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis dashboard refresh failed.");
            errorMessage = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ExecutionFailed");
        }
        finally
        {
            isDashboardRunning = false;
            if (!cancellationToken.IsCancellationRequested)
                StateHasChanged();
        }
    }

    private void UndoDashboard()
    {
        if (PersonalActionsBlocked)
            return;
        Dashboard.Undo();
        RestoreDashboardSystems();
        dashboardStatus = Text["AnalysisStatus.Undo"];
    }

    private void RedoDashboard()
    {
        if (PersonalActionsBlocked)
            return;
        Dashboard.Redo();
        RestoreDashboardSystems();
        dashboardStatus = Text["AnalysisStatus.Redo"];
    }

    private void RestoreDashboardSystems()
    {
        widgetResults.Clear();
        widgetErrors.Clear();
        hasDetailRequest = false;
        selectedSystems.Clear();
        foreach (var saved in Dashboard.Document.Systems)
            selectedSystems.Add($"{saved.SubscriptionId}\u001f{saved.Computer}");
        var opened = Dashboard.Document.Widgets.FirstOrDefault(widget => widget.Id == openedWidgetId);
        if (opened is not null)
            OpenWidget(opened);
        else
        {
            openedWidgetId = null;
            result = null;
            RefreshExecutionPreview();
        }
    }

    private async Task ReloadPublicationsAsync()
    {
        try
        {
            publishedDashboards = await Publishing.ListAsync((await AuthenticationStateTask).User, refreshCancellation.Token);
            publicationLoadError = null;
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogWarning(exception, "Analysis publication list access was denied.");
            publishedDashboards = [];
            publicationLoadError = Text["Analysis.Errors.PublicationNotAllowed"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load analysis dashboard publications.");
            publicationLoadError = Text["Analysis.Errors.PublicationLoadFailed"];
        }
    }

    private async Task OpenPublishedDashboardAsync(Guid id)
    {
        if (DashboardBusy)
            return;
        if (selectedPublishedDashboard is null && !await TrySaveDashboardAsync())
            return;
        selectedPublishedDashboard = id;
        runPublishedOnFilterChange = false;
        confirmWithdrawDashboard = false;
    }

    private async Task ReturnToPersonalDashboard()
    {
        if (!DashboardBusy)
        {
            selectedPublishedDashboard = null;
            if (!editMode)
                await RunDashboardAsync();
        }
    }

    private async Task PublishDashboardAsync()
    {
        if (DashboardBusy || selectedPublishedDashboard is not null)
            return;
        isPublishingDashboard = true;
        publicationError = publicationMessage = null;
        try
        {
            if (!await TrySaveDashboardAsync())
                return;
            var publication = await Publishing.PublishAsync(dashboardCollection.ActiveDashboardId, dashboardRevision,
                (await AuthenticationStateTask).User, refreshCancellation.Token);
            dashboardRevision++;
            dashboardStatus = Text.Format("AnalysisStatus.Saved", dashboardRevision);
            publicationMessage = Text.Format("AnalysisStatus.Published", publication.Name, publication.Version);
            await ReloadPublicationsAsync();
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard publication access was denied.");
            publicationError = Text["Analysis.Errors.PublicationNotAllowed"];
        }
        catch (DbUpdateConcurrencyException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard changed before publication.");
            publicationError = Text["Analysis.Errors.PublicationConflict"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis dashboard publication could not be confirmed.");
            publicationError = Text["Analysis.Errors.PublishUnconfirmed"];
        }
        finally
        {
            isPublishingDashboard = false;
        }
    }

    private async Task WithdrawDashboardAsync()
    {
        if (DashboardBusy || PersonalActionsBlocked)
            return;
        isPublishingDashboard = true;
        publicationError = publicationMessage = null;
        try
        {
            await Publishing.WithdrawAsync(dashboardCollection.ActiveDashboardId,
                (await AuthenticationStateTask).User, refreshCancellation.Token);
            confirmWithdrawDashboard = false;
            publicationMessage = Text["AnalysisStatus.Withdrawn"];
            await ReloadPublicationsAsync();
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard withdrawal access was denied.");
            publicationError = Text["Analysis.Errors.PublicationNotAllowed"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis dashboard withdrawal could not be confirmed.");
            publicationError = Text["Analysis.Errors.WithdrawUnconfirmed"];
        }
        finally
        {
            isPublishingDashboard = false;
        }
    }

    private async Task SelectDashboardAsync(Guid id)
    {
        await ChangeDashboardAsync(collection => collection.Select(id));
        if (!editMode && errorMessage is null)
            await RunDashboardAsync();
    }
    private Task CreateDashboardAsync(string name) => ChangeDashboardAsync(collection => collection.Add(name));
    private Task RenameDashboardAsync(string name) => ChangeDashboardAsync(collection => collection.RenameActive(name));
    private Task DeleteDashboardAsync() => ChangeDashboardAsync(collection => collection.DeleteActive());

    private async Task DuplicateDashboardAsync()
    {
        if (DashboardBusy || dashboardLoadFailed)
            return;
        isChangingDashboard = true;
        publicationError = publicationMessage = null;
        try
        {
            AnalysisDashboardDocument source;
            if (selectedPublishedDashboard is Guid publishedId)
                source = (await Publishing.LoadAsync(publishedId,
                    (await AuthenticationStateTask).User, refreshCancellation.Token)).Document;
            else
            {
                if (!await TrySaveDashboardAsync())
                    return;
                source = Dashboard.Document;
            }
            var candidate = dashboardCollection.Copy();
            candidate.AddCopy(source);
            var saved = await DashboardRepository.SaveAsync(
                dashboardOwnerKey, candidate, dashboardRevision, refreshCancellation.Token);
            ActivatePersonalDashboard(candidate, saved.Revision);
            editMode = dashboardEditMode = true;
            publicationMessage = Text.Format("AnalysisStatus.CopyCreated", Dashboard.Document.Name);
        }
        catch (DbUpdateConcurrencyException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard collection changed before duplication.");
            publicationError = Text["Analysis.Errors.CopyConflict"];
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard duplication access was denied.");
            publicationError = Text["Analysis.Errors.PublicationNotAllowed"];
        }
        catch (KeyNotFoundException exception)
        {
            Logger.LogWarning(exception, "The source analysis publication is unavailable.");
            publicationError = Text["Analysis.Errors.PublicationUnavailable"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis dashboard duplication could not be completed.");
            publicationError = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.CopyFailed");
        }
        finally
        {
            isChangingDashboard = false;
        }
    }

    private void ActivatePersonalDashboard(AnalysisDashboardCollection collection, int revision)
    {
        dashboardRevision = revision;
        dashboardCollection = collection;
        selectedPublishedDashboard = null;
        runPublishedOnFilterChange = false;
        Dashboard.Load(collection.OpenActive());
        confirmWithdrawDashboard = false;
        selectedQueryId = Guid.Empty;
        openedWidgetId = null;
        RestoreDashboardSystems();
        dashboardStatus = Text.Format("AnalysisStatus.NamedSaved", Dashboard.Document.Name, dashboardRevision);
    }

    private async Task ChangeDashboardAsync(Action<AnalysisDashboardCollection> change)
    {
        if (isRunning || isDashboardRunning || PersonalActionsBlocked)
            return;
        isChangingDashboard = true;
        errorMessage = null;
        try
        {
            if (!await TrySaveDashboardAsync())
                return;
            var candidate = dashboardCollection.Copy();
            change(candidate);
            var saved = await DashboardRepository.SaveAsync(dashboardOwnerKey, candidate, dashboardRevision);
            ActivatePersonalDashboard(candidate, saved.Revision);
        }
        catch (DbUpdateConcurrencyException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard collection changed in another session.");
            errorMessage = Text["Analysis.Errors.CollectionChanged"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The analysis dashboard change could not be completed.");
            errorMessage = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ChangeFailed");
        }
        finally
        {
            isChangingDashboard = false;
        }
    }

    private async Task SaveDashboardAsync() => await TrySaveDashboardAsync();

    private async Task<bool> TrySaveDashboardAsync()
    {
        if (dashboardLoadFailed || isLoadingDashboard)
        {
            Logger.LogWarning("Analysis dashboard save is blocked until workspace loading succeeds.");
            return false;
        }
        if (selectedPublishedDashboard is not null)
        {
            Logger.LogWarning("Cannot save a published analysis dashboard as a personal dashboard.");
            publicationError = Text["Analysis.Errors.PublishedReadOnly"];
            return false;
        }
        if (isSavingDashboard)
        {
            Logger.LogWarning("An analysis dashboard save is already in progress.");
            errorMessage = Text["Analysis.Errors.SaveInProgress"];
            return false;
        }
        isSavingDashboard = true;
        errorMessage = null;
        try
        {
            dashboardCollection.CaptureActive(Dashboard.Document);
            var snapshot = dashboardCollection.Copy();
            var saved = await DashboardRepository.SaveAsync(
                dashboardOwnerKey,
                snapshot,
                dashboardRevision);
            dashboardRevision = saved.Revision;
            errorMessage = null;
            dashboardStatus = Text.Format("AnalysisStatus.Saved", dashboardRevision);
            return true;
        }
        catch (DbUpdateConcurrencyException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard changed in another session before saving.");
            errorMessage = Text["Analysis.Errors.SavedElsewhere"];
            return false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis dashboard save could not be confirmed.");
            errorMessage = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.SaveUnconfirmed");
            return false;
        }
        finally { isSavingDashboard = false; }
    }

    [JSInvokable]
    public async Task CommitDashboardMove(string id, int column, int row)
    {
        if (!CanEditGrid || PersonalActionsBlocked)
            return;
        Dashboard.MoveWidget(id, column, row);
        await SaveDashboardAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CommitDashboardResize(string id, int columnSpan, int rowSpan)
    {
        if (!CanEditGrid || PersonalActionsBlocked)
            return;
        Dashboard.ResizeWidget(id, columnSpan, rowSpan);
        await SaveDashboardAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static string DashboardWidgetStyle(AnalysisDashboardWidget widget) =>
        $"grid-column:{widget.Column}/span {widget.ColumnSpan};grid-row:{widget.Row}/span {widget.RowSpan};";

    private static string PanelStyle(AnalysisDashboardPanelLayout panel) =>
        $"width:{(panel.Width == 0 ? "100%" : $"{panel.Width}px")};height:{panel.Height}px;";

    private async Task RunAsync()
    {
        if (!CanRun)
            return;
        isRunning = true;
        hasDetailRequest = true;
        errorMessage = null;
        result = null;
        StateHasChanged();
        try
        {
            var systems = inventory
                .Where(item => selectedSystems.Contains(SystemKey(item)))
                .Select(item => new AnalysisQuerySystem(item.SubscriptionId, item.Computer))
                .ToArray();
            var request = new AnalysisQueryRequest(selectedQueryId, systems, timeRangeMinutes, binMinutes, groupBy,
                workspaceFilter, domainFilter, siteFilter, roleFilter);
            var response = await Execution.ExecuteAsync(request, refreshCancellation.Token);
            if (hasDetailRequest && request.QueryDefinitionId == selectedQueryId &&
                request.TimeRangeMinutes == timeRangeMinutes && request.BinMinutes == binMinutes && request.GroupBy == groupBy)
                result = response;
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis detail query execution failed.");
            errorMessage = exception is KeyNotFoundException
                ? Text["Analysis.Errors.QueryUnavailable"]
                : AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ExecutionFailed");
        }
        finally
        {
            isRunning = false;
        }
    }

    private static string SystemKey(ComputerInventoryEntry entry) => $"{entry.SubscriptionId}\u001f{entry.Computer}";

    private void RefreshExecutionPreview()
    {
        previewError = null;
        executionPreviews = [];
        if (SelectedQuery is null || selectedSystems.Count == 0)
            return;
        try
        {
            var systems = inventory.Where(item => selectedSystems.Contains(SystemKey(item))).ToArray();
            executionPreviews = QueryRunner.CreateExecutionPreviews(SelectedQuery, systems, timeRangeMinutes, binMinutes, groupBy,
                workspaceFilter, domainFilter, siteFilter, roleFilter);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis execution preview failed.");
            previewError = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.PreviewFailed");
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        await refreshCancellation.CancelAsync();
        if (refreshTask is not null)
            await refreshTask;
        if (dashboardBrowser is not null) await dashboardBrowser.DisposeAsync();
        refreshCancellation.Dispose();
    }
}
