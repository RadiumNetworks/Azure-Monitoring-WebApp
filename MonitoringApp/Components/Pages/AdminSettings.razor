@page "/admin/settings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "AdminAccess")]
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Text.Json.Nodes
@inject DatabaseSettingsService SettingsService
@inject AgentAnalysisProfilesOptions AgentAnalysisProfiles
@inject AgentAnalysisExecutionState ActiveAgentAnalysisState
@inject IConfiguration Configuration
@inject UiText Text
@inject ILogger<AdminSettings> Logger

<PageTitle>@Text["AdminSettings.PageTitle"]</PageTitle>

<section class="admin-heading">
    <div>
        <p class="eyebrow">@Text["Common.Administration"]</p>
        <h1>@Text["AdminSettings.Title"]</h1>
        <p class="subtitle">@Text["AdminSettings.Subtitle"]</p>
    </div>
    <div class="admin-heading-actions">
        <button class="admin-secondary" type="button" disabled="@(isLoading || isSaving)" @onclick="LoadAsync">
            @Text[isLoading ? "Common.Loading" : "Common.ResetChanges"]
        </button>
    </div>
</section>

<UiLanguageSettings />

<div class="admin-message admin-message-warning" role="alert">
    <LocalizedContent ResourceKey="AdminSettings.RestartWarning">
        <Value0><strong>@Text["AdminSettings.RestartTitle"]</strong></Value0>
    </LocalizedContent>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="admin-message admin-message-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p class="admin-empty">@Text["AdminSettings.Loading"]</p>
}
else if (hasLoaded)
{
    <form class="admin-form settings-form" inert="@isSaving" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <label class="admin-field admin-field-wide">
            <span>@Text["AdminSettings.Authentication"]</span>
            <select required @bind="authenticationType">
                <option value="open">open</option>
                <option value="sql">sql</option>
                <option value="entra">entra</option>
            </select>
            <small>@Text["AdminSettings.AuthenticationHint"]</small>
        </label>

        <label class="admin-field admin-field-wide">
            <span>@Text["AdminSettings.AlertHistory"]</span>
            <textarea rows="5" required spellcheck="false" @bind="alertHistoryJson"></textarea>
            <small>@Text["AdminSettings.AlertHistoryHint"]</small>
        </label>

        <label class="admin-field admin-field-wide">
            <span>@Text["AdminSettings.AlertGraph"]</span>
            <textarea rows="16" required spellcheck="false" @bind="alertGraphJson"></textarea>
            <small>@Text["AdminSettings.AlertGraphHint"]</small>
        </label>

        <label class="admin-field admin-field-wide">
            <span>@Text["AdminSettings.SeverityDisplay"]</span>
            <textarea rows="16" required spellcheck="false" @bind="alertSeverityDisplayJson"></textarea>
            <small>@Text["AdminSettings.SeverityHint"]</small>
        </label>

        <label class="admin-field admin-field-wide">
            <span>@Text["AdminSettings.TargetOutput"]</span>
            <textarea rows="18" required spellcheck="false" @bind="inboxTargetOutputDisplayJson"></textarea>
            <small>@Text["AdminSettings.TargetOutputHint"]</small>
        </label>

        <label class="admin-field admin-field-wide">
            <span>@Text["AdminSettings.RcaDisplay"]</span>
            <textarea rows="6" required spellcheck="false" @bind="rcaDisplayJson"></textarea>
            <small>@Text["AdminSettings.RcaHint"]</small>
        </label>

        <label class="admin-field admin-field-wide">
            <span>@Text["AdminSettings.DashboardDefaults"]</span>
            <textarea rows="7" required spellcheck="false" @bind="dashboardFiltersJson"></textarea>
            <small>@Text["AdminSettings.DashboardHint"]</small>
        </label>

        <label class="admin-field admin-field-wide">
            <span>@Text["AdminSettings.AgentMode"]</span>
            <select required @bind="agentAnalysisMode">
                <option value="@AgentAnalysisExecutionModes.CopilotPrompt">@Text["AdminSettings.CopilotPrompt"]</option>
                <option value="@AgentAnalysisExecutionModes.TeamsWorkflow">@Text["AdminSettings.TeamsWorkflow"]</option>
                <option value="@AgentAnalysisExecutionModes.Api">API</option>
            </select>
            <small>@Text["AdminSettings.AgentReleaseHint"]</small>
        </label>

        <fieldset class="admin-fieldset">
            <legend>@Text["AdminSettings.InventoryCorrelation"]</legend>
            <label class="admin-check"><input type="checkbox" @bind="correlateByDomain" /> @Text["AdminSettings.Domain"]</label>
            <label class="admin-check"><input type="checkbox" @bind="correlateByRole" /> @Text["AdminSettings.Role"]</label>
            <label class="admin-check"><input type="checkbox" @bind="correlateBySite" /> @Text["AdminSettings.Site"]</label>
            <label class="admin-check"><input type="checkbox" @bind="correlateByResourceGroup" /> @Text["AdminSettings.ResourceGroup"]</label>
            <small>@Text["AdminSettings.CorrelationHint"]</small>
        </fieldset>

        <div class="admin-message @(ActiveAgentAnalysisState.IsEnabled ? "admin-message-success" : "admin-message-warning") agent-settings-state" role="status">
            <strong>@Text.Format("AdminSettings.ActiveState", ActiveAgentAnalysisState.Mode)</strong>
            <span>@ActiveExecutionDescription</span>
        </div>

        <div class="admin-message @(SelectedAgentAnalysisState.IsEnabled ? "admin-message-success" : "admin-message-warning") agent-settings-state" role="status">
            <strong>@Text.Format("AdminSettings.SelectedState", SelectedAgentAnalysisState.Mode)</strong>
            <span>@SelectedExecutionDescription</span>
        </div>

        @if (agentAnalysisMode == AgentAnalysisExecutionModes.TeamsWorkflow)
        {
            <label class="admin-field admin-field-wide">
                <span>@Text["AdminSettings.TeamsProfile"]</span>
                <select required @bind="teamsWorkflowProfile">
                    <option value="">@Text["AdminSettings.SelectProfile"]</option>
                    @if (IsUnregisteredProfile(teamsWorkflowProfile, AgentAnalysisProfiles.TeamsWorkflows.Keys))
                    {
                        <option value="@teamsWorkflowProfile">@Text.Format("AdminSettings.UnregisteredProfile", teamsWorkflowProfile)</option>
                    }
                    @foreach (var profile in AgentAnalysisProfiles.TeamsWorkflows.OrderBy(profile => profile.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@profile.Key">@Text.Format("AdminSettings.TeamsProfileOption", profile.Key, Text[profile.Value.Approved ? "AdminSettings.Approved" : "AdminSettings.NotApproved"])</option>
                    }
                </select>
                <small>@Text["AdminSettings.TeamsProfileHint"]</small>
            </label>
            @if (AgentAnalysisProfiles.TeamsWorkflows.Count == 0)
            {
                <p class="admin-empty agent-profile-empty">@Text["AdminSettings.NoTeamsProfiles"]</p>
            }
        }
        else if (agentAnalysisMode == AgentAnalysisExecutionModes.Api)
        {
            <label class="admin-field admin-field-wide">
                <span>@Text["AdminSettings.ApiProfile"]</span>
                <select required @bind="apiProfile">
                    <option value="">@Text["AdminSettings.SelectProfile"]</option>
                    @if (IsUnregisteredProfile(apiProfile, AgentAnalysisProfiles.Apis.Keys))
                    {
                        <option value="@apiProfile">@Text.Format("AdminSettings.UnregisteredProfile", apiProfile)</option>
                    }
                    @foreach (var profile in AgentAnalysisProfiles.Apis.OrderBy(profile => profile.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@profile.Key">@Text.Format("AdminSettings.ApiProfileOption", profile.Key, profile.Value.Provider, Text[profile.Value.Approved ? "AdminSettings.Approved" : "AdminSettings.NotApproved"])</option>
                    }
                </select>
                <small>@Text["AdminSettings.ApiProfileHint"]</small>
            </label>
            @if (AgentAnalysisProfiles.Apis.Count == 0)
            {
                <p class="admin-empty agent-profile-empty">@Text["AdminSettings.NoApiProfiles"]</p>
            }
        }

        <div class="admin-form-actions">
            <button class="admin-secondary" type="button" disabled="@isSaving" @onclick="LoadAsync">@Text["Common.ResetChanges"]</button>
            <button class="admin-primary" type="submit" disabled="@(isSaving || reloadRequired)">
                @Text[isSaving ? "Common.Saving" : "AdminSettings.Save"]
            </button>
        </div>
    </form>
}

<LegacyAlertResolutionPanel />
<DatabaseResetPanel />

@code {
    private static readonly JsonSerializerOptions PrettyJson = new()
    {
        WriteIndented = true,
        Converters = { new JsonStringEnumConverter() }
    };

    private string authenticationType = ApplicationAuthenticationOptions.Open;
    private string alertHistoryJson = string.Empty;
    private string alertGraphJson = string.Empty;
    private string alertSeverityDisplayJson = string.Empty;
    private string inboxTargetOutputDisplayJson = string.Empty;
    private string rcaDisplayJson = string.Empty;
    private string dashboardFiltersJson = string.Empty;
    private string agentAnalysisMode = AgentAnalysisExecutionModes.CopilotPrompt;
    private string teamsWorkflowProfile = string.Empty;
    private string apiProfile = string.Empty;
    private bool correlateByDomain = true;
    private bool correlateByRole = true;
    private bool correlateBySite;
    private bool correlateByResourceGroup;
    private bool isLoading;
    private bool isSaving;
    private bool hasLoaded;
    private bool reloadRequired;
    private string? statusMessage;
    private string? errorMessage;

    private string ActiveExecutionDescription => ActiveAgentAnalysisState.IsEnabled
        ? Text["AdminSettings.ActiveHandoff"]
        : AgentAnalysisErrorPresentation.DisabledReason(ActiveAgentAnalysisState, Text);

    private AgentAnalysisExecutionState SelectedAgentAnalysisState => AgentAnalysisExecutionState.Create(
        new AgentAnalysisExecutionOptions
        {
            Mode = agentAnalysisMode,
            TeamsWorkflowProfile = agentAnalysisMode == AgentAnalysisExecutionModes.TeamsWorkflow
                ? teamsWorkflowProfile
                : null,
            ApiProfile = agentAnalysisMode == AgentAnalysisExecutionModes.Api
                ? apiProfile
                : null
        },
        AgentAnalysisProfiles,
        key => !string.IsNullOrWhiteSpace(Configuration[key]));

    private string SelectedExecutionDescription => SelectedAgentAnalysisState.IsEnabled
        ? Text["AdminSettings.SelectedHandoff"]
        : AgentAnalysisErrorPresentation.DisabledReason(SelectedAgentAnalysisState, Text);

    private static bool IsUnregisteredProfile(string profile, IEnumerable<string> registeredProfiles) =>
        !string.IsNullOrWhiteSpace(profile) &&
        !registeredProfiles.Contains(profile, StringComparer.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (isSaving || isLoading)
        {
            return;
        }

        isLoading = true;
        statusMessage = null;
        errorMessage = null;
        try
        {
            var settings = await SettingsService.LoadAsync();

            var authentication = DatabaseSettingsLoader.Deserialize<ApplicationAuthenticationOptions>(
                DatabaseSettingsLoader.Authentication,
                settings[DatabaseSettingsLoader.Authentication]);
            var history = FormatJson(settings[DatabaseSettingsLoader.AlertHistory]);
            var graph = FormatGraphJson(settings[DatabaseSettingsLoader.AlertGraph]);
            var severity = FormatJson(settings[DatabaseSettingsLoader.AlertSeverityDisplay]);
            var output = FormatJson(settings[DatabaseSettingsLoader.InboxTargetOutputDisplay]);
            var rca = FormatJson(settings[DatabaseSettingsLoader.RcaDisplay]);
            var dashboard = FormatJson(settings[DatabaseSettingsLoader.DashboardFilters]);
            var agentAnalysisContext = DatabaseSettingsLoader.Deserialize<AgentAnalysisContextOptions>(
                DatabaseSettingsLoader.AgentAnalysisContext,
                settings[DatabaseSettingsLoader.AgentAnalysisContext]);
            var domain = agentAnalysisContext.InventoryCorrelationLayers.Contains(AlertGraphLayer.Domain);
            var role = agentAnalysisContext.InventoryCorrelationLayers.Contains(AlertGraphLayer.Role);
            var site = agentAnalysisContext.InventoryCorrelationLayers.Contains(AlertGraphLayer.Site);
            var resourceGroup = agentAnalysisContext.InventoryCorrelationLayers.Contains(AlertGraphLayer.ResourceGroup);
            var agentAnalysisExecution = DatabaseSettingsLoader.Deserialize<AgentAnalysisExecutionOptions>(
                DatabaseSettingsLoader.AgentAnalysisExecution,
                settings[DatabaseSettingsLoader.AgentAnalysisExecution]);
            authenticationType = authentication.Type;
            alertHistoryJson = history;
            alertGraphJson = graph;
            alertSeverityDisplayJson = severity;
            inboxTargetOutputDisplayJson = output;
            rcaDisplayJson = rca;
            dashboardFiltersJson = dashboard;
            correlateByDomain = domain;
            correlateByRole = role;
            correlateBySite = site;
            correlateByResourceGroup = resourceGroup;
            agentAnalysisMode = agentAnalysisExecution.Mode;
            teamsWorkflowProfile = agentAnalysisExecution.TeamsWorkflowProfile ?? string.Empty;
            apiProfile = agentAnalysisExecution.ApiProfile ?? string.Empty;
            hasLoaded = true;
            reloadRequired = false;
        }
        catch (Exception exception)
        {
            reloadRequired = true;
            errorMessage = SettingsError(exception, "AdminSettings.LoadFailed");
            Logger.LogError(exception, "Failed to load administrative settings.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (isSaving || isLoading)
        {
            return;
        }

        if (!hasLoaded || reloadRequired)
        {
            errorMessage = Text["AdminSettings.ReloadRequired"];
            Logger.LogWarning("Blocked settings save until a successful explicit reload.");
            return;
        }

        statusMessage = null;
        errorMessage = null;
        isSaving = true;
        var saveRequested = false;
        try
        {
            var authentication = new ApplicationAuthenticationOptions { Type = authenticationType };
            var agentAnalysisContext = new AgentAnalysisContextOptions
            {
                InventoryCorrelationLayers = SelectedCorrelationLayers()
            };

            var agentAnalysisExecution = new AgentAnalysisExecutionOptions
            {
                Mode = agentAnalysisMode,
                TeamsWorkflowProfile = agentAnalysisMode == AgentAnalysisExecutionModes.TeamsWorkflow
                    ? teamsWorkflowProfile
                    : null,
                ApiProfile = agentAnalysisMode == AgentAnalysisExecutionModes.Api
                    ? apiProfile
                    : null
            };
            var submitted = new Dictionary<string, string>
            {
                [DatabaseSettingsLoader.Authentication] = JsonSerializer.Serialize(authentication),
                [DatabaseSettingsLoader.AlertHistory] = FormatJson(alertHistoryJson),
                [DatabaseSettingsLoader.AlertGraph] = FormatJson(alertGraphJson),
                [DatabaseSettingsLoader.AlertSeverityDisplay] = FormatJson(alertSeverityDisplayJson),
                [DatabaseSettingsLoader.InboxTargetOutputDisplay] = FormatJson(inboxTargetOutputDisplayJson),
                [DatabaseSettingsLoader.RcaDisplay] = FormatJson(rcaDisplayJson),
                [DatabaseSettingsLoader.DashboardFilters] = FormatJson(dashboardFiltersJson),
                [DatabaseSettingsLoader.AgentAnalysisContext] = JsonSerializer.Serialize(agentAnalysisContext, PrettyJson),
                [DatabaseSettingsLoader.AgentAnalysisExecution] = JsonSerializer.Serialize(agentAnalysisExecution)
            };
            saveRequested = true;
            var settings = await SettingsService.SaveAsync(submitted);

            alertHistoryJson = settings[DatabaseSettingsLoader.AlertHistory];
            alertGraphJson = settings[DatabaseSettingsLoader.AlertGraph];
            alertSeverityDisplayJson = settings[DatabaseSettingsLoader.AlertSeverityDisplay];
            inboxTargetOutputDisplayJson = settings[DatabaseSettingsLoader.InboxTargetOutputDisplay];
            rcaDisplayJson = settings[DatabaseSettingsLoader.RcaDisplay];
            dashboardFiltersJson = settings[DatabaseSettingsLoader.DashboardFilters];
            statusMessage = Text["AdminSettings.Saved"];
        }
        catch (Exception exception)
        {
            if (ValidationCode(exception) is not null || !saveRequested && exception is JsonException)
            {
                errorMessage = exception is JsonException
                    ? Text["AdminSettings.InvalidJson"]
                    : SettingsError(exception, "AdminSettings.SaveUnconfirmed");
                Logger.LogWarning(exception, "Administrative settings validation rejected the save.");
            }
            else
            {
                reloadRequired = true;
                errorMessage = Text["AdminSettings.SaveUnconfirmed"];
                Logger.LogError(exception, "Administrative settings save outcome is unconfirmed.");
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string? SettingLabel(string? name) => name switch
    {
        DatabaseSettingsLoader.Authentication => "AdminSettings.Authentication",
        DatabaseSettingsLoader.AlertHistory => "AdminSettings.AlertHistory",
        DatabaseSettingsLoader.AlertGraph => "AdminSettings.AlertGraph",
        DatabaseSettingsLoader.AlertSeverityDisplay => "AdminSettings.SeverityDisplay",
        DatabaseSettingsLoader.InboxTargetOutputDisplay => "AdminSettings.TargetOutput",
        DatabaseSettingsLoader.RcaDisplay => "AdminSettings.RcaDisplay",
        DatabaseSettingsLoader.DashboardFilters => "AdminSettings.DashboardDefaults",
        DatabaseSettingsLoader.AgentAnalysisContext => "AdminSettings.InventoryCorrelation",
        DatabaseSettingsLoader.AgentAnalysisExecution => "AdminSettings.AgentMode",
        _ => null
    };

    private static DatabaseSettingsValidationCode? ValidationCode(Exception exception) =>
        exception is DatabaseSettingsValidationException validation ? validation.Code switch
        {
            DatabaseSettingsValidationCode.UnknownSettings or
            DatabaseSettingsValidationCode.MissingSettings or
            DatabaseSettingsValidationCode.SqlUserRequired => validation.Code,
            DatabaseSettingsValidationCode.JsonNull or
            DatabaseSettingsValidationCode.JsonInvalid or
            DatabaseSettingsValidationCode.InvalidValues when SettingLabel(validation.SettingName) is not null => validation.Code,
            _ => null
        } : null;

    private string SettingsError(Exception exception, string fallback)
    {
        if (ValidationCode(exception) is not { } code) return Text[fallback];
        var key = $"AdminSettings.Validation.{code}";
        return exception is DatabaseSettingsValidationException validation &&
            SettingLabel(validation.SettingName) is { } label
            ? Text.Format(key, Text[label])
            : Text[key];
    }

    private AlertGraphLayer[] SelectedCorrelationLayers()
    {
        var layers = new List<AlertGraphLayer>();
        if (correlateByDomain) layers.Add(AlertGraphLayer.Domain);
        if (correlateByRole) layers.Add(AlertGraphLayer.Role);
        if (correlateBySite) layers.Add(AlertGraphLayer.Site);
        if (correlateByResourceGroup) layers.Add(AlertGraphLayer.ResourceGroup);
        return layers.ToArray();
    }

    private static string FormatJson(string json)
    {
        using var document = JsonDocument.Parse(json);
        return JsonSerializer.Serialize(document.RootElement, PrettyJson);
    }

    private static string FormatGraphJson(string json)
    {
        var options = DatabaseSettingsLoader.Deserialize<AlertGraphOptions>(DatabaseSettingsLoader.AlertGraph, json);
        var graph = JsonNode.Parse(json)!.AsObject();
        if (!graph.Any(property => property.Key.Equals(nameof(AlertGraphOptions.SLocations), StringComparison.OrdinalIgnoreCase)))
            graph[nameof(AlertGraphOptions.SLocations)] = options.SLocations;
        return graph.ToJsonString(PrettyJson);
    }
}
