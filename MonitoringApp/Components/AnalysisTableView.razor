@using System.Globalization
@inject UiText Text

@for (var tableIndex = 0; tableIndex < Tables.Count; tableIndex++)
{
    var currentIndex = tableIndex;
    var sourceTables = Tables;
    var table = Tables[currentIndex];
    var columnNames = table.Columns.Select(column => column.Name).ToList();
    var visible = table.Columns.Select((column, index) =>
        (Column: column, Index: index, StatusIndex: columnNames.IndexOf($"{column.Name}__Status")))
        .Where(item => !item.Column.Name.EndsWith("__Status", StringComparison.Ordinal) &&
            AnalysisVisualization.Column(Options, item.Column.Name)?.Hidden != true)
        .OrderBy(item => Options.Columns.FindIndex(column => column.Name == item.Column.Name) is var order && order >= 0
            ? order : Options.Columns.Count + item.Index).ToArray();
    var page = Math.Min(pages.GetValueOrDefault(currentIndex), Math.Max(0, (table.Rows.Count - 1) / PageSize));
    @if (table.Rows.Count > PageSize)
    {
        <nav class="analysis-table-pagination" aria-label="@Text.Format("AnalysisResults.TablePages", table.Workspace)">
            <button type="button" class="admin-secondary" disabled="@(page == 0)" @onclick="() => ChangePageForTables(sourceTables, currentIndex, -1)">@Text["Common.Previous"]</button>
            <span>@Text.Format("AnalysisResults.Rows",
                (page * PageSize + 1).ToString(CultureInfo.CurrentCulture),
                Math.Min((page + 1) * PageSize, table.Rows.Count).ToString(CultureInfo.CurrentCulture),
                table.Rows.Count.ToString(CultureInfo.CurrentCulture))</span>
            <button type="button" class="admin-secondary" disabled="@((page + 1) * PageSize >= table.Rows.Count)" @onclick="() => ChangePageForTables(sourceTables, currentIndex, 1)">@Text["Common.Next"]</button>
        </nav>
    }
    <div class="analysis-result-table" tabindex="0" role="region" aria-label="@Text.Format("AnalysisResults.TableResult", table.Workspace)">
        <table>
            <caption>@Name · @table.Workspace</caption>
            <thead><tr>
                @foreach (var column in visible)
                {
                    var display = AnalysisVisualization.Column(Options, column.Column.Name);
                    <th scope="col" style="@(display?.Width is int width ? $"min-width:{width}px;max-width:{width}px;" : null)">@(display?.DisplayName ?? column.Column.Name)</th>
                }
            </tr></thead>
            <tbody>
                @foreach (var row in table.Rows.Skip(page * PageSize).Take(PageSize))
                {
                    <tr>
                        @foreach (var column in visible)
                        {
                            var statusIndex = column.StatusIndex;
                            var isStatus = column.Column.Name == "Status";
                            var value = row[column.Index];
                            var iconOnly = (AnalysisVisualization.Column(Options, column.Column.Name)?.CellDisplay ?? Options.CellDisplay) == "StatusIcon";
                            <td style="@AnalysisVisualization.CellStyle(Options, value, column.Column.Name)">
                                @if (iconOnly)
                                {
                                    var icon = AnalysisVisualization.StatusIcon(Options, value);
                                    var label = icon.Label ?? Text["AnalysisResults.Status.unknown"];
                                    <span class="analysis-status" aria-label="@label" title="@label">@icon.Symbol</span>
                                }
                                else
                                {
                                    @if (statusIndex >= 0 || isStatus)
                                    {
                                        var status = AnalysisResultFormatting.Status(statusIndex >= 0 ? row[statusIndex] : value);
                                        var statusLabel = Text[$"AnalysisResults.Status.{status}"];
                                        <span class="analysis-status analysis-status-@status" aria-label="@statusLabel" title="@statusLabel">@AnalysisResultFormatting.StatusSymbol(status)</span>
                                    }
                                    @AnalysisVisualization.TableText(Options, value, column.Column.Name)
                                    @(AnalysisVisualization.Unit(Options, column.Column.Name) is string unit ? $" {unit}" : "")
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AnalysisQueryTable> Tables { get; set; } = [];
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public AnalysisVisualizationOptions Options { get; set; } = new();
    private const int PageSize = 50;
    private readonly Dictionary<int, int> pages = [];
    private IReadOnlyList<AnalysisQueryTable>? previousTables;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Tables, previousTables))
            pages.Clear();
        previousTables = Tables;
    }

    private void ChangePageForTables(IReadOnlyList<AnalysisQueryTable> source, int tableIndex, int direction)
    {
        if (ReferenceEquals(source, Tables)) ChangePage(tableIndex, direction);
    }

    private void ChangePage(int tableIndex, int direction)
    {
        if (tableIndex < 0 || tableIndex >= Tables.Count) return;
        var lastPage = Math.Max(0, (Tables[tableIndex].Rows.Count - 1) / PageSize);
        pages[tableIndex] = Math.Clamp(pages.GetValueOrDefault(tableIndex) + direction, 0, lastPage);
    }
}
