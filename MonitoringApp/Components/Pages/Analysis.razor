    private bool SystemMatchesWorkspace(ComputerInventoryEntry system)
    {
        if (workspaceFilter.Length == 0)
            return true;
        try
        {
            return QueryRunner.WorkspaceResolver.Resolve(system.SubscriptionId, system.Domain)
                .Workspace.Key.Equals(workspaceFilter, StringComparison.OrdinalIgnoreCase);
        }
        catch (TargetWorkspaceResolutionException)
        {
            return false;
        }
    }

    private async Task DashboardFiltersChangedAsync()
    {
        if (Dashboard.Document.ViewFilters is not null && selectedPublishedDashboard is null)
            Dashboard.UpdateWorkspace(document => document.ViewFilters = CurrentSetupFilters);
        selectionGeneration++;
        widgetResults.Clear();
        widgetErrors.Clear();
        result = null;
        errorMessage = null;
        hasDetailRequest = false;
        if (UsesPersonalRoles)
        {
            if (CanRunDashboard)
                await RunDashboardAsync();
            else
                await RefreshRoleInventoryAsync();
            return;
        }
        RefreshExecutionPreview();
        runPublishedOnFilterChange = selectedPublishedDashboard is not null;
        if (selectedPublishedDashboard is null)
            await RunDashboardAsync();
