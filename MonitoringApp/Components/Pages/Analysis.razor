    private void SyncDashboardSystems()
    {
        if (UsesInventoryRoles)
            return;
        selectionGeneration++;
        result = null;
        hasDetailRequest = false;
        widgetResults.Clear();
        widgetErrors.Clear();
        var systems = Dashboard.Document.Systems
            .Concat(inventory.Select(item => new AnalysisDashboardSystem
            {
                SubscriptionId = item.SubscriptionId,
                Computer = item.Computer
            }))
            .Where(item => selectedSystems.Contains($"{item.SubscriptionId}\u001f{item.Computer}"))
            .DistinctBy(item => $"{item.SubscriptionId}\u001f{item.Computer}", StringComparer.OrdinalIgnoreCase)
            .ToList();
        Dashboard.UpdateWorkspace(document => document.Systems = systems);
        missingDashboardSystems = AnalysisDashboardInventorySelection.Resolve(systems, inventory).MissingSystems;
    }

    [JSInvokable]
    public async Task PlaceDashboardQuery(string queryId, int column, int row)
    {
        if (!editMode || PersonalActionsBlocked || DashboardBrowserBlocked)
            return;
        errorMessage = null;
        var query = availableQueries.FirstOrDefault(item => item.Id.ToString().Equals(queryId, StringComparison.OrdinalIgnoreCase));
        if (query is null)
        {
            Logger.LogWarning("Cannot place an unavailable analysis query.");
            errorMessage = Text["Analysis.Errors.QueryUnavailable"];
        }
        else
        {
            var existing = Dashboard.Document.Widgets.FirstOrDefault(widget => widget.QueryDefinitionId == query.Id);
            if (existing is not null)
                Dashboard.MoveWidget(existing.Id, column, row);
            else if (Dashboard.Document.Widgets.Count >= 12)
            {
                Logger.LogWarning("The analysis dashboard widget limit has been reached.");
                errorMessage = Text["Analysis.Validation.WidgetLimit"];
            }
            else
            {
                var added = Dashboard.AddWidget(query.Id, query.Name, query.DefaultTimeRangeMinutes, column, row);
                added.BinMinutes = query.DefaultBinMinutes;
            }
            if (errorMessage is null)
            {
                dashboardEditMode = true;
                await SaveDashboardAsync();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CommitAnalysisPanelResize(string panel, int width, int height)
    {
        if (!editMode || PersonalActionsBlocked || DashboardBrowserBlocked)
