@page "/access-denied"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject ApplicationAuthenticationOptions AuthenticationOptions
@inject UiText Text

<PageTitle>@Text["AccessDenied.Title"]</PageTitle>

<section class="login-shell">
    <div class="login-panel">
        <p class="eyebrow">@Text["Authentication.RestrictedAccess"]</p>
        <h1>@Text["AccessDenied.Title"]</h1>
        <p class="subtitle">@Text["AccessDenied.Description"]</p>
        <a class="admin-primary login-home-link" href="/">@Text["AccessDenied.ReturnToConsole"]</a>
        @if (AuthenticationOptions.IsEntra)
        {
            <a class="admin-secondary login-home-link" href="/.auth/logout?post_logout_redirect_uri=/login">@Text["AccessDenied.UseAnotherAccount"]</a>
        }
    </div>
</section>