@page "/logbook"
@rendermode InteractiveServer
@inject LogbookStore LogbookStore
@inject AlertStore AlertStore
@inject QueryResultPresenter QueryResultPresenter
@inject ApplicationAuthenticationOptions ApplicationAuthentication
@inject CurrentUserIdentity CurrentUserIdentity
@inject UiText Text
@inject ILogger<Logbook> Logger

<PageTitle>@Text["Navigation.Logbook"]</PageTitle>

<section class="admin-heading">
    <div>
        <p class="eyebrow">@Text["Common.Operations"]</p>
        <h1>@Text["Navigation.Logbook"]</h1>
        <p class="subtitle">@Text["Logbook.Description"]</p>
    </div>
    <button class="admin-secondary" type="button" disabled="@isLoading" @onclick="LoadEntriesAsync">
        @Text[isLoading ? "Common.Refreshing" : "Common.Refresh"]
    </button>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="admin-message admin-message-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}

<section class="logbook-compose" aria-labelledby="new-logbook-entry">
    <div class="admin-section-heading">
        <div>
            <p class="eyebrow">@Text["Logbook.NewEntry"]</p>
            <h2 id="new-logbook-entry">@Text["Logbook.WriteComment"]</h2>
            <span>@(string.IsNullOrWhiteSpace(currentUser) ? Text["Logbook.NoUser"] : Text.Format("Logbook.WritingAs", currentUser))</span>
        </div>
    </div>
    <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <label class="admin-field admin-field-wide">
            <span>@Text["Logbook.Comment"]</span>
            <textarea required maxlength="4000" rows="5" @bind="commentDraft"></textarea>
            <small>@Text.Format("Logbook.CommentHelp", commentDraft.Length)</small>
        </label>
        <div class="admin-form-actions">
            <button class="admin-primary" type="submit" disabled="@(isSaving || string.IsNullOrWhiteSpace(currentUser))">
                @Text[isSaving ? "Common.Saving" : "Logbook.Add"]
            </button>
        </div>
    </form>
</section>

<section class="logbook-history" aria-labelledby="logbook-history-heading">
    <div class="admin-section-heading">
        <div>
            <h2 id="logbook-history-heading">@Text["Logbook.Entries"]</h2>
            <span>@Text.Plural("Logbook.EntryCount", entries.Count)</span>
        </div>
    </div>

    @if (isLoading && entries.Count == 0)
    {
        <p class="admin-empty">@Text["Logbook.Loading"]</p>
    }
    else if (entries.Count == 0)
    {
        <p class="admin-empty">@Text["Logbook.Empty"]</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="logbook-table">
                <thead>
                    <tr>
                        <th>@Text["Logbook.DateUtc"]</th>
                        <th>@Text["Logbook.User"]</th>
                        <th>@Text["Logbook.Comment"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in entries)
                    {
                        <tr>
                            <td><time class="timestamp" datetime="@entry.CreatedAt.ToString("O")">@entry.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</time></td>
                            <td class="logbook-user">@entry.User</td>
                            <td class="logbook-comment">
                                @if (entry.AlertRecordId is { } alertRecordId &&
                                    alertSnapshots.TryGetValue(alertRecordId, out var alert))
                                {
                                    var queryResult = QueryResultPresenter.ParseForDisplay(alert.RawJson, Text);
                                    <div class="logbook-alert-entry">
                                        <strong>@FormatAlertIdentity(alert)</strong>
                                        <div class="logbook-search-results">
                                            <b>@Text["Logbook.SearchResults"]</b>
                                            @if (queryResult is null)
                                            {
                                                <span class="search-result-empty">-</span>
                                            }
                                            else
                                            {
                                                <QueryResultPresentationView Presentation="queryResult" FormatValue="FormatPresentationValue" />
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @entry.Comment
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private IReadOnlyList<LogbookEntry> entries = [];
    private IReadOnlyDictionary<Guid, AlertRecord> alertSnapshots = new Dictionary<Guid, AlertRecord>();
    private IReadOnlyList<ComputerInventoryEntry> computerInventory = [];
    private string currentUser = string.Empty;
    private string commentDraft = string.Empty;
    private string? statusMessage;
    private string? errorMessage;
    private bool isLoading;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateTask;
        currentUser = CurrentUserIdentity.GetActor(
            authenticationState.User,
            ApplicationAuthentication.IsOpen);
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var entriesTask = LogbookStore.GetAllAsync();
            var alertsTask = AlertStore.GetAllRequiredAsync();
            var historyTask = AlertStore.GetFiredHistoryRequiredAsync();
            var inventoryTask = AlertStore.GetComputerInventoryAsync();
            await Task.WhenAll(entriesTask, alertsTask, historyTask, inventoryTask);

            entries = await entriesTask;
            computerInventory = await inventoryTask;
            var snapshots = (await alertsTask).ToDictionary(alert => alert.Id);
            foreach (var historyAlert in await historyTask)
            {
                snapshots[historyAlert.Id] = historyAlert;
            }

            alertSnapshots = snapshots;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the logbook and its alert context.");
            errorMessage = Text["Logbook.LoadError"];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;
        statusMessage = null;
        errorMessage = null;
        try
        {
            await LogbookStore.AddAsync(currentUser, commentDraft);
            commentDraft = string.Empty;
            statusMessage = Text["Logbook.Status.Added"];
            await LoadEntriesAsync();
        }
        catch (LogbookValidationException exception)
        {
            Logger.LogWarning(exception, "Logbook validation reported {ErrorCode}.", exception.Code);
            errorMessage = Text["Logbook.Validation." + exception.Code];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The outcome of adding a logbook entry could not be confirmed.");
            errorMessage = Text["Logbook.Errors.ChangeUnconfirmed"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private string FormatAlertIdentity(AlertRecord alert)
    {
        var domain = computerInventory.FirstOrDefault(entry =>
            entry.SubscriptionId.Equals(alert.SubscriptionId, StringComparison.OrdinalIgnoreCase) &&
            entry.Computer.Equals(alert.TargetName, StringComparison.OrdinalIgnoreCase))?.Domain;
        return $"{Display(domain)} - {Display(alert.SiteName)} - {Display(alert.TargetName)} - {Display(alert.Name)}";
    }

    private static string FormatPresentationValue(QueryResultValue value) =>
        value.Format.Equals("datetime", StringComparison.OrdinalIgnoreCase) &&
        DateTimeOffset.TryParse(value.Value, out var timestamp)
            ? timestamp.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
            : value.Value;

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "(unknown)" : value.Trim();

}
