@page "/graph"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AlertStore AlertStore
@inject AlertGraphOptions AlertGraph
@inject AlertHistoryOptions AlertHistory
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment HostEnvironment
@inject UiText Text
@inject ILogger<Graph> Logger

<PageTitle>@Text["Graph.PageTitle"]</PageTitle>
@if (loadError is not null)
{
    <p role="alert">@loadError</p>
}
@if (graphError is not null)
{
    <div class="admin-message admin-message-error" role="alert">
        <p>@graphError</p>
        <button type="button" disabled="@isGraphBusy" @onclick="RetryGraphAsync">@Text["Graph.Controls.Retry"]</button>
    </div>
}

@{
    var navigationTree = GetNavigationTree();
    var dnsNamespaces = selectedLayer1 == AlertGraphLayer.Domain
        ? DnsNamespaceResolver.Resolve(alerts.Select(alert => alert.Domain))
        : null;
    var graphLayout = AlertGraphLayout.Build(navigationTree, dnsNamespaces);
    var easterEgg = AlertGraph.SLocations
        ? previewEasterEgg ?? AlertGraphEasterEggSites.Resolve(currentTimeUtc)
        : null;
    var openCount = navigationTree.Sum(subscription => subscription.Count);
    var historyCount = navigationTree.Sum(subscription => subscription.HistoryCount);
}

<section class="graph-heading">
    <div>
        <p class="eyebrow">@Text["Common.Operations"]</p>
        <h1>@Text["Graph.Title"]</h1>
        <p class="subtitle">@Text.Plural("Graph.Description", AlertHistory.Days)</p>
    </div>
    <div class="graph-summary" aria-label="@Text.Format("Graph.CountDescription", openCount, historyCount)">
        <strong>@openCount</strong>
        <span>@Text["Graph.OpenCaption"]</span>
        <strong>@historyCount</strong>
        <span>@Text["Graph.HistoryCaption"]</span>
    </div>
</section>

<section class="graph-configuration" aria-label="@Text["Graph.FiltersLabel"]">
    <div class="graph-filter">
        <label for="graph-filter-text">
            <span>@Text["Graph.Filter"]</span>
            <small>@Text["Graph.FilterHelp"]</small>
        </label>
        <div class="graph-filter-input">
            <input id="graph-filter-text"
                   type="search"
                   placeholder="@Text["Graph.FilterPlaceholder"]"
                   autocomplete="off"
                   @bind="filterText"
                   @bind:event="oninput"
                   @bind:after="GraphFilterChanged" />
            @if (!string.IsNullOrWhiteSpace(filterText))
            {
                <button type="button" @onclick="ClearFilter" aria-label="@Text["Graph.ClearFilterLabel"]">@Text["Common.Clear"]</button>
            }
        </div>
    </div>
    <div class="graph-layer-controls" aria-label="@Text["Graph.LayersLabel"]">
        <label>
            <span>@Text["Graph.LayerOne"]</span>
            <select @bind="selectedLayer1" @bind:after="GraphLayersChanged">
                @foreach (var choice in AlertGraph.ChoicesForLevel(1))
                {
                    <option value="@choice.Value">@choice.Label</option>
                }
            </select>
        </label>
        <label>
            <span>@Text["Graph.LayerTwo"]</span>
            <select @bind="selectedLayer2" @bind:after="GraphLayersChanged">
                @foreach (var choice in AlertGraph.ChoicesForLevel(2))
                {
                    <option value="@choice.Value">@choice.Label</option>
                }
            </select>
        </label>
        <label>
            <span>@Text["Graph.LayerThree"]</span>
            <select @bind="selectedLayer3" @bind:after="GraphLayersChanged">
                @foreach (var choice in AlertGraph.ChoicesForLevel(3))
                {
                    <option value="@choice.Value">@choice.Label</option>
                }
            </select>
        </label>
    </div>
</section>

<section class="graph-site-map" aria-labelledby="graph-site-map-heading">
    <div class="graph-site-map-heading">
        <div>
            <p class="eyebrow">@Text["Graph.GlobalSites"]</p>
            <h2 id="graph-site-map-heading">@Text["Graph.SiteStatus"]</h2>
            <p>@Text["Graph.SiteStatusHelp"]</p>
        </div>
        <div class="graph-site-map-legend" aria-label="@Text["Graph.SiteLegendLabel"]">
            <span><i class="graph-site-map-healthy" aria-hidden="true"></i>@Text["Graph.NoOpenAlerts"]</span>
            <span><i class="graph-site-map-alert" aria-hidden="true"></i>@Text["Graph.OpenAlert"]</span>
            <span><i class="graph-site-map-day" aria-hidden="true"></i>@Text["Graph.Day"]</span>
            <span><i class="graph-site-map-twilight" aria-hidden="true"></i>@Text["Graph.Twilight"]</span>
            <span><i class="graph-site-map-night" aria-hidden="true"></i>@Text["Graph.Night"]</span>
        </div>
    </div>
    @if (AlertGraph.SLocations && HostEnvironment.IsDevelopment())
    {
        <nav class="graph-easter-preview" aria-label="@Text["Graph.PreviewLabel"]">
            <span>@Text["Graph.Preview"]</span>
            @foreach (var preview in AlertGraphEasterEggSites.Previews)
            {
                <a href="@($"/graph?easterEgg={preview.Key}")"
                   aria-current="@(EasterEggPreview == preview.Key ? "page" : null)">@preview.Label</a>
            }
            <a href="/graph">@Text["Graph.Today"]</a>
        </nav>
        @if (previewError is not null)
        {
            <div class="admin-message admin-message-error" role="alert">@previewError</div>
        }
    }
    <GraphSiteMap Records="alerts" Locations="AlertGraph.SiteLocations" TimeUtc="currentTimeUtc" EasterEgg="easterEgg" />
    <p class="graph-site-map-source">
        @Text["Graph.MapAttributionLabel"]
        <a href="https://commons.wikimedia.org/wiki/File:World_map_configurable.svg"
           target="_blank"
           rel="noopener noreferrer">World map configurable.svg</a>
        · Wikimedia Commons · CC0
    </p>
</section>

<section class="graph-region" aria-label="@Text["Graph.HierarchyLabel"]">
    <div class="graph-toolbar">
        <div class="graph-legend" aria-label="@Text["Graph.CountLegend"]">
            <span><i class="legend-open" aria-hidden="true"></i>@Text["Graph.OpenAlerts"]</span>
            <span><i class="legend-history" aria-hidden="true"></i>@Text["Graph.HistoryAlerts"]</span>
            <span><i class="legend-target-current" aria-hidden="true"></i>@Text.Format("Graph.TargetCurrent", currentHeartbeatAge.TotalMinutes)</span>
            <span><i class="legend-target-stale" aria-hidden="true"></i>@Text.Format("Graph.TargetStale", currentHeartbeatAge.TotalMinutes)</span>
            <span><i class="legend-target-service-health" aria-hidden="true"></i>@Text["Graph.ServiceHealth"]</span>
            <span><i class="legend-target-maintenance" aria-hidden="true"></i>@Text["Graph.Maintenance"]</span>
            @if (graphLayout.Segments.Count > 0)
            {
                <span><i class="legend-dns-namespace" aria-hidden="true"></i>@Text["Graph.DnsNamespace"]</span>
            }
            <span><i class="@LegendClass(selectedLayer1) legend-level-1" aria-hidden="true"></i>@Text.Format("Graph.LayerLegendOne", AlertGraph.Label(selectedLayer1))</span>
            <span><i class="@LegendClass(selectedLayer2) legend-level-2" aria-hidden="true"></i>@Text.Format("Graph.LayerLegendTwo", AlertGraph.Label(selectedLayer2))</span>
            <span><i class="@LegendClass(selectedLayer3) legend-level-3" aria-hidden="true"></i>@Text.Format("Graph.LayerLegendThree", AlertGraph.Label(selectedLayer3))</span>
        </div>
        <div class="graph-tools">
            <span>@Text.Format("Graph.Updated", currentTimeUtc.ToString("yyyy-MM-dd HH:mm:ss"))</span>
            <button type="button" disabled="@GraphControlsBlocked" title="@Text["Common.ZoomOut"]" aria-label="@Text["Common.ZoomOut"]" @onclick="() => ZoomAsync(1.25)">-</button>
            <button type="button" disabled="@GraphControlsBlocked" title="@Text["Graph.ResetView"]" @onclick="ResetGraphAsync">@Text["Common.Reset"]</button>
            <button type="button" disabled="@GraphControlsBlocked" title="@Text["Common.ZoomIn"]" aria-label="@Text["Common.ZoomIn"]" @onclick="() => ZoomAsync(0.8)">+</button>
        </div>
    </div>

    <div class="graph-viewport">
        @if (navigationTree.Count == 0)
        {
            <div class="graph-empty">
                @if (string.IsNullOrWhiteSpace(filterText))
                {
                    <strong>@Text["Graph.Empty"]</strong>
                    <span>@Text["Graph.EmptyHelp"]</span>
                }
                else
                {
                    <strong>@Text["Graph.EmptyFiltered"]</strong>
                    <span>@Text["Graph.EmptyFilteredHelp"]</span>
                }
            </div>
        }
        <svg id="alert-graph-canvas"
             class="graph-svg"
             viewBox="0 0 @Coordinate(graphLayout.Width) @Coordinate(graphLayout.Height)"
             role="img"
             aria-label="@Text.Format("Graph.CanvasDescription", graphLayout.Nodes.Count, graphLayout.Edges.Count)">
            <g class="graph-world">
                @if (graphLayout.Segments.Count > 0)
                {
                    <g class="graph-namespace-segments" aria-label="@Text["Graph.DnsSegmentsLabel"]">
                        @foreach (var segment in graphLayout.Segments)
                        {
                            <g class="graph-namespace-segment" role="group" aria-label="@Text.Format("Graph.DnsSegmentLabel", segment.Label)">
                                <title>@Text.Format("Graph.DnsSegmentTitle", segment.Label)</title>
                                <rect x="@Coordinate(segment.X)" y="@Coordinate(segment.Y)" width="@Coordinate(segment.Width)" height="@Coordinate(segment.Height)" rx="12" />
                                <text x="@Coordinate(segment.X + 18)" y="@Coordinate(segment.Y + 29)">@Text.Format("Graph.DnsSegmentTitle", segment.Label)</text>
                            </g>
                        }
                    </g>
                }
                <g class="graph-edges" aria-hidden="true">
                    @foreach (var edge in graphLayout.Edges)
                    {
                        <line x1="@Coordinate(edge.X1)" y1="@Coordinate(edge.Y1)" x2="@Coordinate(edge.X2)" y2="@Coordinate(edge.Y2)" />
                    }
                </g>
                <g class="graph-nodes">
                    @foreach (var node in graphLayout.Nodes)
                    {
                        <g class="graph-svg-node graph-level-@node.Level @NodeClasses(node)"
                           transform="translate(@Coordinate(node.X) @Coordinate(node.Y))"
                           role="group"
                           aria-label="@NodeAriaLabel(node)">
                            <title>@NodeTitle(node)</title>
                            @if (node.Level == 1)
                            {
                                <polygon points="-95,0 -78,-25 78,-25 95,0 78,25 -78,25" />
                            }
                            else
                            {
                                <rect x="-95" y="-25" width="190" height="50" rx="@(node.Level == 3 ? 25 : 5)" />
                            }
                            <text class="graph-node-label" x="-82" y="-5">@ShortLabel(node.Label)</text>
                            @if (node.Layer == AlertGraphLayer.Target && !string.IsNullOrWhiteSpace(node.SubscriptionId))
                            {
                                <g>
                                    <text class="graph-node-subscription" x="-82" y="14">@ShortSubscription(node.SubscriptionId)</text>
                                </g>
                            }
                            <text class="graph-node-count" x="82" y="14" text-anchor="end">
                                <tspan class="graph-node-open">@node.Count</tspan><tspan> (@node.HistoryCount)</tspan>
                            </text>
                        </g>
                    }
                </g>
            </g>
        </svg>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "easterEgg")]
    public string? EasterEggPreview { get; set; }

    private AlertGraphEasterEgg? previewEasterEgg;
    private string? previewError;
    private IReadOnlyList<AlertGraphRecord> alerts = [];
    private TimeSpan currentHeartbeatAge = AlertGraphTargetStatusResolver.CurrentThreshold;
    private DateTimeOffset currentTimeUtc = DateTimeOffset.UtcNow;
    private readonly CancellationTokenSource refreshCancellation = new();
    private readonly SemaphoreSlim reloadLock = new(1, 1);
    private Task? refreshTask;
    private string? loadError;
    private bool disposed;
    private bool graphNeedsInitialization = true;
    private bool graphInitialized;
    private bool graphCleanupRequired;
    private bool isGraphBusy;
    private string? graphError;
    private Task? graphOperationTask;
    private bool GraphControlsBlocked => disposed || isGraphBusy || !graphInitialized || graphNeedsInitialization;
    private string filterText = string.Empty;
    private AlertGraphLayer selectedLayer1 = AlertGraphLayer.Subscription;
    private AlertGraphLayer selectedLayer2 = AlertGraphLayer.ResourceGroup;
    private AlertGraphLayer selectedLayer3 = AlertGraphLayer.Target;
    private IReadOnlyList<AlertGraphHierarchyNode> GetNavigationTree() =>
        AlertGraphHierarchy.Build(
            AlertGraphFilter.Apply(alerts, filterText),
            selectedLayer1,
            selectedLayer2,
            selectedLayer3);

    protected override void OnParametersSet()
    {
        previewEasterEgg = null;
        previewError = null;
        if (!AlertGraph.SLocations) return;
        try
        {
            previewEasterEgg = AlertGraphEasterEggSites.ResolvePreview(EasterEggPreview, HostEnvironment.IsDevelopment());
        }
        catch (Exception exception)
        {
            ReportPreviewError(exception);
        }
    }

    private void ReportPreviewError(Exception exception)
    {
        if (exception is AlertGraphPreviewException)
            Logger.LogWarning(exception, "Unknown Graph development preview.");
        else
            Logger.LogError(exception, "Could not load the Graph development preview.");
        previewError = Text[exception is AlertGraphPreviewException ? "Graph.PreviewUnknown" : "Graph.PreviewFailed"];
    }

    protected override async Task OnInitializedAsync()
    {
        selectedLayer1 = AlertGraph.DefaultLayer1;
        selectedLayer2 = AlertGraph.DefaultLayer2;
        selectedLayer3 = AlertGraph.DefaultLayer3;
        AlertStore.Changed += HandleStoreChanged;
        await ReloadAlertsAsync();
        refreshTask = RefreshClockAsync(refreshCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!disposed && !isGraphBusy && graphNeedsInitialization)
        {
            await RunGraphOperationAsync("alertGraph.initialize");
        }
    }

    private void HandleStoreChanged()
    {
        if (!disposed) _ = InvokeAsync(ReloadAlertsAsync);
    }

    private async Task ReloadAlertsAsync()
    {
        if (disposed) return;
        var cancellationToken = refreshCancellation.Token;
        var lockHeld = false;
        try
        {
            await reloadLock.WaitAsync(cancellationToken);
            lockHeld = true;
            if (disposed) return;
            var timeUtc = DateTimeOffset.UtcNow;
            var heartbeatAge = InventoryHeartbeatFreshnessRule.Resolve(await AlertStore.GetAllAlertRulesAsync(cancellationToken));
            var records = await AlertStore.GetAlertGraphRecordsRequiredAsync(AlertHistory.GetCutoff(timeUtc), cancellationToken);
            if (disposed) return;
            currentTimeUtc = timeUtc;
            currentHeartbeatAge = heartbeatAge;
            alerts = records;
            loadError = null;
            graphNeedsInitialization = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not refresh graph alert and inventory data.");
            if (disposed) return;
            loadError = Text["Graph.LoadFailed"];
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            if (lockHeld) reloadLock.Release();
        }
    }

    private Task ZoomAsync(double factor) => GraphControlsBlocked
        ? Task.CompletedTask : RunGraphOperationAsync("alertGraph.zoom", factor);

    private Task ResetGraphAsync() => GraphControlsBlocked
        ? Task.CompletedTask : RunGraphOperationAsync("alertGraph.reset");

    private Task RetryGraphAsync()
    {
        if (disposed || isGraphBusy) return Task.CompletedTask;
        graphNeedsInitialization = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task RunGraphOperationAsync(string operation, double? factor = null)
    {
        if (disposed || isGraphBusy) return Task.CompletedTask;
        graphOperationTask = RunGraphOperationCoreAsync(operation, factor);
        return graphOperationTask;
    }

    private async Task RunGraphOperationCoreAsync(string operation, double? factor)
    {
        isGraphBusy = true;
        var initializing = operation == "alertGraph.initialize";
        if (initializing)
        {
            graphNeedsInitialization = false;
            graphInitialized = false;
            graphCleanupRequired = true;
        }
        try
        {
            await InvokeAsync(StateHasChanged);
            await JSRuntime.InvokeVoidAsync(operation, refreshCancellation.Token,
                factor is { } value ? ["alert-graph-canvas", value] : ["alert-graph-canvas"]);
            if (disposed) return;
            if (initializing) graphInitialized = !graphNeedsInitialization;
            graphError = null;
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Graph browser operation {Operation} failed.", operation);
            if (disposed) return;
            graphError = Text[initializing ? "Graph.Controls.InitializeFailed" : "Graph.Controls.ChangeFailed"];
        }
        finally
        {
            isGraphBusy = false;
        }
        if (!disposed) await InvokeAsync(StateHasChanged);
    }

    private void GraphLayersChanged()
    {
        graphNeedsInitialization = true;
    }

    private void GraphFilterChanged()
    {
        graphNeedsInitialization = true;
    }

    private void ClearFilter()
    {
        filterText = string.Empty;
        graphNeedsInitialization = true;
    }

    private async Task RefreshClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(ReloadAlertsAsync);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private string NodeClasses(AlertGraphNode node)
    {
        var statusClass = AlertGraphTargetStatusResolver.Resolve(node, currentTimeUtc, currentHeartbeatAge) switch
        {
            AlertGraphTargetStatus.OpenAlert => "graph-svg-active",
            AlertGraphTargetStatus.ServiceHealthAlert => "graph-svg-target-service-health",
            AlertGraphTargetStatus.Current => "graph-svg-target-current",
            AlertGraphTargetStatus.Stale => "graph-svg-target-stale",
            AlertGraphTargetStatus.Maintenance => "graph-svg-target-maintenance",
            _ => string.Empty
        };
        return $"{NodeClass(node.Layer)} {statusClass}";
    }

    private string NodeAriaLabel(AlertGraphNode node)
    {
        if (node.Layer != AlertGraphLayer.Target)
            return Text.Format("Graph.NodeAria", node.Level, node.Label, node.Count, node.HistoryCount);

        var key = AlertGraphTargetStatusResolver.Resolve(node, currentTimeUtc, currentHeartbeatAge) switch
        {
            AlertGraphTargetStatus.OpenAlert => "Graph.NodeAriaTarget.OpenAlert",
            AlertGraphTargetStatus.ServiceHealthAlert => "Graph.NodeAriaTarget.ServiceHealthAlert",
            AlertGraphTargetStatus.Current => "Graph.NodeAriaTarget.Current",
            AlertGraphTargetStatus.Stale => "Graph.NodeAriaTarget.Stale",
            AlertGraphTargetStatus.Maintenance => "Graph.NodeAriaTarget.Maintenance",
            AlertGraphTargetStatus.None => "Graph.NodeAriaTarget",
            var status => throw new ArgumentOutOfRangeException(nameof(node), status, "Unknown graph target status.")
        };
        return Text.Format(key, node.Level, node.Label, node.Count, node.HistoryCount, node.SubscriptionId);
    }

    private string NodeTitle(AlertGraphNode node)
    {
        var key = node.Layer == AlertGraphLayer.Target
            ? node.LastHeartbeatAt is null ? "Graph.NodeTitleTarget" : "Graph.NodeTitleTargetHeartbeat"
            : node.LastHeartbeatAt is null ? "Graph.NodeTitle" : "Graph.NodeTitleHeartbeat";
        return Text.Format(key, node.Level, node.Label, node.Count, node.HistoryCount,
            node.SubscriptionId, node.LastHeartbeatAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? string.Empty);
    }

    private static string NodeClass(AlertGraphLayer layer) => layer switch
    {
        AlertGraphLayer.Subscription => "graph-svg-subscription",
        AlertGraphLayer.AlertName => "graph-svg-alert-name",
        AlertGraphLayer.ResourceGroup => "graph-svg-resource-group",
        AlertGraphLayer.Domain => "graph-svg-resource-group",
        AlertGraphLayer.Role => "graph-svg-alert-name",
        _ => "graph-svg-target"
    };

    private static string ShortSubscription(string value) =>
        value.Length <= 22 ? value : $"{value[..10]}...{value[^9..]}";

    private static string LegendClass(AlertGraphLayer layer) => layer switch
    {
        AlertGraphLayer.Subscription => "legend-subscription",
        AlertGraphLayer.AlertName => "legend-alert-name",
        AlertGraphLayer.ResourceGroup => "legend-resource-group",
        AlertGraphLayer.Domain => "legend-resource-group",
        AlertGraphLayer.Role => "legend-alert-name",
        _ => "legend-target"
    };

    private static string ShortLabel(string value)
    {
        var label = string.IsNullOrWhiteSpace(value) ? "-" : value;
        return label.Length <= 22 ? label : $"{label[..19]}...";
    }

    private static string Coordinate(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        AlertStore.Changed -= HandleStoreChanged;
        refreshCancellation.Cancel();
        if (refreshTask is not null)
        {
            await refreshTask;
        }
        if (graphOperationTask is not null) await graphOperationTask;
        await reloadLock.WaitAsync();
        reloadLock.Release();
        refreshCancellation.Dispose();

        if (!graphCleanupRequired)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("alertGraph.dispose", "alert-graph-canvas");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not dispose Graph browser controls.");
        }
    }
}