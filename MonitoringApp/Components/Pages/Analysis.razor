    private async Task RunDashboardAsync()
    {
        if (!CanRunDashboard)
            return;
        setupAwaitingExecution = false;
        isDashboardRunning = true;
        errorMessage = null;
        StateHasChanged();
        var cancellationToken = refreshCancellation.Token;
        var generation = selectionGeneration;
        try
        {
            if (!await CheckDashboardAccessAsync())
                return;
            AnalysisDashboardInventorySelection selection;
            if (UsesInventoryRoles)
            {
                widgetResults.Clear();
                widgetErrors.Clear();
                result = null;
                if (!await LoadRoleSelectionAsync())
                    return;
                selection = roleSelection ?? throw new InvalidOperationException("The role selection snapshot is missing.");
            }
            else
                selection = await Execution.ResolveDashboardSystemsAsync(Dashboard.Document.Systems, cancellationToken);
            if (!IsCurrentSelection(generation))
                return;
            missingDashboardSystems = selection.MissingSystems;
            var systems = selection.Systems;
            if (systems.Count == 0)
            {
                widgetResults.Clear();
                widgetErrors.Clear();
                dashboardStatus = Text[UsesInventoryRoles ? "Analysis.RoleSelection.Empty" : "Analysis.DashboardAllSystemsMissing"];
                return;
            }
            var batch = new AnalysisDashboardQueryBatch(Execution.ExecuteAsync, cancellationToken);
            var widgets = Dashboard.Document.Widgets.OrderBy(widget => widget.Row).ThenBy(widget => widget.Column).ToArray();
            var failedWidgets = 0;
            foreach (var widget in widgets)
            {
                cancellationToken.ThrowIfCancellationRequested();
                if (!await CheckDashboardAccessAsync())
                    return;
                try
                {
                    var query = availableQueries.FirstOrDefault(item => item.Id == widget.QueryDefinitionId)
                        ?? throw new KeyNotFoundException("The published query is no longer available.");
                    var request = Dashboard.Document.CreateExecutionRequest(widget, systems)
                        with { WorkspaceKey = workspaceFilter, Domain = UsesInventoryRoles ? null : domainFilter,
                            Site = UsesInventoryRoles ? null : siteFilter, Role = UsesInventoryRoles ? null : roleFilter };
                    var response = await batch.ExecuteAsync(query, request);
                    if (!await CheckDashboardAccessAsync())
                        return;
                    if (!IsCurrentSelection(generation))
                        return;
                    if (IsCurrentSelection(generation) && Dashboard.Document.Widgets.Any(current => current.Id == widget.Id))
                    {
                        widgetResults[widget.Id] = response;
                        widgetErrors.Remove(widget.Id);
                    }
                }
                catch (Exception exception) when (exception is not OperationCanceledException || !cancellationToken.IsCancellationRequested)
                {
                    Logger.LogError(exception, "Analysis widget {WidgetId} execution failed.", widget.Id);
                    if (Dashboard.Document.Widgets.Any(current => current.Id == widget.Id))
                    {
                        failedWidgets++;
                        widgetResults.Remove(widget.Id);
                        widgetErrors[widget.Id] = exception is KeyNotFoundException
                            ? Text["Analysis.Errors.QueryUnavailable"]
                            : AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ExecutionFailed");
                    }
                }
                if (!IsCurrentSelection(generation))
                    return;
                StateHasChanged();
                await Task.Yield();
            }
            dashboardStatus = failedWidgets > 0
                ? Text.Format(failedWidgets == 1 ? "AnalysisStatus.RefreshFailures.One" : "AnalysisStatus.RefreshFailures.Other",
                    failedWidgets, DateTimeOffset.UtcNow)
                : Text.Format(batch.Count == 1 ? "AnalysisStatus.RefreshedRequests.One" : "AnalysisStatus.RefreshedRequests.Other",
                    DateTimeOffset.UtcNow, batch.Count);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis dashboard refresh failed.");
            if (IsCurrentSelection(generation))
            {
                if (UsesInventoryRoles) RoleSelectionFailed(exception);
                errorMessage = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ExecutionFailed");
            }
        }
        finally
        {
            isDashboardRunning = false;
            if (!disposed && !cancellationToken.IsCancellationRequested)
                StateHasChanged();
        }
    }

    private async Task UndoDashboard()
    {
        if (PersonalActionsBlocked || DashboardBusy)
            return;
        Dashboard.Undo();
        RestoreDashboardSystems();
        if (UsesInventoryRoles) await RefreshRoleInventoryAsync();
        dashboardStatus = Text["AnalysisStatus.Undo"];
    }

    private async Task RedoDashboard()
    {
        if (PersonalActionsBlocked || DashboardBusy)
            return;
        Dashboard.Redo();
        RestoreDashboardSystems();
        if (UsesInventoryRoles) await RefreshRoleInventoryAsync();
        dashboardStatus = Text["AnalysisStatus.Redo"];
    }

    private void RestoreDashboardSystems()
    {
        InvalidateSelection();
        selectionMode = Dashboard.Document.SelectionMode;
        selectedInventoryRoles.Clear();
        selectedInventoryRoles.UnionWith(Dashboard.Document.InventoryRoles);
        widgetResults.Clear();
        widgetErrors.Clear();
        hasDetailRequest = false;
        selectedSystems.Clear();
        foreach (var saved in Dashboard.Document.Systems)
            selectedSystems.Add($"{saved.SubscriptionId}\u001f{saved.Computer}");
        missingDashboardSystems = UsesInventoryRoles ? [] :
            AnalysisDashboardInventorySelection.Resolve(Dashboard.Document.Systems, inventory).MissingSystems;
        if (UsesInventoryRoles)
        {
            try { UpdateRoleSelectionPreview(); }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Could not restore the dashboard inventory-role preview.");
                RoleSelectionFailed(exception);
            }
        }
        var opened = Dashboard.Document.Widgets.FirstOrDefault(widget => widget.Id == openedWidgetId);
        if (opened is not null)
            OpenWidget(opened);
        else
        {
            openedWidgetId = null;
            result = null;
            RefreshExecutionPreview();
        }
    }

    private async Task ReloadPublicationsAsync()
    {
        try
        {
            publishedDashboards = await Publishing.ListAsync((await AuthenticationStateTask).User, refreshCancellation.Token);
            dashboardOwners = await DashboardRepository.ListOwnersAsync(dashboardActorKey, refreshCancellation.Token);
            if (!dashboardOwnerKey.Equals(dashboardActorKey, StringComparison.OrdinalIgnoreCase) &&
                !dashboardOwners.Any(owner => owner.OwnerKey.Equals(dashboardOwnerKey, StringComparison.OrdinalIgnoreCase)))
                DashboardAccessDenied(new UnauthorizedAccessException("The selected historical dashboard owner is no longer available."));
            publicationLoadError = null;
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogWarning(exception, "Analysis publication list access was denied.");
            publishedDashboards = [];
            publicationLoadError = Text["Analysis.Errors.PublicationNotAllowed"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load analysis dashboard publications.");
            publicationLoadError = Text["Analysis.Errors.PublicationLoadFailed"];
        }
    }

    private async Task OpenPublishedDashboardAsync(Guid id)
    {
        if (DashboardBusy)
            return;
        if (selectedPublishedDashboard is null && !await TrySaveDashboardAsync())
            return;
        selectedPublishedDashboard = id;
        runPublishedOnFilterChange = false;
        confirmWithdrawDashboard = false;
    }

    private async Task ReturnToPersonalDashboard()
    {
        if (!DashboardBusy)
        {
            selectedPublishedDashboard = null;
            if (!await CheckDashboardAccessAsync())
                return;
            if (!editMode)
                await RunDashboardAsync();
        }
    }

    private async Task PublishDashboardAsync()
    {
        if (DashboardBusy || selectedPublishedDashboard is not null)
            return;
        isPublishingDashboard = true;
        publicationError = publicationMessage = null;
        try
        {
            if (!await TrySaveDashboardAsync())
                return;
            var publication = await Publishing.PublishAsync(dashboardCollection.ActiveDashboardId, dashboardRevision,
                (await AuthenticationStateTask).User, refreshCancellation.Token, sourceOwnerKey: dashboardOwnerKey);
            dashboardRevision++;
            dashboardStatus = Text.Format("AnalysisStatus.Saved", dashboardRevision);
            publicationMessage = Text.Format("AnalysisStatus.Published", publication.Name, publication.Version);
            await ReloadPublicationsAsync();
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard publication access was denied.");
            publicationError = Text["Analysis.Errors.PublicationNotAllowed"];
        }
        catch (DbUpdateConcurrencyException exception)
        {
            Logger.LogWarning(exception, "Analysis dashboard changed before publication.");
            publicationError = Text["Analysis.Errors.PublicationConflict"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Analysis dashboard publication could not be confirmed.");
            publicationError = Text["Analysis.Errors.PublishUnconfirmed"];
        }
        finally
        {
            isPublishingDashboard = false;
        }
    }

    private void PublishedSelectionModeChanged(Guid id, bool usesRoles)
    {
        if (selectedPublishedDashboard == id)
            publishedUsesInventoryRoles = usesRoles;
