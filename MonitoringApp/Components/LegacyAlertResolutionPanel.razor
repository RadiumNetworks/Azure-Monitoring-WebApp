@inject LegacyAlertResolutionService LegacyAlerts
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<LegacyAlertResolutionPanel> Logger
@inject UiText Text

<section class="admin-editor" aria-labelledby="legacy-alerts-heading">
    <div class="admin-section-heading">
        <h2 id="legacy-alerts-heading">@Text["LegacyAlerts.Title"]</h2>
    </div>
    <p>@Text["LegacyAlerts.Description"]</p>
    @if (message is not null)
    {
        <div class="admin-message admin-message-success" role="status">@message</div>
    }
    @if (!showConfirmation && error is not null)
    {
        <div class="admin-message admin-message-error" role="alert">@error</div>
    }
    <button class="admin-secondary" type="button" disabled="@busy" @onclick="PreviewAsync">@Text["LegacyAlerts.Title"]</button>
</section>

@if (showConfirmation)
{
    <div class="admin-dialog-backdrop" role="presentation">
        <section class="admin-dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-legacy-heading">
            <h2 id="confirm-legacy-heading">@Text.Plural("LegacyAlerts.ConfirmTitle", candidateCount)</h2>
            <p><LocalizedContent ResourceKey="LegacyAlerts.ConfirmBody"><Value0>Resolved</Value0></LocalizedContent></p>
            <label class="admin-field">
                <span><LocalizedContent ResourceKey="LegacyAlerts.ConfirmationHint"><Value0>RESOLVE</Value0></LocalizedContent></span>
                <input autocomplete="off" spellcheck="false" disabled="@busy" @bind="confirmation" @bind:event="oninput" />
            </label>
            @if (error is not null)
            {
                <div class="admin-message admin-message-error" role="alert">@error</div>
            }
            <div class="admin-form-actions">
                <button class="admin-secondary" type="button" disabled="@busy" @onclick="Cancel">@Text["Common.Cancel"]</button>
                <button class="admin-danger" type="button" disabled="@(busy || previewRequired || confirmation != "RESOLVE")"
                        @onclick="ResolveAsync">@Text[busy ? "LegacyAlerts.Resolving" : "LegacyAlerts.Confirm"]</button>
            </div>
        </section>
    </div>
}

@code {
    private bool busy;
    private bool showConfirmation;
    private bool previewRequired = true;
    private int candidateCount;
    private string confirmation = "";
    private string? message;
    private string? error;

    private async Task PreviewAsync()
    {
        if (busy) return;
        busy = true;
        message = null;
        error = null;
        try
        {
            candidateCount = await LegacyAlerts.CountAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
            previewRequired = false;
            confirmation = "";
            showConfirmation = candidateCount > 0;
            if (!showConfirmation)
                message = Text["LegacyAlerts.NoCandidates"];
        }
        catch (Exception exception)
        {
            previewRequired = true;
            showConfirmation = false;
            confirmation = "";
            var validation = MaintenanceErrorPresentation.ValidationMessage(exception, legacy: true, Text);
            error = validation ?? Text["LegacyAlerts.PreviewFailed"];
            if (validation is not null)
                Logger.LogWarning(exception, "Legacy alert preview was rejected.");
            else
                Logger.LogError(exception, "Failed to preview legacy alert resolution.");
        }
        finally { busy = false; }
    }

    private async Task ResolveAsync()
    {
        if (busy) return;
        if (previewRequired || !showConfirmation || candidateCount <= 0)
        {
            error = Text["LegacyAlerts.PreviewRequired"];
            Logger.LogWarning("Blocked legacy alert resolution pending a successful explicit preview.");
            return;
        }
        busy = true;
        message = null;
        error = null;
        try
        {
            var count = await LegacyAlerts.ResolveAsync(
                (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User, confirmation);
            showConfirmation = false;
            previewRequired = true;
            message = Text.Plural("LegacyAlerts.Completed", count);
        }
        catch (Exception exception)
        {
            var validation = MaintenanceErrorPresentation.ValidationMessage(exception, legacy: true, Text);
            if (validation is not null)
            {
                Logger.LogWarning(exception, "Legacy alert resolution was rejected.");
                error = validation;
            }
            else
            {
                Logger.LogError(exception, "Legacy alert resolution outcome is unconfirmed.");
                error = Text["LegacyAlerts.Unconfirmed"];
                previewRequired = true;
                showConfirmation = false;
            }
        }
        finally { busy = false; confirmation = ""; }
    }

    private void Cancel()
    {
        if (busy) return;
        showConfirmation = false;
        confirmation = "";
        previewRequired = true;
        error = null;
    }
}
