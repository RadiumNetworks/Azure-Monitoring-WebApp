@page "/graph"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject AlertStore AlertStore
@inject AlertGraphOptions AlertGraph
@inject AlertHistoryOptions AlertHistory
@inject IJSRuntime JSRuntime

<PageTitle>Alert Graph</PageTitle>

@{
    var navigationTree = GetNavigationTree();
    var dnsNamespaces = selectedLayer1 == AlertGraphLayer.Domain
        ? DnsNamespaceResolver.Resolve(alerts.Select(alert => alert.Domain))
        : null;
    var graphLayout = AlertGraphLayout.Build(navigationTree, dnsNamespaces);
    var solarOverlay = AlertGraphSolarOverlay.Build(currentTimeUtc);
    var siteMarkers = AlertGraphSiteMap.Build(alerts, AlertGraph.SiteLocations, currentTimeUtc);
    var easterEgg = AlertGraphEasterEggSites.Resolve(currentTimeUtc);
    var openCount = navigationTree.Sum(subscription => subscription.Count);
    var historyCount = navigationTree.Sum(subscription => subscription.HistoryCount);
}

<section class="graph-heading">
    <div>
        <p class="eyebrow">Operations</p>
        <h1>Alert graph</h1>
        <p class="subtitle">Parsed alerts seen in the last @HistoryWindowLabel, enriched with maintained computer inventory information.</p>
    </div>
    <div class="graph-summary" aria-label="@openCount open alerts and @historyCount parsed history alerts">
        <strong>@openCount</strong>
        <span>open</span>
        <strong>@historyCount</strong>
        <span>parsed history</span>
    </div>
</section>

<section class="graph-configuration" aria-label="Graph filters and layers">
    <div class="graph-filter">
        <label for="graph-filter-text">
            <span>Filter graph</span>
            <small>Subscription, resource group, site, or role</small>
        </label>
        <div class="graph-filter-input">
            <input id="graph-filter-text"
                   type="search"
                   placeholder="Type to filter the graph..."
                   autocomplete="off"
                   @bind="filterText"
                   @bind:event="oninput"
                   @bind:after="GraphFilterChanged" />
            @if (!string.IsNullOrWhiteSpace(filterText))
            {
                <button type="button" @onclick="ClearFilter" aria-label="Clear graph filter">Clear</button>
            }
        </div>
    </div>
    <div class="graph-layer-controls" aria-label="Graph layers">
        <label>
            <span>Layer 1</span>
            <select @bind="selectedLayer1" @bind:after="GraphLayersChanged">
                @foreach (var choice in AlertGraph.ChoicesForLevel(1))
                {
                    <option value="@choice.Value">@choice.Label</option>
                }
            </select>
        </label>
        <label>
            <span>Layer 2</span>
            <select @bind="selectedLayer2" @bind:after="GraphLayersChanged">
                @foreach (var choice in AlertGraph.ChoicesForLevel(2))
                {
                    <option value="@choice.Value">@choice.Label</option>
                }
            </select>
        </label>
        <label>
            <span>Layer 3</span>
            <select @bind="selectedLayer3" @bind:after="GraphLayersChanged">
                @foreach (var choice in AlertGraph.ChoicesForLevel(3))
                {
                    <option value="@choice.Value">@choice.Label</option>
                }
            </select>
        </label>
    </div>
</section>

<section class="graph-site-map" aria-labelledby="graph-site-map-heading">
    <div class="graph-site-map-heading">
        <div>
            <p class="eyebrow">Global sites</p>
            <h2 id="graph-site-map-heading">Site alert status</h2>
            <p>Open alerts across all graph data, independent of the hierarchy filter.</p>
        </div>
        <div class="graph-site-map-legend" aria-label="Site status legend">
            <span><i class="graph-site-map-healthy" aria-hidden="true"></i>No open alerts</span>
            <span><i class="graph-site-map-alert" aria-hidden="true"></i>Open alert</span>
            <span><i class="graph-site-map-day" aria-hidden="true"></i>Day</span>
            <span><i class="graph-site-map-twilight" aria-hidden="true"></i>Twilight</span>
            <span><i class="graph-site-map-night" aria-hidden="true"></i>Night</span>
        </div>
    </div>
    <div class="graph-site-map-frame">
        @if (easterEgg is not null)
        {
            <aside class="graph-offworld-sites graph-easter-egg-@easterEgg.Theme" aria-label="@easterEgg.AriaLabel">
                <span class="graph-offworld-heading">@easterEgg.Heading</span>
                <div class="graph-offworld-site-list">
                    @foreach (var site in easterEgg.Sites)
                    {
                        <div class="graph-offworld-site graph-offworld-site-@site.Tone @(site.IsDanger ? "graph-offworld-site-danger" : null)"
                             title="@(string.IsNullOrWhiteSpace(site.Status) ? site.Name : $"{site.Name} · {site.Status}")">
                            <i aria-hidden="true"></i>
                            <strong>@site.Name</strong>
                        </div>
                    }
                </div>
            </aside>
        }
        <svg class="graph-site-map-svg"
             viewBox="0 0 2756 1399"
             role="img"
             aria-label="World map showing alert status for @siteMarkers.Count configured sites">
            <image href="/world-map-configurable.svg"
                   x="0"
                   y="0"
                   width="2756"
                   height="1399"
                   preserveAspectRatio="xMidYMid meet" />
            <g class="graph-solar-overlay" aria-hidden="true">
                @foreach (var path in solarOverlay.Paths)
                {
                    <path class="@(path.Phase == AlertGraphSolarPhase.Night ? "graph-map-night" : "graph-map-twilight")"
                          d="@path.Data" />
                }
            </g>
            @foreach (var marker in siteMarkers)
            {
                <g class="graph-site-marker @(marker.HasOpenAlerts ? "graph-site-marker-alert" : "graph-site-marker-healthy")"
                   transform="translate(@Coordinate(marker.X) @Coordinate(marker.Y))"
                   role="group"
                   aria-label="@marker.Name, @marker.StatusLabel, @marker.SolarPhaseLabel">
                    <title>@marker.Name · @marker.StatusLabel · @marker.SolarPhaseLabel</title>
                    <circle class="graph-site-marker-pulse" r="31" aria-hidden="true" />
                    <circle class="graph-site-marker-point" r="18" aria-hidden="true" />
                    <text x="@Coordinate(marker.LabelOffsetX)"
                          y="@Coordinate(marker.LabelOffsetY)"
                          text-anchor="@marker.TextAnchor">@marker.Name</text>
                </g>
            }
        </svg>
    </div>
    <p class="graph-site-map-source">
        Map:
        <a href="https://commons.wikimedia.org/wiki/File:World_map_configurable.svg"
           target="_blank"
           rel="noopener noreferrer">World map configurable.svg</a>
        · Wikimedia Commons · CC0
    </p>
</section>

<section class="graph-region" aria-label="Alert hierarchy graph">
    <div class="graph-toolbar">
        <div class="graph-legend" aria-label="Count legend">
            <span><i class="legend-open" aria-hidden="true"></i>Open alerts</span>
            <span><i class="legend-history" aria-hidden="true"></i>History alerts</span>
            <span><i class="legend-target-current" aria-hidden="true"></i>Target current (heartbeat within @currentHeartbeatAge.TotalMinutes min)</span>
            <span><i class="legend-target-stale" aria-hidden="true"></i>Target stale (heartbeat older than @currentHeartbeatAge.TotalMinutes min or missing)</span>
            <span><i class="legend-target-service-health" aria-hidden="true"></i>Service health alert (service not running)</span>
            <span><i class="legend-target-maintenance" aria-hidden="true"></i>Target in maintenance</span>
            @if (graphLayout.Segments.Count > 0)
            {
                <span><i class="legend-dns-namespace" aria-hidden="true"></i>DNS namespace</span>
            }
            <span><i class="@LegendClass(selectedLayer1) legend-level-1" aria-hidden="true"></i>Layer 1: @AlertGraph.Label(selectedLayer1)</span>
            <span><i class="@LegendClass(selectedLayer2) legend-level-2" aria-hidden="true"></i>Layer 2: @AlertGraph.Label(selectedLayer2)</span>
            <span><i class="@LegendClass(selectedLayer3) legend-level-3" aria-hidden="true"></i>Layer 3: @AlertGraph.Label(selectedLayer3)</span>
        </div>
        <div class="graph-tools">
            <span>Updated @currentTimeUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
            <button type="button" title="Zoom out" aria-label="Zoom out" @onclick="() => ZoomAsync(1.25)">-</button>
            <button type="button" title="Reset graph view" @onclick="ResetGraphAsync">Reset</button>
            <button type="button" title="Zoom in" aria-label="Zoom in" @onclick="() => ZoomAsync(0.8)">+</button>
        </div>
    </div>

    <div class="graph-viewport">
        @if (navigationTree.Count == 0)
        {
            <div class="graph-empty">
                @if (string.IsNullOrWhiteSpace(filterText))
                {
                    <strong>No alert history available</strong>
                    <span>Nodes appear after an alert has been received.</span>
                }
                else
                {
                    <strong>No matching alert history</strong>
                    <span>Try another subscription, resource group, site, or role.</span>
                }
            </div>
        }
        <svg id="alert-graph-canvas"
             class="graph-svg"
             viewBox="0 0 @Coordinate(graphLayout.Width) @Coordinate(graphLayout.Height)"
             role="img"
             aria-label="Two-dimensional alert graph with @graphLayout.Nodes.Count nodes and @graphLayout.Edges.Count connections">
            <g class="graph-world">
                @if (graphLayout.Segments.Count > 0)
                {
                    <g class="graph-namespace-segments" aria-label="DNS namespace segments">
                        @foreach (var segment in graphLayout.Segments)
                        {
                            <g class="graph-namespace-segment" role="group" aria-label="DNS namespace @segment.Label">
                                <title>DNS namespace · @segment.Label</title>
                                <rect x="@Coordinate(segment.X)" y="@Coordinate(segment.Y)" width="@Coordinate(segment.Width)" height="@Coordinate(segment.Height)" rx="12" />
                                <text x="@Coordinate(segment.X + 18)" y="@Coordinate(segment.Y + 29)">DNS namespace · @segment.Label</text>
                            </g>
                        }
                    </g>
                }
                <g class="graph-edges" aria-hidden="true">
                    @foreach (var edge in graphLayout.Edges)
                    {
                        <line x1="@Coordinate(edge.X1)" y1="@Coordinate(edge.Y1)" x2="@Coordinate(edge.X2)" y2="@Coordinate(edge.Y2)" />
                    }
                </g>
                <g class="graph-nodes">
                    @foreach (var node in graphLayout.Nodes)
                    {
                        <g class="graph-svg-node graph-level-@node.Level @NodeClasses(node)"
                           transform="translate(@Coordinate(node.X) @Coordinate(node.Y))"
                           role="group"
                           aria-label="Layer @node.Level, @(node.Label + SubscriptionLabel(node)), @node.Count open, @node.HistoryCount history@(StatusAriaLabel(node))">
                            <title>Layer @node.Level · @(node.Label + SubscriptionLabel(node)): @node.Count open, @node.HistoryCount history@(StatusTitle(node))</title>
                            @if (node.Level == 1)
                            {
                                <polygon points="-95,0 -78,-25 78,-25 95,0 78,25 -78,25" />
                            }
                            else
                            {
                                <rect x="-95" y="-25" width="190" height="50" rx="@(node.Level == 3 ? 25 : 5)" />
                            }
                            <text class="graph-node-label" x="-82" y="-5">@ShortLabel(node.Label)</text>
                            @if (node.Layer == AlertGraphLayer.Target && !string.IsNullOrWhiteSpace(node.SubscriptionId))
                            {
                                <g>
                                    <text class="graph-node-subscription" x="-82" y="14">@ShortSubscription(node.SubscriptionId)</text>
                                </g>
                            }
                            <text class="graph-node-count" x="82" y="14" text-anchor="end">
                                <tspan class="graph-node-open">@node.Count</tspan><tspan> (@node.HistoryCount)</tspan>
                            </text>
                        </g>
                    }
                </g>
            </g>
        </svg>
    </div>
</section>

@code {
    private IReadOnlyList<AlertGraphRecord> alerts = [];
    private TimeSpan currentHeartbeatAge = AlertGraphTargetStatusResolver.CurrentThreshold;
    private DateTimeOffset currentTimeUtc = DateTimeOffset.UtcNow;
    private readonly CancellationTokenSource refreshCancellation = new();
    private readonly SemaphoreSlim reloadLock = new(1, 1);
    private Task? refreshTask;
    private bool graphNeedsInitialization = true;
    private bool graphInitialized;
    private string filterText = string.Empty;
    private AlertGraphLayer selectedLayer1 = AlertGraphLayer.Subscription;
    private AlertGraphLayer selectedLayer2 = AlertGraphLayer.ResourceGroup;
    private AlertGraphLayer selectedLayer3 = AlertGraphLayer.Target;
    private string HistoryWindowLabel => AlertHistory.Days == 1 ? "day" : $"{AlertHistory.Days} days";
    private IReadOnlyList<AlertGraphHierarchyNode> GetNavigationTree() =>
        AlertGraphHierarchy.Build(
            AlertGraphFilter.Apply(alerts, filterText),
            selectedLayer1,
            selectedLayer2,
            selectedLayer3);

    protected override async Task OnInitializedAsync()
    {
        selectedLayer1 = AlertGraph.DefaultLayer1;
        selectedLayer2 = AlertGraph.DefaultLayer2;
        selectedLayer3 = AlertGraph.DefaultLayer3;
        AlertStore.Changed += HandleStoreChanged;
        await ReloadAlertsAsync();
        refreshTask = RefreshClockAsync(refreshCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (graphNeedsInitialization)
        {
            graphNeedsInitialization = false;
            await JSRuntime.InvokeVoidAsync("alertGraph.initialize", "alert-graph-canvas");
            graphInitialized = true;
        }
    }

    private void HandleStoreChanged()
    {
        _ = ReloadAlertsAsync();
    }

    private async Task ReloadAlertsAsync()
    {
        await reloadLock.WaitAsync();
        try
        {
            currentTimeUtc = DateTimeOffset.UtcNow;
            currentHeartbeatAge = InventoryHeartbeatFreshnessRule.Resolve(await AlertStore.GetAllAlertRulesAsync());
            alerts = await AlertStore.GetAlertGraphRecordsAsync(AlertHistory.GetCutoff(currentTimeUtc));
            graphNeedsInitialization = true;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            reloadLock.Release();
        }
    }

    private async Task ZoomAsync(double factor) =>
        await JSRuntime.InvokeVoidAsync("alertGraph.zoom", "alert-graph-canvas", factor);

    private async Task ResetGraphAsync() =>
        await JSRuntime.InvokeVoidAsync("alertGraph.reset", "alert-graph-canvas");

    private void GraphLayersChanged()
    {
        graphNeedsInitialization = true;
    }

    private void GraphFilterChanged()
    {
        graphNeedsInitialization = true;
    }

    private void ClearFilter()
    {
        filterText = string.Empty;
        graphNeedsInitialization = true;
    }

    private async Task RefreshClockAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await ReloadAlertsAsync();
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private string NodeClasses(AlertGraphNode node)
    {
        var statusClass = AlertGraphTargetStatusResolver.Resolve(node, currentTimeUtc, currentHeartbeatAge) switch
        {
            AlertGraphTargetStatus.OpenAlert => "graph-svg-active",
            AlertGraphTargetStatus.ServiceHealthAlert => "graph-svg-target-service-health",
            AlertGraphTargetStatus.Current => "graph-svg-target-current",
            AlertGraphTargetStatus.Stale => "graph-svg-target-stale",
            AlertGraphTargetStatus.Maintenance => "graph-svg-target-maintenance",
            _ => string.Empty
        };
        return $"{NodeClass(node.Layer)} {statusClass}";
    }

    private string StatusAriaLabel(AlertGraphNode node) =>
        AlertGraphTargetStatusResolver.Resolve(node, currentTimeUtc, currentHeartbeatAge) switch
        {
            AlertGraphTargetStatus.OpenAlert => ", status open alert",
            AlertGraphTargetStatus.ServiceHealthAlert => ", status service health alert",
            AlertGraphTargetStatus.Current => ", status current",
            AlertGraphTargetStatus.Stale => ", status stale",
            AlertGraphTargetStatus.Maintenance => ", status Maintenance",
            _ => string.Empty
        };

    private string StatusTitle(AlertGraphNode node) => node.LastHeartbeatAt is null
        ? string.Empty
        : $", last heartbeat {node.LastHeartbeatAt.Value:yyyy-MM-dd HH:mm:ss} UTC";

    private static string NodeClass(AlertGraphLayer layer) => layer switch
    {
        AlertGraphLayer.Subscription => "graph-svg-subscription",
        AlertGraphLayer.AlertName => "graph-svg-alert-name",
        AlertGraphLayer.ResourceGroup => "graph-svg-resource-group",
        AlertGraphLayer.Domain => "graph-svg-resource-group",
        AlertGraphLayer.Role => "graph-svg-alert-name",
        _ => "graph-svg-target"
    };

    private static string SubscriptionLabel(AlertGraphNode node) =>
        node.Layer == AlertGraphLayer.Target ? $", subscription {node.SubscriptionId}" : string.Empty;

    private static string ShortSubscription(string value) =>
        value.Length <= 22 ? value : $"{value[..10]}...{value[^9..]}";

    private static string LegendClass(AlertGraphLayer layer) => layer switch
    {
        AlertGraphLayer.Subscription => "legend-subscription",
        AlertGraphLayer.AlertName => "legend-alert-name",
        AlertGraphLayer.ResourceGroup => "legend-resource-group",
        AlertGraphLayer.Domain => "legend-resource-group",
        AlertGraphLayer.Role => "legend-alert-name",
        _ => "legend-target"
    };

    private static string ShortLabel(string value)
    {
        var label = string.IsNullOrWhiteSpace(value) ? "-" : value;
        return label.Length <= 22 ? label : $"{label[..19]}...";
    }

    private static string Coordinate(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        AlertStore.Changed -= HandleStoreChanged;
        refreshCancellation.Cancel();
        if (refreshTask is not null)
        {
            await refreshTask;
        }
        refreshCancellation.Dispose();

        if (!graphInitialized)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("alertGraph.dispose", "alert-graph-canvas");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}