<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SQLAuth</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notes">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Notes
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="users">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Users
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized Context="authenticationState">
                <div class="nav-item px-3 text-light small">
                    Signed in as @authenticationState.User.Identity?.Name
                </div>
                <div class="nav-item px-3">
                    <form method="post" action="/auth/logout">
                        <AntiforgeryToken />
                        <button class="nav-link btn btn-link" type="submit">Sign out</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

