{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "workspaceId": {
        "type": "String",
        "defaultValue": ""
      },
      "webhookUrl": {
        "type": "String",
        "defaultValue": ""
      },
      "webhookAudience": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "triggers": {
      "When_an_Azure_Monitor_alert_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "schemaId": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "required": [
                  "alertContext"
                ],
                "properties": {
                  "essentials": {
                    "type": "object"
                  },
                  "alertContext": {
                    "type": "object",
                    "required": [
                      "condition"
                    ],
                    "properties": {
                      "condition": {
                        "type": "object",
                        "required": [
                          "allOf"
                        ],
                        "properties": {
                          "allOf": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "dimensions": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "name": {
                                        "type": "string"
                                      },
                                      "value": {
                                        "type": "string"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "Filter_SourceDSA_Dimension": {
        "type": "Query",
        "inputs": {
          "from": "@coalesce(triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['dimensions'], json('[]'))",
          "where": "@equals(toLower(string(item()?['name'])), 'sourcedsa')"
        },
        "runAfter": {}
      },
      "SourceDSA_Dimension_Found": {
        "type": "If",
        "expression": "@greater(length(body('Filter_SourceDSA_Dimension')), 0)",
        "actions": {
          "SourceDSA": {
            "type": "Compose",
            "inputs": "@trim(string(first(body('Filter_SourceDSA_Dimension'))?['value']))",
            "runAfter": {}
          },
          "SourceDSA_Value_Is_Safe": {
            "type": "If",
            "expression": "@and(not(empty(outputs('SourceDSA'))), not(equals(toUpper(outputs('SourceDSA')), '<EMPTY_VALUE>')), not(contains(outputs('SourceDSA'), decodeUriComponent('%22'))), not(contains(outputs('SourceDSA'), decodeUriComponent('%5C'))), not(contains(outputs('SourceDSA'), decodeUriComponent('%0A'))), not(contains(outputs('SourceDSA'), decodeUriComponent('%0D'))))",
            "actions": {
              "Run_Log_Analytics_Query": {
                "type": "Http",
                "inputs": {
                  "uri": "@concat('https://api.loganalytics.azure.com/v1/workspaces/', parameters('workspaceId'), '/query')",
                  "method": "POST",
                  "headers": {
                    "Content-Type": "application/json",
                    "Prefer": "wait=30"
                  },
                  "body": {
                    "query": "@concat('DCReplicationData_CL\n| where TimeGenerated > ago(1h)\n| where tostring(SourceDSA) =~ \"', outputs('SourceDSA'), '\"\n| summarize arg_max(TimeGenerated, *) by SourceDSA\n| where toint(NumberOfFailures) > 0\n| order by TimeGenerated desc')",
                    "timespan": "PT1H"
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "identity": "<user-assigned-managed-identity-resource-id>",
                    "audience": "https://api.loganalytics.io"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "minimumInterval": "PT5S",
                    "maximumInterval": "PT30S"
                  }
                },
                "runAfter": {}
              },
              "Forward_Alert_To_Webhook": {
                "type": "Http",
                "inputs": {
                  "uri": "@parameters('webhookUrl')",
                  "method": "POST",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "schemaId": "@triggerBody()?['schemaId']",
                    "data": "@triggerBody()?['data']",
                    "queryResult": {
                      "type": "Replication",
                      "sourceDSA": "@outputs('SourceDSA')",
                      "columns": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['columns'], json('[]'))",
                      "rows": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]'))",
                      "rowCount": "@length(coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]')))"
                    }
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "identity": "<user-assigned-managed-identity-resource-id>",
                    "audience": "@parameters('webhookAudience')"
                  },
                  "retryPolicy": {
                    "type": "exponential",
                    "count": 3,
                    "interval": "PT5S",
                    "minimumInterval": "PT5S",
                    "maximumInterval": "PT30S"
                  }
                },
                "runAfter": {
                  "Run_Log_Analytics_Query": [
                    "Succeeded"
                  ]
                }
              },
              "Return_Query_Result": {
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": 200,
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "sourceDSA": "@outputs('SourceDSA')",
                    "columns": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['columns'], json('[]'))",
                    "rows": "@coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]'))",
                    "rowCount": "@length(coalesce(body('Run_Log_Analytics_Query')?['tables']?[0]?['rows'], json('[]')))",
                    "webhookStatusCode": "@outputs('Forward_Alert_To_Webhook')?['statusCode']",
                    "webhookResponse": "@body('Forward_Alert_To_Webhook')",
                    "alert": "@triggerBody()"
                  }
                },
                "runAfter": {
                  "Forward_Alert_To_Webhook": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {
                "Return_Invalid_SourceDSA": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": {
                    "statusCode": 400,
                    "headers": {
                      "Content-Type": "application/json"
                    },
                    "body": {
                      "error": "The SourceDSA dimension is empty, contains a placeholder, or contains unsupported characters.",
                      "sourceDSA": "@outputs('SourceDSA')"
                    }
                  },
                  "runAfter": {}
                }
              }
            },
            "runAfter": {
              "SourceDSA": [
                "Succeeded"
              ]
            }
          }
        },
        "else": {
          "actions": {
            "Return_Missing_SourceDSA": {
              "type": "Response",
              "kind": "Http",
              "inputs": {
                "statusCode": 400,
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "error": "The alert payload does not contain a SourceDSA dimension at data.alertContext.condition.allOf[0].dimensions."
                }
              },
              "runAfter": {}
            }
          }
        },
        "runAfter": {
          "Filter_SourceDSA_Dimension": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "parameters": {
    "workspaceId": {
      "value": "<log-analytics-workspace-guid>"
    },
    "webhookUrl": {
      "value": "https://<app-service-name>.azurewebsites.net/api/alerts"
    },
    "webhookAudience": {
      "value": "api://<monitoring-api-client-id>"
    }
  }
}
