@baseUrl = https://localhost:7150/scim/v2
@scimToken = {{$processEnv SCIM_TOKEN}}
@userId = {{createUser.response.body.$.id}}
@scimGroupId = {{createGroup.response.body.$.id}}

### Capabilities
GET {{baseUrl}}/ServiceProviderConfig
Authorization: Bearer {{scimToken}}

### Resource types (Users and direct-member Groups)
GET {{baseUrl}}/ResourceTypes
Authorization: Bearer {{scimToken}}

###
GET {{baseUrl}}/ResourceTypes/User
Authorization: Bearer {{scimToken}}

### Supported schemas
GET {{baseUrl}}/Schemas
Authorization: Bearer {{scimToken}}

###
GET {{baseUrl}}/Schemas/urn:ietf:params:scim:schemas:core:2.0:User
Authorization: Bearer {{scimToken}}

### Matching before provisioning
GET {{baseUrl}}/Users?filter=externalId%20eq%20%2211111111-1111-1111-1111-111111111111%22&startIndex=1&count=100
Authorization: Bearer {{scimToken}}

### Create: replace the example externalId with the actual Entra Object ID
# @name createUser
POST {{baseUrl}}/Users
Authorization: Bearer {{scimToken}}
Content-Type: application/scim+json

{
  "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
  "externalId": "11111111-1111-1111-1111-111111111111",
  "userName": "provisioning-demo@contoso.test",
  "displayName": "Provisioning demo",
  "name": { "givenName": "First", "familyName": "Last" },
  "emails": [{ "type": "work", "primary": true, "value": "provisioning-demo@contoso.test" }],
  "active": true
}

### Read the resource (also returns ETag)
# @name readUser
GET {{baseUrl}}/Users/{{userId}}
Authorization: Bearer {{scimToken}}

### Full replacement: optional profile values omitted here are cleared
PUT {{baseUrl}}/Users/{{userId}}
Authorization: Bearer {{scimToken}}
Content-Type: application/scim+json

{
  "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
  "externalId": "11111111-1111-1111-1111-111111111111",
  "userName": "provisioning-demo@contoso.test",
  "active": true
}

### Atomic partial profile/status update
PATCH {{baseUrl}}/Users/{{userId}}
Authorization: Bearer {{scimToken}}
Content-Type: application/scim+json

{
  "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
  "Operations": [
    { "op": "replace", "path": "name.givenName", "value": "Updated" },
    { "op": "replace", "path": "emails[type eq \"work\"].value", "value": "updated@contoso.test" },
    { "op": "replace", "path": "active", "value": false }
  ]
}

### Missing resource: SCIM 404 response
GET {{baseUrl}}/Users/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{scimToken}}

### List source groups
GET {{baseUrl}}/Groups
Authorization: Bearer {{scimToken}}

### Group discovery
GET {{baseUrl}}/ResourceTypes/Group
Authorization: Bearer {{scimToken}}

###
GET {{baseUrl}}/Schemas/urn:ietf:params:scim:schemas:core:2.0:Group
Authorization: Bearer {{scimToken}}

### Match by stable Entra group Object ID
GET {{baseUrl}}/Groups?filter=externalId%20eq%20%2222222222-2222-2222-2222-222222222222%22&startIndex=1&count=100
Authorization: Bearer {{scimToken}}

### Create group; first create an undeleted User above, and use its SCIM id, not its Entra oid
# @name createGroup
POST {{baseUrl}}/Groups
Authorization: Bearer {{scimToken}}
Content-Type: application/scim+json

{
  "schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group"],
  "externalId": "22222222-2222-2222-2222-222222222222",
  "displayName": "Provisioning demo group",
  "members": [{"value": "{{userId}}", "type": "User"}]
}

### Read group and ETag
GET {{baseUrl}}/Groups/{{scimGroupId}}
Authorization: Bearer {{scimToken}}

### Incremental add; other members remain unchanged
PATCH {{baseUrl}}/Groups/{{scimGroupId}}
Authorization: Bearer {{scimToken}}
Content-Type: application/scim+json

{
  "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
  "Operations": [{"op": "add", "path": "members", "value": [{"value": "{{userId}}"}]}]
}

### Incremental remove; manual and other group team sources remain unchanged
PATCH {{baseUrl}}/Groups/{{scimGroupId}}
Authorization: Bearer {{scimToken}}
Content-Type: application/scim+json

{
  "schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
  "Operations": [{"op": "remove", "path": "members[value eq \"{{userId}}\"]"}]
}

### Full replacement explicitly clears the group's complete member set
PUT {{baseUrl}}/Groups/{{scimGroupId}}
Authorization: Bearer {{scimToken}}
Content-Type: application/scim+json

{
  "schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group"],
  "externalId": "22222222-2222-2222-2222-222222222222",
  "displayName": "Renamed demo group",
  "members": []
}

### Group tombstone; keep mappings and remove only this group's derived sources
DELETE {{baseUrl}}/Groups/{{scimGroupId}}
Authorization: Bearer {{scimToken}}

### User tombstone; remove SCIM group references, retain manual teams and app data
DELETE {{baseUrl}}/Users/{{userId}}
Authorization: Bearer {{scimToken}}
