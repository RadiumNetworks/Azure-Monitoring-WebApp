@page "/admin/rules"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "OperatorAccess")]
@inject AlertStore AlertStore

<PageTitle>Alert Rule Administration</PageTitle>

<section class="admin-heading">
    <div>
        <p class="eyebrow">Administration</p>
        <h1>Alert rules</h1>
        <p class="subtitle">Manage database rules that categorize or suppress inbox alerts, assign inventory roles, and configure global heartbeat freshness.</p>
    </div>
    <button class="admin-primary" type="button" @onclick="BeginCreate">Create rule</button>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="admin-message admin-message-success" role="status">@statusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}

<div class="admin-workspace">
    <section class="admin-rule-list" aria-labelledby="rules-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="rules-heading">Current rules</h2>
                <span>@RuleCountLabel(rules.Count)</span>
            </div>
            <button class="admin-secondary" type="button" disabled="@isLoading" @onclick="LoadRulesAsync">
                @(isLoading ? "Refreshing..." : "Refresh")
            </button>
        </div>

        @if (isLoading && rules.Count == 0)
        {
            <p class="admin-empty">Loading alert rules...</p>
        }
        else if (rules.Count == 0)
        {
            <p class="admin-empty">No alert rules are configured.</p>
        }
        else
        {
            <div class="admin-rule-cards">
                @foreach (var rule in rules)
                {
                    var isExpanded = IsExpanded(rule);
                    <article class="admin-rule-card collapsible-rule-card @(editingRule?.Id == rule.Id ? "selected" : null) @(isExpanded ? "expanded" : null)">
                        <button class="collapsible-card-toggle" type="button" aria-expanded="@isExpanded.ToString().ToLowerInvariant()" @onclick="() => ToggleExpanded(rule)">
                            <strong title="@rule.Name">@rule.Name</strong>
                            <span title="@RuleTypeLabel(rule)">@RuleTypeLabel(rule)</span>
                            <span class="collapsible-card-chevron" aria-hidden="true"></span>
                        </button>
                        @if (isExpanded)
                        {
                            <div class="collapsible-card-details">
                                <div class="collapsible-card-toolbar">
                                    <span class="admin-status @(rule.Enabled ? "enabled" : "disabled")">
                                        @(rule.Enabled ? "Enabled" : "Disabled")
                                    </span>
                                    <div class="admin-card-actions">
                                        <button class="admin-secondary" type="button" @onclick="() => BeginEdit(rule)">Edit</button>
                                        <button class="admin-danger" type="button" @onclick="() => BeginDelete(rule)">Delete</button>
                                    </div>
                                </div>
                                <dl class="admin-rule-summary">
                                    @if (rule.RuleType != AlertRuleTypes.InventoryHeartbeatFreshness)
                                    {
                                        <div><dt>Priority</dt><dd>@rule.Priority</dd></div>
                                    }
                                    <div><dt>Type</dt><dd>@RuleTypeLabel(rule)</dd></div>
                                    <div><dt>Condition</dt><dd>@ConditionLabel(rule)</dd></div>
                                    @if (rule.RuleType == AlertRuleTypes.Categorization)
                                    {
                                        <div><dt>Category</dt><dd>@rule.CategoryName</dd></div>
                                        <div><dt>Scope</dt><dd>@(rule.ApplyToTarget ? "All alerts for target" : "Matching alert only")</dd></div>
                                        <div><dt>Criticality</dt><dd>@(rule.IsCritical ? "Critical" : "Standard")</dd></div>
                                        <div><dt>Analysis classification</dt><dd>@AnalysisClassificationLabel(rule.AnalysisClassification)</dd></div>
                                    }
                                    else if (rule.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness)
                                    {
                                        <div><dt>Scope</dt><dd>All inventory targets</dd></div>
                                        <div><dt>Heartbeat freshness</dt><dd>@rule.Threshold minutes</dd></div>
                                        <div><dt>Default when disabled or deleted</dt><dd>@InventoryHeartbeatFreshnessRule.DefaultMinutes minutes</dd></div>
                                    }
                                    else if (rule.RuleType == AlertRuleTypes.InventoryRoleAssignment)
                                    {
                                        <div><dt>Inventory role</dt><dd>@rule.InventoryRole</dd></div>
                                    }
                                    else
                                    {
                                        <div><dt>Action</dt><dd>Update inventory without storing the alert</dd></div>
                                    }
                                </dl>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="admin-editor" aria-labelledby="editor-heading">
        @if (editingRule is null)
        {
            <div class="admin-editor-placeholder">
                <strong>Select or create a rule</strong>
                <span>Choose an existing rule to update it, or create a new alert rule.</span>
            </div>
        }
        else
        {
            var rule = editingRule;
            <div class="admin-section-heading">
                <div>
                    <p class="eyebrow">@(isCreating ? "New rule" : "Edit rule")</p>
                    <h2 id="editor-heading">@(isCreating ? "Create alert rule" : rule.Name)</h2>
                </div>
            </div>

            <form class="admin-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label class="admin-field admin-field-wide">
                    <span>Rule name</span>
                    <input required maxlength="256" @bind="rule.Name" />
                    <small>A unique name used to identify this rule.</small>
                </label>

                @if (rule.RuleType != AlertRuleTypes.InventoryHeartbeatFreshness)
                {
                <label class="admin-field">
                    <span>Priority</span>
                    <input type="number" min="0" required @bind="rule.Priority" />
                    <small>Lower values are evaluated first.</small>
                </label>
                }

                <label class="admin-check">
                    <input type="checkbox" @bind="rule.Enabled" />
                    <span>Rule enabled</span>
                </label>

                <label class="admin-field admin-field-wide">
                    <span>Rule type</span>
                    <select @bind="rule.RuleType" @bind:after="RuleTypeChanged">
                        <option value="@AlertRuleTypes.Categorization">Categorize inbox alerts</option>
                        <option value="@AlertRuleTypes.Suppression">Suppress from inbox after inventory update</option>
                        <option value="@AlertRuleTypes.InventoryStatus">Update inventory status without storing the alert</option>
                        <option value="@AlertRuleTypes.InventoryRoleAssignment">Assign computer inventory role</option>
                        <option value="@AlertRuleTypes.InventoryHeartbeatFreshness" disabled="@rules.Any(existing => existing.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness && existing.Id != rule.Id)">Inventory heartbeat freshness (global)</option>
                    </select>
                </label>

                @if (rule.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness)
                {
                    <fieldset class="admin-fieldset">
                        <legend>Global inventory heartbeat freshness</legend>
                        <label class="admin-field admin-field-wide">
                            <span>Heartbeat freshness limit (minutes)</span>
                            <input type="number" min="1" required @bind="rule.Threshold" />
                            <small>Applies to all targets without open alerts. Heartbeats up to this age are current (green); older or missing heartbeats are stale (yellow). Changes take effect immediately without a restart.</small>
                            <small>Only one global rule is allowed. Disabling or deleting it restores the default of @InventoryHeartbeatFreshnessRule.DefaultMinutes minutes.</small>
                        </label>
                    </fieldset>
                }
                else
                {
                <fieldset class="admin-fieldset">
                    <legend>Alert matching</legend>
                    <label class="admin-field">
                        <span>Alert name contains</span>
                        <input maxlength="256" @bind="rule.AlertNameContains" />
                        <small>Optional, case-insensitive text match.</small>
                    </label>
                    <label class="admin-field">
                        <span>Query-result type</span>
                        <input maxlength="128" @bind="rule.QueryResultType" />
                        <small>For example: DCPort or DCDiag. Leave empty to match only by alert name.</small>
                    </label>
                    @if (rule.RuleType != AlertRuleTypes.InventoryRoleAssignment)
                    {
                        <label class="admin-field admin-field-wide">
                            <span>Condition</span>
                            <select @bind="rule.ConditionType">
                                @if (rule.RuleType is AlertRuleTypes.Suppression or AlertRuleTypes.InventoryStatus)
                                {
                                    <option value="@AlertRuleConditionTypes.AnyMatchingAlert">Any alert matching the name and optional query type</option>
                                }
                                <option value="@AlertRuleConditionTypes.RowCountGreaterThan">Row count greater than threshold</option>
                                <option value="@AlertRuleConditionTypes.RowCountEquals">Row count equals threshold</option>
                                <option value="@AlertRuleConditionTypes.OnlyFailedItems">Only the specified items failed</option>
                                <option value="@AlertRuleConditionTypes.NoFailedItems">No failed items are shown</option>
                                @if (rule.RuleType == AlertRuleTypes.Categorization)
                                {
                                    <option value="@AlertRuleConditionTypes.DomainControllerPercentageInDomain">More than a percentage of DCs in a domain have alerts</option>
                                    <option value="@AlertRuleConditionTypes.AllDomainControllersInSite">All DCs in a site have alerts</option>
                                }
                            </select>
                        </label>
                        @if (rule.ConditionType is AlertRuleConditionTypes.RowCountGreaterThan or AlertRuleConditionTypes.RowCountEquals)
                        {
                            <label class="admin-field admin-field-wide">
                                <span>Row-count threshold</span>
                                <input type="number" min="0" required @bind="rule.Threshold" />
                                <small>@(rule.ConditionType == AlertRuleConditionTypes.RowCountEquals
                                    ? "The rule matches only when the result contains exactly this many rows. Use 0 for no failed DCPort checks."
                                    : "The rule matches only when the result contains more rows than this value.")</small>
                            </label>
                        }
                        else if (rule.ConditionType == AlertRuleConditionTypes.DomainControllerPercentageInDomain)
                        {
                            <label class="admin-field admin-field-wide">
                                <span>Domain-controller percentage</span>
                                <input type="number" min="0" max="100" required @bind="rule.Threshold" />
                                <small>The rule matches when the percentage of DCs with active alerts is strictly greater than this value.</small>
                            </label>
                        }
                        else if (rule.ConditionType == AlertRuleConditionTypes.OnlyFailedItems)
                        {
                            <label class="admin-field admin-field-wide">
                                <span>Failed item names</span>
                                <input required maxlength="256" @bind="rule.FailedItemName" />
                                <small>Comma-separated. The rule matches when one or more of these items failed and no other item failed.</small>
                            </label>
                        }
                    }
                    else
                    {
                        <label class="admin-field admin-field-wide">
                            <span>Inventory role</span>
                            <input required maxlength="256" @bind="rule.InventoryRole" />
                            <small>The matching alert assigns this role to its target computer.</small>
                        </label>
                    }
                </fieldset>
                }

                @if (rule.RuleType == AlertRuleTypes.Categorization)
                {
                    <fieldset class="admin-fieldset">
                    <legend>Category presentation</legend>
                    <label class="admin-field admin-field-wide">
                        <span>Category name</span>
                        <input required maxlength="256" @bind="rule.CategoryName" />
                    </label>
                    <label class="admin-field">
                        <span>Tone</span>
                        <select @bind="rule.Tone">
                            <option value="info">Information</option>
                            <option value="failure">Failure</option>
                        </select>
                    </label>
                    <label class="admin-field">
                        <span>Analysis classification</span>
                        <select @bind="rule.AnalysisClassification">
                            <option value="@AlertRuleAnalysisClassifications.None">Standard categorization</option>
                            <option value="@AlertRuleAnalysisClassifications.SystemOutage">System outage</option>
                            <option value="@AlertRuleAnalysisClassifications.Suppressed">Stored suppressed evidence</option>
                        </select>
                        <small>Stable meaning used by analysis independently of the editable category name.</small>
                    </label>
                    <div class="admin-check-group">
                        <label class="admin-check">
                            <input type="checkbox" @bind="rule.Collapsed" />
                            <span>Collapsed by default</span>
                        </label>
                        <label class="admin-check">
                            <input type="checkbox" @bind="rule.ApplyToTarget" />
                            <span>Include all alerts for the target</span>
                        </label>
                        <label class="admin-check">
                            <input type="checkbox" @bind="rule.IsCritical" />
                            <span>Mark matching alert lifecycle as critical</span>
                        </label>
                    </div>
                    </fieldset>
                }

                <div class="admin-form-actions">
                    <button class="admin-secondary" type="button" disabled="@isSaving" @onclick="CancelEdit">Cancel</button>
                    <button class="admin-primary" type="submit" disabled="@isSaving">
                        @(isSaving ? "Saving..." : isCreating ? "Create rule" : "Save changes")
                    </button>
                </div>
            </form>
        }
    </section>
</div>

@if (ruleToDelete is not null)
{
    <div class="admin-dialog-backdrop" role="presentation">
        <section class="admin-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-rule-heading">
            <p class="eyebrow">Permanent action</p>
            <h2 id="delete-rule-heading">Delete alert rule?</h2>
            <p>
                Delete <strong>@ruleToDelete.Name</strong>?
                @(ruleToDelete.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness
                    ? $"All targets will use the default heartbeat freshness limit of {InventoryHeartbeatFreshnessRule.DefaultMinutes} minutes."
                    : ruleToDelete.RuleType == AlertRuleTypes.InventoryRoleAssignment
                    ? "Matching alerts will no longer assign the inventory role."
                    : ruleToDelete.RuleType == AlertRuleTypes.Suppression
                        ? "Future matching alerts will be stored and shown in the inbox again."
                        : $"Alerts assigned by this rule will no longer be placed in the {ruleToDelete.CategoryName} category.")
            </p>
            <div class="admin-form-actions">
                <button class="admin-secondary" type="button" disabled="@isDeleting" @onclick="CancelDelete">Cancel</button>
                <button class="admin-danger" type="button" disabled="@isDeleting" @onclick="DeleteAsync">
                    @(isDeleting ? "Deleting..." : "Delete rule")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private IReadOnlyList<AlertRule> rules = [];
    private readonly HashSet<Guid> expandedRules = [];
    private AlertRule? editingRule;
    private AlertRule? ruleToDelete;
    private bool isCreating;
    private bool isLoading;
    private bool isSaving;
    private bool isDeleting;
    private string? statusMessage;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadRulesAsync();

    private async Task LoadRulesAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            rules = await AlertStore.GetAllAlertRulesAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BeginCreate()
    {
        editingRule = new AlertRule
        {
            Enabled = true,
            Priority = rules.Count == 0 ? 10 : rules.Max(rule => rule.Priority) + 10,
            RuleType = AlertRuleTypes.Categorization,
            ConditionType = AlertRuleConditionTypes.RowCountGreaterThan,
            Collapsed = true,
            Tone = "info"
        };
        isCreating = true;
        statusMessage = null;
        errorMessage = null;
    }

    private void BeginEdit(AlertRule source)
    {
        editingRule = Clone(source);
        isCreating = false;
        statusMessage = null;
        errorMessage = null;
    }

    private void RuleTypeChanged()
    {
        if (editingRule?.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness)
        {
            editingRule.Threshold = InventoryHeartbeatFreshnessRule.DefaultMinutes;
        }
    }

    private bool IsExpanded(AlertRule rule) => expandedRules.Contains(rule.Id);

    private void ToggleExpanded(AlertRule rule)
    {
        if (!expandedRules.Add(rule.Id))
        {
            expandedRules.Remove(rule.Id);
        }
    }

    private void CancelEdit()
    {
        editingRule = null;
        isCreating = false;
        errorMessage = null;
    }

    private void BeginDelete(AlertRule source)
    {
        ruleToDelete = Clone(source);
        statusMessage = null;
        errorMessage = null;
    }

    private void CancelDelete() => ruleToDelete = null;

    private async Task DeleteAsync()
    {
        if (ruleToDelete is null || isDeleting)
        {
            return;
        }

        isDeleting = true;
        statusMessage = null;
        errorMessage = null;
        var deletedRule = ruleToDelete;
        try
        {
            var deleted = await AlertStore.DeleteAlertRuleAsync(deletedRule.Id);
            if (!deleted)
            {
                errorMessage = "The alert rule no longer exists.";
                return;
            }

            if (editingRule?.Id == deletedRule.Id)
            {
                editingRule = null;
                isCreating = false;
            }

            ruleToDelete = null;
            statusMessage = $"Rule '{deletedRule.Name}' was deleted.";
            await LoadRulesAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task SaveAsync()
    {
        if (editingRule is null || isSaving)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            var saved = await AlertStore.SaveAlertRuleAsync(editingRule);
            statusMessage = $"Rule '{saved.Name}' was {(isCreating ? "created" : "updated")}.";
            editingRule = null;
            isCreating = false;
            await LoadRulesAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private static AlertRule Clone(AlertRule source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Enabled = source.Enabled,
        Priority = source.Priority,
        RuleType = source.RuleType,
        AlertNameContains = source.AlertNameContains,
        QueryResultType = source.QueryResultType,
        ConditionType = source.ConditionType,
        Threshold = source.Threshold,
        FailedItemName = source.FailedItemName,
        CategoryName = source.CategoryName,
        ApplyToTarget = source.ApplyToTarget,
        Collapsed = source.Collapsed,
        Tone = source.Tone,
        InventoryRole = source.InventoryRole,
        IsCritical = source.IsCritical,
        AnalysisClassification = source.AnalysisClassification
    };

    private static string ConditionLabel(AlertRule rule) => rule.RuleType == AlertRuleTypes.InventoryHeartbeatFreshness
        ? $"Heartbeat older than {rule.Threshold} minutes or missing"
        : rule.RuleType == AlertRuleTypes.InventoryRoleAssignment
        ? $"{(string.IsNullOrWhiteSpace(rule.QueryResultType) ? "Matching alert" : rule.QueryResultType)} → {rule.InventoryRole}"
        : rule.ConditionType switch
    {
        AlertRuleConditionTypes.AnyMatchingAlert => "Any matching alert",
        AlertRuleConditionTypes.RowCountGreaterThan => $"More than {rule.Threshold} rows",
        AlertRuleConditionTypes.RowCountEquals => $"Exactly {rule.Threshold} rows",
        AlertRuleConditionTypes.OnlyFailedItems => $"Only {rule.FailedItemName} failed",
        AlertRuleConditionTypes.NoFailedItems => "No failed items shown",
        AlertRuleConditionTypes.DomainControllerPercentageInDomain => $"More than {rule.Threshold}% of DCs in domain have alerts",
        AlertRuleConditionTypes.AllDomainControllersInSite => "All DCs in site have alerts",
        _ => rule.ConditionType
    };

    private static string RuleTypeLabel(AlertRule rule) => rule.RuleType switch
    {
        AlertRuleTypes.InventoryHeartbeatFreshness => "Inventory heartbeat freshness",
        AlertRuleTypes.InventoryRoleAssignment => "Inventory role",
        AlertRuleTypes.InventoryStatus => "Inventory status",
        AlertRuleTypes.Suppression => "Inbox suppression",
        _ => "Categorization"
    };

    private static string AnalysisClassificationLabel(string value) => value switch
    {
        AlertRuleAnalysisClassifications.SystemOutage => "System outage",
        AlertRuleAnalysisClassifications.Suppressed => "Stored suppressed evidence",
        _ => "Standard categorization"
    };

    private static string RuleCountLabel(int count) => count == 1 ? "1 configured rule" : $"{count} configured rules";
}
