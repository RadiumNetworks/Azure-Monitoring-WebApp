@inherits LayoutComponentBase
@inject ApplicationAuthenticationOptions AuthenticationOptions

<header class="app-header">
    <div class="header-inner">
        <a class="brand" href="/" aria-label="Alert Console home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>Alert Console</span>
        </a>
        <div class="header-actions">
            <nav class="view-navigation" aria-label="Primary navigation">
                <div class="navigation-group">
                    <button type="button" class="navigation-group-toggle" aria-haspopup="true">Analyze</button>
                    <div class="navigation-submenu">
                        <NavLink href="/" Match="NavLinkMatch.All">Inbox</NavLink>
                        <NavLink href="/graph">Graph</NavLink>
                        <NavLink href="/queries">Queries</NavLink>
                        <NavLink href="/logbook">Logbook</NavLink>
                        <NavLink href="/prompt">Copilot Prompt</NavLink>
                    </div>
                </div>
                <AuthorizeView Policy="OperatorAccess">
                    <div class="navigation-group">
                        <button type="button" class="navigation-group-toggle" aria-haspopup="true">Configuration</button>
                        <div class="navigation-submenu">
                            <NavLink href="/admin/rules">Rules</NavLink>
                            <NavLink href="/admin/inventory">Inventory</NavLink>
                        </div>
                    </div>
                </AuthorizeView>
                <AuthorizeView Policy="AdminAccess">
                    <div class="navigation-group">
                        <button type="button" class="navigation-group-toggle" aria-haspopup="true">Admin</button>
                        <div class="navigation-submenu">
                            <NavLink href="/admin/settings">Settings</NavLink>
                            <NavLink href="/admin/users">Users</NavLink>
                        </div>
                    </div>
                </AuthorizeView>
            </nav>
            @if (AuthenticationOptions.IsSql)
            {
                <form method="post" action="/auth/logout" class="logout-form">
                    <AntiforgeryToken />
                    <button type="submit">Sign out</button>
                </form>
            }
            <span class="environment">Azure Monitor</span>
        </div>
    </div>
</header>

<main>@Body</main>