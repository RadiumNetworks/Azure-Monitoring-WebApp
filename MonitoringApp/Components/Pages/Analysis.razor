@page "/analysis"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@attribute [Authorize(Policy = "OperatorAccess")]
@inject AnalysisQueryRegistry Registry
@inject AnalysisQueryExecutionService Execution
@inject AnalysisQueryRunner QueryRunner
@inject AlertStore AlertStore
@inject CrossTenantLogAnalyticsOptions Options
@inject DashboardFilterOptions FilterDefaults
@inject ApplicationAuthenticationOptions AuthenticationOptions
@inject CurrentUserIdentity CurrentUserIdentity
@inject AnalysisDashboardState Dashboard
@inject AnalysisDashboardRepository DashboardRepository
@inject AnalysisDashboardPublishing Publishing
@inject IJSRuntime JS
@inject UiText Text
@inject QueryTextPresentation QueryText
@inject ILogger<Analysis> Logger

<PageTitle>@Text["Navigation.Dashboards"]</PageTitle>

@if (dashboardBrowserError is not null)
{
    <div class="admin-message admin-message-error" role="alert">
        <p>@dashboardBrowserError</p>
        <button type="button" disabled="@isInitializingBrowser" @onclick="RetryDashboardBrowserAsync">@Text["Analysis.Browser.Retry"]</button>
    </div>
}

<section class="query-heading analysis-page-heading" data-language-dirty="@((Dashboard.CanUndo || Dashboard.CanRedo || (UsesInventoryRoles && selectedInventoryRoles.Count == 0)) ? "true" : "false")">
    <div>
        <p class="eyebrow">@Text["Analysis.Eyebrow"]</p>
        <h1>@Text["Navigation.Dashboards"]</h1>
        <p class="subtitle">@Text["Analysis.Description"]</p>
    </div>
    <label class="inbox-edit-toggle">
        <input type="checkbox" disabled="@DashboardBusy" @bind="editMode" @bind:after="EditModeChangedAsync" />
        <span>@Text["Common.Edit"]</span>
    </label>
    @if (editMode)
    {
    <div class="admin-heading-actions analysis-personal-actions" hidden="@(selectedPublishedDashboard is not null)">
        <label class="inbox-edit-toggle"><input type="checkbox" disabled="@PersonalActionsBlocked" @bind="dashboardEditMode" /><span>@Text["Analysis.EditGrid"]</span></label>
        <label class="inbox-edit-toggle">
            <input type="checkbox" checked="@Dashboard.Document.AutoRefreshEnabled" disabled="@(!Options.Enabled || PersonalActionsBlocked)"
                   @onchange="AutoRefreshChangedAsync" />
            <span>@Text["Analysis.AutoRefresh"]</span>
        </label>
        <button class="admin-primary" type="button" disabled="@(!CanRunDashboard)" @onclick="RunDashboardAsync">
            @(isDashboardRunning ? Text["Analysis.RunningDashboard"] : Text["Analysis.RunDashboard"])
        </button>
        <button class="admin-secondary" type="button" disabled="@(!Dashboard.CanUndo || DashboardBusy)" @onclick="UndoDashboard">@Text["Common.Undo"]</button>
        <button class="admin-secondary" type="button" disabled="@(!Dashboard.CanRedo || DashboardBusy)" @onclick="RedoDashboard">@Text["Common.Redo"]</button>
        <button class="admin-primary" type="button" disabled="@PersonalActionsBlocked" @onclick="SaveDashboardAsync">@Text["Analysis.SaveDashboard"]</button>
    </div>
    }
</section>

@if (editMode && selectedPublishedDashboard is null)
{
    <details class="admin-rule-card analysis-setup-transfer">
        <summary>@Text["DashboardSetup.Title"]</summary>
        <p>@Text["DashboardSetup.Help"]</p>
        @if (setupTransferError is not null)
        {
            <p class="admin-message admin-message-error" role="alert">@setupTransferError</p>
        }
        @if (setupTransferStatus is not null)
        {
            <p class="admin-message" role="status">@setupTransferStatus</p>
        }
        @if (setupAwaitingExecution)
        {
            <p class="admin-message admin-message-warning" role="status">@Text["DashboardSetup.ExecutionPending"]</p>
        }
        <button class="admin-secondary" type="button" disabled="@(DashboardBusy || PersonalActionsBlocked)"
                @onclick="ExportDashboardSetupAsync">@Text["DashboardSetup.Export"]</button>
        @if (setupExportJson is not null)
        {
            <a class="admin-secondary" download="dashboard-setup.json"
               href="@("data:application/json;charset=utf-8;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(setupExportJson)))">
                @Text["DashboardSetup.Download"]
            </a>
        }
        <label class="admin-field">
            <span>@Text["DashboardSetup.File"]</span>
            <InputFile accept=".json,application/json" disabled="@(DashboardBusy || PersonalActionsBlocked)"
                       OnChange="ReadDashboardSetupFileAsync" />
        </label>
        <label class="admin-field">
            <span>@Text["DashboardSetup.Json"]</span>
            <textarea rows="8" maxlength="@AnalysisDashboardSetupJson.MaxBytes" spellcheck="false"
                      disabled="@(DashboardBusy || PersonalActionsBlocked)" @bind="setupImportJson"
                      @bind:after="ClearSetupPreview"></textarea>
        </label>
        <button class="admin-secondary" type="button" disabled="@(DashboardBusy || PersonalActionsBlocked)"
                @onclick="PreviewDashboardSetupAsync">@Text["DashboardSetup.Preview"]</button>
        @if (pendingSetup is not null)
        {
            <h3>@Text.Format("DashboardSetup.Summary", pendingSetup.Name, pendingSetup.Widgets.Count,
                pendingSetup.Columns, pendingSetup.Rows)</h3>
            <label class="admin-field">
                <span>@Text["DashboardSetup.TargetWorkspace"]</span>
                <select value="@(setupImportWorkspace ?? "__select__")" disabled="@DashboardBusy" @onchange="SetupWorkspaceChangedAsync">
                    @if (setupImportWorkspace is null)
                    {
                        <option value="__select__" disabled>@Text["DashboardSetup.SelectWorkspace"]</option>
                    }
                    <option value="">@Text["Filters.AllWorkspaces"]</option>
                    @foreach (var workspace in Options.Workspaces.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@workspace.Key">@workspace.DisplayName</option>
                    }
                </select>
            </label>
            <p>@Text["DashboardSetup.PrivateImport"]</p>
            @if (setupPreview is not null)
            {
            @if (setupPreview.WorkspaceUnavailable)
            {
                <p class="admin-message admin-message-warning" role="status">@Text.Format("DashboardSetup.WorkspaceUnavailable", pendingSetup.Filters.WorkspaceKey)</p>
            }
            @if (setupPreview.UnavailableQueries.Count > 0)
            {
                <p class="admin-message admin-message-warning" role="status">@Text["DashboardSetup.UnavailableQueries"]</p>
                <ul>@foreach (var key in setupPreview.UnavailableQueries) { <li><code>@key</code></li> }</ul>
            }
            @if (setupPreview.HasInventoryWarnings)
            {
                <p class="admin-message admin-message-warning" role="status">@Text["DashboardSetup.InventoryWarnings"]</p>
                <ul>
                    @foreach (var system in setupPreview.MissingSystems) { <li>@system.Computer · @system.SubscriptionId</li> }
                    @foreach (var role in setupPreview.EmptyRoles) { <li>@role</li> }
                </ul>
                <label class="inbox-edit-toggle">
                    <input type="checkbox" disabled="@DashboardBusy" @bind="setupAcknowledgeInventory" />
                    <span>@Text["DashboardSetup.AcknowledgeInventory"]</span>
                </label>
            }
            }
            @if (HasUnsavedSetupChanges)
            {
                <p class="admin-message admin-message-warning" role="status">@Text["DashboardSetup.UnsavedChanges"]</p>
            }
            <button class="admin-primary" type="button"
                    disabled="@(DashboardBusy || PersonalActionsBlocked || setupPreview is null || !setupPreview.CanImport || HasUnsavedSetupChanges ||
                        (setupPreview.HasInventoryWarnings && !setupAcknowledgeInventory))"
                    @onclick="ImportDashboardSetupAsync">@Text["DashboardSetup.Import"]</button>
        }
    </details>
}

<section class="@(UsesRoleFilters ? "analysis-controls analysis-role-filters" : "analysis-controls")" aria-label="@Text["Analysis.FiltersLabel"]">
    <label>
        <span>@Text["Filters.Workspace"]</span>
        <select disabled="@DashboardBusy" @bind="workspaceFilter" @bind:after="WorkspaceChangedAsync">
            <option value="">@Text["Filters.AllWorkspaces"]</option>
            @foreach (var workspace in Options.Workspaces.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase))
            {
                <option value="@workspace.Key">@workspace.DisplayName</option>
            }
        </select>
    </label>
    @if (!UsesRoleFilters)
    {
    <label>
        <span>@Text["Filters.Domain"]</span>
        <select disabled="@DashboardBusy" @bind="domainFilter" @bind:after="DomainChangedAsync">
            <option value="">@Text["Filters.AllDomains"]</option>
            @foreach (var domain in AvailableDomains)
            {
                <option value="@domain.Value">@domain.Label</option>
            }
        </select>
    </label>
    <label>
        <span>@Text["Filters.Site"]</span>
        <select disabled="@DashboardBusy" @bind="siteFilter" @bind:after="SiteChangedAsync">
            <option value="">@Text["Filters.AllSites"]</option>
            @foreach (var site in FilteredByDomain.Select(item => item.Site).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Order())
            {
                <option value="@site">@site</option>
            }
        </select>
    </label>
    <label>
        <span>@Text["Filters.Role"]</span>
        <select disabled="@DashboardBusy" @bind="roleFilter" @bind:after="DashboardFiltersChangedAsync">
            <option value="">@Text["Filters.AllRoles"]</option>
            @foreach (var role in FilteredBySite.Select(item => item.Role).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase).Order())
            {
                <option value="@role">@role</option>
            }
        </select>
    </label>
    }
    else
    {
        <p role="status">@Text["Analysis.RoleSelection.FiltersHelp"]</p>
    }
</section>

<section class="analysis-dashboard-tabs" aria-label="@Text["AnalysisPublications.SharedDashboards"]">
    <div class="admin-heading-actions">
        <button class="admin-secondary" type="button" disabled="@DashboardBusy" @onclick="ReturnToPersonalDashboard">@Text["AnalysisPublications.MyDashboards"]</button>
        @if (selectedPublishedDashboard is null &&
            (dashboardOwners.Count > 1 || !dashboardOwnerKey.Equals(dashboardActorKey, StringComparison.OrdinalIgnoreCase)))
        {
            <label class="analysis-dashboard-owner">
                <span>@Text["AnalysisDashboards.Owner"]</span>
                <select value="@dashboardOwnerKey" disabled="@DashboardBusy" @onchange="ChangeDashboardOwnerAsync">
                    @if (!dashboardOwners.Any(owner => owner.OwnerKey.Equals(dashboardOwnerKey, StringComparison.OrdinalIgnoreCase)))
                    {
                        <option value="@dashboardOwnerKey" disabled>@Text.Format("AnalysisDashboards.UnavailableOwner", dashboardOwnerKey)</option>
                    }
                    @foreach (var owner in dashboardOwners)
                    {
                        <option value="@owner.OwnerKey">@(owner.OwnerKey.Equals(dashboardActorKey, StringComparison.OrdinalIgnoreCase)
                            ? Text.Format("AnalysisDashboards.OwnCollection", owner.DisplayName ?? owner.OwnerKey)
                            : owner.DisplayName ?? owner.OwnerKey)</option>
                    }
                </select>
            </label>
            <p>@Text["AnalysisDashboards.AliasHelp"]</p>
        }
        <button class="admin-secondary" type="button" disabled="@DashboardBusy" @onclick="DuplicateDashboardAsync">@Text["AnalysisPublications.Duplicate"]</button>
        @if (editMode)
        {
            <button class="admin-secondary" type="button" disabled="@DashboardBusy" @onclick="ReloadPublicationsAsync">@Text["AnalysisPublications.Refresh"]</button>
        }
        @foreach (var publication in publishedDashboards)
        {
            <button class="@(selectedPublishedDashboard == publication.Id ? "admin-primary" : "admin-secondary")"
                    type="button" disabled="@DashboardBusy" @onclick="() => OpenPublishedDashboardAsync(publication.Id)">
                @Text.Format("AnalysisPublications.Tab", publication.Name, publication.Version)
            </button>
        }
    </div>
    @if (editMode && canPublishDashboard && selectedPublishedDashboard is null)
    {
        <div class="admin-heading-actions">
            <button class="admin-primary" type="button" disabled="@(DashboardBusy || (UsesInventoryRoles && !HasSelectionRule))" @onclick="PublishDashboardAsync">
                @(OwnPublication is null ? Text["AnalysisPublications.Publish"] : Text["AnalysisPublications.Update"])
            </button>
            @if (OwnPublication is not null)
            {
                <span>@Text.Format("AnalysisPublications.OwnNotice", OwnPublication.Version)</span>
                <button class="admin-danger" type="button" disabled="@DashboardBusy" @onclick="() => confirmWithdrawDashboard = true">@Text["AnalysisPublications.Withdraw"]</button>
            }
        </div>
        @if (confirmWithdrawDashboard)
        {
            <div class="admin-message admin-message-warning" role="alertdialog" aria-label="@Text["AnalysisPublications.Withdraw"]">
                <p>@Text["AnalysisPublications.WithdrawQuestion"]</p>
                <button class="admin-secondary" type="button" disabled="@DashboardBusy" @onclick="() => confirmWithdrawDashboard = false">@Text["Common.Cancel"]</button>
                <button class="admin-danger" type="button" disabled="@DashboardBusy" @onclick="WithdrawDashboardAsync">@Text["AnalysisPublications.ConfirmWithdrawal"]</button>
            </div>
        }
    }
    @if (publicationMessage is not null)
    {
        <p role="status">@publicationMessage</p>
    }
    @if (publicationError is not null)
    {
        <div class="admin-message admin-message-error" role="alert">@publicationError</div>
    }
</section>
@if (selectedPublishedDashboard is Guid publishedId)
{
    <PublishedAnalysisDashboardView @key="(publishedId, workspaceFilter, domainFilter, siteFilter, roleFilter)" DashboardId="publishedId"
        WorkspaceKey="@workspaceFilter" Domain="@domainFilter" Site="@siteFilter" Role="@roleFilter"
        FilteredSystems="@VisibleSystems.ToArray()"
        InventoryRolesChanged="@(usesRoles => PublishedSelectionModeChanged(publishedId, usesRoles))"
        ShowControls="@editMode" AutoRunOnOpen="@(!editMode || runPublishedOnFilterChange)" />
}
<div class="analysis-personal-dashboard" hidden="@(selectedPublishedDashboard is not null)">
<AnalysisDashboardInventoryNotice MissingSystems="missingDashboardSystems"
    AllMissing="@(missingDashboardSystems.Count > 0 && missingDashboardSystems.Count == Dashboard.Document.Systems.Count)" />
@if (editMode)
{
    <p class="inbox-save-status" role="status"><i></i>@(dashboardStatus ?? Text["AnalysisStatus.NotSaved"])</p>
}
<AnalysisDashboardTabs Collection="dashboardCollection" Disabled="@DashboardBusy" EditMode="@editMode"
    Selected="SelectDashboardAsync" Created="CreateDashboardAsync" Renamed="RenameDashboardAsync" Deleted="DeleteDashboardAsync" />
@if (editMode)
{
<AnalysisDashboardExecutionControls TimeRangeMinutes="Dashboard.Document.TimeRangeMinutesOverride"
    BinMinutes="Dashboard.Document.BinMinutesOverride" Disabled="@(DashboardBusy || PersonalActionsBlocked)"
    Changed="DashboardExecutionSettingsChangedAsync" />
}
<fieldset class="analysis-dashboard-content" disabled="@PersonalActionsBlocked">
@if (CanEditGrid)
{
    <AnalysisGridControls Document="Dashboard.Document" Disabled="@(DashboardBusy || PersonalActionsBlocked)" SizeChanged="ResizeGridAsync" />
}

@if (!Options.Enabled)
{
    <div class="admin-message admin-message-warning">
        <strong>@Text["Analysis.Disabled"]</strong>
        @Text["Analysis.EnableHint"]
    </div>
}
@if (dashboardLoadFailed)
{
    <div class="admin-message admin-message-error" role="alert">
        <span>@Text["Analysis.Errors.WorkspaceLoadFailed"]</span>
        <button type="button" @onclick="LoadWorkspaceAsync" disabled="@DashboardBusy">@Text["Common.Refresh"]</button>
    </div>
}
@if (publicationLoadError is not null)
{
    <div class="admin-message admin-message-error" role="alert">@publicationLoadError</div>
}
@if (libraryLoadError is not null)
{
    <div class="admin-message admin-message-error" role="alert">@libraryLoadError</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="admin-message admin-message-error" role="alert">@errorMessage</div>
}

@if (editMode)
{
<section class="analysis-controls" aria-label="@Text["Analysis.QueryControlsLabel"]">
    <label>
        <span>@Text["Analysis.PublishedQuery"]</span>
        <select @bind="selectedQueryId" @bind:after="QueryChanged">
            <option value="@Guid.Empty">@Text["Analysis.SelectQuery"]</option>
            @foreach (var query in VisibleLibraryQueries)
            {
                <option value="@query.Id">@Text.Format(query.Scope == AnalysisQueryScopes.Workspace ? "Analysis.WorkspaceQueryOption" : "Analysis.QueryOption", query.Category, QueryText.Name(query), query.Version)</option>
            }
            @if (SelectedQuery is { } openedQuery && Dashboard.Document.HiddenQueryIds.Contains(openedQuery.Id))
            {
                <option value="@openedQuery.Id">@Text.Format("Analysis.OpenedQueryOption", QueryText.Name(openedQuery))</option>
            }
        </select>
    </label>
    @if (SelectedQuery?.Scope == AnalysisQueryScopes.Workspace)
    {
        <div class="admin-message admin-message-warning" role="status">
            @Text[UsesInventoryRoles ? "Analysis.RoleSelection.WorkspaceWide" : "Analysis.WorkspaceQueryHelp"]
        </div>
    }
    <AnalysisExecutionSelections @bind-TimeRangeMinutes="timeRangeMinutes" @bind-BinMinutes="binMinutes"
        @bind-GroupBy="groupBy" MaxTimeRangeMinutes="@(SelectedQuery?.MaxTimeRangeMinutes ?? 43200)"
        ShowGrouping="@(SelectedQuery?.Kql.Contains("_GroupBy", StringComparison.Ordinal) == true)"
        Disabled="@(isRunning || isDashboardRunning)" Changed="SelectionsChanged" />
    <button class="admin-primary" type="button" disabled="@(!CanRun)" @onclick="RunAsync">
        @(isRunning ? Text["Analysis.RunningQuery"] : Text["Analysis.RunQuery"])
    </button>
    @if (openedWidgetId is not null && SelectedQuery is not null)
    {
        <button class="admin-secondary" type="button" disabled="@(isRunning || isDashboardRunning)" @onclick="ApplyWidgetSettingsAsync">@Text["Analysis.ApplyWidgetSettings"]</button>
    }
</section>
}

<div class="analysis-workspace" @ref="dashboardRoot">
<div class="analysis-selection-panels">
<section class="analysis-system-picker analysis-resizable-panel" aria-labelledby="analysis-systems"
         data-analysis-panel="systems" style="@PanelStyle(Dashboard.Document.SystemsPanel)">
    <div class="admin-section-heading">
        <div><h2 id="analysis-systems">@Text["Analysis.Systems"]</h2><span>@(UsesInventoryRoles && roleSelection is null
            ? Text["Analysis.RoleSelection.CountUnavailable"]
            : Text.Format("Analysis.SelectedSystems", UsesInventoryRoles ? roleSelection?.Systems.Count ?? 0 : selectedSystems.Count))</span></div>
        @if (!UsesInventoryRoles)
        {
        <div class="admin-card-actions">
            <button class="admin-secondary" type="button" disabled="@DashboardBusy" @onclick="SelectVisibleAsync">@Text["Analysis.SelectVisible"]</button>
            <button class="admin-secondary" type="button" disabled="@DashboardBusy" @onclick="ClearSelectionAsync">@Text["Common.Clear"]</button>
        </div>
        }
    </div>
    <label class="analysis-selection-mode">
        <span>@Text["Analysis.RoleSelection.Mode"]</span>
        <select value="@selectionMode" disabled="@(DashboardBusy || PersonalActionsBlocked)" @onchange="SelectionModeChangedAsync">
            <option value="@AnalysisDashboardSelectionMode.FixedSystems">@Text["Analysis.RoleSelection.Fixed"]</option>
            <option value="@AnalysisDashboardSelectionMode.InventoryRoles">@Text["Analysis.RoleSelection.Dynamic"]</option>
        </select>
    </label>
    @if (UsesInventoryRoles)
    {
        <div class="analysis-role-selection" tabindex="0" role="region" aria-label="@Text["Analysis.RoleSelection.Roles"]">
        <fieldset disabled="@(DashboardBusy || PersonalActionsBlocked)">
            <legend>@Text["Analysis.RoleSelection.Roles"]</legend>
            <div class="analysis-system-grid">
                @foreach (var role in AvailableInventoryRoles)
                {
                    <label class="admin-check">
                        <input type="checkbox" checked="@selectedInventoryRoles.Contains(role)"
                               @onchange="args => InventoryRoleChangedAsync(role, args)" />
                        <span>@role</span>
                    </label>
                }
            </div>
        </fieldset>
        <button class="admin-secondary" type="button" disabled="@(DashboardBusy || PersonalActionsBlocked)"
                @onclick="RefreshRolePreviewAsync">@Text["Analysis.RoleSelection.Refresh"]</button>
        <p>@Text["Analysis.RoleSelection.Help"]</p>
        <div aria-live="polite">
            @if (isRefreshingSelection)
            {
                <p role="status">@Text["Analysis.RoleSelection.Loading"]</p>
            }
            else if (roleSelectionError is not null)
            {
                <div class="admin-message admin-message-error" role="alert">@roleSelectionError</div>
            }
            else if (roleSelection is not null && inventoryLoadedAt is { } snapshotAt)
            {
                <p>@Text.Format("Analysis.RoleSelection.Snapshot", snapshotAt.ToString("u"))</p>
                @if (roleSelection.Systems.Count == 0)
                {
                    <p role="status">@Text["Analysis.RoleSelection.Empty"]</p>
                }
                else
                {
                    <ul>
                        @foreach (var system in roleSelection.Systems)
                        {
                            <li><strong>@system.Computer</strong> <small>@system.SubscriptionId</small></li>
                        }
                    </ul>
                }
            }
        </div>
        </div>
    }
    else
    {
    <div class="analysis-system-grid">
        @foreach (var system in VisibleSystems)
        {
            var key = SystemKey(system);
            <label class="admin-check">
                <input type="checkbox" checked="@selectedSystems.Contains(key)"
                       disabled="@(DashboardBusy || (!selectedSystems.Contains(key) && selectedSystems.Count >= 100))"
                       @onchange="eventArgs => ToggleSystemAsync(key, eventArgs)" />
                <span><strong>@system.Computer</strong><small>@system.Domain · @system.Site · @system.Role</small></span>
            </label>
        }
    </div>
    }
    @if (editMode)
    {
    <button class="analysis-panel-resize-handle" type="button" data-analysis-panel-resize
            disabled="@DashboardBrowserBlocked"
            aria-label="@Text["Analysis.ResizeSystems"]" title="@Text["Analysis.ResizeSystemsHelp"]"></button>
    }
</section>

@if (editMode)
{
<section class="analysis-query-library analysis-resizable-panel" aria-labelledby="analysis-query-library"
         data-analysis-panel="queries" style="@PanelStyle(Dashboard.Document.QueryLibraryPanel)">
    <div class="admin-section-heading">
        <div>
            <h2 id="analysis-query-library">@Text["Analysis.QueryLibrary"]</h2>
            <span>@Text["Analysis.LibraryHelp"]</span>
        </div>
        <button class="admin-secondary" type="button" disabled="@(DashboardBusy || isRefreshingLibrary)"
                @onclick="RefreshLibraryAsync">@Text["Analysis.RefreshLibrary"]</button>
    </div>
    <AnalysisQueryCategoryTree Nodes="LibraryCategories" QueryListClass="analysis-query-library-grid">
        <QueryContent Context="query">
        @{
            var existing = Dashboard.Document.Widgets.FirstOrDefault(widget => widget.QueryDefinitionId == query.Id);
            var canPlace = !DashboardBrowserBlocked && (existing is not null || Dashboard.Document.Widgets.Count < 12);
        }
            <div class="analysis-query-library-item" @key="query.Id">
            <article draggable="@(canPlace ? "true" : "false")" tabindex="@(canPlace ? 0 : -1)" role="button"
                     aria-disabled="@(!canPlace)" aria-label="@Text.Format("Analysis.PlaceQueryLabel", QueryText.Name(query))"
                     data-analysis-query-id="@query.Id" data-column-span="@(existing?.ColumnSpan ?? 2)"
                     data-row-span="@(existing?.RowSpan ?? 4)" title="@QueryText.Description(query)">
                <span>@query.Category</span>
                <h3>@QueryText.Name(query)</h3>
                <small>@Text.Format(existing is not null ? "Analysis.LibraryVersionPlaced" : "Analysis.LibraryVersion", query.Unit, query.Version)</small>
            </article>
            <button class="admin-secondary" type="button" disabled="@(isRunning || isDashboardRunning)"
                    aria-label="@Text.Format("Analysis.RemoveFromLibraryLabel", QueryText.Name(query))" @onclick="() => HideQueryAsync(query.Id)">
                @Text["Analysis.RemoveFromLibrary"]
            </button>
            </div>
        </QueryContent>
    </AnalysisQueryCategoryTree>
    @if (HiddenLibraryQueries.Any())
    {
        <details class="analysis-hidden-queries">
            <summary>@Text.Format("Analysis.RemovedFromLibrary", HiddenLibraryQueries.Count())</summary>
            @foreach (var hiddenQuery in HiddenLibraryQueries)
            {
                <div class="admin-card-actions">
                    <span>@QueryText.Name(hiddenQuery)</span>
                    <button class="admin-secondary" type="button" @onclick="() => RestoreQueryAsync(hiddenQuery.Id)">@Text["Common.Restore"]</button>
                </div>
            }
        </details>
    }
    <button class="analysis-panel-resize-handle" type="button" data-analysis-panel-resize
            disabled="@DashboardBrowserBlocked"
            aria-label="@Text["Analysis.ResizeLibrary"]" title="@Text["Analysis.ResizeLibraryHelp"]"></button>
</section>
}
</div>

<section class="analysis-dashboard-canvas" aria-label="@Text["Analysis.CanvasLabel"]">
    @if (Dashboard.Document.Widgets.Count == 0)
    {
        <p class="admin-empty">@(editMode ? Text["Analysis.EmptyEditing"] : Text["Analysis.EmptyReadonly"])</p>
    }
        <div class="inbox-dashboard-grid analysis-dashboard-grid @(CanEditGrid ? "show-grid" : null)"
             data-inbox-dashboard-grid
             data-columns="@Dashboard.Document.Columns"
             data-rows="@Dashboard.Document.Rows"
             data-row-height="@Dashboard.Document.RowHeight"
             style="--columns:@Dashboard.Document.Columns;--rows:@Dashboard.Document.Rows;--row-height:@(Dashboard.Document.RowHeight)px">
                @for (var row = 1; row <= Dashboard.Document.Rows; row++)
                {
                    @for (var column = 1; column <= Dashboard.Document.Columns; column++)
                    {
                        <div class="inbox-drop-cell" aria-hidden="true" style="grid-column:@column;grid-row:@row;pointer-events:none">
                            <span>@column / @row</span>
                        </div>
                }
            }
            @foreach (var widget in Dashboard.Document.Widgets)
            {
                widgetResults.TryGetValue(widget.Id, out var widgetResult);
                widgetErrors.TryGetValue(widget.Id, out var widgetError);
                <article @key="widget.Id" class="inbox-dashboard-widget analysis-dashboard-widget accent-@widget.Accent @(CanEditGrid ? "edit-enabled" : null)"
                         data-inbox-widget-id="@widget.Id"
                         data-analysis-widget-query-id="@widget.QueryDefinitionId"
                         data-column-span="@widget.ColumnSpan"
                         data-row-span="@widget.RowSpan"
                         style="@DashboardWidgetStyle(widget)">
                    <header class="inbox-widget-header" data-inbox-drag-handle="@(CanEditGrid ? string.Empty : null)" title="@(CanEditGrid ? Text["Analysis.DragWidget"] : null)">
                        @if (CanEditGrid)
                        {
                            <span aria-hidden="true">⠿</span>
                        }
                        <div><strong>@widget.Title</strong><small>@AnalysisSelectionLabels.TimeRange(Text, Dashboard.Document.TimeRangeMinutesOverride ?? widget.TimeRangeMinutes) · @(Dashboard.Document.BinMinutesOverride ?? widget.BinMinutes ?? availableQueries.FirstOrDefault(query => query.Id == widget.QueryDefinitionId)?.DefaultBinMinutes) min · @widget.GroupBy</small></div>
                        @if (editMode)
                        {
                            <button class="inbox-widget-menu" type="button" @onclick="() => OpenWidget(widget)">@Text["Common.Open"]</button>
                        }
                    </header>
                    @if (CanEditGrid)
                    {
                        <div class="analysis-widget-actions">
                            <button type="button" @onclick="() => RemoveWidget(widget.Id)">@Text["Common.Remove"]</button>
                        </div>
                    }
                    <div class="inbox-widget-body analysis-widget-body">
                        @if (UsesInventoryRoles && availableQueries.Any(query => query.Id == widget.QueryDefinitionId && query.Scope == AnalysisQueryScopes.Workspace))
                        {
                            <p class="admin-message admin-message-warning" role="status">@Text["Analysis.RoleSelection.WorkspaceWide"]</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(widgetError))
                        {
                            <div class="admin-message admin-message-error">@widgetError</div>
                        }
                        else
                        {
                            <AnalysisResultView Result="widgetResult" />
                        }
                    </div>
                    @if (CanEditGrid)
                    {
                    <button class="inbox-resize-handle"
                            data-inbox-resize-handle
                            type="button"
                            title="@Text.Format("Widgets.DragResize", widget.Title)"></button>
                    }
                </article>
            }
        </div>
</section>
</div>

@if (editMode && SelectedQuery is not null)
{
    <section class="analysis-execution-preview" aria-labelledby="analysis-execution-preview">
        <div class="admin-section-heading">
            <div>
                <h2 id="analysis-execution-preview">@Text["Analysis.ExecutionPreview"]</h2>
                <span>@Text["Analysis.ExecutionPreviewHelp"]</span>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(previewError))
        {
            <div class="admin-message admin-message-warning">@previewError</div>
        }
        else if (executionPreviews.Count == 0)
        {
            <p class="admin-empty">@Text[UsesInventoryRoles ? "Analysis.RoleSelection.Empty" : "Analysis.PreviewEmpty"]</p>
        }
        else
        {
            <div class="analysis-execution-preview-grid">
                @foreach (var preview in executionPreviews)
                {
                    <article class="analysis-execution-preview-card">
                        <header>
                            <div><span>@Text["Filters.Workspace"]</span><strong>@preview.WorkspaceDisplayName</strong></div>
                            <code>@preview.WorkspaceKey</code>
                        </header>
                        <p><strong>@Text["Analysis.PreviewSystemsLabel"]</strong> @string.Join(", ", preview.Systems)</p>
                        <details open>
                            <summary>@Text["Analysis.EffectiveKql"]</summary>
                            <pre>@preview.EffectiveKql</pre>
                        </details>
                    </article>
                }
            </div>
        }
    </section>
}

@if (editMode && result is not null)
{
    <section class="analysis-result" aria-labelledby="analysis-result-title">
        <div class="admin-section-heading">
            <div>
                <h2 id="analysis-result-title">@QueryText.Name(result)</h2>
                <span>@Text.Format("AnalysisResults.ExecutionSummary", result.Version.ToString(System.Globalization.CultureInfo.CurrentCulture),
                    result.From.ToString("u"), result.To.ToString("u"),
                    result.DurationMilliseconds.ToString(System.Globalization.CultureInfo.CurrentCulture))</span>
            </div>
        </div>
        <AnalysisResultView Result="result" AllowTableView="true" @bind-ShowTable="showResultTable" />
    </section>
}

</fieldset>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private IReadOnlyList<ComputerInventoryEntry> inventory = [];
    private IReadOnlyList<AnalysisQueryDefinition> availableQueries = [];
    private IReadOnlyList<AnalysisQueryCategoryNode> LibraryCategories => AnalysisQueryCategories.Build(VisibleLibraryQueries);
    private bool isRefreshingLibrary;
    private readonly HashSet<string> selectedSystems = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> selectedInventoryRoles = new(StringComparer.OrdinalIgnoreCase);
    private AnalysisDashboardSelectionMode selectionMode;
    private AnalysisDashboardInventorySelection? roleSelection;
    private string? roleSelectionFingerprint;
    private string? roleSelectionError;
    private DateTimeOffset? inventoryLoadedAt;
    private bool isRefreshingSelection;
    private long selectionGeneration;
    private bool UsesInventoryRoles => selectionMode == AnalysisDashboardSelectionMode.InventoryRoles;
    private bool UsesPersonalRoles => selectedPublishedDashboard is null && UsesInventoryRoles;
    private bool publishedUsesInventoryRoles;
    private bool UsesRoleFilters => selectedPublishedDashboard is null ? UsesInventoryRoles : publishedUsesInventoryRoles;
    private bool HasSelectionRule => UsesInventoryRoles ? selectedInventoryRoles.Count > 0 : selectedSystems.Count > 0;
    private IEnumerable<string> AvailableInventoryRoles => inventory
        .Select(system => InventoryRoleRuleMatcher.NormalizeRole(system.Role?.Trim()))
        .OfType<string>().Where(role => !string.IsNullOrWhiteSpace(role))
        .Concat(selectedInventoryRoles).Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase);
    private string domainFilter = string.Empty;
    private string siteFilter = string.Empty;
    private string roleFilter = string.Empty;
    private string workspaceFilter = string.Empty;
    private bool runPublishedOnFilterChange;
    private Guid selectedQueryId;
    private int timeRangeMinutes = 1440;
    private int binMinutes = 15;
    private string groupBy = "SourceDSA";
    private string? openedWidgetId;
    private bool isRunning;
    private string? errorMessage;
    private string? libraryLoadError;
    private AnalysisQueryResponse? result;
    private bool showResultTable;
    private bool hasDetailRequest;
    private IReadOnlyList<AnalysisQueryExecutionPreview> executionPreviews = [];
    private string? previewError;
    private string dashboardOwnerKey = "open-access";
    private string dashboardActorKey = "open-access";
    private IReadOnlyList<AnalysisDashboardOwner> dashboardOwners = [];
    private int dashboardRevision;
    private AnalysisDashboardCollection dashboardCollection = AnalysisDashboardCollection.Create();
    private bool isChangingDashboard;
    private bool isSavingDashboard;
    private bool dashboardLoadFailed;
    private bool isLoadingDashboard;
    private bool isPublishingDashboard;
    private bool canPublishDashboard;
    private bool confirmWithdrawDashboard;
    private Guid? selectedPublishedDashboard;
    private IReadOnlyList<PublishedAnalysisDashboard> publishedDashboards = [];
    private string? publicationError;
    private string? publicationLoadError;
    private string? publicationMessage;
    private bool isTransferringSetup;
    private bool setupAwaitingExecution;
    private string setupImportJson = string.Empty;
    private string? setupExportJson;
    private string? setupTransferError;
    private string? setupTransferStatus;
    private AnalysisDashboardSetup? pendingSetup;
    private AnalysisDashboardSetupPreview? setupPreview;
    private string? setupImportWorkspace;
    private bool setupAcknowledgeInventory;
    private bool DashboardBusy => isRunning || isDashboardRunning || isChangingDashboard || isSavingDashboard || isPublishingDashboard || isLoadingDashboard || isRefreshingSelection || isTransferringSetup;
    private bool PersonalActionsBlocked => selectedPublishedDashboard is not null || isChangingDashboard || isSavingDashboard || isPublishingDashboard || isLoadingDashboard || dashboardLoadFailed || isTransferringSetup;
    private PublishedAnalysisDashboard? OwnPublication => publishedDashboards.FirstOrDefault(item =>
        item.Id == dashboardCollection.ActiveDashboardId && item.Owner.Equals(dashboardOwnerKey, StringComparison.OrdinalIgnoreCase));
    private string? dashboardStatus;
    private IReadOnlyList<AnalysisDashboardSystem> missingDashboardSystems = [];
    private readonly Dictionary<string, AnalysisQueryResponse> widgetResults = [];
    private readonly Dictionary<string, string> widgetErrors = [];
    private bool dashboardEditMode = true;
    private bool editMode;
    private bool CanEditGrid => editMode && dashboardEditMode && !DashboardBrowserBlocked;
    private bool isDashboardRunning;
    private readonly CancellationTokenSource refreshCancellation = new();
    private Task? refreshTask;
    private ElementReference dashboardRoot;
    private DashboardBrowserSession<Analysis>? dashboardBrowser;
    private bool disposed;
    private bool dashboardBrowserInitialized => dashboardBrowser?.Initialized == true;
    private bool isInitializingBrowser => dashboardBrowser?.IsInitializing == true;
    private bool initialDashboardRunStarted;
    private string? dashboardBrowserError => dashboardBrowser?.ErrorMessage(Text, "Analysis.Browser.");
    private bool DashboardBrowserBlocked => disposed || isInitializingBrowser || dashboardBrowserError is not null;

    private IEnumerable<ComputerInventoryEntry> FilteredByWorkspace => inventory.Where(SystemMatchesWorkspace);
    private IEnumerable<(string Value, string Label)> AvailableDomains =>
        Options.Workspaces
            .Where(workspace => workspaceFilter.Length == 0 || workspace.Key.Equals(workspaceFilter, StringComparison.OrdinalIgnoreCase))
            .SelectMany(workspace => workspace.Domains.Select(domain =>
                (Value: CrossTenantLogAnalyticsOptions.NormalizeDomain(domain),
                 Label: workspaceFilter.Length == 0 ? $"{workspace.GetDomainDisplayName(domain)} · {workspace.DisplayName}" : workspace.GetDomainDisplayName(domain))))
            .Concat(FilteredByWorkspace.Select(system => CrossTenantLogAnalyticsOptions.NormalizeDomain(system.Domain))
                .Where(domain => domain.Length > 0).Select(domain => (Value: domain, Label: domain)))
            .DistinctBy(domain => domain.Value, StringComparer.OrdinalIgnoreCase)
            .OrderBy(domain => domain.Label, StringComparer.OrdinalIgnoreCase);
    private IEnumerable<ComputerInventoryEntry> FilteredByDomain => FilteredByWorkspace.Where(item =>
        domainFilter.Length == 0 || CrossTenantLogAnalyticsOptions.NormalizeDomain(item.Domain) == CrossTenantLogAnalyticsOptions.NormalizeDomain(domainFilter));
    private IEnumerable<ComputerInventoryEntry> FilteredBySite => FilteredByDomain.Where(item =>
        string.IsNullOrWhiteSpace(siteFilter) || string.Equals(item.Site, siteFilter, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<ComputerInventoryEntry> VisibleSystems => FilteredBySite.Where(item =>
        string.IsNullOrWhiteSpace(roleFilter) || string.Equals(item.Role, roleFilter, StringComparison.OrdinalIgnoreCase));
    private AnalysisQueryDefinition? SelectedQuery => availableQueries.FirstOrDefault(query => query.Id == selectedQueryId);
    private IEnumerable<AnalysisQueryDefinition> VisibleLibraryQueries =>
        availableQueries.Where(query => !Dashboard.Document.HiddenQueryIds.Contains(query.Id));
    private IEnumerable<AnalysisQueryDefinition> HiddenLibraryQueries =>
        availableQueries.Where(query => Dashboard.Document.HiddenQueryIds.Contains(query.Id));
    private bool CanRun => Options.Enabled && !isRunning && !isDashboardRunning && !isRefreshingSelection && !PersonalActionsBlocked &&
        !disposed && !refreshCancellation.IsCancellationRequested && SelectedQuery is not null && HasSelectionRule;
    private bool CanRunDashboard =>
        Options.Enabled &&
        !isDashboardRunning &&
        !isRunning &&
        !isRefreshingSelection &&
        !PersonalActionsBlocked &&
        !refreshCancellation.IsCancellationRequested &&
        Dashboard.Document.Widgets.Count > 0 &&
        !disposed && HasSelectionRule;

    private async Task<IReadOnlyList<AnalysisQueryDefinition>> LoadAllowedQueriesAsync()
    {
        var user = (await AuthenticationStateTask).User;
        return (await Registry.ListPublishedAsync(refreshCancellation.Token))
            .Where(query => AnalysisQueryExecutionService.IsRoleAllowed(query.MinimumRole, user, AuthenticationOptions.IsOpen))
            .ToArray();
    }

    private async Task LoadLibraryAsync() => availableQueries = await LoadAllowedQueriesAsync();

    private AnalysisDashboardViewFilters CurrentSetupFilters => new()
        { WorkspaceKey = workspaceFilter, Domain = domainFilter, Site = siteFilter, Role = roleFilter };

    private bool HasUnsavedSetupChanges
    {
        get
        {
            if (UsesInventoryRoles && selectedInventoryRoles.Count == 0)
                return true;
            var saved = new AnalysisDashboardState();
            saved.Load(dashboardCollection.OpenActive());
            return System.Text.Json.JsonSerializer.Serialize(saved.Document) !=
                System.Text.Json.JsonSerializer.Serialize(Dashboard.Document);
        }
    }

    private void ClearSetupPreview()
    {
        pendingSetup = null;
        setupPreview = null;
        setupAcknowledgeInventory = false;
        setupTransferError = setupTransferStatus = null;
    }

    private void SetupTransferFailed(Exception exception)
    {
        Logger.LogWarning(exception, "Dashboard setup transfer could not be completed.");
        setupTransferError = exception is AnalysisDashboardSetupException setup
            ? Text[$"DashboardSetup.Errors.{setup.Code}"]
            : exception is DbUpdateConcurrencyException ? Text["Analysis.Errors.CollectionChanged"]
            : AnalysisErrorPresentation.Message(exception, Text, "DashboardSetup.Errors.Failed");
    }

    private async Task ExportDashboardSetupAsync()
    {
        if (DashboardBusy || PersonalActionsBlocked || !editMode) return;
        isTransferringSetup = true;
        setupExportJson = null;
        setupTransferError = setupTransferStatus = null;
        try
        {
            ValidateSelectionDraft();
            await DashboardRepository.RequireAccessAsync(dashboardActorKey, dashboardOwnerKey, refreshCancellation.Token);
            var queries = await LoadAllowedQueriesAsync();
            setupExportJson = AnalysisDashboardSetupJson.Export(Dashboard.Document, CurrentSetupFilters, queries);
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AnalysisDashboardSetupException or AnalysisValidationException or
            UnauthorizedAccessException or Microsoft.Data.SqlClient.SqlException or
            AnalysisQueryPublicationException or AnalysisQuerySnapshotJsonException)
        { SetupTransferFailed(exception); }
        finally { isTransferringSetup = false; }
    }

    private async Task ReadDashboardSetupFileAsync(InputFileChangeEventArgs args)
    {
        if (DashboardBusy || PersonalActionsBlocked || !editMode) return;
        ClearSetupPreview();
        setupImportJson = string.Empty;
        isTransferringSetup = true;
        try
        {
            if (args.File.Size > AnalysisDashboardSetupJson.MaxBytes)
                throw new AnalysisDashboardSetupException(AnalysisDashboardSetupError.TooLarge);
            await using var stream = args.File.OpenReadStream(AnalysisDashboardSetupJson.MaxBytes, refreshCancellation.Token);
            using var reader = new StreamReader(stream, new System.Text.UTF8Encoding(false, true), detectEncodingFromByteOrderMarks: true);
            setupImportJson = await reader.ReadToEndAsync(refreshCancellation.Token);
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AnalysisDashboardSetupException or IOException or System.Text.DecoderFallbackException or JSException)
        { SetupTransferFailed(exception); }
        finally { isTransferringSetup = false; }
        if (setupTransferError is null && !disposed)
            await PreviewDashboardSetupAsync();
    }

    private async Task RefreshSetupPreviewAsync()
    {
        var setup = pendingSetup ?? throw new InvalidOperationException("Dashboard setup preview is missing.");
        await DashboardRepository.RequireAccessAsync(dashboardActorKey, dashboardOwnerKey, refreshCancellation.Token);
        var queries = await LoadAllowedQueriesAsync();
        var currentInventory = await AlertStore.GetComputerInventoryAsync(refreshCancellation.Token);
        setupPreview = AnalysisDashboardSetupJson.Preview(setup, setupImportWorkspace, queries, currentInventory, QueryRunner.WorkspaceResolver);
    }

    private async Task PreviewDashboardSetupAsync()
    {
        if (DashboardBusy || PersonalActionsBlocked || !editMode) return;
        ClearSetupPreview();
        isTransferringSetup = true;
        try
        {
            pendingSetup = AnalysisDashboardSetupJson.Parse(setupImportJson);
            setupImportWorkspace = pendingSetup.Filters.WorkspaceKey.Length == 0 ||
                QueryRunner.WorkspaceResolver.IsConfiguredWorkspace(pendingSetup.Filters.WorkspaceKey)
                ? pendingSetup.Filters.WorkspaceKey : null;
            await RefreshSetupPreviewAsync();
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AnalysisDashboardSetupException or AnalysisValidationException or
            UnauthorizedAccessException or Microsoft.Data.SqlClient.SqlException or
            AnalysisQueryPublicationException or AnalysisQuerySnapshotJsonException)
        { setupPreview = null; SetupTransferFailed(exception); }
        finally { isTransferringSetup = false; }
    }

    private async Task SetupWorkspaceChangedAsync(ChangeEventArgs args)
    {
        if (DashboardBusy || PersonalActionsBlocked || pendingSetup is null) return;
        setupImportWorkspace = args.Value?.ToString();
        setupAcknowledgeInventory = false;
        setupTransferError = null;
        setupPreview = null;
        isTransferringSetup = true;
        try { await RefreshSetupPreviewAsync(); }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AnalysisDashboardSetupException or AnalysisValidationException or
            UnauthorizedAccessException or Microsoft.Data.SqlClient.SqlException or
            AnalysisQueryPublicationException or AnalysisQuerySnapshotJsonException)
        { SetupTransferFailed(exception); }
        finally { isTransferringSetup = false; }
    }

    private async Task ImportDashboardSetupAsync()
    {
        if (DashboardBusy || PersonalActionsBlocked || !editMode) return;
        setupTransferError = setupTransferStatus = null;
        if (pendingSetup is null || setupPreview is null || HasUnsavedSetupChanges)
        {
            Logger.LogWarning("Dashboard setup import requires a preview and a saved current dashboard.");
            setupTransferError = Text[HasUnsavedSetupChanges ? "DashboardSetup.UnsavedChanges" : "DashboardSetup.Errors.DependenciesUnavailable"];
            return;
        }
        isTransferringSetup = true;
        try
        {
            await DashboardRepository.RequireAccessAsync(dashboardActorKey, dashboardOwnerKey, refreshCancellation.Token);
            var queries = await LoadAllowedQueriesAsync();
            var currentInventory = await AlertStore.GetComputerInventoryAsync(refreshCancellation.Token);
            var previousPreview = setupPreview;
            setupPreview = AnalysisDashboardSetupJson.Preview(pendingSetup, setupImportWorkspace, queries, currentInventory, QueryRunner.WorkspaceResolver);
            if (!previousPreview.MissingSystems.Select(system => SubscriptionComputerKey.Create(system.SubscriptionId, system.Computer))
                    .SequenceEqual(setupPreview.MissingSystems.Select(system => SubscriptionComputerKey.Create(system.SubscriptionId, system.Computer)),
                        StringComparer.OrdinalIgnoreCase) ||
                !previousPreview.EmptyRoles.SequenceEqual(setupPreview.EmptyRoles, StringComparer.OrdinalIgnoreCase))
                setupAcknowledgeInventory = false;
            var document = AnalysisDashboardSetupJson.CreateDocument(pendingSetup, setupImportWorkspace, queries, currentInventory,
                QueryRunner.WorkspaceResolver, setupAcknowledgeInventory);
            var stored = await DashboardRepository.LoadAsync(dashboardActorKey, refreshCancellation.Token);
            if (dashboardOwnerKey.Equals(dashboardActorKey, StringComparison.OrdinalIgnoreCase) && stored.Revision != dashboardRevision)
                throw new DbUpdateConcurrencyException("The dashboard collection changed before import.");
            var candidate = stored.Collection ?? AnalysisDashboardCollection.Create();
            candidate.AddImported(document);
            var saved = await DashboardRepository.SaveAsync(dashboardActorKey, candidate, stored.Revision, refreshCancellation.Token);
            inventory = currentInventory;
            availableQueries = queries;
            dashboardOwnerKey = dashboardActorKey;
            ActivatePersonalDashboard(candidate, saved.Revision);
            setupAwaitingExecution = true;
            editMode = dashboardEditMode = true;
            setupImportJson = string.Empty;
            setupTransferStatus = Text.Format("DashboardSetup.Imported", Dashboard.Document.Name);
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AnalysisDashboardSetupException or AnalysisValidationException or
            UnauthorizedAccessException or DbUpdateException or Microsoft.Data.SqlClient.SqlException or
            AnalysisQueryPublicationException or AnalysisQuerySnapshotJsonException)
        { SetupTransferFailed(exception); }
        finally { isTransferringSetup = false; }
    }

    private async Task RefreshLibraryAsync()
    {
        isRefreshingLibrary = true;
        libraryLoadError = null;
        try { await LoadLibraryAsync(); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load the analysis query library.");
            libraryLoadError = exception is AnalysisQueryPublicationException or AnalysisQuerySnapshotJsonException
                ? AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.LibraryLoadFailed")
                : Text["Analysis.Errors.LibraryLoadFailed"];
        }
        finally { isRefreshingLibrary = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        workspaceFilter = FilterDefaults.ResolveWorkspace(Options);
        domainFilter = CrossTenantLogAnalyticsOptions.NormalizeDomain(FilterDefaults.Domain);
        siteFilter = FilterDefaults.Site?.Trim() ?? string.Empty;
        roleFilter = FilterDefaults.Role?.Trim() ?? string.Empty;
        var user = (await AuthenticationStateTask).User;
        dashboardActorKey = dashboardOwnerKey = await CurrentUserIdentity.GetActorAsync(user, AuthenticationOptions.IsOpen);
        canPublishDashboard = await Publishing.CanPublishAsync(user);
        await ReloadPublicationsAsync();
        await RefreshLibraryAsync();
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        if (DashboardBusy)
            return;
        isLoadingDashboard = true;
        try
        {
            await LoadDashboardOwnerAsync(dashboardOwnerKey);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load the analysis workspace data.");
            errorMessage = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ChangeFailed");
            dashboardLoadFailed = true;
            editMode = false;
        }
        finally { isLoadingDashboard = false; }
    }

    private async Task LoadDashboardOwnerAsync(string ownerKey)
    {
        var owners = await DashboardRepository.ListOwnersAsync(dashboardActorKey, refreshCancellation.Token);
        var stored = await DashboardRepository.LoadForOwnerAsync(dashboardActorKey, ownerKey, refreshCancellation.Token);
        if (stored.Collection is null && !ownerKey.Equals(dashboardActorKey, StringComparison.OrdinalIgnoreCase))
            throw new KeyNotFoundException("The historical dashboard collection is no longer available.");
        var loadedInventory = await AlertStore.GetComputerInventoryAsync(refreshCancellation.Token);
        if (!ownerKey.Equals(dashboardActorKey, StringComparison.OrdinalIgnoreCase))
            await DashboardRepository.RequireAccessAsync(dashboardActorKey, ownerKey, refreshCancellation.Token);
        var collection = stored.Collection ?? AnalysisDashboardCollection.Create();
        collection.OpenActive().ValidateSelection();
        InvalidateSelection();
        inventory = loadedInventory;
        inventoryLoadedAt = DateTimeOffset.UtcNow;
        dashboardOwnerKey = ownerKey;
        dashboardOwners = owners;
        ActivatePersonalDashboard(collection, stored.Revision);
        dashboardLoadFailed = false;
        dashboardStatus = stored.Collection is null ? null : Text.Format("AnalysisStatus.Restored", dashboardRevision);
    }

    private async Task ChangeDashboardOwnerAsync(ChangeEventArgs args)
    {
        if (DashboardBusy || selectedPublishedDashboard is not null)
            return;
        var ownerKey = args.Value?.ToString();
        if (ownerKey is null || !dashboardOwners.Any(owner => owner.OwnerKey.Equals(ownerKey, StringComparison.OrdinalIgnoreCase)))
        {
            Logger.LogWarning("An unavailable analysis dashboard owner was selected.");
            errorMessage = Text["AnalysisDashboards.AccessDenied"];
            return;
        }
        isChangingDashboard = true;
        try
        {
            if (!dashboardLoadFailed && !await TrySaveDashboardAsync() && !dashboardLoadFailed)
                return;
            await LoadDashboardOwnerAsync(ownerKey);
            errorMessage = publicationError = publicationMessage = null;
        }
        catch (UnauthorizedAccessException exception) { DashboardAccessDenied(exception); }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not switch the analysis dashboard owner.");
            errorMessage = AnalysisErrorPresentation.Message(exception, Text, "Analysis.Errors.ChangeFailed");
        }
        finally { isChangingDashboard = false; }
        if (!editMode && !dashboardLoadFailed && errorMessage is null)
            await RunDashboardAsync();
    }

    private void DashboardAccessDenied(UnauthorizedAccessException exception)
    {
        Logger.LogWarning(exception, "Historical alias dashboard access is no longer available.");
        ClearSetupPreview();
        setupExportJson = null;
        setupImportJson = string.Empty;
        InvalidateSelection();
        dashboardLoadFailed = true;
        errorMessage = Text["AnalysisDashboards.AccessDenied"];
    }

    private async Task<bool> CheckDashboardAccessAsync()
    {
        if (dashboardOwnerKey.Equals(dashboardActorKey, StringComparison.OrdinalIgnoreCase))
            return true;
        try
        {
            await DashboardRepository.RequireAccessAsync(dashboardActorKey, dashboardOwnerKey, refreshCancellation.Token);
            return true;
        }
        catch (UnauthorizedAccessException exception)
        {
            DashboardAccessDenied(exception);
            return false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        refreshTask ??= RefreshClockAsync(refreshCancellation.Token);
        if (!dashboardBrowserInitialized && dashboardBrowserError is null)
            await InitializeDashboardBrowserAsync();
        if (disposed || initialDashboardRunStarted) return;
        initialDashboardRunStarted = true;
        if (!editMode)
        {
            await RunDashboardAsync();
            if (!disposed) StateHasChanged();
        }
    }

    private Task RetryDashboardBrowserAsync() => InitializeDashboardBrowserAsync();

    private Task InitializeDashboardBrowserAsync()
    {
        if (disposed) return Task.CompletedTask;
        dashboardBrowser ??= new(JS, Logger, "./js/analysis-dashboard.js", this, refreshCancellation.Token);
        return dashboardBrowser.InitializeAsync(dashboardRoot,
            () => disposed ? Task.CompletedTask : InvokeAsync(StateHasChanged));
    }

    private async Task EditModeChangedAsync()
    {
        confirmWithdrawDashboard = false;
        if (!editMode)
        {
            hasDetailRequest = false;
            await RunDashboardAsync();
        }
    }

    private async Task WorkspaceChangedAsync()
    {
        domainFilter = siteFilter = roleFilter = string.Empty;
        await DashboardFiltersChangedAsync();
    }

    private async Task DomainChangedAsync()
